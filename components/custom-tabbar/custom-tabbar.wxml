<view class="custom-tabbar {{dimmed ? 'content-dimmed' : ''}}" style="--safe-bottom: {{safeBottom}}px;">
  <image class="tabbar-bg" src="/assets/images/home-bottom-btn.png" mode="scaleToFill"></image>
  <view class="tab-item {{active === 'home' ? 'active' : ''}}" hover-class="none" bindtap="switchToHome">
    <image class="tab-icon" src="{{active === 'home' ? '/assets/images/tabbar-home02.svg' : '/assets/images/tabbar-home01.svg'}}" mode="aspectFit"></image>
    <view>首页</view>
  </view>
  <!-- 中间 AI 入口（新版需求：Tab 栏中间新增独立 ICON）。UI 未出图，先用渐变色块占位。
       ⚠️ 当前需求：AI生图入口暂时整体屏蔽（后续再开放），aiEntryEnabled 默认 false 隐藏本按钮，
       置回 true 即恢复。屏蔽期间可在「硬件联调调试台」底部暗门输入口令临时进入 AI 页面。
       用 wx:else 空占位保住中间栏，维持首页/我的的左右布局不塌。 -->
  <view wx:if="{{aiEntryEnabled}}" class="tab-item tab-item--ai" hover-class="none" bindtap="goAi">
    <view class="ai-fab">AI</view>
    <view class="ai-label">AI生图</view>
  </view>
  <view wx:else class="tab-item tab-item--ai-placeholder"></view>
  <view class="tab-item {{active === 'mine' ? 'active' : ''}}" hover-class="none" bindtap="switchToMine">
    <image class="tab-icon" src="{{active === 'mine' ? '/assets/images/tabbar-mine02.svg' : '/assets/images/tabbar-mine01.svg'}}" mode="aspectFit"></image>
    <view>我的</view>
  </view>
</view>
