.custom-tabbar {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(26rpx + var(--safe-bottom));
  z-index: 5;
  display: grid;
  grid-template-columns: 1fr 1fr;
  height: 112rpx;
  background: rgba(255, 255, 255, 0.74);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 50rpx rgba(126, 150, 184, 0.14);
}

.content-dimmed {
  opacity: 0.42;
}

button {
  font: inherit;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 0;
  padding: 0;
  color: #777d86;
  background: transparent;
  border-radius: 0;
  font-size: 24rpx;
  line-height: 1;
}

.tab-item::after {
  border: 0;
}

.tab-item.active {
  color: #ff6421;
}

.tab-icon {
  width: 56rpx;
  height: 56rpx;
}
