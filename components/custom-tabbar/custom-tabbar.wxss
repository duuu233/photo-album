.custom-tabbar {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(26rpx + var(--safe-bottom));
  z-index: 5;
  display: grid;
  /* 2026-08-21 由四格收回两格（首页 / 我的）：中间的「AI助手」「官方图库」入口已搬到首页六宫格。
     胶囊本身宽高没变，只是每格从 163rpx 回到 327rpx，两个 tab 各占半边、图标文字自然居中。 */
  grid-template-columns: repeat(2, 1fr);
  height: 112rpx;
  /* 2026-08-21：底色改成纯白，不再用背景图（原来是 home-bottom-btn.png 那张「胶囊实体 + 投影」整图）。
     阴影随之由 CSS 自己画：与首页设备卡 .carousel-glass 同一套参数，观感一致。 */
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 32rpx rgba(60, 53, 16, 0.12);
}

/* ⚠️ 2026-08-21 起底栏不再用背景图，下面这块按产品要求注释保留（怕要换回去，图片文件也还在）：
   home-bottom-btn.png 是 720×183 的「胶囊实体 + 投影」整图，实测实体 x[32,687] y[32,145]=656×114、
   四周投影留白 L32/R32/T32/B37，等比映射成 718×180rpx 并用负偏移定位，使实体正好覆盖可视区 654×112rpx。

.tabbar-bg {
  position: absolute;
  left: -32rpx;
  top: -31rpx;
  width: 718rpx;
  height: 180rpx;
  z-index: -1;
}
*/

.content-dimmed {
  opacity: 0.42;
}

button {
  font: inherit;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 0;
  padding: 0;
  color: #777d86;
  background: transparent;
  border-radius: 0;
  font-size: 24rpx;
  line-height: 1;
}

.tab-item::after {
  border: 0;
}

.tab-item.active {
  color: #ED6315;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}
