.name-mask {
  position: fixed;
  inset: 0;
  z-index: 990;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(19, 29, 43, 0.42);
  backdrop-filter: blur(10rpx);
}

.name-dialog {
  width: 100%;
  padding: 40rpx 40rpx 36rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(246, 251, 255, 0.96));
  border: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 40rpx;
  box-shadow: 0 32rpx 80rpx rgba(78, 104, 141, 0.22);
}

/* 设备图：图片本身四角透明、自带圆环底，不要再加背景色块或圆角，否则会露出方底 */
.name-dialog__device {
  display: block;
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto 20rpx;
}

.name-dialog__title {
  color: #252b33;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.25;
  text-align: center;
}

.name-dialog__tip {
  margin-top: 12rpx;
  color: #89919d;
  font-size: 24rpx;
  text-align: center;
}

.name-field {
  display: flex;
  align-items: center;
  height: 104rpx;
  margin-top: 34rpx;
  padding: 0 28rpx;
  background: rgba(236, 244, 252, 0.86);
  border: 2rpx solid rgba(156, 179, 209, 0.22);
  border-radius: 24rpx;
}

.name-field__input {
  flex: 1;
  min-width: 0;
  color: #252b33;
  font-size: 30rpx;
}

.name-field__placeholder {
  color: #a9b1bc;
  font-size: 30rpx;
}

.name-field__count {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #98a0ab;
  font-size: 22rpx;
}

.name-dialog__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

/* 文案居中（2026-07-31）：原来只靠 line-height 撑高，button 自带的左右 padding 与
   loading 态插入的 spinner 都会把文字顶偏。改成 flex 居中，两态、两行文案长度都稳定在正中。 */
.name-dialog__button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.name-dialog__button::after {
  border: 0;
}

.name-dialog__button--cancel {
  color: #6d7682;
  background: #edf2f7;
}

.name-dialog__button--confirm {
  color: #fff;
  background: linear-gradient(100deg, #ff8b42, #ff6122);
  box-shadow: 0 14rpx 28rpx rgba(255, 97, 34, 0.22);
}

.name-dialog__button[disabled] {
  opacity: 0.62;
}
