.page-nav {
  position: relative;
  z-index: 10;
  height: var(--nav-height, 64px);
  padding-top: calc(var(--nav-status, 20px) + var(--nav-row-top, 6px));
  color: #111111;
  background: transparent;
}

.nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--nav-row-height, 32px);
  padding: 0 var(--nav-capsule-space, 96px) 0 24rpx;
}

.nav-btn,
.nav-right {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: var(--nav-row-height, 32px);
}

.nav-btn {
  flex: 0 0 var(--nav-row-height, 32px);
  width: var(--nav-row-height, 32px);
}

.nav-right {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  max-width: 160rpx;
  padding: 0 12rpx;
  color: #ff6421;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right--icon {
  min-width: var(--nav-row-height, 32px);
  width: var(--nav-row-height, 32px);
  padding: 0;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.18);
  font-size: 34rpx;
  font-weight: 400;
}

.nav-placeholder {
  visibility: hidden;
  pointer-events: none;
}

.nav-btn--hover {
  opacity: 0.58;
}

.nav-back-icon {
  width: 20rpx;
  height: 20rpx;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.nav-title {
  position: absolute;
  top: 50%;
  right: var(--nav-capsule-space, 96px);
  left: var(--nav-capsule-space, 96px);
  overflow: hidden;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  transform: translateY(-50%);
  white-space: nowrap;
  pointer-events: none;
}
