.page-nav {
  position: relative;
  z-index: 10;
  height: var(--nav-height, 64px);
  padding-top: calc(var(--nav-status, 20px) + var(--nav-row-top, 6px));
  color: #111111;
  background: transparent;
}

.nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--nav-row-height, 32px);
  padding: 0 var(--nav-capsule-space, 96px) 0 24rpx;
}

.nav-btn,
.nav-right {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: var(--nav-row-height, 32px);
}

.nav-btn {
  flex: 0 0 var(--nav-row-height, 32px);
  width: var(--nav-row-height, 32px);
}

.nav-right {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  max-width: 160rpx;
  padding: 0 12rpx;
  color: #ff6421;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right--icon {
  min-width: var(--nav-row-height, 32px);
  width: var(--nav-row-height, 32px);
  padding: 0;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.18);
  font-size: 34rpx;
  font-weight: 400;
}

.nav-placeholder {
  visibility: hidden;
  pointer-events: none;
}

.nav-btn--hover {
  opacity: 0.58;
}

/* 返回按钮：整颗按钮就是一张 ai-back-button.png(136×136)，注意这张图不是「画满」的：
   ① 看得见的白色圆角方块只占画布 48.5%（35..100 / 28..93），四周是透明投影留白 ——
      所以图要放到行高的 2 倍(64px)，白块才 31px、和右侧原生胶囊(32px)等高；
      左右方向图是对称的，居中放进 32px 的 .nav-btn 后白块正好铺满这个盒子，无需补偿；
   ② 投影是往下糊的，白块在画布里偏上 7px = 画布高的 5.15%，直接居中会看着偏高 ——
      所以整张图再往下推 5.15% 自身高度，让「白块」而不是「图+投影」上下居中。
   ③ 图比 32px 的点击盒大一圈会溢出到页面内容上，pointer-events 关掉它自己的命中，
      只让 .nav-btn 收点击，免得吃掉导航下方内容的触摸。*/
.nav-back {
  position: relative;
}

.nav-back-image {
  flex: 0 0 auto;
  width: calc(var(--nav-row-height, 32px) * 2);
  height: calc(var(--nav-row-height, 32px) * 2);
  transform: translateY(5.15%);
  pointer-events: none;
}

/* 导航栏自定义内容位：与 .nav-title 占同一条带，但左边界让开返回按钮、右边界让开微信胶囊，
   内容靠右（产品口径「右上角的设备选择下拉框」）。宽度由内容自己定，最宽不越界。
   left 用固定 110rpx 而不是 calc(返回键宽度…)：返回键宽度是 px 变量、左内边距是 rpx，
   混进 calc 在部分基础库上会失效；内容本就靠右排，这里只需保证不压到返回键。 */
.nav-center {
  position: absolute;
  top: 50%;
  right: var(--nav-capsule-space, 96px);
  left: 110rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  transform: translateY(-50%);
}

.nav-title {
  position: absolute;
  top: 50%;
  right: var(--nav-capsule-space, 96px);
  left: var(--nav-capsule-space, 96px);
  overflow: hidden;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  transform: translateY(-50%);
  white-space: nowrap;
  pointer-events: none;
}
