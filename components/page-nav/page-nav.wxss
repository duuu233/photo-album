.page-nav {
  position: relative;
  z-index: 10;
  height: var(--nav-height, 64px);
  padding-top: calc(var(--nav-status, 20px) + var(--nav-row-top, 6px));
  color: #111111;
  background: transparent;
}

.nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--nav-row-height, 32px);
  padding: 0 var(--nav-capsule-space, 96px) 0 24rpx;
}

.nav-btn,
.nav-right {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: var(--nav-row-height, 32px);
}

.nav-btn {
  flex: 0 0 var(--nav-row-height, 32px);
  width: var(--nav-row-height, 32px);
}

.nav-right {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  max-width: 160rpx;
  padding: 0 12rpx;
  color: #ff6421;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right--icon {
  min-width: var(--nav-row-height, 32px);
  width: var(--nav-row-height, 32px);
  padding: 0;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.18);
  font-size: 34rpx;
  font-weight: 400;
}

/* 图标型右侧入口：点击盒与返回键同高（＝原生胶囊高度），图本身按各自留白单独补偿。
   ai-new-chat.png 是画满的方图，不需要像返回键那样放大两倍。 */
.nav-right--image {
  min-width: var(--nav-row-height, 32px);
  width: var(--nav-row-height, 32px);
  padding: 0;
}

.nav-right-image {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
}

.nav-placeholder {
  visibility: hidden;
  pointer-events: none;
}

.nav-btn--hover {
  opacity: 0.58;
}

/* 返回按钮：整颗按钮就是一张 ai-back-button.png(136×136)，注意这张图不是「画满」的：
   ① 看得见的白色圆角方块只占画布 48.5%（35..100 / 28..93），四周是透明投影留白 ——
      所以图要放到行高的 2 倍(64px)，白块才 31px、和右侧原生胶囊(32px)等高；
      左右方向图是对称的，居中放进 32px 的 .nav-btn 后白块正好铺满这个盒子，无需补偿；
   ② 投影是往下糊的，白块在画布里偏上 7px = 画布高的 5.15%，直接居中会看着偏高 ——
      所以整张图再往下推 5.15% 自身高度，让「白块」而不是「图+投影」上下居中。
   ③ 图比 32px 的点击盒大一圈会溢出到页面内容上，pointer-events 关掉它自己的命中，
      只让 .nav-btn 收点击，免得吃掉导航下方内容的触摸。*/
.nav-back {
  position: relative;
}

.nav-back-image {
  flex: 0 0 auto;
  width: calc(var(--nav-row-height, 32px) * 2);
  height: calc(var(--nav-row-height, 32px) * 2);
  transform: translateY(5.15%);
  pointer-events: none;
}

/* 导航栏自定义内容位：与 .nav-title 占同一条带，**屏幕水平居中**（2026-08-02 改）。
   它承担的是标题的角色（设备照片 / 投屏管理两页去掉了标题，改放设备下拉），
   所以必须站在标题该在的位置——靠右排会紧贴微信胶囊，看起来就是「压着胶囊」。

   三条必须一起写，少一条就出 bug：
   ① `left/right: 0` + `margin: 0 auto` 才是真居中：靠 `right: 胶囊宽` 去挤会把中心点左移
      （靠右排正是「压着胶囊」的来源）。两侧都是 0 时 auto 边距把盒子摆到屏幕正中，
      再由 max-width 决定它多宽；
   ② max-width 用 --nav-center-max（page-nav.js 按真实胶囊位置算，见 computeCenterMaxWidth）：
      居中元素两侧各留 (屏宽 − 自身宽)/2，只要自身宽 ≤ 屏宽 − 2×胶囊 − 2×间距，
      右边不碰胶囊、左边也不碰返回键。**这个夹子必须放在组件自己的节点上**——
      页面通过 slot 传进来的内容归页面作用域，组件样式管不到它；
   ③ 这块盖在返回键上面（DOM 里排最后），所以自己 pointer-events:none，
      再由内容（app.wxss 的 .nav-device-filter）单独打开——否则返回键点不动。 */
.nav-center {
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  max-width: var(--nav-center-max, 160px);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  transform: translateY(-50%);
  pointer-events: none;
}

.nav-title {
  position: absolute;
  top: 50%;
  right: var(--nav-capsule-space, 96px);
  left: var(--nav-capsule-space, 96px);
  overflow: hidden;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  transform: translateY(-50%);
  white-space: nowrap;
  pointer-events: none;
}
