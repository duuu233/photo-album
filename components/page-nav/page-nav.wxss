.page-nav {
  padding: calc(18rpx + env(safe-area-inset-top)) 24rpx 14rpx;
  color: #172133;
  background: #ffffff;
}

.page-nav--immersive {
  background: transparent;
}

.nav-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}

.nav-back,
.nav-right {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 64rpx;
  color: #1769e0;
  font-size: 26rpx;
}

.nav-back {
  width: 64rpx;
  border-radius: 8rpx;
  background: rgba(23, 105, 224, 0.08);
}

.nav-back--placeholder,
.nav-right--placeholder {
  background: transparent;
}

.nav-back-icon {
  height: 58rpx;
  font-size: 52rpx;
  line-height: 52rpx;
}

.nav-copy {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.nav-title {
  overflow: hidden;
  color: #172133;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-subtitle {
  overflow: hidden;
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}
