page {
  min-height: 100vh;
  color: #232323;
  background: #f2f5fc;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1.4;
  text-align: inherit;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

input {
  min-width: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx;
  background:
    radial-gradient(circle at 12% 0%, rgba(255, 236, 215, 0.86), transparent 310rpx),
    linear-gradient(180deg, #f6f7fb 0%, #eef2f8 100%);
}

.safe-bottom {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.page-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.page-title__main {
  color: #232323;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-title__sub {
  margin-top: 8rpx;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.6;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
  color: #232323;
  font-size: 30rpx;
  font-weight: 700;
}

.card,
.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(218, 225, 235, 0.92);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 42rpx rgba(64, 77, 97, 0.08);
}

.soft-card {
  background: #f8fafc;
  border: 1rpx solid #e5ebf3;
  border-radius: 18rpx;
}

.caption,
.muted {
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.55;
}

.strong {
  color: #232323;
  font-weight: 800;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.ghost-btn,
.text-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn {
  color: #ffffff;
  background: #eb5f1b;
  box-shadow: 0 14rpx 28rpx rgba(235, 95, 27, 0.22);
}

.primary-btn[disabled],
.primary-btn.disabled {
  color: rgba(255, 255, 255, 0.76);
  background: #c8cdd5;
  box-shadow: none;
}

.secondary-btn {
  color: #eb5f1b;
  background: #fff1e9;
}

.danger-btn {
  color: #c7372f;
  background: #fff0ef;
}

.ghost-btn {
  color: #3b4048;
  background: #edf1f7;
}

.text-btn,
.link-btn {
  min-height: 56rpx;
  color: #eb5f1b;
  font-size: 26rpx;
  font-weight: 700;
}

.tag,
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1d8a5f;
  background: #e9f8f1;
  font-size: 22rpx;
  font-weight: 700;
}

.tag.warn,
.pill.warn {
  color: #b5650f;
  background: #fff3df;
}

.tag.danger,
.pill.danger {
  color: #c7372f;
  background: #fff0ef;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #1d8a5f;
}

.tag.danger .status-dot {
  background: #c7372f;
}

.empty {
  padding: 74rpx 34rpx;
  color: #8b9098;
  text-align: center;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a2a8b1;
  background: #f0f0f0;
  border: 1rpx dashed #d1d5dc;
  font-size: 24rpx;
}

.list-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: 104rpx;
  padding: 0 26rpx;
  color: #232323;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f5;
}

.list-cell:last-child {
  border-bottom: 0;
}

.cell-arrow {
  color: #b3b8c2;
  font-size: 36rpx;
  line-height: 1;
}

.form-row {
  padding: 22rpx 26rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f5;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-label {
  margin-bottom: 12rpx;
  color: #6d747e;
  font-size: 24rpx;
  font-weight: 700;
}

.form-input {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  color: #232323;
  background: #f7f9fc;
  border: 1rpx solid #e1e7ef;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: rgba(17, 24, 39, 0.42);
}

.modal-panel {
  width: 100%;
  padding: 34rpx 30rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.modal-title {
  color: #232323;
  font-size: 34rpx;
  font-weight: 800;
}

.modal-desc {
  margin-top: 14rpx;
  color: #6d747e;
  font-size: 26rpx;
  line-height: 1.65;
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.mock-root {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  color: #25282d;
  background:
    radial-gradient(circle at 88% 22%, rgba(255, 190, 126, 0.34), rgba(255, 190, 126, 0) 260rpx),
    radial-gradient(circle at 8% 2%, rgba(190, 221, 255, 0.8), rgba(190, 221, 255, 0) 540rpx),
    linear-gradient(180deg, #f5f9ff 0%, #edf6ff 100%);
}

.mock-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
}

.mock-bg__curve {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 50%;
}

.mock-bg__curve--top {
  top: -330rpx;
  left: -210rpx;
  width: 840rpx;
  height: 580rpx;
}

.mock-bg__curve--bottom {
  right: -150rpx;
  bottom: -246rpx;
  width: 550rpx;
  height: 550rpx;
}

.mock-bg__spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  box-shadow: 0 0 20rpx rgba(255, 198, 130, 0.76);
}

.mock-bg__spark--one {
  top: 126rpx;
  right: 116rpx;
}

.mock-bg__spark--two {
  top: 178rpx;
  left: 138rpx;
}

.mock-bg__spark--three {
  right: 156rpx;
  bottom: 82rpx;
  opacity: 0.72;
}

.mock-nav {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  min-height: 64rpx;
  padding: calc(var(--status-bar, 20px) + 28rpx) 44rpx 26rpx;
}

.mock-nav__title {
  overflow: hidden;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mock-nav__back,
.mock-nav__right {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.mock-nav__back {
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
}

.mock-nav__right {
  justify-self: end;
}

.mock-nav__back-icon {
  width: 18rpx;
  height: 18rpx;
  border-bottom: 3rpx solid #7d8792;
  border-left: 3rpx solid #7d8792;
  transform: rotate(45deg);
}

.mock-nav__add {
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.18);
}

.mock-nav__add::before,
.mock-nav__add::after {
  position: absolute;
  width: 24rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 999rpx;
  content: "";
}

.mock-nav__add::after {
  transform: rotate(90deg);
}

.mock-content {
  position: relative;
  z-index: 1;
  padding: 0 46rpx calc(42rpx + var(--safe-bottom, 0px));
}

.glass-panel {
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 34rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

.thin-divider {
  height: 1rpx;
  background: rgba(218, 222, 228, 0.95);
}

.ui-chevron {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.ui-bluetooth {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  color: currentColor;
}

.ui-bluetooth::before {
  position: absolute;
  top: 1rpx;
  left: 8rpx;
  width: 3rpx;
  height: 18rpx;
  background: currentColor;
  border-radius: 999rpx;
  content: "";
}

.ui-bluetooth::after {
  position: absolute;
  top: 1rpx;
  left: 4rpx;
  width: 11rpx;
  height: 11rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
  content: "";
}

.ui-battery {
  position: relative;
  width: 32rpx;
  height: 18rpx;
  padding: 3rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}

.ui-battery::after {
  position: absolute;
  top: 4rpx;
  right: -6rpx;
  width: 4rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 0 2rpx 2rpx 0;
  content: "";
}

.ui-battery__fill {
  display: block;
  height: 100%;
  background: #52b862;
  border-radius: 2rpx;
}

.frame-logo {
  position: relative;
  width: 48rpx;
  height: 40rpx;
  color: currentColor;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.frame-logo::before {
  position: absolute;
  right: 4rpx;
  bottom: -13rpx;
  left: 4rpx;
  height: 5rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  content: "";
}
