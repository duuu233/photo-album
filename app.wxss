page {
  min-height: 100vh;
  color: #232323;
  background: #f2f5fc;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1.4;
  text-align: inherit;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

input {
  min-width: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx;
  background:
    radial-gradient(
      circle at 12% 0%,
      rgba(255, 236, 215, 0.86),
      transparent 310rpx
    ),
    linear-gradient(180deg, #f6f7fb 0%, #eef2f8 100%);
}

.safe-bottom {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.page-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.page-title__main {
  color: #232323;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-title__sub {
  margin-top: 8rpx;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.6;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
 
  margin-bottom: 16rpx;
  color: #232323;
  font-size: 30rpx;
  font-weight: 700;
}

.card,
.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(218, 225, 235, 0.92);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 42rpx rgba(64, 77, 97, 0.08);
}

.soft-card {
  background: #f8fafc;
  border: 1rpx solid #e5ebf3;
  border-radius: 18rpx;
}

.caption,
.muted {
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.55;
}

.strong {
  color: #232323;
  font-weight: 800;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.ghost-btn,
.text-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn {
  color: #ffffff;
  background: #eb5f1b;
  box-shadow: 0 14rpx 28rpx rgba(235, 95, 27, 0.22);
}

.primary-btn[disabled],
.primary-btn.disabled {
  color: rgba(255, 255, 255, 0.76);
  background: #c8cdd5;
  box-shadow: none;
}

.secondary-btn {
  color: #eb5f1b;
  background: #fff1e9;
}

.danger-btn {
  color: #c7372f;
  background: #fff0ef;
}

.ghost-btn {
  color: #3b4048;
  background: #edf1f7;
}

.text-btn,
.link-btn {
  min-height: 56rpx;
  color: #eb5f1b;
  font-size: 26rpx;
  font-weight: 700;
}

.tag,
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1d8a5f;
  background: #e9f8f1;
  font-size: 22rpx;
  font-weight: 700;
}

.tag.warn,
.pill.warn {
  color: #b5650f;
  background: #fff3df;
}

.tag.danger,
.pill.danger {
  color: #c7372f;
  background: #fff0ef;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #1d8a5f;
}

.tag.danger .status-dot {
  background: #c7372f;
}

.empty {
  padding: 74rpx 34rpx;
  color: #8b9098;
  text-align: center;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a2a8b1;
  background: #f0f0f0;
  border: 1rpx dashed #d1d5dc;
  font-size: 24rpx;
}

.list-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: 104rpx;
  padding: 0 26rpx;
  color: #232323;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f5;
}

.list-cell:last-child {
  border-bottom: 0;
}

.cell-arrow {
  color: #b3b8c2;
  font-size: 36rpx;
  line-height: 1;
}

.form-row {
  padding: 22rpx 26rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f5;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-label {
  margin-bottom: 12rpx;
  color: #6d747e;
  font-size: 24rpx;
  font-weight: 700;
}

.form-input {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  color: #232323;
  background: #f7f9fc;
  border: 1rpx solid #e1e7ef;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 弹层动画（全局可用）：只作用于弹层本体——底部弹层上滑、居中弹窗缩放淡入（入场），
   配合 pop-closing-* 类做退场。遮罩层不加任何动画，保持原样瞬时显隐。 */
@keyframes popSheetSlideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes popDialogIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes popSheetSlideDown {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}

@keyframes popDialogOut {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.94);
  }
}

.pop-closing-sheet {
  animation: popSheetSlideDown 0.24s ease-in forwards !important;
}

.pop-closing-dialog {
  animation: popDialogOut 0.2s ease-in forwards !important;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: rgba(17, 24, 39, 0.42);
}

.modal-panel {
  width: 100%;
  padding: 34rpx 30rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.modal-title {
  color: #232323;
  font-size: 34rpx;
  font-weight: 800;
}

.modal-desc {
  margin-top: 14rpx;
  color: #6d747e;
  font-size: 26rpx;
  line-height: 1.65;
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.mock-root {
  position: relative;
  min-height: 100vh;
  /* overflow-x: hidden;
  color: #25282d; */
  /* background:
    radial-gradient(
      circle at 88% 22%,
      rgba(255, 190, 126, 0.34),
      rgba(255, 190, 126, 0) 260rpx
    ),
    radial-gradient(
      circle at 8% 2%,
      rgba(190, 221, 255, 0.8),
      rgba(190, 221, 255, 0) 540rpx
    ),
    linear-gradient(180deg, #f5f9ff 0%, #edf6ff 100%); */
}

.mock-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
}

/* 背景图：铺满整个 mock-bg 层 */
.mock-bg__image {
  width: 100%;
  height: 100%;
}

.mock-nav {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  min-height: 64rpx;
  padding: calc(var(--status-bar, 20px) + 28rpx) 44rpx 26rpx;
}

.mock-nav__title {
  overflow: hidden;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mock-nav__back,
.mock-nav__right {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.mock-nav__back {
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
}

.mock-nav__right {
  justify-self: end;
}

.mock-nav__back-icon {
  width: 18rpx;
  height: 18rpx;
  border-bottom: 3rpx solid #7d8792;
  border-left: 3rpx solid #7d8792;
  transform: rotate(45deg);
}

.mock-nav__add {
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.18);
}

.mock-nav__add::before,
.mock-nav__add::after {
  position: absolute;
  width: 24rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 999rpx;
  content: '';
}

.mock-nav__add::after {
  transform: rotate(90deg);
}

.mock-content {
  position: relative;
  z-index: 1;
  padding: 0 46rpx calc(42rpx + var(--safe-bottom, 0px));
}

.glass-panel {
  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

.thin-divider {
  height: 1rpx;
  /* background: rgba(218, 222, 228, 0.95); */
  background: rgba(42, 43, 43, 0.08);
}

.ui-chevron {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.ui-bluetooth {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  color: currentColor;
}

.ui-bluetooth::before {
  position: absolute;
  top: 1rpx;
  left: 8rpx;
  width: 3rpx;
  height: 18rpx;
  background: currentColor;
  border-radius: 999rpx;
  content: '';
}

.ui-bluetooth::after {
  position: absolute;
  top: 1rpx;
  left: 4rpx;
  width: 11rpx;
  height: 11rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
  content: '';
}

.ui-battery {
  position: relative;
  width: 32rpx;
  height: 18rpx;
  padding: 3rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}

.ui-battery::after {
  position: absolute;
  top: 4rpx;
  right: -6rpx;
  width: 4rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 0 2rpx 2rpx 0;
  content: '';
}

.ui-battery__fill {
  display: block;
  height: 100%;
  background: #52b862;
  border-radius: 2rpx;
}

/* 电量等级图标（BatteryLevel/battery-{n}.png，原图 60x60 方形）：
   盒子必须同为方形——过宽盒子会让 aspectFit 把图标水平居中，左侧留出空白，
   与上一行的蓝牙图标左边缘对不齐（首页/设备列表/设备详情三处共用） */
.battery-level-icon {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
}

.frame-logo {
  position: relative;
  width: 48rpx;
  height: 40rpx;
  color: currentColor;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.frame-logo::before {
  position: absolute;
  right: 4rpx;
  bottom: -13rpx;
  left: 4rpx;
  height: 5rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  content: '';
}

/* 数据加载占位：接口返回前展示，避免「空态先闪一下再出数据」。各数据页通用 */
.page-loading {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 48vh;
  padding: 80rpx 46rpx;
}

.page-loading__spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(235, 95, 27, 0.18);
  border-top-color: #eb5f1b;
  border-radius: 50%;
  animation: pageLoadingSpin 0.8s linear infinite;
}

.page-loading__text {
  margin-top: 24rpx;
  color: #8b9098;
  font-size: 26rpx;
}

@keyframes pageLoadingSpin {
  to {
    transform: rotate(360deg);
  }
}

/* ───────────────────────────────────────────────────────────────────────────
   导航栏内的设备选择下拉框（2026-08-01）
   设备照片页与投屏管理页都去掉了页面标题，改由导航栏右上角的设备下拉承担标题作用。
   两页此前各写一套（图库 224rpx 胶囊 / 投屏 370rpx 胶囊，宽度对不上，App 也跟着不一致），
   这里收成一份全局样式：两页共用，改一处两页同步，Flutter 侧按同样尺寸对齐。
   ─────────────────────────────────────────────────────────────────────────── */
.nav-device-filter {
  position: relative;
  min-width: 0;
  /* 拉长到 370rpx（与投屏管理原有宽度一致）；空间不足时可收缩，不越过微信胶囊 */
  flex: 0 1 370rpx;
  width: 370rpx;
}

.nav-device-filter__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 60rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #3b4149;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(126, 150, 184, 0.1);
  font-size: 25rpx;
  font-weight: 600;
}

/* 设备名单行省略号。min-width:0 不可省：flex 子项默认 min-width:auto，
   不归零时 overflow:hidden 不生效，长名字照样把胶囊顶宽/顶成两行。 */
.nav-device-filter__name {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-device-filter__arrow {
  /* 箭头不许被长名字压缩掉 */
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #777e88;
  border-bottom: 2rpx solid #777e88;
  transform: rotate(45deg) translateY(-3rpx);
}

.nav-device-filter__arrow.is-open {
  transform: rotate(225deg) translateY(-3rpx);
}

.nav-device-filter__menu {
  position: absolute;
  top: 70rpx;
  right: 0;
  z-index: 20;
  width: 420rpx;
  max-width: 70vw;
  padding: 10rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  border-radius: 18rpx;
  box-shadow: 0 18rpx 40rpx rgba(126, 116, 106, 0.18);
}

/* 单行省略号（不用 flex 居中：flex 容器上的 text-overflow 不生效，
   长设备名会直接换行把菜单撑成两行高）。改用 block + line-height 垂直居中。 */
.nav-device-filter__option {
  display: block;
  height: 62rpx;
  overflow: hidden;
  padding: 0 18rpx;
  color: #727b87;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 62rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-device-filter__option.is-active {
  color: #ff5f1f;
  background: rgba(255, 116, 54, 0.12);
}

.nav-device-filter__option--loading {
  color: #9ba2ad;
}
