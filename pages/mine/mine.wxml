<view class="page mine-page safe-bottom">
  <view class="mine-profile card" wx:if="{{userInfo}}">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
    </button>
    <view class="profile-main">
      <input class="nickname-input" type="nickname" value="{{userInfo.nickName || '微信用户'}}" bindblur="onNicknameBlur" />
      <view class="phone-line">{{userInfo.phone || '未绑定手机号'}}</view>
    </view>
    <button class="profile-edit" bindtap="goProfile">编辑</button>
  </view>

  <view class="mine-profile mine-profile--loading card" wx:else>
    <view class="avatar-skeleton"></view>
    <view class="profile-main">
      <view class="skeleton-line skeleton-line--wide"></view>
      <view class="skeleton-line"></view>
    </view>
  </view>

  <view class="stats-card card">
    <button class="stat-item" bindtap="goAlbum">
      <text class="stat-value">{{stats.photoCount}}</text>
      <text class="stat-label">照片</text>
    </button>
    <button class="stat-item" bindtap="goDevices">
      <text class="stat-value">{{stats.deviceCount}}</text>
      <text class="stat-label">设备</text>
    </button>
    <button class="stat-item" bindtap="goRecords">
      <text class="stat-value">{{stats.recordCount}}</text>
      <text class="stat-label">投屏</text>
    </button>
  </view>

  <view class="section">
    <view class="section-title">
      <text>常用功能</text>
    </view>
    <view class="quick-grid">
      <button class="quick-card quick-card--album" bindtap="goAlbum">
        <text class="quick-icon">相</text>
        <text class="quick-title">我的相册</text>
        <text class="quick-desc">管理投屏照片</text>
      </button>
      <button class="quick-card quick-card--device" bindtap="goDevices">
        <text class="quick-icon">框</text>
        <text class="quick-title">我的设备</text>
        <text class="quick-desc">绑定与播放设置</text>
      </button>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>账户服务</text>
    </view>
    <view class="card mine-list">
      <button class="list-cell" bindtap="goRecords">
        <view>
          <view class="cell-title">投屏管理</view>
          <view class="cell-desc">查看成功与失败记录</view>
        </view>
        <text class="cell-arrow">›</text>
      </button>
      <button class="list-cell" bindtap="goGuide">
        <view>
          <view class="cell-title">操作指南</view>
          <view class="cell-desc">设备连接与照片投屏说明</view>
        </view>
        <text class="cell-arrow">›</text>
      </button>
      <button class="list-cell" bindtap="goModifyPassword">
        <view>
          <view class="cell-title">修改密码</view>
          <view class="cell-desc">更新账号登录密码</view>
        </view>
        <text class="cell-arrow">›</text>
      </button>
      <button class="list-cell" bindtap="goSettings">
        <view>
          <view class="cell-title">设置</view>
          <view class="cell-desc">语言、协议与账号管理</view>
        </view>
        <text class="cell-arrow">›</text>
      </button>
    </view>
  </view>

  <button class="bind-phone secondary-btn" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" wx:if="{{userInfo && !userInfo.phone}}">
    微信快捷绑定手机号
  </button>
</view>
