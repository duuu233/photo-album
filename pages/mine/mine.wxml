<!-- 根容器同首页折叠屏适配（2026-08-04）：一屏高由 wxss 的 100vh 决定（不用 JS 测的窗口高度），
     导航栏之下整块交给 .mine-scroll 滚动，折叠屏展开/分屏时「我的相册」等入口不会被挤出屏外。 -->
<view
  class="mine-root"
  style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;"
>
  <view class="mine-bg" aria-hidden="true">
    <image
      class="mine-bg-placeholder"
      src="/assets/images/home-bg-placeholder.jpg"
      mode="aspectFill" />
    <image
      class="mine-bg-image {{bgReady ? 'is-ready' : ''}}"
      src="https://oss.boltfox.cn/prodFile/202607310920402821453.png"
      mode="aspectFill"
      bindload="onMineBgLoaded" />
  </view>
  <page-nav title="我的" show-back="{{false}}">
  </page-nav>
  <scroll-view class="mine-scroll" scroll-y="{{true}}">
    <view class="mine-body">
      <view
        class="profile-card"
        hover-class="none"
        bindtap="goProfile"
      >
        <image
          class="profile-card-bg"
          src="/assets/images/mine-header-bg01.png"
          mode="aspectFill" />
        <image
          wx:if="{{avatarUrl}}"
          class="profile-avatar"
          src="{{avatarUrl}}"
          mode="aspectFill" />
        <image
          wx:else
          class="profile-avatar"
          src="/assets/images/mine-header.jpg"
          mode="aspectFill" />
        <view class="profile-copy">
          <text class="profile-name" decode="{{true}}">{{nickName}}</text>
          <view class="profile-id">ID：{{userId}}</view>
        </view>
        <image
          class="chevron"
          src="/assets/images/mine-icon-right.png"
          mode="aspectFit" />
      </view>
      <view class="section-title functions-title">常用功能</view>
      <!-- 2026-08-06：按设计稿（assets/ai/UI页面/我的.png）由两张并排卡片改为单列列表，
           并新增「我的收藏」「Token管理」两个入口。
           ⚠️ 设计稿画了 5 行（我的图库 / 我的设备 / 我的收藏 / Token管理 / 投屏管理），这里只有 4 行：
           「我的图库」和「投屏管理」已于 2026-08-04 合并进「我的相册」，2026-08-06 产品再次确认
           **只取设计稿的视觉样式，不恢复这两个入口**。见
           docs/changes/2026-08-04-折叠屏滚动适配与我的相册合并.md。 -->
      <view class="feature-list">
        <view class="feature-row" hover-class="none" bindtap="goAlbum">
          <view class="feature-icon-bg">
            <image class="feature-icon" src="/assets/images/mine-icon06.png" mode="aspectFit" />
          </view>
          <text class="feature-label">我的相册</text>
          <text class="feature-value">{{photoCount}} 张照片</text>
          <image class="chevron" src="/assets/images/mine-icon-right.png" mode="aspectFit" />
        </view>
        <view class="feature-row" hover-class="none" bindtap="goDevices">
          <view class="feature-icon-bg feature-icon-bg--blue">
            <image class="feature-icon" src="/assets/images/mine-icon07.png" mode="aspectFit" />
          </view>
          <text class="feature-label">我的设备</text>
          <text class="feature-value">{{deviceCount}} 个设备</text>
          <image class="chevron" src="/assets/images/mine-icon-right.png" mode="aspectFit" />
        </view>
        <view class="feature-row" hover-class="none" bindtap="goFavorites">
          <view class="feature-icon-bg">
            <image class="feature-icon" src="/assets/images/mine-icon-favorite.png" mode="aspectFit" />
          </view>
          <text class="feature-label">我的收藏</text>
          <text class="feature-value">{{favoriteCount}} 张照片</text>
          <image class="chevron" src="/assets/images/mine-icon-right.png" mode="aspectFit" />
        </view>
        <view class="feature-row" hover-class="none" bindtap="goToken">
          <view class="feature-icon-bg">
            <image class="feature-icon" src="/assets/images/mine-icon-token.png" mode="aspectFit" />
          </view>
          <text class="feature-label">Token管理</text>
          <text class="feature-value">剩余 {{tokenBalance}} Token</text>
          <image class="chevron" src="/assets/images/mine-icon-right.png" mode="aspectFit" />
        </view>
      </view>
      <view class="section-title help-title">服务与帮助</view>
      <view class="service-list">
        <view
          class="service-row"
          hover-class="none"
          bindtap="goGuide"
        >
          <image
            class="service-icon"
            src="/assets/images/mine-icon05.png"
            mode="aspectFit" />
          <text>操作指南</text>
          <image
            class="chevron"
            src="/assets/images/mine-icon-right.png"
            mode="aspectFit" />
        </view>
        <view
          class="service-row"
          hover-class="none"
          bindtap="goSettings"
        >
          <image
            class="service-icon"
            src="/assets/images/mine-icon04.png"
            mode="aspectFit" />
          <text>设置</text>
          <image
            class="chevron"
            src="/assets/images/mine-icon-right.png"
            mode="aspectFit" />
        </view>
      </view>
    </view>
  </scroll-view>
  <!-- 固定层：底部导航不随内容滚动，必须留在 scroll-view 之外 -->
  <custom-tabbar active="mine" safe-bottom="{{safeBottom}}">
  </custom-tabbar>
  <global-toast id="globalToast">
  </global-toast>
</view>
