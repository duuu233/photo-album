<!-- 根容器同首页折叠屏适配（2026-08-04）：一屏高由 wxss 的 100vh 决定（不用 JS 测的窗口高度），
     导航栏之下整块交给 .mine-scroll 滚动，折叠屏展开/分屏时「我的相册」等入口不会被挤出屏外。 -->
<view
  class="mine-root"
  style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;"
>
  <!-- 「我的」页仍用原来那张 OSS 背景（2026-08-21 只换了首页），所以占位图也必须是**原背景**的
       压缩版：占位图与大图不同源就会看见一次换底色。首页换新背景后 home-bg-placeholder.jpg
       跟着换成了新图，本页因此改用自己的 mine-bg-placeholder.jpg（内容就是原来那张占位图）。 -->
  <view class="mine-bg" aria-hidden="true">
    <image
      class="mine-bg-placeholder"
      src="/assets/images/mine-bg-placeholder.jpg"
      mode="aspectFill" />
    <image
      class="mine-bg-image {{bgReady ? 'is-ready' : ''}}"
      src="https://oss.boltfox.cn/prodFile/202607310920402821453.png"
      mode="aspectFill"
      bindload="onMineBgLoaded" />
  </view>
  <page-nav title="我的" show-back="{{false}}">
  </page-nav>
  <scroll-view class="mine-scroll" scroll-y="{{true}}">
    <view class="mine-body">
      <view
        class="profile-card"
        hover-class="none"
        bindtap="goProfile"
      >
        <image
          class="profile-card-bg"
          src="/assets/images/mine-header-bg01.png"
          mode="aspectFill" />
        <image
          wx:if="{{avatarUrl}}"
          class="profile-avatar"
          src="{{avatarUrl}}"
          mode="aspectFill" />
        <image
          wx:else
          class="profile-avatar"
          src="/assets/images/mine-header.jpg"
          mode="aspectFill" />
        <view class="profile-copy">
          <text class="profile-name" decode="{{true}}">{{nickName}}</text>
          <view class="profile-id">ID：{{userId}}</view>
        </view>
        <image
          class="chevron"
          src="/assets/images/mine-icon-right.png"
          mode="aspectFit" />
      </view>
      <!-- 「我的设备 / 我的相册」回到 2026-08-06 之前的两张并排卡片（左右布局）。
           「常用功能」标题按产品要求去掉，卡片与头像卡之间的间距改由 .quick-grid 的 margin-top 承担。 -->
      <view class="quick-grid">
        <view
          class="quick-card"
          hover-class="none"
          bindtap="goDevices"
        >
          <view class="quick-icon-bg quick-icon-bg-blue">
            <image
              class="quick-icon"
              src="/assets/images/mine-icon07.png"
              mode="aspectFit" />
          </view>
          <view class="quick-title">我的设备</view>
          <view class="quick-desc">{{deviceCount}}个设备</view>
        </view>
        <view
          class="quick-card"
          hover-class="none"
          bindtap="goAlbum"
        >
          <view class="quick-icon-bg">
            <image
              class="quick-icon"
              src="/assets/images/mine-icon06.png"
              mode="aspectFit" />
          </view>
          <view class="quick-title">我的上传</view>
          <view class="quick-desc">{{photoCount}}张照片</view>
        </view>
      </view>
      <view class="section-title help-title">服务与帮助</view>
      <!-- 星币管理（原「Token管理」）于 2026-08-06 从「常用功能」并入此处，顺序按产品要求：
           星币管理 → 操作指南 → 设置。右侧数值沿用原来的余额。
           ⚠️ 「我的收藏」这一行 2026-08-12 按产品要求**移出本页**，改为常驻在官方图库页
           分类条右侧（`subpackages/gallery/list`）—— 收藏的是官方图库的图，入口贴着图库更顺手。
           别再在这里加回来：两个入口指同一个页面只会让人犹豫点哪个。 -->
      <view class="service-list">
        <view
          class="service-row"
          hover-class="none"
          bindtap="goToken"
        >
          <image
            class="service-icon"
            src="/assets/images/mine-icon-token.png"
            mode="aspectFit" />
          <text>星币管理</text>
          <text class="service-value">剩余 {{tokenBalance}} 星币</text>
          <image
            class="chevron"
            src="/assets/images/mine-icon-right.png"
            mode="aspectFit" />
        </view>
        <view
          class="service-row"
          hover-class="none"
          bindtap="goGuide"
        >
          <image
            class="service-icon"
            src="/assets/images/mine-icon05.png"
            mode="aspectFit" />
          <text>操作指南</text>
          <image
            class="chevron"
            src="/assets/images/mine-icon-right.png"
            mode="aspectFit" />
        </view>
        <view
          class="service-row"
          hover-class="none"
          bindtap="goSettings"
        >
          <image
            class="service-icon"
            src="/assets/images/mine-icon04.png"
            mode="aspectFit" />
          <text>设置</text>
          <image
            class="chevron"
            src="/assets/images/mine-icon-right.png"
            mode="aspectFit" />
        </view>
      </view>
    </view>
  </scroll-view>
  <!-- 固定层：底部导航不随内容滚动，必须留在 scroll-view 之外 -->
  <custom-tabbar active="mine" safe-bottom="{{safeBottom}}">
  </custom-tabbar>
  <global-toast id="globalToast">
  </global-toast>
</view>
