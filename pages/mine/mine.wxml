<view class="mine-root" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mine-bg">
    <view class="bg-curve bg-curve-top"></view>
    <view class="bg-curve bg-curve-bottom"></view>
    <view class="bg-spark spark-one"></view>
    <view class="bg-spark spark-two"></view>
  </view>

  <view class="page-title">我的</view>

  <button class="profile-card" hover-class="none" bindtap="goProfile">
    <image wx:if="{{avatarUrl}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="profile-avatar avatar-placeholder"></view>
    <view class="profile-copy">
      <view class="profile-name">{{nickName}}</view>
      <view class="profile-id">ID：{{userId}}</view>
    </view>
    <view class="chevron">›</view>
  </button>

  <view class="section-title functions-title">常用功能</view>
  <view class="quick-grid">
    <button class="quick-card" hover-class="none" bindtap="goAlbum">
      <view class="quick-icon orange-icon"><view class="icon-picture"></view></view>
      <view class="quick-title">我的图库</view>
      <view class="quick-desc">{{photoCount}}张照片</view>
    </button>
    <button class="quick-card" hover-class="none" bindtap="goDevices">
      <view class="quick-icon blue-icon"><view class="icon-device"></view></view>
      <view class="quick-title">我的设备</view>
      <view class="quick-desc">{{deviceCount}}个设备</view>
    </button>
    <button class="quick-card" hover-class="none" bindtap="goRecords">
      <view class="quick-icon orange-icon"><view class="icon-project"></view></view>
      <view class="quick-title">投屏管理</view>
    </button>
  </view>

  <view class="section-title help-title">服务与帮助</view>
  <view class="service-list">
    <button class="service-row" hover-class="none" bindtap="goGuide">
      <view class="service-icon blue-icon"><view class="icon-book"></view></view>
      <text>操作指南</text>
      <view class="chevron">›</view>
    </button>
    <button class="service-row" hover-class="none" bindtap="goSettings">
      <view class="service-icon blue-icon"><view class="icon-setting"></view></view>
      <text>设置</text>
      <view class="chevron">›</view>
    </button>
  </view>

  <view class="custom-tabbar">
    <button class="tab-item" hover-class="none" bindtap="goHome">
      <view class="tab-home-icon">
        <view class="home-roof"></view>
        <view class="home-body"></view>
      </view>
      <text>首页</text>
    </button>
    <button class="tab-item active" hover-class="none">
      <view class="tab-user-icon">
        <view class="user-head"></view>
        <view class="user-shoulder"></view>
      </view>
      <text>我的</text>
    </button>
  </view>
</view>
