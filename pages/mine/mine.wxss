.mine-page {
  background:
    radial-gradient(circle at 50% 0%, rgba(235, 95, 27, 0.16), transparent 280rpx),
    linear-gradient(180deg, #f6f7fb 0%, #eef2f8 100%);
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
}

.avatar-btn,
.avatar,
.avatar-skeleton {
  width: 116rpx;
  height: 116rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.avatar-skeleton {
  background: linear-gradient(90deg, #eef2f6, #f8fafc, #eef2f6);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  width: 100%;
  min-height: 58rpx;
  color: #232323;
  font-size: 38rpx;
  font-weight: 900;
}

.edit-btn {
  min-width: 102rpx;
  min-height: 62rpx;
  font-size: 24rpx;
}

.skeleton-line {
  width: 210rpx;
  height: 24rpx;
  margin-top: 16rpx;
  background: #eef2f6;
  border-radius: 999rpx;
}

.skeleton-line--wide {
  width: 280rpx;
  height: 34rpx;
  margin-top: 0;
}

.stats-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx;
  padding: 24rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 112rpx;
  border-right: 1rpx solid #edf0f5;
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: #232323;
  font-size: 44rpx;
  font-weight: 900;
}

.stat-label {
  color: #8b9098;
  font-size: 24rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.quick-card {
  min-height: 214rpx;
  padding: 26rpx;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid #e5ebf3;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(64, 77, 97, 0.08);
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  color: #ffffff;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.quick-card--album .quick-icon {
  background: #eb5f1b;
}

.quick-card--device .quick-icon {
  background: #2f6f75;
}

.quick-title {
  display: block;
  margin-top: 22rpx;
  color: #232323;
  font-size: 31rpx;
  font-weight: 850;
}

.quick-desc {
  display: block;
  margin-top: 8rpx;
  color: #8b9098;
  font-size: 23rpx;
}

.mine-list {
  overflow: hidden;
}

.cell-title {
  margin-bottom: 8rpx;
  color: #232323;
  font-size: 29rpx;
  font-weight: 800;
}

.bind-phone {
  margin-top: 24rpx;
}
