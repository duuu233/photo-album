.mine-root {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(170rpx + var(--safe-bottom));
  overflow: hidden;
  color: #2a2d32;
  padding: 0 48rpx;
}

.mine-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.mine-bg-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.mine-bg-image {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.35s ease;
}

.mine-bg-image.is-ready {
  opacity: 1;
}

.page-title {
  position: relative;
  z-index: 1;
  color: #2a2b2b;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.profile-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  width: 654rpx;

  height: 242rpx;
  margin: 72rpx 0 0;
  padding: 0 34rpx 0 44rpx;
  overflow: hidden;
}

/* 卡片背景图：铺满卡片，置于内容下方 */
.profile-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100%;
  height: 100%;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  overflow: hidden;
  border-radius: 50%;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 34rpx;
}

.profile-name {
  display: block;
  overflow: hidden;
  color: #2a2d2d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Segoe UI Emoji", "Apple Color Emoji", sans-serif;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-id {
  margin-top: 20rpx;
  color: #808690;
  font-size: 24rpx;
  line-height: 1;
}

.chevron {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.service-list .chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
.section-title {
  position: relative;
  z-index: 1;
  color: #2a2b2b;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}

.functions-title {
  margin: 92rpx 0 24rpx 0;
}

.quick-grid {
  position: relative;
  padding: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quick-card {
  position: relative;
  width: 204rpx;
  height: 296rpx;

  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;

  border-radius: 20px;

  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.31);
  background: linear-gradient(
    326deg,
    rgba(255, 255, 255, 0.24) 6.29%,
    rgba(255, 255, 255, 0.43) 97.85%
  );
  box-shadow: 0 4px 12px 0 rgba(44, 63, 97, 0.03);
  backdrop-filter: blur(10.550000190734863px);
}

/* 卡片背景图：铺满卡片，置于内容下方 */
.quick-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100%;
  height: 100%;
}

.quick-icon,
.service-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
}

.quick-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 0;
}
.quick-icon-bg {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(255, 175, 139, 0.1);
}
.quick-icon-bg-blue {
  background-color: #e7f2ff;
}
.service-icon {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin: 0 28rpx 0 0;
}

.orange-icon {
  color: #ff6421;
  background: rgba(255, 100, 33, 0.08);
}

.blue-icon {
  color: #287dff;
  background: rgba(40, 125, 255, 0.1);
}

.quick-title {
  margin-top: 22rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}

.quick-desc {
  margin-top: 12rpx;
  color: #777e88;
  font-size: 22rpx;
  line-height: 1;
}

.icon-picture,
.icon-device,
.icon-project,
.icon-book,
.icon-setting {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.icon-picture::before {
  position: absolute;
  top: 6rpx;
  left: 5rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
  content: '';
}

.icon-picture::after {
  position: absolute;
  right: 4rpx;
  bottom: 3rpx;
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: skewX(-24deg);
  content: '';
}

.icon-device::after {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 12rpx;
  height: 10rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  content: '';
}

.icon-project::after {
  position: absolute;
  left: -4rpx;
  bottom: -18rpx;
  width: 38rpx;
  height: 6rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
  content: '';
}

.icon-book {
  width: 30rpx;
  height: 32rpx;
  border-radius: 6rpx;
}

.icon-book::after {
  position: absolute;
  top: 5rpx;
  left: 12rpx;
  width: 0;
  height: 22rpx;
  border-left: 3rpx solid currentColor;
  content: '';
}

.icon-setting {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.icon-setting::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  content: '';
}

.help-title {
  margin: 86rpx 0 0;
}

.service-list {
  position: relative;
  z-index: 1;
  margin: 18rpx 0 0;
}

.service-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 108rpx;
  margin-bottom: 26rpx;
  padding: 0 36rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  box-shadow: 0 16rpx 38rpx rgba(125, 148, 181, 0.1);
}

.service-row text {
  flex: 1;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 500;
}
