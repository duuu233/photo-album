.mine-root {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(170rpx + var(--safe-bottom));
  overflow: hidden;
  color: #2a2d32;
  background:
    radial-gradient(circle at 92% 26%, rgba(255, 184, 118, 0.42), rgba(255, 184, 118, 0) 250rpx),
    radial-gradient(circle at 6% 5%, rgba(184, 218, 255, 0.78), rgba(184, 218, 255, 0) 540rpx),
    linear-gradient(180deg, #f4f9ff 0%, #edf6ff 100%);
}

.mine-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.bg-curve {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 50%;
}

.bg-curve-top {
  top: -330rpx;
  left: -210rpx;
  width: 840rpx;
  height: 580rpx;
}

.bg-curve-bottom {
  right: -140rpx;
  bottom: -250rpx;
  width: 520rpx;
  height: 520rpx;
}

.bg-spark {
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  box-shadow: 0 0 22rpx rgba(255, 195, 127, 0.72);
}

.spark-one {
  top: 130rpx;
  right: 116rpx;
}

.spark-two {
  top: 214rpx;
  left: 86rpx;
}

.page-title {
  position: relative;
  z-index: 1;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.profile-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  width: auto;
  height: 178rpx;
  margin: 42rpx 48rpx 0;
  padding: 0 34rpx 0 48rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 36rpx;
  box-shadow: 0 24rpx 52rpx rgba(128, 151, 184, 0.14);
}

.profile-avatar {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-placeholder {
  background:
    radial-gradient(circle at 50% 38%, #ffe3cb 0 22rpx, transparent 23rpx),
    radial-gradient(circle at 50% 94%, #ff873e 0 44rpx, transparent 45rpx),
    linear-gradient(135deg, #fff6ee, #d7eaff);
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 34rpx;
}

.profile-name {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.profile-id {
  margin-top: 20rpx;
  color: #808690;
  font-size: 24rpx;
  line-height: 1;
}

.chevron {
  color: #777e88;
  font-size: 58rpx;
  font-weight: 300;
  line-height: 1;
}

.section-title {
  position: relative;
  z-index: 1;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.functions-title {
  margin: 92rpx 48rpx 0;
}

.quick-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22rpx;
  margin: 18rpx 48rpx 0;
}

.quick-card {
  padding: 32rpx 8rpx 28rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.66);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(131, 154, 187, 0.12);
}

.quick-icon,
.service-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
}

.service-icon {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin: 0 28rpx 0 0;
}

.orange-icon {
  color: #ff6421;
  background: rgba(255, 100, 33, 0.08);
}

.blue-icon {
  color: #287dff;
  background: rgba(40, 125, 255, 0.1);
}

.quick-title {
  margin-top: 22rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}

.quick-desc {
  margin-top: 12rpx;
  color: #777e88;
  font-size: 22rpx;
  line-height: 1;
}

.icon-picture,
.icon-device,
.icon-project,
.icon-book,
.icon-setting {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.icon-picture::before {
  position: absolute;
  top: 6rpx;
  left: 5rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
  content: '';
}

.icon-picture::after {
  position: absolute;
  right: 4rpx;
  bottom: 3rpx;
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: skewX(-24deg);
  content: '';
}

.icon-device::after {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 12rpx;
  height: 10rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  content: '';
}

.icon-project::after {
  position: absolute;
  left: -4rpx;
  bottom: -18rpx;
  width: 38rpx;
  height: 6rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
  content: '';
}

.icon-book {
  width: 30rpx;
  height: 32rpx;
  border-radius: 6rpx;
}

.icon-book::after {
  position: absolute;
  top: 5rpx;
  left: 12rpx;
  width: 0;
  height: 22rpx;
  border-left: 3rpx solid currentColor;
  content: '';
}

.icon-setting {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.icon-setting::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  content: '';
}

.help-title {
  margin: 86rpx 48rpx 0;
}

.service-list {
  position: relative;
  z-index: 1;
  margin: 18rpx 48rpx 0;
}

.service-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 108rpx;
  margin-bottom: 26rpx;
  padding: 0 36rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  box-shadow: 0 16rpx 38rpx rgba(125, 148, 181, 0.1);
}

.service-row text {
  flex: 1;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 600;
}
