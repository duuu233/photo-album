/* 根容器锁一屏高，纵向排布：导航栏(自然高度) + .mine-scroll(占满剩余并滚动)。
   折叠屏展开后内容按 rpx 放大会超出一屏，靠滚动容器消化，不再被裁掉下半屏。
   高度**只用 100vh**，不用 JS 测的窗口高度——原因见 home.wxss `.home-root` 的注释
   （tabBar 页的 windowHeight 会扣掉已隐藏的原生 tabBar，且冷启动快照在折叠屏上可能失真）。 */
.mine-root {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: #2a2d32;
}

/* 同首页 .home-scroll：基准必须是 0，用 auto 会在内容超屏时把导航栏一起压扁 */
.mine-scroll {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  min-height: 0; /* 不可省：否则滚动区按内容高度撑开，整块顶出根容器又变成滑不动 */
}

/* 页面左右留白与底部导航避让都收进滚动内容里（原来写在 .mine-root 的 padding 上，
   会连带把导航栏也内缩 48rpx）。 */
.mine-body {
  padding: 0 48rpx calc(170rpx + var(--safe-bottom));
}

/* 背景层用 fixed 铺满**视口**，不跟随根容器的计算高度（同首页 .home-bg、图库页 .mock-bg）：
   根容器高度万一与视口差几十 px 也不会在底部露出一条没有背景的缝。 */
.mine-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.mine-bg-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.mine-bg-image {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.35s ease;
}

.mine-bg-image.is-ready {
  opacity: 1;
}

.page-title {
  position: relative;
  z-index: 1;
  color: #2a2b2b;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.profile-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  width: 654rpx;

  height: 242rpx;
  margin: 72rpx 0 0;
  padding: 0 34rpx 0 44rpx;
  overflow: hidden;
}

/* 卡片背景图：铺满卡片，置于内容下方 */
.profile-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100%;
  height: 100%;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  overflow: hidden;
  border-radius: 50%;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 34rpx;
}

.profile-name {
  display: block;
  overflow: hidden;
  color: #2a2d2d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Segoe UI Emoji", "Apple Color Emoji", sans-serif;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-id {
  margin-top: 20rpx;
  color: #808690;
  font-size: 24rpx;
  line-height: 1;
}

.chevron {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.service-list .chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
.section-title {
  position: relative;
  z-index: 1;
  color: #2a2b2b;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}

.functions-title {
  margin: 92rpx 0 24rpx 0;
}

/* 2026-08-06：常用功能由「两张并排卡片」改为单列列表（设计稿 assets/ai/UI页面/我的.png）。
   条目数从 2 涨到 4，并排卡片再塞就得换行，也放不下「剩余 1280 Token」这类右对齐的值。
   行样式与下方「服务与帮助」的 .service-row 同源（同一种毛玻璃白卡），只是多了图标底色和右值。 */
.feature-list {
  position: relative;
  z-index: 1;
}

.feature-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  box-shadow: 0 16rpx 38rpx rgba(125, 148, 181, 0.1);
}

.feature-icon-bg {
  flex: 0 0 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  background-color: rgba(255, 175, 139, 0.16);
  border-radius: 22rpx;
}

.feature-icon-bg--blue {
  background-color: #e7f2ff;
}

.feature-icon {
  width: 40rpx;
  height: 40rpx;
}

.feature-label {
  flex: 0 0 auto;
  margin-left: 24rpx;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 500;
}

/* 右侧的值吃掉中间剩余宽度并右对齐；过长（余额位数多）时省略而不是把 chevron 顶出去 */
.feature-value {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx 0 24rpx;
  overflow: hidden;
  color: #777e88;
  font-size: 26rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-list .chevron {
  width: 24rpx;
  height: 24rpx;
}

.service-icon {
  position: relative;
  flex: 0 0 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin: 0 28rpx 0 0;
  border-radius: 50%;
}

.orange-icon {
  color: #ff6421;
  background: rgba(255, 100, 33, 0.08);
}

.blue-icon {
  color: #287dff;
  background: rgba(40, 125, 255, 0.1);
}

.icon-picture,
.icon-device,
.icon-project,
.icon-book,
.icon-setting {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.icon-picture::before {
  position: absolute;
  top: 6rpx;
  left: 5rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
  content: '';
}

.icon-picture::after {
  position: absolute;
  right: 4rpx;
  bottom: 3rpx;
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: skewX(-24deg);
  content: '';
}

.icon-device::after {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 12rpx;
  height: 10rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  content: '';
}

.icon-project::after {
  position: absolute;
  left: -4rpx;
  bottom: -18rpx;
  width: 38rpx;
  height: 6rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
  content: '';
}

.icon-book {
  width: 30rpx;
  height: 32rpx;
  border-radius: 6rpx;
}

.icon-book::after {
  position: absolute;
  top: 5rpx;
  left: 12rpx;
  width: 0;
  height: 22rpx;
  border-left: 3rpx solid currentColor;
  content: '';
}

.icon-setting {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.icon-setting::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  content: '';
}

.help-title {
  margin: 86rpx 0 0;
}

.service-list {
  position: relative;
  z-index: 1;
  margin: 18rpx 0 0;
}

.service-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 108rpx;
  margin-bottom: 26rpx;
  padding: 0 36rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  box-shadow: 0 16rpx 38rpx rgba(125, 148, 181, 0.1);
}

.service-row text {
  flex: 1;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 500;
}
