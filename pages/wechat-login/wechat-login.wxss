.wechat-login-page {
  min-height: 100vh;
  overflow: hidden;
  background:
    linear-gradient(160deg, rgba(255, 244, 223, 0.88) 0%, rgba(232, 245, 242, 0.92) 44%, rgba(245, 247, 251, 1) 100%);
}

.login-stage {
  position: relative;
  padding: 34rpx 42rpx 0;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #172133;
  font-size: 42rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 30rpx rgba(23, 33, 51, 0.16);
}

.eyebrow {
  margin-top: 32rpx;
  color: #0b7a6b;
  font-size: 24rpx;
  font-weight: 700;
}

.headline {
  width: 620rpx;
  max-width: 100%;
  margin-top: 14rpx;
  color: #172133;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.16;
}

.subcopy {
  width: 560rpx;
  max-width: 100%;
  margin-top: 20rpx;
  color: #5f6b7a;
  font-size: 28rpx;
  line-height: 1.58;
}

.frame-scene {
  position: relative;
  height: 430rpx;
  margin-top: 48rpx;
}

.frame-shell {
  position: absolute;
  right: 8rpx;
  left: 8rpx;
  height: 330rpx;
  padding: 18rpx;
  border: 12rpx solid #172133;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 60rpx rgba(24, 34, 48, 0.18);
}

.frame-shell::after {
  position: absolute;
  right: 190rpx;
  bottom: -56rpx;
  left: 190rpx;
  height: 48rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #172133;
  content: '';
}

.frame-photo {
  position: absolute;
  border-radius: 8rpx;
}

.frame-photo--main {
  top: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  background:
    linear-gradient(145deg, rgba(23, 105, 224, 0.24), rgba(11, 122, 107, 0.18)),
    linear-gradient(45deg, #ffe4bd 0%, #fff6dc 42%, #bfd7ff 100%);
}

.frame-photo--side {
  right: 44rpx;
  bottom: 44rpx;
  width: 190rpx;
  height: 126rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  background: linear-gradient(135deg, #172133, #1769e0);
  opacity: 0.88;
}

.frame-glow {
  position: absolute;
  top: 68rpx;
  left: 62rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #fff4c2;
}

.signal-card {
  position: absolute;
  right: 26rpx;
  bottom: 52rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 66rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  color: #172133;
  background: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 34rpx rgba(24, 34, 48, 0.12);
}

.signal-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #12b76a;
  box-shadow: 0 0 0 8rpx rgba(18, 183, 106, 0.14);
}

.login-actions {
  padding: 0 42rpx 42rpx;
}

.password-entry {
  width: 100%;
  height: 76rpx;
  margin-top: 16rpx;
  color: #1769e0;
  font-size: 28rpx;
  font-weight: 600;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 64rpx;
  margin-top: 12rpx;
  color: #667085;
  font-size: 23rpx;
}

.check-dot {
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid #98a2b3;
  border-radius: 8rpx;
  background: #ffffff;
}

.check-dot--active {
  border-color: #0b7a6b;
  background: #0b7a6b;
}
