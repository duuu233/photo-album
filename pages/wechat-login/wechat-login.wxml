<view class="wechat-login-page safe-bottom">
  <page-nav title="微信登录" show-back="{{false}}" right-text="跳过" immersive="{{true}}" bind:righttap="skipLogin" />

  <view class="login-stage">
    <view class="brand-mark">B</view>
    <view class="eyebrow">BoltStar 智能相框</view>
    <view class="headline">让家里的每一帧，都能准时抵达。</view>
    <view class="subcopy">同步相册、绑定设备、查看投屏记录，一次授权即可接入。</view>

    <view class="frame-scene">
      <view class="frame-shell">
        <view class="frame-photo frame-photo--main"></view>
        <view class="frame-photo frame-photo--side"></view>
        <view class="frame-glow"></view>
      </view>
      <view class="signal-card">
        <text class="signal-dot"></text>
        <text>微信安全授权</text>
      </view>
    </view>
  </view>

  <view class="login-actions">
    <brand-button text="微信一键登录" size="large" loading="{{loading}}" disabled="{{!agreed}}" bind:tap="loginByWechat" />
    <button class="password-entry" bindtap="goForgotPassword">忘记密码</button>
    <button class="agreement" bindtap="toggleAgreement">
      <view class="check-dot {{agreed ? 'check-dot--active' : ''}}"></view>
      <text>已阅读并同意《用户协议》《隐私政策》</text>
    </button>
  </view>
</view>
