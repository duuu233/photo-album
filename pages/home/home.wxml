<!-- 首页根容器：通过 CSS 变量把状态栏高度/底部安全区传给样式，适配各机型 -->
<view class="home-root" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <!-- 背景图随当前场景切换，具体路径由 sceneState 派生 -->
  <view class="home-bg" aria-hidden="true">
    <image
      class="home-bg-image"
      src="{{homeBgImage}}"
      mode="aspectFill"
      data-asset="bg"
      bindload="onHomeAssetLoaded"
      binderror="onHomeAssetError" />
  </view>
  <!-- 前景图预加载：不显示，仅用于「背景图+前景图都加载完再展示首页」的 loading 门控 -->
  <image
    class="home-asset-preload"
    src="{{homeFgImage}}"
    data-asset="fg"
    bindload="onHomeAssetLoaded"
    binderror="onHomeAssetError" />
  <page-nav
    title="{{navTitle}}"
    show-back="{{showNavBack}}"
    custom-back="{{showNavBack}}"
    bind:backtap="backFromBinding"
  >
  </page-nav>
  <!-- 首屏加载中：拉设备列表确定已绑定/未绑定，或背景图/前景图尚未加载完成前先展示 loading -->
  <view wx:if="{{pageLoading || !bgReady}}" class="page-loading">
    <view class="page-loading__spinner">
    </view>
    <view class="page-loading__text">加载中…</view>
  </view>
  <!-- ===== 分支一：首页场景（已绑定 / 未绑定）。isHomeScene 由 sceneState 派生 ===== -->
  <block wx:elif="{{isHomeScene}}">
    <!-- 主内容区：hasHomeOverlay 为真时（有弹层）加 content-dimmed 变暗 -->
    <view class="home-content {{isBoundHome ? 'bound-home' : 'unbound-home'}} {{hasHomeOverlay ? 'content-dimmed' : ''}}">
      <!-- 已绑定：展示设备卡片（名称/连接状态/电量）+ 轮播指示点 -->
      <block wx:if="{{isBoundHome}}">
        <view class="home-topbar">
          <button
            class="avatar-btn"
            hover-class="none"
            open-type="chooseAvatar"
            bind:chooseavatar="onChooseAvatar"
          >
            <image
              class="avatar-img"
              src="{{avatarUrl || '/assets/images/mine-header.jpg'}}"
              mode="aspectFill" />
          </button>
          <view
            class="add-btn"
            hover-class="none"
            bindtap="startBindingScan"
          >
            <image
              class="avatar-img add-btn-img"
              src="/assets/images/home-add-icon.png"
              mode="aspectFill" />
          </view>
        </view>
        <view class="hello-title">Hi</view>
        <view class="hello-subtitle">
          欢迎使用
          <image
            class="hello-logo"
            src="/assets/images/logo.png"
            mode="aspectFit" />
        </view>
        <!-- 设备轮播：左右滑动切换已绑定的多台设备，change 时同步当前设备与指示点 -->
        <swiper
          class="device-swiper"
          current="{{currentDeviceIndex}}"
          circular="{{deviceList.length > 1}}"
          bindchange="onDeviceChange"
        >
          <swiper-item
            class="device-swiper-item"
            wx:for="{{deviceList}}"
            wx:key="id"
          >
            <view class="device-carousel" bindtap="goDeviceList">
              <!-- 玻璃背景层（融入自设计稿）：渐变 + 阴影 + 圆角 + 毛玻璃，作为最顶层 view 垫在整张背景图之下 -->
              <view class="carousel-glass">
              </view>
              <image
                class="device-carousel-bg"
                src="https://oss.boltfox.cn/prodFile/202607072104114724571.png"
                mode="aspectFill" />
              <image
                class="device-orbit"
                src="/assets/images/home-icon02.png"
                mode="aspectFill" />
              <view class="device-info">
                <view class="device-title">{{item.name}}</view>
                <view class="device-status {{item.connected ? 'is-connected' : ''}}">
                  <image
                    class="mini-bluetooth"
                    src="{{item.connected ? '/assets/images/bluetooth-icon.png' : '/assets/images/bluetooth-icon-not.png'}}"
                    mode="aspectFill" />
                  <text>{{item.connected ? '已连接' : '未连接'}}</text>
                </view>
                <!-- 仅在已连接设备后才展示电量图标与数值 -->
                <view wx:if="{{item.connected}}" class="battery-row">
                  <image
                    class="battery-level-icon"
                    src="{{item.batteryIcon}}"
                    mode="aspectFit" />
                  <text>{{item.battery}}%</text>
                </view>
                <!-- 未连接时展示「连接蓝牙」按钮；catchtap 阻止冒泡到卡片的进入设备列表 -->
                <view
                  wx:if="{{!item.connected}}"
                  class="device-connect-btn"
                  hover-class="device-connect-btn--hover"
                  hover-stay-time="80"
                  catchtap="connectCurrentDevice"
                >
                  <image
                    class="device-connect-icon"
                    src="/assets/images/bluetooth-icon-white.png"
                    mode="aspectFit" />
                  <text>连接蓝牙</text>
                </view>
              </view>
            </view>
          </swiper-item>
        </swiper>
        <view class="carousel-dots">
          <view
            class="dot {{index === currentDeviceIndex ? 'active' : ''}}"
            wx:for="{{deviceList}}"
            wx:key="id"
          >
          </view>
        </view>
      </block>
      <!-- 未绑定：空态插画 + 绑定设备入口 -->
      <block wx:else>
        <image
          class="empty-hero-art"
          src="/assets/images/empty_device_art.png"
          mode="aspectFit" />
        <view class="empty-hint">请先绑定相框设备后再投屏照片</view>
        <view
          class="bind-pill"
          hover-class="none"
          bindtap="showBindNowSheet"
        >
          <image
            class="mini-bluetooth-white"
            src="/assets/images/bluetooth-icon-white.png"
            mode="aspectFill" />
          <view class="bind-pill-text">绑定设备</view>
        </view>
      </block>
      <!-- 投屏方式入口（拍照 / 相册），两种场景共用；未绑定时点击会先引导绑定 -->
      <view class="projection-title">选择投屏方式</view>
      <view class="projection-grid">
        <view
          class="projection-card camera-card"
          hover-class="none"
          bindtap="tapCameraEntry"
        >
          <image
            class="projection-card-bg"
            src="/assets/images/home-camera-card-bg.png"
            mode="scaleToFill" />
          <image
            class="media-art camera-art"
            src="/assets/images/camera_material.png"
            mode="aspectFit" />
          <view class="projection-copy">
            <view>
              <view class="projection-name">拍照</view>
              <view class="projection-desc">拍摄照片并投屏</view>
            </view>
            <image
              class="projection-arrow"
              src="/assets/images/home-icon05.png"
              mode="aspectFit"
            />
          </view>
        </view>
        <view
          class="projection-card album-card"
          hover-class="none"
          bindtap="tapAlbumEntry"
        >
          <image
            class="projection-card-bg"
            src="/assets/images/home-album-card-bg.png"
            mode="scaleToFill" />
          <image
            class="media-art album-art"
            src="/assets/images/album_material.png"
            mode="aspectFit" />
          <view class="projection-copy">
            <view>
              <view class="projection-name">相册</view>
              <view class="projection-desc">选择照片并投屏</view>
            </view>
            <image
              class="projection-arrow"
              src="/assets/images/home-icon06.png"
              mode="aspectFit"
            />
          </view>
        </view>
      </view>
    </view>
    <!-- 自定义底部导航（首页/我的），替代原生 tabBar -->
    <custom-tabbar
      active="home"
      safe-bottom="{{safeBottom}}"
      dimmed="{{hasHomeOverlay}}"
    >
    </custom-tabbar>
    <!-- 弹层①：未绑定/重连提示（标题文案随场景变化）。catchtouchmove 阻止背景滚动穿透 -->
    <view
      wx:if="{{showPromptSheet}}"
      class="home-mask"
      catchtouchmove="noop"
    >
      <view class="bottom-sheet prompt-sheet {{sheetClosing ? 'pop-closing-sheet' : ''}}">
        <view
          class="sheet-close"
          hover-class="none"
          bindtap="closeHomeSheet"
        >
          ×
        </view>
        <view class="prompt-title">{{promptTitle}}</view>
        <view class="prompt-desc">{{promptDesc}}</view>
        <view
          class="primary-action"
          hover-class="none"
          bindtap="confirmPrompt"
        >
          {{promptButton}}
        </view>
      </view>
    </view>
    <!-- 弹层②：离线断网模式 -->
    <view
      wx:if="{{isOfflineMode}}"
      class="home-mask"
      catchtouchmove="noop"
    >
      <view class="bottom-sheet prompt-sheet offline-sheet {{sheetClosing ? 'pop-closing-sheet' : ''}}">
        <view
          class="sheet-close"
          hover-class="none"
          bindtap="closeOfflineMode"
        >
          ×
        </view>
        <view class="prompt-title">离线模式</view>
        <view class="prompt-desc offline-desc">当前网络异常，app进入离线模式无法同步投屏记录与图库</view>
        <view
          class="primary-action"
          hover-class="none"
          bindtap="closeOfflineMode"
        >
          我知道了
        </view>
      </view>
    </view>
  </block>
  <!-- ===== 分支二：绑定设备流程（搜索中 / 已发现 / 未发现），与首页场景互斥 ===== -->
  <block wx:else>
    <view class="binding-content {{isScanHelp ? 'content-dimmed' : ''}}">
      <!-- 雷达插画随状态切换：已发现 / 未发现（含帮助）/ 搜索中 -->
      <view class="radar-wrap {{isBindingScanning ? 'radar-scanning' : ''}}">
        <image
          wx:if="{{isBindingFound}}"
          class="radar-art"
          src="/assets/images/device_found_art.png"
          mode="aspectFit"
        >
        </image>
        <image
          wx:elif="{{isBindingNoDevice || isScanHelp}}"
          class="radar-art"
          src="/assets/images/device_not_found_art.png"
          mode="aspectFit" />
        <image
          wx:else
          class="radar-art"
          src="https://oss.boltfox.cn/prodFile/202606161504054302273.gif"
          mode="aspectFit" />
      </view>
      <!-- 已发现设备：列出附近设备供单选，确认后绑定 -->
      <block wx:if="{{isBindingFound}}">
        <view class="device-container-box">
          <view class="nearby-head">
            <text>附近设备</text>
            <image
              class="refresh-btn"
              src="/assets/images/refresh-icon.png"
              mode="aspectFit" />
          </view>
          <view class="device-list">
            <view
              wx:for="{{nearbyDevices}}"
              wx:key="id"
              class="nearby-device {{item.selected ? 'selected' : ''}}"
              hover-class="none"
              data-id="{{item.id}}"
              bindtap="selectNearbyDevice"
            >
              <image
                class="nearby-icon"
                src="{{item.icon}}"
                mode="aspectFit" />
              <text>{{item.name}}</text>
              <image
                wx:if="{{item.selected}}"
                class="select-circle"
                src="/assets/images/selected-icon.png"
                mode="aspectFit" />
              <view wx:else class="select-circle">
              </view>
            </view>
          </view>
        </view>
        <view
          class="primary-action bind-bottom"
          hover-class="none"
          bindtap="finishBind"
        >
          立即绑定
        </view>
      </block>
      <!-- 搜索中：提示靠近设备，可取消或查看帮助 -->
      <block wx:elif="{{isBindingScanning}}">
        <view class="scan-copy">
          <view class="scan-title">正在搜索附近设备</view>
          <view class="scan-desc">请尽量将手机靠近需要添加的设备...</view>
        </view>
        <view
          class="scan-help-link"
          hover-class="none"
          bindtap="showScanHelp"
        >
          扫描不到怎么办?
        </view>
        <view
          class="primary-action bind-bottom"
          hover-class="none"
          bindtap="cancelScan"
        >
          取消扫描
        </view>
      </block>
      <!-- 未发现设备：提示重试，可重新扫描或查看帮助 -->
      <block wx:else>
        <view class="scan-copy no-device-copy">
          <view class="scan-title">未发现设备</view>
          <view class="scan-desc">设备连接中断，请检查设备状态后重试</view>
        </view>
        <view
          class="scan-help-link"
          hover-class="none"
          bindtap="showScanHelp"
        >
          扫描不到怎么办?
        </view>
        <view
          class="primary-action bind-bottom"
          hover-class="none"
          bindtap="rescanDevices"
        >
          重新扫描
        </view>
      </block>
    </view>
    <!-- 弹层④：「扫描不到怎么办」排查清单 -->
    <view
      wx:if="{{isScanHelp}}"
      class="home-mask scan-help-mask"
      catchtouchmove="noop"
    >
      <view class="bottom-sheet scan-help-sheet {{sheetClosing ? 'pop-closing-sheet' : ''}}">
        <view
          class="sheet-close"
          hover-class="none"
          bindtap="closeScanHelp"
        >
          ×
        </view>
        <view class="scan-help-title">扫描不到怎么办?</view>
        <image
          class="scan-help-icon"
          src="/assets/images/scan_help_art.png"
          mode="aspectFit" />
        <view class="check-title">请检查:</view>
        <view class="check-list">
          <text>1.设备是否有电?</text>
          <text>2.当前设备是否被占用?</text>
          <text>3.设备蓝牙是否工作正常，手机蓝牙是否打开</text>
          <text>4.设备是否与手机距离过远，隔离或有其他遮挡物</text>
        </view>
        <view
          class="primary-action"
          hover-class="none"
          bindtap="rescanDevices"
        >
          重新扫描
        </view>
      </view>
    </view>
  </block>
  <global-toast id="globalToast">
  </global-toast>
</view>
