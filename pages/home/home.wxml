<view class="home-root" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="home-bg">
    <view class="bg-curve bg-curve-top"></view>
    <view class="bg-curve bg-curve-bottom"></view>
    <view class="bg-spark spark-one"></view>
    <view class="bg-spark spark-two"></view>
    <view class="bg-spark spark-three"></view>
  </view>

  <block wx:if="{{isHomeScene}}">
    <view class="home-content {{isBoundHome ? 'bound-home' : 'unbound-home'}} {{hasHomeOverlay ? 'content-dimmed' : ''}}">
      <block wx:if="{{isBoundHome}}">
        <button class="avatar-btn" hover-class="none" bindtap="goMine">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-fallback"></view>
        </button>
        <button class="add-btn" hover-class="none" bindtap="startBindingScan">
          <text class="plus-symbol">+</text>
        </button>

        <view class="hello-title">Hi</view>
        <view class="hello-subtitle">欢迎使用 <text>BoltStar</text></view>

        <view class="device-carousel">
          <view class="device-card">
            <view class="device-orbit">
              <view class="orbit-ring ring-one"></view>
              <view class="orbit-ring ring-two"></view>
              <view class="orbit-ring ring-three"></view>
              <view class="orbit-dot dot-a"></view>
              <view class="orbit-dot dot-b"></view>
              <view class="orbit-dot dot-c"></view>
              <view class="bolt-mark">
                <view class="bolt-cut cut-one"></view>
                <view class="bolt-cut cut-two"></view>
              </view>
            </view>
            <view class="device-info">
              <view class="device-title">{{currentDevice.name}}</view>
              <view class="device-status">
                <view class="mini-bluetooth">ᛒ</view>
                <text>{{currentDevice.connected ? '已连接' : '未连接'}}</text>
              </view>
              <view class="battery-row">
                <view class="battery-icon"><view class="battery-fill" style="width: {{batteryWidth}}%;"></view></view>
                <text>{{currentDevice.battery}}%</text>
              </view>
            </view>
          </view>
          <view class="device-card side-card"></view>
        </view>
        <view class="carousel-dots">
          <view class="dot active"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </block>

      <block wx:else>
        <image class="empty-hero-art" src="/assets/images/empty_device_art.png" mode="aspectFit"></image>
        <view class="empty-hint">请先绑定相框设备后再投屏照片</view>
        <button class="bind-pill" hover-class="none" bindtap="showBindNowSheet">
          <view class="btn-bluetooth">ᛒ</view>
          <text>绑定设备</text>
        </button>
      </block>

      <view class="projection-title">选择投屏方式</view>
      <view class="projection-grid">
        <button class="projection-card camera-card" hover-class="none" bindtap="tapCameraEntry">
          <image class="media-art camera-art" src="/assets/images/camera_material.png" mode="aspectFit"></image>
          <view class="projection-copy">
            <view class="projection-name">拍照</view>
            <view class="projection-desc">拍摄照片并投屏</view>
          </view>
          <view class="round-arrow orange-arrow">→</view>
        </button>
        <button class="projection-card album-card" hover-class="none" bindtap="tapAlbumEntry">
          <image class="media-art album-art" src="/assets/images/album_material.png" mode="aspectFit"></image>
          <view class="projection-copy">
            <view class="projection-name">相册</view>
            <view class="projection-desc">选择照片并投屏</view>
          </view>
          <view class="round-arrow blue-arrow">→</view>
        </button>
      </view>
    </view>

    <view class="custom-tabbar {{hasHomeOverlay ? 'content-dimmed' : ''}}">
      <button class="tab-item active" hover-class="none">
        <view class="tab-home-icon">
          <view class="home-roof"></view>
          <view class="home-body"></view>
        </view>
        <text>首页</text>
      </button>
      <button class="tab-item" hover-class="none" bindtap="goMine">
        <view class="tab-user-icon">
          <view class="user-head"></view>
          <view class="user-shoulder"></view>
        </view>
        <text>我的</text>
      </button>
    </view>

    <view wx:if="{{showPromptSheet}}" class="home-mask" catchtouchmove="noop">
      <view class="bottom-sheet prompt-sheet">
        <button class="sheet-close" hover-class="none" bindtap="closeHomeSheet">×</button>
        <view class="prompt-title">{{promptTitle}}</view>
        <view class="prompt-desc">{{promptDesc}}</view>
        <button class="primary-action" hover-class="none" bindtap="confirmPrompt">{{promptButton}}</button>
      </view>
    </view>

    <view wx:if="{{isMediaSheet}}" class="home-mask" catchtouchmove="noop">
      <view class="bottom-sheet media-sheet">
        <view class="media-sheet-title">选择投屏方式</view>
        <button class="media-option" hover-class="none" bindtap="chooseCamera">
          <image class="media-art mini camera-art" src="/assets/images/camera_material.png" mode="aspectFit"></image>
          <view class="media-option-copy">
            <view>拍照</view>
            <text>调用手机相机拍照</text>
          </view>
          <view class="round-arrow orange-arrow">→</view>
        </button>
        <button class="media-option" hover-class="none" bindtap="chooseAlbum">
          <image class="media-art mini album-art" src="/assets/images/album_material.png" mode="aspectFit"></image>
          <view class="media-option-copy">
            <view>相册</view>
            <text>从手机相册选择照片</text>
          </view>
          <view class="round-arrow blue-arrow">→</view>
        </button>
        <button class="cancel-action" hover-class="none" bindtap="closeHomeSheet">取消</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="binding-content {{isScanHelp ? 'content-dimmed' : ''}}">
      <view class="binding-nav">
        <button class="back-btn" hover-class="none" bindtap="backFromBinding">←</button>
        <view class="binding-title">绑定设备</view>
      </view>

      <view class="radar-wrap {{isBindingScanning ? 'radar-scanning' : ''}}">
        <image wx:if="{{isBindingFound}}" class="radar-art" src="/assets/images/device_found_art.png" mode="aspectFit"></image>
        <image wx:elif="{{isBindingNoDevice || isScanHelp}}" class="radar-art" src="/assets/images/device_not_found_art.png" mode="aspectFit"></image>
        <image wx:else class="radar-art" src="/assets/images/device_scanning_art.png" mode="aspectFit"></image>
      </view>

      <block wx:if="{{isBindingFound}}">
        <view class="nearby-head">
          <text>附近设备</text>
          <button class="refresh-btn" hover-class="none" bindtap="rescanDevices"></button>
        </view>
        <view class="device-list">
          <button wx:for="{{nearbyDevices}}" wx:key="id" class="nearby-device {{item.selected ? 'selected' : ''}}" hover-class="none" data-id="{{item.id}}" bindtap="selectNearbyDevice">
            <view class="nearby-icon {{item.color}}">
              <view class="small-frame-icon"></view>
            </view>
            <text>{{item.name}}</text>
            <view class="select-circle">{{item.selected ? '✓' : ''}}</view>
          </button>
        </view>
        <button class="primary-action bind-bottom" hover-class="none" bindtap="finishBind">立即绑定</button>
      </block>

      <block wx:elif="{{isBindingScanning}}">
        <view class="scan-copy">
          <view class="scan-title">正在搜索附近设备</view>
          <view class="scan-desc">请尽量将手机靠近需要添加的设备...</view>
        </view>
        <button class="scan-help-link" hover-class="none" bindtap="showScanHelp">扫描不到怎么办?</button>
        <button class="primary-action bind-bottom" hover-class="none" bindtap="cancelScan">取消扫描</button>
      </block>

      <block wx:else>
        <view class="scan-copy no-device-copy">
          <view class="scan-title">未发现设备</view>
          <view class="scan-desc">设备连接中断，请检查设备状态后重试</view>
        </view>
        <button class="scan-help-link" hover-class="none" bindtap="showScanHelp">扫描不到怎么办?</button>
        <button class="primary-action bind-bottom" hover-class="none" bindtap="rescanDevices">重新扫描</button>
      </block>
    </view>

    <view wx:if="{{isScanHelp}}" class="home-mask scan-help-mask" catchtouchmove="noop">
      <view class="bottom-sheet scan-help-sheet">
        <button class="sheet-close" hover-class="none" bindtap="closeScanHelp">×</button>
        <view class="scan-help-title">扫描不到怎么办?</view>
        <image class="scan-help-icon" src="/assets/images/scan_help_art.png" mode="aspectFit"></image>
        <view class="check-title">请检查:</view>
        <view class="check-list">
          <text>1.设备是否有电?</text>
          <text>2.当前设备是否被占用?</text>
          <text>3.设备蓝牙是否工作正常，手机蓝牙是否打开</text>
          <text>4.设备是否与手机距离过远，隔离或有其他遮挡物</text>
        </view>
        <button class="primary-action" hover-class="none" bindtap="rescanDevices">重新扫描</button>
      </view>
    </view>
  </block>
</view>
