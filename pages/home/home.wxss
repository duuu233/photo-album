.home-root {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #2a2d32;
  background:
    radial-gradient(circle at 92% 22%, rgba(255, 184, 118, 0.42), rgba(255, 184, 118, 0) 250rpx),
    radial-gradient(circle at 8% 8%, rgba(187, 220, 255, 0.78), rgba(187, 220, 255, 0) 520rpx),
    linear-gradient(180deg, #f4f9ff 0%, #edf6ff 100%);
}

.home-bg,
.home-content,
.binding-content {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.home-bg {
  pointer-events: none;
}

.bg-curve {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 50%;
}

.bg-curve-top {
  top: -330rpx;
  left: -210rpx;
  width: 840rpx;
  height: 580rpx;
}

.bg-curve-bottom {
  right: -150rpx;
  bottom: -240rpx;
  width: 500rpx;
  height: 500rpx;
}

.bg-spark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  box-shadow: 0 0 22rpx rgba(255, 195, 127, 0.72);
}

.spark-one {
  top: 132rpx;
  right: 112rpx;
}

.spark-two {
  top: 214rpx;
  left: 88rpx;
}

.spark-three {
  right: 44rpx;
  bottom: 102rpx;
}

button {
  font: inherit;
}

.content-dimmed {
  opacity: 0.42;
}

.avatar-btn,
.add-btn,
.back-btn,
.refresh-btn,
.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn {
  position: absolute;
  top: calc(var(--status-bar) + 26rpx);
  left: 48rpx;
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 50%;
}

.avatar-img,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  background:
    radial-gradient(circle at 52% 42%, #ffe0c7 0 18rpx, transparent 19rpx),
    radial-gradient(circle at 50% 92%, #ff8a47 0 34rpx, transparent 35rpx),
    linear-gradient(135deg, #fff5ec, #d9ecff);
}

.add-btn {
  position: absolute;
  top: calc(var(--status-bar) + 26rpx);
  right: 34rpx;
  width: 62rpx;
  height: 62rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff8a3f, #ff691e);
  border-radius: 50%;
  box-shadow: 0 12rpx 22rpx rgba(255, 105, 30, 0.2);
}

.plus-symbol {
  margin-top: -4rpx;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.hello-title {
  position: absolute;
  top: calc(var(--status-bar) + 198rpx);
  left: 48rpx;
  font-size: 82rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0;
}

.hello-subtitle {
  position: absolute;
  top: calc(var(--status-bar) + 304rpx);
  left: 48rpx;
  color: #545963;
  font-size: 40rpx;
  line-height: 1;
}

.hello-subtitle text {
  color: #ff7a2e;
  font-size: 44rpx;
  font-weight: 800;
}

.device-carousel {
  position: absolute;
  top: calc(var(--status-bar) + 394rpx);
  left: 48rpx;
  width: 702rpx;
  height: 372rpx;
}

.device-card {
  position: absolute;
  top: 0;
  left: 0;
  width: 654rpx;
  height: 372rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 60rpx;
  box-shadow: 0 30rpx 60rpx rgba(130, 155, 190, 0.14);
}

.side-card {
  left: 700rpx;
  opacity: 0.56;
}

.device-orbit {
  position: absolute;
  top: 42rpx;
  left: 42rpx;
  width: 288rpx;
  height: 288rpx;
}

.orbit-ring {
  position: absolute;
  border: 2rpx solid rgba(255, 122, 46, 0.08);
  border-radius: 50%;
}

.ring-one {
  top: 38rpx;
  right: 38rpx;
  bottom: 38rpx;
  left: 38rpx;
}

.ring-two {
  top: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  left: 14rpx;
}

.ring-three {
  top: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
  left: -12rpx;
}

.orbit-dot {
  position: absolute;
  background: linear-gradient(180deg, #ffcba9, #ffa16d);
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 46, 0.18);
}

.dot-a {
  top: 0;
  right: 48rpx;
  width: 26rpx;
  height: 26rpx;
}

.dot-b {
  left: 14rpx;
  bottom: 64rpx;
  width: 32rpx;
  height: 32rpx;
}

.dot-c {
  right: 6rpx;
  bottom: 36rpx;
  width: 14rpx;
  height: 14rpx;
}

.bolt-mark {
  position: absolute;
  top: 96rpx;
  left: 96rpx;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ff8a42, #ff6322);
  border-radius: 28rpx;
}

.bolt-cut {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
}

.cut-one {
  top: -8rpx;
  left: 42rpx;
  width: 10rpx;
  height: 114rpx;
  transform: rotate(-12deg);
}

.cut-two {
  top: 44rpx;
  left: 0;
  width: 104rpx;
  height: 10rpx;
  transform: rotate(-12deg);
}

.device-info {
  position: absolute;
  top: 116rpx;
  left: 390rpx;
  right: 28rpx;
}

.device-title {
  margin-bottom: 26rpx;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.device-status,
.battery-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
  line-height: 1;
}

.device-status {
  margin-bottom: 22rpx;
}

.mini-bluetooth {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  color: #ffffff;
  background: #5b9bff;
  border-radius: 50%;
  font-size: 22rpx;
}

.battery-icon {
  position: relative;
  width: 40rpx;
  height: 20rpx;
  border: 2rpx solid #8a8f97;
  border-radius: 4rpx;
}

.battery-icon::after {
  position: absolute;
  top: 5rpx;
  right: -8rpx;
  width: 6rpx;
  height: 8rpx;
  background: #8a8f97;
  border-radius: 0 2rpx 2rpx 0;
  content: "";
}

.battery-fill {
  height: 100%;
  background: #ff6a25;
}

.carousel-dots {
  position: absolute;
  top: calc(var(--status-bar) + 830rpx);
  left: 298rpx;
  display: flex;
  gap: 24rpx;
}

.dot {
  width: 34rpx;
  height: 8rpx;
  background: #d7dce3;
  border-radius: 999rpx;
}

.dot.active {
  background: #ff6922;
}

.empty-hero-art {
  position: absolute;
  top: calc(var(--status-bar) + 262rpx);
  left: 50%;
  width: 420rpx;
  height: 320rpx;
  transform: translateX(-50%);
}

.empty-hint {
  position: absolute;
  top: calc(var(--status-bar) + 598rpx);
  left: 0;
  width: 100%;
  color: #777e88;
  font-size: 28rpx;
  text-align: center;
}

.bind-pill {
  position: absolute;
  top: calc(var(--status-bar) + 674rpx);
  left: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 400rpx;
  height: 88rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8538, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.28);
  font-size: 30rpx;
  font-weight: 700;
}

.btn-bluetooth {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  color: #ff6421;
  background: #ffffff;
  border-radius: 50%;
  font-size: 22rpx;
}

.projection-title {
  position: absolute;
  left: 48rpx;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 600;
}

.bound-home .projection-title,
.unbound-home .projection-title {
  top: calc(var(--status-bar) + 898rpx);
}

.projection-grid {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

.bound-home .projection-grid,
.unbound-home .projection-grid {
  top: calc(var(--status-bar) + 950rpx);
}

.projection-card {
  position: relative;
  height: 306rpx;
  overflow: hidden;
  text-align: left;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 20rpx 44rpx rgba(137, 160, 190, 0.12);
}

.camera-card {
  background: rgba(255, 248, 244, 0.86);
}

.album-card {
  background: rgba(237, 247, 255, 0.88);
}

.media-art {
  position: absolute;
  top: 26rpx;
  left: 38rpx;
  width: 156rpx;
  height: 156rpx;
}

.projection-copy {
  position: absolute;
  left: 24rpx;
  bottom: 34rpx;
}

.projection-name {
  margin-bottom: 12rpx;
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.projection-desc {
  color: #8a9099;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  box-shadow: 0 16rpx 26rpx rgba(96, 126, 166, 0.12);
  font-size: 40rpx;
  line-height: 1;
}

.orange-arrow {
  color: #ff6421;
}

.blue-arrow {
  color: #287dff;
}

.custom-tabbar {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(26rpx + var(--safe-bottom));
  z-index: 5;
  display: grid;
  grid-template-columns: 1fr 1fr;
  height: 112rpx;
  background: rgba(255, 255, 255, 0.74);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 50rpx rgba(126, 150, 184, 0.14);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #777d86;
  font-size: 24rpx;
}

.tab-item.active {
  color: #ff6421;
}

.tab-home-icon,
.tab-user-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.home-roof {
  position: absolute;
  top: 4rpx;
  left: 7rpx;
  width: 30rpx;
  height: 30rpx;
  background: currentColor;
  border-radius: 5rpx;
  transform: rotate(45deg);
}

.home-body {
  position: absolute;
  bottom: 2rpx;
  left: 10rpx;
  width: 24rpx;
  height: 28rpx;
  background: currentColor;
  border-radius: 4rpx;
}

.user-head {
  position: absolute;
  top: 2rpx;
  left: 13rpx;
  width: 18rpx;
  height: 18rpx;
  border: 5rpx solid currentColor;
  border-radius: 50%;
}

.user-shoulder {
  position: absolute;
  bottom: 2rpx;
  left: 7rpx;
  width: 30rpx;
  height: 22rpx;
  border: 5rpx solid currentColor;
  border-bottom: 0;
  border-radius: 28rpx 28rpx 0 0;
}

.home-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

.prompt-sheet {
  height: 500rpx;
  padding: 104rpx 48rpx 0;
}

.sheet-close {
  position: absolute;
  top: 32rpx;
  right: 36rpx;
  width: 44rpx;
  height: 44rpx;
  color: #8b9098;
  font-size: 42rpx;
  line-height: 1;
}

.prompt-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.prompt-desc {
  margin-top: 24rpx;
  color: #747b85;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.prompt-sheet .primary-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  width: auto;
  margin-top: 0;
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 34rpx;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 124rpx;
  margin-bottom: 22rpx;
  padding: 0 28rpx;
  text-align: left;
  background: #f8f9fb;
  border-radius: 18rpx;
}

.media-art.mini {
  position: relative;
  top: auto;
  left: auto;
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  margin-right: 20rpx;
}

.media-option-copy {
  flex: 1;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.media-option .round-arrow {
  position: static;
  flex: 0 0 72rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  margin-top: 0;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.binding-nav {
  position: absolute;
  top: calc(var(--status-bar) + 28rpx);
  left: 0;
  width: 100%;
  height: 88rpx;
}

.back-btn {
  position: absolute;
  left: 44rpx;
  top: 0;
  width: 64rpx;
  height: 64rpx;
  color: #565d67;
  background: rgba(255, 255, 255, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 50%;
  font-size: 38rpx;
}

.binding-title {
  color: #000000;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.radar-wrap {
  position: absolute;
  top: calc(var(--status-bar) + 112rpx);
  left: 50%;
  width: 500rpx;
  height: 500rpx;
  transform: translateX(-50%);
}

.radar-art {
  width: 100%;
  height: 100%;
}

.radar-scanning .radar-art {
  animation: radarPulse 1.8s ease-in-out infinite;
}

@keyframes radarPulse {
  0% {
    opacity: 0.85;
    transform: scale(0.96);
  }
  55% {
    opacity: 1;
  }
  100% {
    opacity: 0.9;
    transform: scale(1.03);
  }
}

.scan-copy {
  position: absolute;
  top: calc(var(--status-bar) + 574rpx);
  left: 0;
  width: 100%;
  text-align: center;
}

.no-device-copy {
  top: calc(var(--status-bar) + 568rpx);
}

.scan-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.scan-desc {
  margin-top: 22rpx;
  color: #737a84;
  font-size: 24rpx;
  line-height: 1;
}

.scan-help-link {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(150rpx + var(--safe-bottom));
  color: #ff6421;
  font-size: 26rpx;
  text-align: center;
}

.bind-bottom {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + var(--safe-bottom));
  width: auto;
}

.nearby-head {
  position: absolute;
  top: calc(var(--status-bar) + 670rpx);
  left: 48rpx;
  right: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nearby-head text {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.refresh-btn {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.refresh-btn::before,
.refresh-btn::after {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ff6421;
  border-left-color: transparent;
  border-radius: 50%;
  content: "";
}

.refresh-btn::after {
  width: 0;
  height: 0;
  right: 1rpx;
  bottom: 2rpx;
  border: 9rpx solid transparent;
  border-top-color: #ff6421;
  transform: rotate(-35deg);
}

.device-list {
  position: absolute;
  top: calc(var(--status-bar) + 728rpx);
  left: 48rpx;
  right: 48rpx;
}

.nearby-device {
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  margin-bottom: 22rpx;
  padding: 0 34rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.54);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 20rpx;
}

.nearby-device.selected {
  background: rgba(255, 247, 242, 0.88);
  border-color: #ff6421;
}

.nearby-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-right: 52rpx;
  border-radius: 24rpx;
}

.nearby-icon.orange {
  color: #ff6421;
  background: rgba(255, 100, 33, 0.08);
}

.nearby-icon.green {
  color: #28b365;
  background: rgba(40, 179, 101, 0.1);
}

.nearby-icon.blue {
  color: #287dff;
  background: rgba(40, 125, 255, 0.08);
}

.small-frame-icon {
  position: relative;
  width: 44rpx;
  height: 30rpx;
  border: 5rpx solid currentColor;
  border-radius: 4rpx;
}

.small-frame-icon::before {
  position: absolute;
  right: -16rpx;
  top: 4rpx;
  width: 12rpx;
  height: 16rpx;
  border: 5rpx solid currentColor;
  border-left: 0;
  border-radius: 0 4rpx 4rpx 0;
  content: "";
}

.small-frame-icon::after {
  position: absolute;
  left: -4rpx;
  bottom: -22rpx;
  width: 50rpx;
  height: 8rpx;
  border: 5rpx solid currentColor;
  border-radius: 4rpx;
  content: "";
}

.nearby-device > text {
  flex: 1;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.select-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #ffffff;
  border: 3rpx solid #b9bec6;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 800;
}

.nearby-device.selected .select-circle {
  background: #ff8239;
  border-color: #ff8239;
}

.scan-help-sheet {
  height: 932rpx;
  padding: 48rpx 48rpx 0;
}

.scan-help-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.scan-help-icon {
  display: block;
  width: 190rpx;
  height: 190rpx;
  margin: 48rpx auto 44rpx;
}

.check-title {
  margin-bottom: 22rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 700;
}

.check-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #555c66;
  font-size: 24rpx;
  line-height: 1.24;
}

.scan-help-sheet .primary-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  width: auto;
  margin-top: 0;
}
