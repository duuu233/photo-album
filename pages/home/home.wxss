.home-root {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  overflow-x: hidden;
  color: #2a2d32;
}

.home-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.home-bg-image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-content,
.binding-content {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - var(--status-bar) - 88rpx);
}

.home-content {
  display: flex;
  flex-direction: column;
  padding-bottom: calc(170rpx + var(--safe-bottom));
}

.binding-content {
  height: calc(100vh - var(--status-bar) - 88rpx);
  min-height: 0;
}

button {
  font: inherit;
}

.content-dimmed {
  opacity: 0.42;
}

.avatar-btn,
.add-btn,
.refresh-btn,
.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 10rpx 48rpx 0 48rpx;
}

/* avatar-btn 承载 open-type="chooseAvatar"，需清除 button 默认外观，外观与原圆形头像一致 */
.avatar-btn {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  overflow: hidden;
  background: #ffffff;
  border: none;
  border-radius: 50%;
  line-height: normal;
}

/* 去掉 button 默认的 ::after 边框线 */
.avatar-btn::after {
  display: none;
  border: none;
}

.avatar-img,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  background:
    radial-gradient(circle at 52% 42%, #ffe0c7 0 18rpx, transparent 19rpx),
    radial-gradient(circle at 50% 92%, #ff8a47 0 34rpx, transparent 35rpx),
    linear-gradient(135deg, #fff5ec, #d9ecff);
}

.add-btn {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff8a3f, #ff691e);
  border-radius: 50%;
  box-shadow: 0 12rpx 22rpx rgba(255, 105, 30, 0.2);
}

.plus-symbol {
  margin-top: -4rpx;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.hello-title {
  margin-top: 70rpx;
  padding: 0 48rpx;
  font-size: 82rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0;
  color: #2a2b2b;
}

.hello-subtitle {
  margin-top: 18rpx;
  padding: 0 48rpx;
  color: #545963;
  font-size: 40rpx;
  line-height: 1;
}

.hello-subtitle text {
  color: #ff7a2e;
  font-size: 44rpx;
  font-weight: 800;
}

.device-swiper {
  width: 100%;
  height: 372rpx;
  margin-top: 46rpx;
}

.device-swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.device-carousel {
  position: relative;
  display: flex;
  width: 654rpx;
  height: 372rpx;
  margin: 0 auto;

  justify-content: space-around;
  align-items: center;
  /* overflow: hidden; */
  /* border: 1rpx solid #ffffff4f;
  border-radius: 60rpx;
  fill: linear-gradient(326deg, rgba(255, 255, 255, 0.26) 6.29%, #fff 97.85%);
  stroke-width: 1px;
  stroke: rgba(255, 255, 255, 0.31);
  filter: drop-shadow(0 4px 12px rgba(44, 63, 97, 0.03));
  backdrop-filter: blur(10.550000190734863px); */
