.home-root {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  overflow-x: hidden;
  color: #2a2d32;
}

.home-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.home-bg-image {
  display: block;
  width: 100%;
  height: 100%;
}

/* 前景图预加载占位：移出视口且不占布局，只为触发加载完成事件做首页展示门控 */
.home-asset-preload {
  position: absolute;
  top: -9999rpx;
  left: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.home-content,
.binding-content {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - var(--status-bar) - 88rpx);
}

.home-content {
  display: flex;
  flex-direction: column;
  padding-bottom: calc(170rpx + var(--safe-bottom));
}

.binding-content {
  height: calc(100vh - var(--status-bar) - 88rpx);
  min-height: 0;
}

button {
  font: inherit;
}

.content-dimmed {
  opacity: 0.42;
}

.avatar-btn,
.add-btn,
.refresh-btn,
.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 10rpx 48rpx 0 48rpx;
}

/* avatar-btn 承载 open-type="chooseAvatar"，需彻底清除小程序 button 默认样式，外观与原圆形头像一致 */
.avatar-btn {
  flex: 0 0 auto;
  width: 72rpx !important;
  height: 72rpx;
  min-height: 0;
  padding: 0;
  margin: 0 !important;
  overflow: hidden;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: normal;
  text-align: center;
  white-space: normal;
  background: #ffffff;
  border: none;
  border-radius: 50%;
  box-sizing: border-box;
}

/* 去掉 button 默认的 ::after 边框线（含点击态） */
.avatar-btn::after,
.avatar-btn.button-hover::after {
  display: none;
  border: none;
  content: none;
}

/* 去掉默认点击态背景（已设 hover-class="none"，此处兜底） */
.avatar-btn.button-hover {
  background: #ffffff;
}

.avatar-img,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  background:
    radial-gradient(circle at 52% 42%, #ffe0c7 0 18rpx, transparent 19rpx),
    radial-gradient(circle at 50% 92%, #ff8a47 0 34rpx, transparent 35rpx),
    linear-gradient(135deg, #fff5ec, #d9ecff);
}

.add-btn-img {
  flex: 0 0 auto;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  box-shadow: 0px 3px 18px rgba(237, 99, 21, 0.4);
}

.plus-symbol {
  margin-top: -4rpx;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.hello-title {
  margin-top: 70rpx;
  padding: 0 48rpx;
  font-size: 82rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0;
  color: #2a2b2b;
}

.hello-subtitle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 0 48rpx;
  color: #545963;
  font-size: 40rpx;
  line-height: 1;
}

.hello-logo {
  flex: 0 0 auto;
  width: 194rpx;
  height: 40rpx;
}

.device-swiper {
  width: 100%;
  height: 372rpx;
  margin-top: 40rpx;
}

.device-swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.device-carousel {
  position: relative;
  display: flex;
  width: 654rpx;
  height: 298rpx;
  margin: 0 auto;

  justify-content: space-around;
  align-items: center;
  border-radius: 24px;
}

/* 玻璃背景层（融入自设计稿）：渐变 + 阴影 + 圆角 + 毛玻璃。
   与 .device-carousel-bg 同为 z-index:0，但它在 DOM 顺序更靠前，背景图会盖在其上→玻璃层垫在背景图之下；
   阴影绘制在卡片外沿、不受背景图遮挡，正好满足「主要要它的阴影和背景色」。 */
.carousel-glass {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  border-radius: 24px;
  /* background: linear-gradient(318deg, rgba(255, 255, 255, 0.26) 0%, white 100%); */
  box-shadow: 0px 4px 16px rgba(60, 53, 16, 0.12);
  backdrop-filter: blur(10.55px);
}

/* 卡片背景图：用 image 标签铺满，置于内容下方 */
.device-carousel-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.device-carousel .device-orbit,
.device-carousel .device-info {
  position: relative;
  z-index: 1;
}

.device-card {
  position: relative;
  display: flex;
  align-items: center;
}

.side-card {
  margin-left: 46rpx;
  opacity: 0.56;
}

.device-orbit {
  width: 166rpx;
  height: 166rpx;
}

.bolt-mark {
  position: absolute;
  top: 96rpx;
  left: 96rpx;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ff8a42, #ff6322);
  border-radius: 28rpx;
}

.bolt-cut {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
}

.cut-one {
  top: -8rpx;
  left: 42rpx;
  width: 10rpx;
  height: 114rpx;
  transform: rotate(-12deg);
}

.cut-two {
  top: 44rpx;
  left: 0;
  width: 104rpx;
  height: 10rpx;
  transform: rotate(-12deg);
}

.device-info {
  /* 已连接显示「电量行」、未连接显示更高的「连接蓝牙」按钮，两态内容高度不同。
     device-info 在卡片内垂直居中，高度不固定时切换连接态会重新居中，导致标题/状态文字上下跳动。
     固定最小高度(取较高的未连接态)让整块居中位置恒定，内容仍从顶部排布 → 文字位置稳定不跳。 */
  min-height: 220rpx;
}

.device-title {
  margin-bottom: 18rpx;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 500;
}

.device-status,
.battery-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.device-status {
  margin-bottom: 22rpx;
}

/* 已连接：蓝色图标（wxml 里换图）+ 蓝色文字，取色与设备列表/详情页 .connection.is-connected 一致 */
.device-status.is-connected {
  color: #287dff;
}

/* 设备卡片「连接蓝牙」按钮：未连接时的主操作，引导用户先连接再投屏。
   沿用页面 .bind-pill 的「胶囊 + 渐变 + 柔光阴影」CTA 语言，取连接语义蓝
   （与 .device-status.is-connected / 列表·详情连接态同色），在玻璃卡上更清晰、更像可点的主按钮。
   区分：橙色=绑定/新增设备(.bind-pill)，蓝色=连接已有设备。 */
.device-connect-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(92deg, #2f95ff 0%, #2079fc 100%);
  box-shadow: 0 12rpx 24rpx rgba(32, 121, 252, 0.28);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

/* 按压反馈（配合 wxml hover-class）：轻微下沉 + 阴影收敛，避免生硬点击感 */
.device-connect-btn--hover {
  transform: translateY(1rpx);
  box-shadow: 0 6rpx 14rpx rgba(32, 121, 252, 0.22);
  opacity: 0.94;
}

.device-connect-icon {
  width: 26rpx;
  height: 26rpx;
}

.mini-bluetooth {
  width: 22rpx;
  height: 28rpx;
}
.mini-bluetooth-white {
  width: 28rpx;
  height: 36rpx;
}
