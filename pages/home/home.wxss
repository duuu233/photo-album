}

.scan-copy {
  width: 100%;
  text-align: center;
}

.no-device-copy {
  top: 480rpx;
}

.scan-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
}

.scan-desc {
  margin-top: 22rpx;
  color: #737a84;
  font-size: 24rpx;
  line-height: 1;
}

.scan-help-link {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  /* 紧贴底部按钮上方：按钮底距 + 按钮高度 112rpx + 间距 24rpx */
  bottom: calc(48rpx + var(--safe-bottom) + 112rpx + 24rpx);
  color: #ff6421;
  font-size: 26rpx;
  text-align: center;
}

.bind-bottom {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + var(--safe-bottom));
  width: auto;
}

.nearby-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.nearby-head text {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.refresh-btn {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.device-container-box {
  margin: 0 48rpx 0 48rpx;
}
.device-list {
}

.nearby-device {
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  margin-bottom: 22rpx;
  padding: 0 34rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.54);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
}

.nearby-device.selected {
  background: rgba(255, 247, 242, 0.88);
  border-color: #ff6421;
}

.nearby-icon {
  width: 96rpx;
  height: 96rpx;
  margin-right: 36rpx;
}

.nearby-device > text {
  flex: 1;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.select-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  /* color: #ffffff; */
  /* border: 3rpx solid #b9bec6; */
  /* border-radius: 50%;
  font-size: 34rpx;
  font-weight: 800; */
}

.nearby-device.selected .select-circle {
  /* background: #ff8239;
  border-color: #ff8239; */
}

/* 选中态用图片替代时去掉描边/背景，只显示图标 */
image.select-circle {
  background: transparent;
  border: 0;
}

.scan-help-sheet {
  height: 932rpx;
  padding: 48rpx 48rpx 0;
}

.scan-help-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.scan-help-icon {
  display: block;
  width: 190rpx;
  height: 190rpx;
  margin: 48rpx auto 44rpx;
}

.check-title {
  margin-bottom: 22rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 500;
}

.check-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #555c66;
  font-size: 24rpx;
  line-height: 1.24;
}

.scan-help-sheet .primary-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  width: auto;
  margin-top: 0;
}
