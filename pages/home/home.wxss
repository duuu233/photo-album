.home-root {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  overflow-x: hidden;
  color: #2a2d32;
}

.home-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.home-bg-image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-content,
.binding-content {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - var(--status-bar) - 88rpx);
}

.home-content {
  display: flex;
  flex-direction: column;
  padding-bottom: calc(170rpx + var(--safe-bottom));
}

.binding-content {
  height: calc(100vh - var(--status-bar) - 88rpx);
  min-height: 0;
}

button {
  font: inherit;
}

.content-dimmed {
  opacity: 0.42;
}

.avatar-btn,
.add-btn,
.refresh-btn,
.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 10rpx 48rpx 0 48rpx;
}

.avatar-btn {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 50%;
}

.avatar-img,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  background:
    radial-gradient(circle at 52% 42%, #ffe0c7 0 18rpx, transparent 19rpx),
    radial-gradient(circle at 50% 92%, #ff8a47 0 34rpx, transparent 35rpx),
    linear-gradient(135deg, #fff5ec, #d9ecff);
}

.add-btn {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff8a3f, #ff691e);
  border-radius: 50%;
  box-shadow: 0 12rpx 22rpx rgba(255, 105, 30, 0.2);
}

.plus-symbol {
  margin-top: -4rpx;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.hello-title {
  margin-top: 70rpx;
  padding: 0 48rpx;
  font-size: 82rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0;
  color: #2a2b2b;
}

.hello-subtitle {
  margin-top: 18rpx;
  padding: 0 48rpx;
  color: #545963;
  font-size: 40rpx;
  line-height: 1;
}

.hello-subtitle text {
  color: #ff7a2e;
  font-size: 44rpx;
  font-weight: 800;
}

.device-carousel {
  position: relative;
  display: flex;
  width: 654rpx;
  height: 372rpx;
  margin: 46rpx 48rpx 0 48rpx;

  justify-content: space-around;
  align-items: center;
  background-color: #ffffff42;
  border: 1rpx solid #ffffff4f;
  border-radius: 60rpx;
  fill: linear-gradient(326deg, rgba(255, 255, 255, 0.26) 6.29%, #fff 97.85%);
  stroke-width: 1px;
  stroke: rgba(255, 255, 255, 0.31);
  filter: drop-shadow(0 4px 12px rgba(44, 63, 97, 0.03));
  backdrop-filter: blur(10.550000190734863px);
}

.device-card {
  position: relative;
  display: flex;
  align-items: center;
}

.side-card {
  margin-left: 46rpx;
  opacity: 0.56;
}

.device-orbit {
  width: 286rpx;
  height: 286rpx;
}

.bolt-mark {
  position: absolute;
  top: 96rpx;
  left: 96rpx;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ff8a42, #ff6322);
  border-radius: 28rpx;
}

.bolt-cut {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
}

.cut-one {
  top: -8rpx;
  left: 42rpx;
  width: 10rpx;
  height: 114rpx;
  transform: rotate(-12deg);
}

.cut-two {
  top: 44rpx;
  left: 0;
  width: 104rpx;
  height: 10rpx;
  transform: rotate(-12deg);
}

.device-info {
}

.device-title {
  margin-bottom: 18rpx;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
}

.device-status,
.battery-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.device-status {
  margin-bottom: 22rpx;
}

.mini-bluetooth {
  width: 22rpx;
  height: 28rpx;
}

.battery-icon {
  position: relative;
  width: 40rpx;
  height: 20rpx;
  border: 2rpx solid #8a8f97;
  border-radius: 4rpx;
}

.battery-icon::after {
  position: absolute;
  top: 5rpx;
  right: -8rpx;
  width: 6rpx;
  height: 8rpx;
  background: #8a8f97;
  border-radius: 0 2rpx 2rpx 0;
  content: '';
}

.battery-fill {
  height: 100%;
  background: #ff6a25;
}

.carousel-dots {
  display: flex;
  align-self: center;
  gap: 24rpx;
  margin-top: 64rpx;
}

.dot {
  width: 34rpx;
  height: 8rpx;
  background: #d7dce3;
  border-radius: 999rpx;
}

.dot.active {
  background: #ff6922;
}

.empty-hero-art {
  align-self: center;
  width: 480rpx;
  height: 380rpx;
  margin-top: 100rpx;
}

.empty-hint {
  width: 100%;
  /* margin-top: 16rpx; */
  color: #2a2b2b99;
  font-size: 26rpx;
  text-align: center;
}
.bind-pill-text {
  font-size: 30rpx;
}
.bind-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  gap: 16rpx;
  width: 400rpx;
  height: 88rpx;
  margin-top: 48rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8538, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.28);
  font-size: 30rpx;
  font-weight: 700;
}

.btn-bluetooth {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  color: #ff6421;
  background: #ffffff;
  border-radius: 50%;
  font-size: 22rpx;
}

.projection-title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0 48rpx;
}

.bound-home .projection-title {
  margin-top: 62rpx;
}
.unbound-home .projection-title {
  margin-top: 136rpx;
}
.projection-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin: 20rpx 24rpx 0 24rpx;

  overflow: hidden;
}

.bound-home .projection-grid,
.unbound-home .projection-grid {
  margin-top: 16rpx;
}

.projection-card {
  position: relative;
  flex-direction: column;
  display: flex;
  width: 366rpx;
  height: 358rpx;
}

.projection-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100%;
  height: 100%;
}

.media-art {
  z-index: 2;
  width: 132rpx;
  height: 132rpx;
  margin: 40rpx 0 0 50rpx;
}

.projection-copy {
  z-index: 2;
  /* padding-right 要在原来基础 - 23px 即46rpx */
  padding: 28rpx 27rpx 0 50rpx;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.projection-name {
  margin-bottom: 12rpx;
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.projection-desc {
  color: #8a9099;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  box-shadow: 0 16rpx 26rpx rgba(96, 126, 166, 0.12);
  font-size: 40rpx;
  line-height: 1;
}

.orange-arrow {
  color: #ff6421;
}

.blue-arrow {
  color: #287dff;
}

.projection-arrow {
  z-index: 1;
  width: 118rpx;
  height: 118rpx;
}

.home-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

.prompt-sheet {
  height: 500rpx;
  padding: 104rpx 48rpx 0;
}

.sheet-close {
  position: absolute;
  top: 32rpx;
  right: 36rpx;
  width: 44rpx;
  height: 44rpx;
  color: #8b9098;
  font-size: 42rpx;
  line-height: 1;
}

.prompt-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.prompt-desc {
  margin-top: 24rpx;
  color: #747b85;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
}

.offline-desc {
  line-height: 1.45;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.prompt-sheet .primary-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  width: auto;
  margin-top: 0;
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 34rpx;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 124rpx;
  margin-bottom: 22rpx;
  padding: 0 28rpx;
  text-align: left;
  background: #f8f9fb;
  border-radius: 18rpx;
}

.media-art.mini {
  position: relative;
  top: auto;
  left: auto;
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  margin-right: 20rpx;
}

.media-option-copy {
  flex: 1;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.media-option .round-arrow {
  position: static;
  flex: 0 0 72rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  margin-top: 0;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.radar-wrap {
  position: absolute;
  top: 24rpx;
  left: 50%;
  width: 500rpx;
  height: 500rpx;
  transform: translateX(-50%);
}

.radar-art {
  width: 100%;
  height: 100%;
}

.radar-scanning .radar-art {
  animation: radarPulse 1.8s ease-in-out infinite;
}

@keyframes radarPulse {
  0% {
    opacity: 0.85;
    transform: scale(0.96);
  }
  55% {
    opacity: 1;
  }
  100% {
    opacity: 0.9;
    transform: scale(1.03);
  }
}

.scan-copy {
  position: absolute;
  top: 486rpx;
  left: 0;
  width: 100%;
  text-align: center;
}

.no-device-copy {
  top: 480rpx;
}

.scan-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.scan-desc {
  margin-top: 22rpx;
  color: #737a84;
  font-size: 24rpx;
  line-height: 1;
}

.scan-help-link {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(150rpx + var(--safe-bottom));
  color: #ff6421;
  font-size: 26rpx;
  text-align: center;
}

.bind-bottom {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + var(--safe-bottom));
  width: auto;
}

.nearby-head {
  position: absolute;
  top: 582rpx;
  left: 48rpx;
  right: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nearby-head text {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.refresh-btn {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.refresh-btn::before,
.refresh-btn::after {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ff6421;
  border-left-color: transparent;
  border-radius: 50%;
  content: '';
}

.refresh-btn::after {
  width: 0;
  height: 0;
  right: 1rpx;
  bottom: 2rpx;
  border: 9rpx solid transparent;
  border-top-color: #ff6421;
  transform: rotate(-35deg);
}

.device-list {
  position: absolute;
  top: 640rpx;
  left: 48rpx;
  right: 48rpx;
}

.nearby-device {
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  margin-bottom: 22rpx;
  padding: 0 34rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.54);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 20rpx;
}

.nearby-device.selected {
  background: rgba(255, 247, 242, 0.88);
  border-color: #ff6421;
}

.nearby-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-right: 52rpx;
  border-radius: 24rpx;
}

.nearby-icon.orange {
  color: #ff6421;
  background: rgba(255, 100, 33, 0.08);
}

.nearby-icon.green {
  color: #28b365;
  background: rgba(40, 179, 101, 0.1);
}

.nearby-icon.blue {
  color: #287dff;
  background: rgba(40, 125, 255, 0.08);
}

.small-frame-icon {
  position: relative;
  width: 44rpx;
  height: 30rpx;
  border: 5rpx solid currentColor;
  border-radius: 4rpx;
}

.small-frame-icon::before {
  position: absolute;
  right: -16rpx;
  top: 4rpx;
  width: 12rpx;
  height: 16rpx;
  border: 5rpx solid currentColor;
  border-left: 0;
  border-radius: 0 4rpx 4rpx 0;
  content: '';
}

.small-frame-icon::after {
  position: absolute;
  left: -4rpx;
  bottom: -22rpx;
  width: 50rpx;
  height: 8rpx;
  border: 5rpx solid currentColor;
  border-radius: 4rpx;
  content: '';
}

.nearby-device > text {
  flex: 1;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.select-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #ffffff;
  border: 3rpx solid #b9bec6;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 800;
}

.nearby-device.selected .select-circle {
  background: #ff8239;
  border-color: #ff8239;
}

.scan-help-sheet {
  height: 932rpx;
  padding: 48rpx 48rpx 0;
}

.scan-help-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.scan-help-icon {
  display: block;
  width: 190rpx;
  height: 190rpx;
  margin: 48rpx auto 44rpx;
}

.check-title {
  margin-bottom: 22rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 700;
}

.check-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #555c66;
  font-size: 24rpx;
  line-height: 1.24;
}

.scan-help-sheet .primary-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  width: auto;
  margin-top: 0;
}
