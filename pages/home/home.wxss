.home-page {
  background:
    radial-gradient(circle at 82% 0%, rgba(236, 95, 27, 0.16), transparent 260rpx),
    linear-gradient(180deg, #f6f7fb 0%, #eef2f8 100%);
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 2rpx 24rpx;
}

.hero-copy {
  min-width: 0;
}

.hero-kicker {
  color: #eb5f1b;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-title {
  margin-top: 8rpx;
  color: #232323;
  font-size: 54rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-subtitle {
  width: 520rpx;
  max-width: 100%;
  margin-top: 12rpx;
  color: #737a84;
  font-size: 25rpx;
  line-height: 1.6;
}

.guide-chip {
  flex: 0 0 auto;
  min-width: 104rpx;
  min-height: 58rpx;
  padding: 0 22rpx;
  color: #eb5f1b;
  background: #fff1e9;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.device-panel,
.empty-device {
  padding: 28rpx;
}

.device-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.device-name {
  margin-bottom: 8rpx;
  color: #232323;
  font-size: 36rpx;
  font-weight: 850;
}

.memory-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  color: #6d747e;
  font-size: 24rpx;
}

.memory-track {
  height: 14rpx;
  margin-top: 14rpx;
  overflow: hidden;
  background: #edf1f7;
  border-radius: 999rpx;
}

.memory-bar {
  height: 100%;
  background: linear-gradient(90deg, #eb5f1b, #ff9c45);
  border-radius: 999rpx;
}

.device-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
}

.empty-device {
  text-align: center;
}

.empty-device .primary-btn {
  margin-top: 28rpx;
}

.empty-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 20rpx;
  color: #eb5f1b;
  background: #fff1e9;
  border-radius: 28rpx;
  font-size: 58rpx;
  font-weight: 300;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #232323;
  font-size: 34rpx;
  font-weight: 800;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-card {
  min-height: 220rpx;
  padding: 28rpx;
  overflow: hidden;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid #e5ebf3;
  border-radius: 20rpx;
  box-shadow: 0 14rpx 36rpx rgba(64, 77, 97, 0.08);
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.camera-card .action-icon {
  background: #eb5f1b;
}

.album-card .action-icon {
  background: #2f6f75;
}

.action-title {
  margin-bottom: 8rpx;
  color: #232323;
  font-size: 34rpx;
  font-weight: 850;
}

.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.photo-card {
  position: relative;
  height: 218rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #f0f0f0;
}

.tone-blue {
  background: linear-gradient(135deg, #cfe4ff, #d9efe8);
}

.tone-amber {
  background: linear-gradient(135deg, #ffd8bd, #fff0c1);
}

.tone-rose {
  background: linear-gradient(135deg, #ded6ff, #ffd7e9);
}

.tone-green {
  background: linear-gradient(135deg, #bff0d7, #d7f3ff);
}

.photo-img,
.photo-placeholder {
  width: 100%;
  height: 100%;
}

.photo-meta {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 46rpx 18rpx 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  background: linear-gradient(180deg, rgba(35, 35, 35, 0), rgba(35, 35, 35, 0.72));
}

.record-list {
  overflow: hidden;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 118rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.record-row:last-child {
  border-bottom: 0;
}

.record-title {
  margin-bottom: 6rpx;
  color: #232323;
  font-size: 28rpx;
  font-weight: 800;
}
