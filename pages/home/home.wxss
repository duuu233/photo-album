/* 卡片背景图：用 image 标签铺满，置于内容下方 */
.device-carousel-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.device-carousel .device-orbit,
.device-carousel .device-info {
  position: relative;
  z-index: 1;
}

.device-card {
  position: relative;
  display: flex;
  align-items: center;
}

.side-card {
  margin-left: 46rpx;
  opacity: 0.56;
}

.device-orbit {
  width: 286rpx;
  height: 286rpx;
}

.bolt-mark {
  position: absolute;
  top: 96rpx;
  left: 96rpx;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ff8a42, #ff6322);
  border-radius: 28rpx;
}

.bolt-cut {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
}

.cut-one {
  top: -8rpx;
  left: 42rpx;
  width: 10rpx;
  height: 114rpx;
  transform: rotate(-12deg);
}

.cut-two {
  top: 44rpx;
  left: 0;
  width: 104rpx;
  height: 10rpx;
  transform: rotate(-12deg);
}

.device-info {
}

.device-title {
  margin-bottom: 18rpx;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 500;
}

.device-status,
.battery-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.device-status {
  margin-bottom: 22rpx;
}

.mini-bluetooth {
  width: 22rpx;
  height: 28rpx;
}
.mini-bluetooth-white {
  width: 28rpx;
  height: 36rpx;
}
.carousel-dots {
  display: flex;
  align-self: center;
  gap: 24rpx;
  margin-top: 64rpx;
}

.dot {
  width: 34rpx;
  height: 8rpx;
  background: #d7dce3;
  border-radius: 999rpx;
}

.dot.active {
  background: #ff6922;
}

.empty-hero-art {
  align-self: center;
  width: 480rpx;
  height: 380rpx;
  margin-top: 100rpx;
}

.empty-hint {
  width: 100%;
  /* margin-top: 16rpx; */
  color: #2a2b2b99;
  font-size: 26rpx;
  text-align: center;
}
.bind-pill-text {
  font-size: 30rpx;
}
.bind-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  gap: 28rpx;
  width: 400rpx;
  height: 88rpx;
  margin-top: 48rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8538, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.28);
  font-size: 30rpx;
  font-weight: 500;
}

.btn-bluetooth {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  color: #ff6421;
  background: #ffffff;
  border-radius: 50%;
  font-size: 22rpx;
}

.projection-title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0 48rpx;
}

.bound-home .projection-title {
  margin-top: 62rpx;
}
.unbound-home .projection-title {
  margin-top: 136rpx;
}
.projection-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin: 20rpx 48rpx 0 48rpx;

  overflow: hidden;
}

.bound-home .projection-grid,
.unbound-home .projection-grid {
  margin-top: 16rpx;
}

.projection-card {
  position: relative;
  flex-direction: column;
  display: flex;
  width: 316rpx;
  height: 308rpx;
}

.projection-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100%;
  height: 100%;
}

.media-art {
  z-index: 2;
  width: 132rpx;
  height: 132rpx;
}
.projection-grid .media-art {
  margin: 34rpx 0 0 26rpx;
}
.projection-copy {
  z-index: 2;
  padding: 12rpx 0rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.projection-name {
  margin-bottom: 12rpx;
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
}

.projection-desc {
  color: #8a9099;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  width: 118rpx;
  height: 118rpx;
}

.projection-arrow {
  z-index: 1;
  width: 118rpx;
  height: 118rpx;
}

.home-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

.prompt-sheet {
  height: 500rpx;
  padding: 104rpx 48rpx 0;
}

.sheet-close {
  position: absolute;
  top: 32rpx;
  right: 36rpx;
  width: 44rpx;
  height: 44rpx;
  color: #8b9098;
  font-size: 42rpx;
  line-height: 1;
}

.prompt-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.prompt-desc {
  margin-top: 24rpx;
  color: #747b85;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
}

.offline-desc {
  line-height: 1.45;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
}

.prompt-sheet .primary-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  width: auto;
  margin-top: 0;
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 46rpx;
  color: #2a2b2b;
  font-size: 40rpx;
  font-weight: 500;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  justify-content: space-between;
  background: #f8f9fb;
  border-radius: 28rpx;
}
.media-option-left {
  display: flex;
  align-items: center;
}
.media-art.mini {
  position: relative;

  width: 98rpx;
  height: 96rpx;
}

.media-option-copy {
  height: 100%;
  display: flex;
  /* align-items: center; */
  justify-content: center;
  flex-direction: column;
  padding-left: 28rpx;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  margin-top: 0;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 500;
}

.radar-wrap {
  width: 500rpx;
  height: 500rpx;
  margin: 56rpx auto 18rpx auto;
}

.radar-art {
  width: 100%;
  height: 100%;
}

.radar-scanning .radar-art {
  animation: radarPulse 1.8s ease-in-out infinite;
}

@keyframes radarPulse {
  0% {
    opacity: 0.85;
    transform: scale(0.96);
  }
  55% {
    opacity: 1;
  }
  100% {
    opacity: 0.9;
    transform: scale(1.03);
  }
}

.scan-copy {
  width: 100%;
  text-align: center;
}

.no-device-copy {
  top: 480rpx;
}

.scan-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
}

.scan-desc {
  margin-top: 22rpx;
  color: #737a84;
  font-size: 24rpx;
  line-height: 1;
}

.scan-help-link {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  /* 紧贴底部按钮上方：按钮底距 + 按钮高度 112rpx + 间距 24rpx */
  bottom: calc(48rpx + var(--safe-bottom) + 112rpx + 24rpx);
  color: #ff6421;
  font-size: 26rpx;
  text-align: center;
}

.bind-bottom {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + var(--safe-bottom));
  width: auto;
}

.nearby-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.nearby-head text {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.refresh-btn {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.device-container-box {
  margin: 0 48rpx 0 48rpx;
}
.device-list {
}

.nearby-device {
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  margin-bottom: 22rpx;
  padding: 0 34rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.54);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
}

.nearby-device.selected {
  background: rgba(255, 247, 242, 0.88);
  border-color: #ff6421;
}

.nearby-icon {
  width: 96rpx;
  height: 96rpx;
  margin-right: 36rpx;
}

.nearby-device > text {
  flex: 1;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.select-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  /* color: #ffffff; */
  /* border: 3rpx solid #b9bec6; */
  /* border-radius: 50%;
  font-size: 34rpx;
  font-weight: 800; */
}

.nearby-device.selected .select-circle {
  /* background: #ff8239;
  border-color: #ff8239; */
}

/* 选中态用图片替代时去掉描边/背景，只显示图标 */
image.select-circle {
  background: transparent;
  border: 0;
}

.scan-help-sheet {
  height: 932rpx;
  padding: 48rpx 48rpx 0;
}

.scan-help-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.scan-help-icon {
  display: block;
  width: 190rpx;
  height: 190rpx;
  margin: 48rpx auto 44rpx;
}

.check-title {
  margin-bottom: 22rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 500;
}

.check-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #555c66;
  font-size: 24rpx;
  line-height: 1.24;
}

.scan-help-sheet .primary-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  width: auto;
  margin-top: 0;
}
