.login-page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 0 calc(34rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: #2a2b2b;
  background:
    radial-gradient(
      circle at 88% 18%,
      rgba(255, 236, 214, 0.98) 0,
      rgba(255, 236, 214, 0.58) 130rpx,
      transparent 330rpx
    ),
    radial-gradient(
      circle at 5% 6%,
      rgba(211, 229, 255, 0.96) 0,
      rgba(211, 229, 255, 0.6) 300rpx,
      transparent 620rpx
    ),
    linear-gradient(180deg, #edf5ff 0%, #f6f8fb 78%, #f3f4f6 100%);
  font-family:
    'Source Han Sans CN',
    'PingFang SC',
    -apple-system,
    BlinkMacSystemFont,
    'Helvetica Neue',
    sans-serif;
  transition: opacity 0.24s ease-out;
}

/* 离场态：整页淡出，露出窗口底色，掩盖 switchTab 的无动画硬切；时长与 login.js leaveTo 的 240ms 对齐 */
.login-page--leaving {
  opacity: 0;
  pointer-events: none;
}

.login-bg-stack,
.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
}

.login-bg-stack {
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.login-bg {
  height: 100%;
}

.login-bg--soft {
  height: 1518rpx;
}

.login-bg--halo,
.login-bg--grain {
  height: 1624rpx;
}

.login-bg--wash {
  height: 1594rpx;
}

.login-bg__bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 368rpx;
  background: linear-gradient(
    180deg,
    rgba(245, 247, 250, 0) 0%,
    rgba(247, 248, 250, 0.9) 34%,
    #f5f6f8 100%
  );
}

.login-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 376rpx;
}

.login-back {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-left: -32rpx;
  border-radius: 50%;
}

.login-back--hover {
  opacity: 0.64;
}

.login-back__icon {
  width: 18rpx;
  height: 34rpx;
}

.login-logo {
  width: 348rpx;
  height: 72rpx;
  margin-bottom: 232rpx;
}

.login-submit {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 646rpx !important;
  height: 128rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff7d31 0%, #f35b16 100%);
  border-radius: 136rpx;
  box-shadow: 0 22rpx 42rpx rgba(235, 95, 27, 0.2);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 128rpx;
}

.login-submit__icon {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: 23rpx;
}

/* 按下反馈只做透明度变化：translateY 位移会让按钮按下/松开时上下跳一下 */
.login-submit--hover {
  opacity: 0.92;
}

/* 登录成功过渡层：全屏盖住整页，背景与全局窗口底色一致(#f2f5fc)，
   switchTab 落到同底色的首页时视觉上近似无缝；spinner/文字复用 app.wxss 的 page-loading__* */
.login-transition {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  /* 需盖住自定义导航(page-nav z-index:10)避免登录中还能点返回；层级与其他页面遮罩(20)一致，低于全局 toast */
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f2f5fc;
}

.login-text-hover {
  opacity: 0.7;
}

.login-agreement {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
  min-height: 42rpx;
  /* 水平居中必须靠 `margin: … auto`，不能只写 `align-self: center`：
     2026-08-05 折叠屏适配后本行的父节点从 `.login-page`（flex 纵向）换成了
     `.fold-scroll-body`（普通块级），align-self 在块级父容器里不生效，
     这一行 600rpx 宽的勾选区就整体贴到了左边（与折叠与否无关，所有机型都偏）。 */
  margin: 58rpx auto 0;
}

.login-agreement__check-group {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  /* 点击热区 86rpx = 42rpx 图标 + 两侧各 22rpx padding（全局 border-box，见 app.wxss），
     负 margin 抵消布局占位，右侧 22-10=12rpx 与原 margin-right 间距一致。
     ⚠️ width/height 不能写 42rpx：border-box 下 padding 会把内容区压成 0，
     图标被 flex 收缩到 0 宽直接不可见（2026-07-22 已踩坑） */
  width: 86rpx;
  height: 86rpx;
  padding: 22rpx;
  margin: -22rpx -10rpx -22rpx -22rpx;
}

.login-agreement__check-icon {
  width: 32rpx;
  height: 32rpx;
}

.login-agreement__text {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  flex-wrap: wrap;
  align-items: center;
  color: rgba(42, 43, 43, 0.6);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.login-agreement__link {
  color: #eb5f1b;
}
