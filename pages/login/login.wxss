.login-page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 0 calc(34rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: #2a2b2b;
  background:
    radial-gradient(
      circle at 88% 18%,
      rgba(255, 236, 214, 0.98) 0,
      rgba(255, 236, 214, 0.58) 130rpx,
      transparent 330rpx
    ),
    radial-gradient(
      circle at 5% 6%,
      rgba(211, 229, 255, 0.96) 0,
      rgba(211, 229, 255, 0.6) 300rpx,
      transparent 620rpx
    ),
    linear-gradient(180deg, #edf5ff 0%, #f6f8fb 78%, #f3f4f6 100%);
  font-family:
    'Source Han Sans CN',
    'PingFang SC',
    -apple-system,
    BlinkMacSystemFont,
    'Helvetica Neue',
    sans-serif;
}

.login-bg-stack,
.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
}

.login-bg-stack {
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.login-bg {
  height: 100%;
}

.login-bg--soft {
  height: 1518rpx;
}

.login-bg--halo,
.login-bg--grain {
  height: 1624rpx;
}

.login-bg--wash {
  height: 1594rpx;
}

.login-bg__bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 368rpx;
  background: linear-gradient(
    180deg,
    rgba(245, 247, 250, 0) 0%,
    rgba(247, 248, 250, 0.9) 34%,
    #f5f6f8 100%
  );
}

.login-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 376rpx;
}

.login-back {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-left: -32rpx;
  border-radius: 50%;
}

.login-back--hover {
  opacity: 0.64;
}

.login-back__icon {
  width: 18rpx;
  height: 34rpx;
}

.login-logo {
  width: 348rpx;
  height: 72rpx;
  margin-bottom: 232rpx;
}

.login-submit {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 646rpx !important;
  height: 128rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff7d31 0%, #f35b16 100%);
  border-radius: 136rpx;
  box-shadow: 0 22rpx 42rpx rgba(235, 95, 27, 0.2);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 128rpx;
}

.login-submit__icon {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: 23rpx;
}

.login-submit--hover {
  transform: translateY(2rpx);
  opacity: 0.92;
}

.login-submit--loading {
  opacity: 0.82;
}

.login-text-hover {
  opacity: 0.7;
}

.login-agreement {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  align-self: center;
  width: 100%;
  max-width: 600rpx;
  min-height: 42rpx;
  margin-top: 58rpx;
}

.login-agreement__check-group {
  display: flex;
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
}

.login-agreement__check {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
}

.login-agreement__checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
}

.login-agreement__checkbox .wx-checkbox-input {
  width: 32rpx;
  height: 32rpx;
  margin: 0;
  border: 1rpx solid rgba(42, 43, 43, 0.6);
  border-radius: 50%;
  background: transparent;
}

.login-agreement__checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  border-color: #eb5f1b;
  background: #eb5f1b;
}

.login-agreement__checkbox
  .wx-checkbox-input.wx-checkbox-input-checked::before {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  transform: translate(-50%, -50%) scale(0.72);
}

.login-agreement__text {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  flex-wrap: wrap;
  align-items: center;
  color: rgba(42, 43, 43, 0.6);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.login-agreement__link {
  color: #eb5f1b;
}
