<view class="login-page safe-bottom {{leaving ? 'login-page--leaving' : ''}}">
  <view class="login-bg-stack" aria-hidden="true">
    <image class="login-bg login-bg--halo" src="https://oss.boltfox.cn/prodFile/202607070935141637931.png" mode="aspectFill"></image>
    <view class="login-bg__bottom"></view>
  </view>

  <page-nav title="登录" custom-back="{{true}}" bind:backtap="goBack"></page-nav>

  <view class="login-main">
    <image class="login-logo" src="/assets/images/logo.png" mode="aspectFit"></image>

    <!-- 不用 button 的 loading 属性：原生 spinner 会插进按钮内容挤动图标文字（视觉上抖动）；
         提交期间的反馈由全屏过渡层承担 -->
    <button class="login-submit"
      hover-class="login-submit--hover" open-type="{{agreed ? 'getPhoneNumber' : ''}}"
      bindtap="onLoginTap" bindgetphonenumber="onWechatLogin">
   
    

      <text>微信登录</text>
    </button>
  </view>

  <view class="login-agreement">
    <view class="login-agreement__check-group" bindtap="onAgreementChange">
      <image class="login-agreement__check-icon"
        src="{{agreed ? '/assets/images/radio-button-icon02.png' : '/assets/images/radio-button-icon01.png'}}"
        mode="aspectFit"></image>
    </view>
    <view class="login-agreement__text">
      <text>我已阅读并同意</text>
      <text class="login-agreement__link" bindtap="openUserAgreement">《用户协议》</text>
      <text>和</text>
      <text class="login-agreement__link" bindtap="openPrivacyPolicy">《隐私政策》</text>
    </view>
  </view>

  <!-- 登录成功过渡层：登录接口 + 首页数据预取期间全屏覆盖（含按钮，防重复点击），
       期间预取的设备列表由首页 loadHomeState 一次性消费，落地即是加载完毕的首页 -->
  <view wx:if="{{loggingIn}}" class="login-transition" catchtouchmove="noop">
    <view class="page-loading__spinner"></view>
    <view class="page-loading__text">{{loginTip}}</view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
