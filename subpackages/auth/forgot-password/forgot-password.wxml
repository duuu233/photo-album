<view class="auth-page safe-bottom">
  <page-nav title="忘记密码" subtitle="验证手机号后重设登录密码" />

  <view class="auth-shell">
    <view class="auth-title">找回账号访问权</view>
    <view class="auth-desc">验证码通过后即可设置新密码，用于手机号登录或后台账号登录场景。</view>

    <view class="form-stack">
      <form-field
        name="phone"
        label="手机号"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入手机号"
        bind:input="updateField"
      />
      <form-field
        name="code"
        label="验证码"
        type="number"
        maxlength="6"
        value="{{code}}"
        placeholder="请输入验证码"
        right-text="{{countdown > 0 ? countdown + 's' : '获取验证码'}}"
        right-disabled="{{countdown > 0}}"
        bind:input="updateField"
        bind:righttap="sendCode"
      />
      <form-field
        name="password"
        label="新密码"
        password="{{true}}"
        value="{{password}}"
        placeholder="至少 8 位字符"
        bind:input="updateField"
      />
      <form-field
        name="confirmPassword"
        label="确认新密码"
        password="{{true}}"
        value="{{confirmPassword}}"
        placeholder="再次输入新密码"
        bind:input="updateField"
      />
    </view>

    <brand-button text="确认重设" loading="{{loading}}" bind:tap="submitReset" />
  </view>
</view>
