.auth-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffffff 0%, #f5f7fb 52%, #eef8f5 100%);
}

.auth-shell {
  padding: 34rpx 32rpx 48rpx;
}

.auth-title {
  color: #172133;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.auth-desc {
  width: 620rpx;
  max-width: 100%;
  margin-top: 14rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin: 44rpx 0 36rpx;
  padding: 28rpx;
  border: 1rpx solid #e6ebf2;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 48, 0.05);
}
