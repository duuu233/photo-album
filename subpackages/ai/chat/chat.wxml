<view
  class="ai-root"
  style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px; --menu-offset-top: {{menuButtonOffsetTop}}px; --menu-height: {{menuButtonHeight}}px; --navigation-height: {{navigationHeight}}px;"
>
  <!-- 背景：2026-08-21 起与首页同一张（浅蓝墙面）。
       ⚠️ 原来那张按产品要求先注释保留，怕还要用回去：
           src="https://oss.boltfox.cn/prodFile/202607310920402821453.png" -->
  <image
    class="ai-page-background"
    src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg"
    mode="aspectFill"
  ></image>

  <!-- 顶栏（2026-08-10 需求 1.3/5 重排）：左侧「返回 + 会话列表」两颗按钮并排，标题**屏幕正中**、
       定宽超出省略；Token 胶囊已移到「历史会话」页顶部（右上角只剩微信原生胶囊）——
       原生胶囊左边缘在 375pt 屏上约 281px，Token 胶囊占住 167~273px 时标题根本无法真正居中。
       ⚠️ Flutter APP 的按钮排布与此不同（会话列表按钮在最右），见
       docs/changes/2026-08-10-AI助手八项优化.md。 -->
  <view class="ai-header" bindtap="closeTools">
    <view class="ai-header__row">
      <view class="header-buttons">
        <view class="header-button" hover-class="header-button--pressed" bindtap="goBack">
          <image
            class="header-button__image"
            src="/assets/images/ai-back-button.png"
            mode="aspectFit"
          ></image>
        </view>
        <view class="header-button" hover-class="header-button--pressed" bindtap="goSessions">
          <image
            class="header-button__image"
            src="/assets/images/ai-history-button.png"
            mode="aspectFit"
          ></image>
        </view>
      </view>

      <!-- 默认页（还没建会话）标题留空：需求「进入 AI 默认页，标题不需要显示新对话」 -->
      <view class="ai-header__title">{{sessionId ? sessionTitle : ''}}</view>
    </view>
  </view>

  <view class="chat-wrap" bindtap="closeTools">
    <scroll-view
      class="chat-scroll {{chatReady ? '' : 'chat-scroll--warming'}}"
      scroll-y
      scroll-top="{{scrollTop}}"
      scroll-with-animation="{{scrollAnimate}}"
      bindscroll="onChatScroll"
      bindtouchmove="onChatTouchMove"
      bindtouchend="onChatTouchEnd"
      bindtouchcancel="onChatTouchEnd"
      enable-passive
    >
      <view wx:if="{{!historyLoading && !messages.length}}" class="welcome">
        <view class="welcome-mark">
          <image src="/assets/images/ai-welcome-star.png" mode="aspectFit"></image>
        </view>
        <view class="welcome-title">
          <text>您好！我是星宝</text>
          <image src="/assets/images/ai-spark-orange.png" mode="aspectFit"></image>
        </view>
        <view class="welcome-text">您的 AI 创作伙伴，有什么我可以帮您的吗？</view>
        <view class="welcome-suggestions">
          <view class="welcome-suggestion" data-prompt="生成一张温馨的客厅插画" bindtap="useSuggestion">
            <image src="/assets/images/ai-suggestion-home.png" mode="aspectFit"></image>
            <text>生成一张温馨的客厅插画</text>
          </view>
          <view class="welcome-suggestion" data-prompt="帮我写一句早安文案" bindtap="useSuggestion">
            <image src="/assets/images/ai-suggestion-sunrise.png" mode="aspectFit"></image>
            <text>帮我写一句早安文案</text>
          </view>
          <view class="welcome-suggestion" data-prompt="把照片变成漫画风" bindtap="useSuggestion">
            <image src="/assets/images/ai-suggestion-palette.png" mode="aspectFit"></image>
            <text>把照片变成漫画风</text>
          </view>
        </view>
      </view>

      <block wx:for="{{messages}}" wx:key="id">
        <view wx:if="{{item.timeLabel}}" class="message-time">{{item.timeLabel}}</view>

        <view
          id="msg-{{item.id}}"
          class="msg-row {{item.role === 'user' ? 'msg-row--user' : 'msg-row--ai'}} {{item.streaming ? 'msg-row--gen' : ''}}"
        >
          <view
            wx:if="{{item.role !== 'user'}}"
            class="bubble bubble--ai {{item.loading ? 'bubble--loading' : ''}} {{item.failed ? 'bubble--failed' : ''}} {{item.streaming ? 'bubble--gen' : ''}} {{item.streaming && item.genPad < 100 ? 'bubble--gen-wide' : ''}}"
            bindlongpress="onBubbleLongPress"
            data-id="{{item.id}}"
          >
            <view wx:if="{{item.failed}}" class="failure-card">
              <view
                class="failure-card__delete"
                data-id="{{item.id}}"
                catchtap="onFailureDelete"
              >
                <image src="/assets/images/ai-delete-red.png" mode="aspectFit"></image>
                <text>删除</text>
              </view>
              <view class="failure-card__visual">
                <view class="failure-card__title">{{item.failureTitle}}</view>
                <view class="failure-card__desc">{{item.failureDesc}}</view>
                <view
                  class="failure-card__retry"
                  data-id="{{item.id}}"
                  catchtap="onRetryMessage"
                >
                  <view class="retry-placeholder">↻</view>
                  <text>重新生成</text>
                </view>
              </view>
            </view>

            <!-- 「星宝正在想」的等待气泡（2026-08-12 需求 5）：原来是一张静态图
                 assets/images/ai-loading-bubble.png（白胶囊 + 三个点），胶囊与阴影已按原图
                 用 CSS 还原，三个点改成常见的依次跳动动画（见 chat.wxss .loading-bubble）。 -->
            <view wx:elif="{{item.loading}}" class="loading-bubble">
              <view class="loading-bubble__dot"></view>
              <view class="loading-bubble__dot"></view>
              <view class="loading-bubble__dot"></view>
            </view>

            <block wx:else>
              <!-- 流式预描述（SSE pre_text）：秒回的一句「正在为您绘制…」，生成完成后保留，当作这条回复的前情提要 -->
              <view wx:if="{{item.preText}}" class="pre-text">
                <image class="pre-text__icon" src="/assets/images/ai-spark-orange.png" mode="aspectFit"></image>
                <text class="pre-text__body" user-select catchlongpress="noop">{{item.preText}}</text>
              </view>

              <!-- 生成中的图片占位（SSE progress，5→45→50→80→85→90→100）。
                   位置就是图片将来出现的位置（.bubble-imgs 之前），100% 时原地换成真图，
                   前后不跳。genPad 与真图占位比例同源，所以换的时候高度也不跳。
                   进度文案压在百分比下面、盒子**内部**（2026-08-07 需求），盒外不再留字。 -->
              <view wx:if="{{item.streaming}}" class="gen-canvas-wrap">
                <view class="gen-canvas" style="padding-bottom: {{item.genPad}}%">
                  <view class="gen-canvas__inner">
                    <image
                      class="gen-canvas__icon"
                      src="/assets/images/ai-magic-white.png"
                      mode="aspectFit"
                    ></image>
                    <text class="gen-canvas__value">{{item.progress}}%</text>
                    <text class="gen-canvas__label">{{item.progressLabel}}</text>
                  </view>
                </view>
              </view>

              <!-- 生成中先不显示真图：占位盒还占着这个位置，等 100%（streaming 落下）再上屏 -->
              <view wx:if="{{item.images.length && !item.streaming}}" class="bubble-imgs">
                <block
                  wx:for="{{item.images}}"
                  wx:for-item="img"
                  wx:for-index="imgIndex"
                  wx:key="url"
                >
                  <view
                    class="img-box"
                    style="padding-bottom: {{img.pad}}%"
                    catchtap="onImageTap"
                    catchlongpress="noop"
                    data-url="{{img.url}}"
                    data-id="{{item.id}}"
                    data-index="{{imgIndex}}"
                  >
                    <image
                      class="img-el"
                      src="{{img.url}}"
                      mode="aspectFill"
                      lazy-load
                      bindload="onImageLoad"
                      data-id="{{item.id}}"
                      data-index="{{imgIndex}}"
                    ></image>
                  </view>

                  <!-- 下载/投屏/删除**常驻**在每张图下方（2026-08-10 需求 7），不再靠长按唤起：
                       长按只留给纯文字气泡（删除确认框）。 -->
                  <view class="image-actions" catchtap="noop" catchlongpress="noop">
                    <view
                      class="image-action"
                      data-action="download"
                      data-url="{{img.url}}"
                      data-id="{{item.id}}"
                      data-index="{{imgIndex}}"
                      bindtap="onImageActionTap"
                    >
                      <image
                        class="image-action__icon"
                        src="/assets/images/ai-download.png"
                        mode="aspectFit"
                      ></image>
                      <text>下载</text>
                    </view>
                    <view class="image-actions__divider"></view>
                    <view
                      class="image-action"
                      data-action="project"
                      data-url="{{img.url}}"
                      data-id="{{item.id}}"
                      data-index="{{imgIndex}}"
                      bindtap="onImageActionTap"
                    >
                      <image
                        class="image-action__icon"
                        src="/assets/images/ai-project.png"
                        mode="aspectFit"
                      ></image>
                      <text>投屏</text>
                    </view>
                    <view class="image-actions__divider"></view>
                    <view
                      class="image-action image-action--danger"
                      data-action="delete"
                      data-url="{{img.url}}"
                      data-id="{{item.id}}"
                      data-index="{{imgIndex}}"
                      bindtap="onImageActionTap"
                    >
                      <image
                        class="image-action__icon"
                        src="/assets/images/ai-delete-red.png"
                        mode="aspectFit"
                      ></image>
                      <text>删除</text>
                    </view>
                  </view>
                </block>
              </view>

              <!-- 回复正文放在**图片下方**（2026-08-07 需求）：SSE 里 text 事件本来就排在 image
                   之后，先出图、文字再往下续，比原来「文字在上、图从下面顶出来」更贴事件顺序。
                   ⚠️ {{item.content}} 必须紧贴标签写、不能换行缩进：<text> 组件内的空白会原样渲染，
                   换行写就等于给正文顶部平白加一个空行（2026-08-07 修）。 -->
              <text wx:if="{{item.content}}" class="bubble-text" user-select catchlongpress="noop">{{item.content}}<text wx:if="{{item.typing}}" class="caret">▍</text></text>
            </block>
          </view>

          <!-- 长按分区（2026-08-10 需求 2）：正文 <text> 自己 catchlongpress 吃掉长按 —— 长按文字
               只走系统选字/复制；长按气泡内边距、边缘等空白处才冒泡到 .bubble 上弹删除确认框。
               两种交互从此不再重叠，也不再用 wx.showActionSheet（样式与其它页面的弹框统一）。 -->
          <view
            wx:elif="{{item.kind === 'text'}}"
            class="bubble bubble--user"
            bindlongpress="onBubbleLongPress"
            data-id="{{item.id}}"
          >
            <text class="bubble-text" user-select catchlongpress="noop">{{item.content}}</text>
          </view>

          <view
            wx:else
            class="bubble bubble--image"
            bindlongpress="onBubbleLongPress"
            data-id="{{item.id}}"
          >
            <view
              class="img-box"
              style="padding-bottom: {{item.images[0].pad}}%"
              catchtap="onImageTap"
              catchlongpress="noop"
              data-url="{{item.images[0].url}}"
              data-id="{{item.id}}"
              data-index="0"
            >
              <image
                class="img-el"
                src="{{item.images[0].url}}"
                mode="aspectFill"
                lazy-load
                bindload="onImageLoad"
                data-id="{{item.id}}"
                data-index="0"
              ></image>
            </view>

            <!-- 用户自己发的图同样常驻三颗按钮：长按菜单撤掉后，这里是「投屏/下载」仅剩的入口 -->
            <view class="image-actions image-actions--user" catchtap="noop" catchlongpress="noop">
              <view
                class="image-action"
                data-action="download"
                data-url="{{item.images[0].url}}"
                data-id="{{item.id}}"
                data-index="0"
                bindtap="onImageActionTap"
              >
                <image
                  class="image-action__icon"
                  src="/assets/images/ai-download.png"
                  mode="aspectFit"
                ></image>
                <text>下载</text>
              </view>
              <view class="image-actions__divider"></view>
              <view
                class="image-action"
                data-action="project"
                data-url="{{item.images[0].url}}"
                data-id="{{item.id}}"
                data-index="0"
                bindtap="onImageActionTap"
              >
                <image
                  class="image-action__icon"
                  src="/assets/images/ai-project.png"
                  mode="aspectFit"
                ></image>
                <text>投屏</text>
              </view>
              <view class="image-actions__divider"></view>
              <view
                class="image-action image-action--danger"
                data-action="delete"
                data-url="{{item.images[0].url}}"
                data-id="{{item.id}}"
                data-index="0"
                bindtap="onImageActionTap"
              >
                <image
                  class="image-action__icon"
                  src="/assets/images/ai-delete-red.png"
                  mode="aspectFit"
                ></image>
                <text>删除</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view class="bottom-anchor {{sending ? 'bottom-anchor--sending' : ''}}"></view>
    </scroll-view>

    <view wx:if="{{historyLoading || !chatReady}}" class="page-loading chat-loading">
      <view class="page-loading__spinner"></view>
      <view class="page-loading__text">加载中…</view>
    </view>
  </view>

  <view wx:if="{{banned}}" class="banned-bar">账号已被限制，暂时无法使用 AI 对话</view>

  <view class="input-area">
    <!-- 停止生成：贴着输入框上沿悬浮（定位锚在 .input-area 上，输入框长高了也自动跟着走，
         不再靠写死的 bottom 值猜高度）。生图时占位盒底部正好压到输入框，这颗药丸就悬浮在
         盒子偏下的位置（2026-08-07 需求 1）。 -->
    <view wx:if="{{sending}}" class="stop-pill" catchtap="onStopTap">
      <view class="stop-square"></view>
      <text>停止生成</text>
    </view>

    <scroll-view wx:if="{{pendingImages.length}}" class="pending-strip" scroll-x>
      <view wx:for="{{pendingImages}}" wx:key="id" class="pending-thumb">
        <image
          class="pending-thumb__img"
          src="{{item.url || item.tempFilePath}}"
          mode="aspectFill"
        ></image>
        <view wx:if="{{item.uploading}}" class="pending-thumb__mask">
          <view class="pending-thumb__spin"></view>
        </view>
        <view
          class="pending-thumb__del"
          catchtap="removePendingImage"
          data-index="{{index}}"
        >×</view>
      </view>
    </scroll-view>

    <view class="quick-tools">
      <view class="quick-tool" hover-class="quick-tool--pressed" bindtap="chooseAlbum">
        <image
          class="quick-tool__icon"
          src="/assets/images/ai-album-outline.png"
          mode="aspectFit"
        ></image>
        <text>相册</text>
      </view>
      <view class="quick-tool" hover-class="quick-tool--pressed" bindtap="chooseCamera">
        <image
          class="quick-tool__icon"
          src="/assets/images/ai-camera-outline.png"
          mode="aspectFit"
        ></image>
        <text>拍照</text>
      </view>
      <view
        class="orientation-button {{showOrientationPicker ? 'orientation-button--active' : ''}}"
        hover-class="quick-tool--pressed"
        bindtap="toggleOrientationPicker"
      >
        <image
          class="orientation-button__icon"
          src="/assets/images/ai-orientation-{{orientation}}-active.png"
          mode="aspectFit"
        ></image>
        <text>{{orientationLabel}}</text>
        <!-- 箭头/关闭都用等大的方图，切换时按钮里内容宽度不变，也不会像字符 ›/× 那样偏上偏左 -->
        <image
          class="orientation-button__tail"
          src="{{showOrientationPicker ? '/assets/images/ai-close-orange.png' : '/assets/images/ai-chevron-right.png'}}"
          mode="aspectFit"
        ></image>
      </view>
      <view
        class="generate-button {{showStylePicker ? 'generate-button--active' : ''}}"
        hover-class="quick-tool--pressed"
        bindtap="openStylePicker"
      >
        <view class="generate-button__icon">
          <image
            class="generate-button__icon-img {{showStylePicker ? 'generate-button__icon-img--close' : ''}}"
            src="{{showStylePicker ? '/assets/images/ai-close-orange.png' : '/assets/images/ai-magic-white.png'}}"
            mode="aspectFit"
          ></image>
        </view>
        <text>一键生图</text>
      </view>
    </view>

    <view class="input-line">
      <view
        wx:if="{{!voiceMode}}"
        class="input-wrap"
        bindtouchstart="onInputTouchStart"
        bindtouchmove="onInputTouchMove"
        bindtouchend="onInputTouchEnd"
        bindtouchcancel="onInputTouchEnd"
      >
        <input
          class="chat-input"
          value="{{inputValue}}"
          placeholder="{{banned ? '账号已被限制' : (pendingImages.length ? '描述您想对图片做什么…' : '按住说话或输入您的想法...')}}"
          disabled="{{banned || recording}}"
          confirm-type="send"
          bindinput="onInput"
          bindfocus="closeTools"
          bindconfirm="onSendTap"
        />
      </view>

      <view
        wx:else
        class="voice-hold {{recording ? 'voice-hold--recording' : ''}}"
        bindtouchstart="onVoiceStart"
        bindtouchmove="onVoiceMove"
        bindtouchend="onVoiceEnd"
        bindtouchcancel="onVoiceEnd"
      >{{recording ? (voiceCancel ? '松开取消' : '松开发送') : '按住 说话'}}</view>

      <!-- 右侧那一颗按钮的三态（2026-08-10 需求 4）。三态**同一个盒子、同一张图的尺寸位置**，
           切换时不位移：
             · 语音模式  → 点它切回键盘，画 ai-send-active（原先是灰底「键」字占位块，UI 没同步）；
             · 有草稿    → 发送；
             · 空输入框  → 麦克风，点它进语音模式。 -->
      <view
        wx:if="{{voiceMode}}"
        class="send-image-button"
        hover-class="quick-tool--pressed"
        bindtap="toggleVoice"
      >
        <image
          class="send-image-button__icon"
          src="/assets/images/ai-send-active.png"
          mode="aspectFit"
        ></image>
      </view>
      <view
        wx:elif="{{inputValue}}"
        class="send-image-button {{sending || submitting || banned ? 'send-image-button--disabled' : ''}}"
        hover-class="quick-tool--pressed"
        bindtap="onSendTap"
      >
        <image
          class="send-image-button__icon"
          src="/assets/images/ai-send-active.png"
          mode="aspectFit"
        ></image>
      </view>
      <view
        wx:else
        class="voice-switch"
        hover-class="quick-tool--pressed"
        bindtap="toggleVoice"
      >
        <image
          class="voice-placeholder__image"
          src="/assets/images/ai-microphone.png"
          mode="aspectFit"
        ></image>
      </view>
    </view>

    <view wx:if="{{showOrientationPicker}}" class="tool-popover orientation-popover" catchtap="noop">
      <view class="orientation-popover__title">设置文生图比例</view>
      <view
        wx:for="{{orientationOptions}}"
        wx:key="key"
        class="orientation-option {{orientation === item.key ? 'orientation-option--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onOrientationTap"
      >
        <image
          class="orientation-option__image"
          src="{{orientation === item.key ? item.activeIcon : item.icon}}"
          mode="aspectFit"
        ></image>
        <text>{{item.label}}</text>
        <image
          wx:if="{{orientation === item.key}}"
          class="orientation-check"
          src="/assets/images/ai-check-orange.png"
          mode="aspectFit"
        ></image>
      </view>
    </view>

    <view wx:if="{{showStylePicker}}" class="tool-popover style-popover" catchtap="noop">
      <view class="style-popover__header">
        <view class="style-popover__mark">
          <image src="/assets/images/ai-generate.png" mode="aspectFit"></image>
        </view>
        <view>
          <view class="style-popover__title">一键生图</view>
          <view class="style-popover__desc">选择后立即发送</view>
        </view>
      </view>
      <view
        wx:for="{{styleOptions}}"
        wx:key="key"
        class="style-option"
        data-key="{{item.key}}"
        bindtap="onStyleTap"
      >
        <view class="style-option__dot"></view>
        <text>{{item.label}}</text>
        <image
          class="style-option__arrow"
          src="/assets/images/ai-send-outline.png"
          mode="aspectFit"
        ></image>
      </view>
    </view>

    <view wx:if="{{recording}}" class="voice-cover {{voiceCancel ? 'voice-cover--cancel' : ''}}">
      <view class="voice-wave">
        <view class="voice-wave__bar"></view>
        <view class="voice-wave__bar"></view>
        <view class="voice-wave__bar"></view>
        <view class="voice-wave__bar"></view>
        <view class="voice-wave__bar"></view>
        <view class="voice-wave__bar"></view>
        <view class="voice-wave__bar"></view>
      </view>
      <view class="voice-tip">{{voiceCancel ? '松开手指，取消发送' : '上滑取消 · 松开直接发送'}}</view>
      <view wx:if="{{!speechReady}}" class="voice-tip voice-tip--warn">未开通语音转文字插件</view>
    </view>
  </view>

  <!-- 底部 tabbar 已移除（2026-08-10 需求 5）：从 tabbar 进 AI 后就是「沉浸在 AI 助手里」，
       底栏留着既遮挡对话又和顶部返回键功能重复；腾出来的 166rpx 由 .ai-root 的下内边距一并收掉，
       输入卡片顺势下移贴到安全区。返回上一个 tab 走顶部返回键（goBack）。 -->

  <!-- 删除消息确认框（2026-08-10 需求 2）：与「我的相册」删除弹窗同一套版式，
       替换原来的 wx.showActionSheet（原生面板样式和全站弹框对不上）。 -->
  <view
    wx:if="{{deleteDialog.show}}"
    class="confirm-mask"
    catchtouchmove="noop"
    bindtap="closeDeleteDialog"
  >
    <view class="confirm-dialog" catchtap="noop">
      <view class="confirm-icon">
        <image
          class="confirm-icon__image"
          src="/assets/images/ai-delete-red.png"
          mode="aspectFit"
        ></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">{{deleteDialog.title}}</view>
        <view class="confirm-desc">{{deleteDialog.desc}}</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="closeDeleteDialog">取消</view>
        <view class="confirm-primary" hover-class="none" bindtap="confirmDeleteMessage">确认</view>
      </view>
    </view>
  </view>

  <!-- 星币不足（2026-08-12 需求 1）：与上面的删除确认框**同一套自绘版式**
       （图标 + 标题/说明 + 取消/确认两颗按钮）。原来这里是 wx.showModal，
       原生弹框的圆角、字号、按钮排布与全站都对不上，一眼就看得出是两拨人做的。
       文案由 showTokenShortModal 拼（数字取自后端 chkAiDialogue 的 retMsg）。 -->
  <view
    wx:if="{{tokenDialog.show}}"
    class="confirm-mask"
    catchtouchmove="noop"
    bindtap="closeTokenDialog"
  >
    <view class="confirm-dialog" catchtap="noop">
      <view class="confirm-icon">
        <image
          class="confirm-icon__image"
          src="/assets/images/ai-token-spark.png"
          mode="aspectFit"
        ></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">星币不足</view>
        <view class="confirm-desc">{{tokenDialog.desc}}</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="closeTokenDialog">知道了</view>
        <view class="confirm-primary" hover-class="none" bindtap="goBuyTokens">去购买</view>
      </view>
    </view>
  </view>

  <!-- 未绑定电子纸设备（2026-08-12 需求 2）：同上，与全站弹框同一套自绘版式。
       ⚠️ 这里的遮罩**不绑关闭**：两颗按钮是「去绑定 / 返回」的二选一，
       点空白处溜走只会把用户留在一个投不了屏的页面上，还以为是自己点错了。 -->
  <view wx:if="{{bindDialog.show}}" class="confirm-mask" catchtouchmove="noop" catchtap="noop">
    <view class="confirm-dialog" catchtap="noop">
      <view class="confirm-icon">
        <image
          class="confirm-icon__image"
          src="/assets/images/ai-project.png"
          mode="aspectFit"
        ></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">未绑定设备</view>
        <view class="confirm-desc">使用 AI 创作前请先绑定电子纸设备</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="onBindDialogBack">返回</view>
        <view class="confirm-primary" hover-class="none" bindtap="goBindDevice">去绑定</view>
      </view>
    </view>
  </view>

  <!-- 选择投屏设备（2026-08-13 需求 2）：整块换成公共组件 device-picker-sheet，
       与图片详情页同一份实现（列表版式照搬搜索设备页、不默认选中、按钮才连接）。 -->
  <device-picker-sheet
    show="{{devicePicker.show}}"
    loading="{{devicePicker.loading}}"
    devices="{{devicePicker.devices}}"
    bind:confirm="onDevicePickerConfirm"
    bind:cancel="closeDevicePicker"
  ></device-picker-sheet>

  <view wx:if="{{consentDialogVisible}}" class="consent-mask" catchtouchmove="noop">
    <view class="consent-dialog" catchtap="noop">
      <view class="consent-dialog__title">{{consentDialogTitle}}</view>
      <view class="consent-dialog__content">
        <view class="consent-dialog__paragraph">{{consentServiceDescription}}</view>
        <view class="consent-dialog__paragraph">{{consentDataNotice}}</view>
        <!-- 境外传输告知（2026-08-13）：AI 网关在新加坡，内容出境必须单独告知；
             细则在隐私政策第八节，这里只指路，不复述整节法律文本 -->
        <view class="consent-dialog__paragraph">{{consentCrossBorderNotice}}</view>
      </view>
      <view class="consent-dialog__actions">
        <view
          class="consent-dialog__button consent-dialog__button--cancel"
          hover-class="none"
          bindtap="onConsentDisagree"
        >不同意</view>
        <view
          class="consent-dialog__button consent-dialog__button--confirm"
          hover-class="none"
          bindtap="onConsentAgree"
        >同意</view>
      </view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
