.ai-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(166rpx + var(--safe-bottom));
  overflow: hidden;
  color: #292929;
  background: #f7f5f0;
  box-sizing: border-box;
}

/* ==================== 顶部导航 ==================== */
.ai-header {
  flex: 0 0 auto;
  padding-top: var(--status-bar);
}

.ai-header__row {
  display: grid;
  grid-template-columns: 190rpx minmax(0, 1fr) 190rpx;
  align-items: center;
  height: 112rpx;
  padding: 0 40rpx;
}

.history-button {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 9rpx;
  width: 66rpx;
  height: 66rpx;
  padding: 0 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 10rpx 28rpx rgba(83, 73, 60, 0.08);
}

.history-button__line {
  width: 32rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #5c5c5c;
}

.history-button__line:nth-child(2) {
  width: 25rpx;
}

.header-button--pressed,
.quick-tool--pressed {
  opacity: 0.68;
}

.ai-header__title {
  overflow: hidden;
  color: #111111;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.token-pill {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 7rpx;
  min-width: 176rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 10rpx 28rpx rgba(83, 73, 60, 0.08);
}

.token-pill__icon {
  width: 25rpx;
  height: 25rpx;
}

.token-pill__value {
  color: #ff6f25;
  font-size: 28rpx;
  font-weight: 600;
}

.token-pill__unit {
  color: #777777;
  font-size: 22rpx;
}

/* ==================== 聊天区 ==================== */
.chat-wrap {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.chat-scroll--warming {
  opacity: 0;
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
  background: transparent;
}

.chat-loading {
  position: absolute;
  inset: 0;
  min-height: 0;
  background: #f7f5f0;
}

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 36rpx 0;
  text-align: center;
}

.welcome-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ff8b48, #ff6425);
  box-shadow: 0 18rpx 34rpx rgba(255, 104, 39, 0.24);
}

.welcome-mark image {
  width: 46rpx;
  height: 46rpx;
}

.welcome-title {
  margin-top: 32rpx;
  color: #2e2e2e;
  font-size: 36rpx;
  font-weight: 600;
}

.welcome-text {
  margin-top: 14rpx;
  color: #777777;
  font-size: 27rpx;
  line-height: 1.6;
}

.welcome-tip {
  margin-top: 28rpx;
  padding: 13rpx 24rpx;
  border-radius: 999rpx;
  color: #ef6b2a;
  background: rgba(255, 118, 46, 0.09);
  font-size: 23rpx;
}

.message-time {
  margin: 26rpx 0 18rpx;
  color: #aaa6a1;
  font-size: 25rpx;
  text-align: center;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 0;
}

.msg-row--user {
  flex-direction: row-reverse;
}

.bubble {
  max-width: 560rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  font-size: 29rpx;
  line-height: 1.55;
  word-break: break-all;
  box-sizing: border-box;
}

.bubble-text {
  display: block;
}

.bubble--ai {
  color: #555555;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 30rpx rgba(89, 76, 58, 0.07);
}

.bubble--ai.bubble--loading {
  width: auto;
  padding: 0;
  overflow: visible;
  background: transparent;
  box-shadow: none;
}

.loading-bubble {
  display: block;
  width: 142rpx;
}

.bubble--user {
  color: #555555;
  background: #ffddc8;
  border-top-right-radius: 10rpx;
}

.bubble--image {
  width: 430rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 30rpx rgba(89, 76, 58, 0.07);
}

.bubble-imgs {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bubble-text + .bubble-imgs {
  margin-top: 18rpx;
}

.img-box {
  position: relative;
  width: 400rpx;
  max-width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: 22rpx;
  background: #eee9e2;
}

.bubble-imgs .img-box {
  width: 510rpx;
}

.img-el {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.caret {
  color: #ef641e;
  animation: blink 0.8s infinite;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

.image-actions {
  display: flex;
  align-items: center;
  align-self: flex-start;
  height: 76rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(74, 62, 46, 0.12);
}

.image-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 100%;
  padding: 0 14rpx;
  color: #2f2f2f;
  font-size: 25rpx;
}

.image-action--danger {
  color: #ef4545;
}

.image-actions__divider {
  width: 2rpx;
  height: 34rpx;
  background: #dedbd7;
}

/* 视觉稿尚未提供下载/投屏/删除图标，按约定保留小色块占位。 */
.action-placeholder {
  width: 23rpx;
  height: 23rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}

.action-placeholder--download {
  border-top-color: transparent;
}

.action-placeholder--project {
  border-radius: 3rpx;
}

.action-placeholder--delete {
  border-radius: 50%;
}

.bottom-anchor {
  height: 26rpx;
}

.bottom-anchor--sending {
  height: 150rpx;
}

/* ==================== 失败卡片 ==================== */
.bubble--ai.bubble--failed {
  position: relative;
  width: 520rpx;
  max-width: 520rpx;
  padding: 10rpx;
  overflow: visible;
}

.failure-card__delete {
  position: absolute;
  top: -54rpx;
  right: -18rpx;
  z-index: 2;
  padding: 15rpx 24rpx;
  border-radius: 22rpx;
  color: #ef4545;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(74, 62, 46, 0.1);
  font-size: 24rpx;
}

.failure-card__visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  padding: 38rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.78), transparent 230rpx),
    linear-gradient(180deg, #fff0e7 0%, #f5eee8 100%);
}

.failure-card__title {
  color: #2b2b2b;
  font-size: 34rpx;
  font-weight: 600;
}

.failure-card__desc {
  margin-top: 16rpx;
  color: #85817d;
  font-size: 25rpx;
  text-align: center;
}

.failure-card__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-width: 260rpx;
  height: 72rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ed8a69, #ed744f);
  box-shadow: 0 14rpx 26rpx rgba(226, 111, 75, 0.22);
  font-size: 27rpx;
  font-weight: 500;
}

.retry-placeholder {
  font-size: 39rpx;
  line-height: 1;
}

/* ==================== 输入区 ==================== */
.stop-pill {
  position: fixed;
  left: 50%;
  bottom: calc(450rpx + var(--safe-bottom));
  z-index: 14;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 13rpx 28rpx;
  border-radius: 999rpx;
  color: #555555;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 28rpx rgba(74, 62, 46, 0.12);
  font-size: 25rpx;
  transform: translateX(-50%);
}

.stop-square {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: #ef641e;
}

.banned-bar {
  flex: 0 0 auto;
  margin: 0 32rpx 12rpx;
  padding: 11rpx 20rpx;
  border-radius: 16rpx;
  color: #d64541;
  background: #fdecec;
  font-size: 23rpx;
  text-align: center;
}

.input-area {
  position: relative;
  z-index: 12;
  flex: 0 0 auto;
  margin: 8rpx 32rpx 18rpx;
  padding: 20rpx 20rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 20rpx 44rpx rgba(91, 72, 45, 0.16);
}

.pending-strip {
  width: 100%;
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.pending-thumb {
  position: relative;
  display: inline-block;
  width: 100rpx;
  height: 100rpx;
  margin-right: 14rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #eee9e2;
  vertical-align: top;
}

.pending-thumb__img {
  width: 100%;
  height: 100%;
}

.pending-thumb__mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 20, 30, 0.42);
}

.pending-thumb__spin {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: pending-spin 0.8s linear infinite;
}

@keyframes pending-spin {
  to {
    transform: rotate(360deg);
  }
}

.pending-thumb__del {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #ffffff;
  background: rgba(15, 20, 30, 0.55);
  border-bottom-left-radius: 14rpx;
  font-size: 23rpx;
}

.quick-tools {
  display: grid;
  grid-template-columns: 1fr 1fr 1.35fr 1.75fr;
  align-items: center;
  gap: 8rpx;
}

.quick-tool,
.orientation-button,
.generate-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  min-width: 0;
  height: 58rpx;
  border-radius: 999rpx;
  color: #6f6f6f;
  font-size: 25rpx;
  white-space: nowrap;
}

.quick-tool__icon {
  width: 27rpx;
  height: 27rpx;
}

.orientation-button {
  border: 2rpx solid transparent;
}

.orientation-button--active {
  color: #f26724;
  border-color: #f5a77e;
  background: #fff4ed;
}

.orientation-button__icon {
  width: 27rpx;
  height: 27rpx;
  opacity: 0.75;
}

.orientation-button__tail {
  color: inherit;
  font-size: 34rpx;
  line-height: 1;
}

.generate-button {
  color: #ffffff;
  background: linear-gradient(90deg, #ff5f24, #ff884a);
  box-shadow: 0 10rpx 22rpx rgba(255, 104, 39, 0.22);
  font-weight: 500;
}

.generate-button--active {
  color: #f26724;
  border: 2rpx solid #f26724;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: none;
}

.generate-button__icon {
  width: 29rpx;
  height: 29rpx;
}

.input-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 82rpx;
  margin-top: 12rpx;
  padding: 0 4rpx 0 22rpx;
  border-top: 1rpx solid rgba(92, 81, 68, 0.06);
}

.input-wrap,
.voice-hold {
  flex: 1;
  min-width: 0;
}

.chat-input {
  width: 100%;
  height: 78rpx;
  color: #3a3a3a;
  background: transparent;
  font-size: 30rpx;
}

.voice-hold {
  height: 68rpx;
  border-radius: 999rpx;
  color: #555555;
  background: #f2eee9;
  font-size: 28rpx;
  line-height: 68rpx;
  text-align: center;
}

.voice-hold--recording {
  color: #ffffff;
  background: linear-gradient(90deg, #ff6c2a, #ff884a);
}

.send-image-button,
.voice-switch {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
}

.send-image-button image {
  width: 70rpx;
  height: 70rpx;
}

.send-image-button--disabled {
  opacity: 0.42;
}

.voice-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 15rpx;
  color: #ffffff;
  background: #7c7c7c;
  font-size: 20rpx;
}

/* 方向/风格缺少完整图标资源，菜单内未提供的方向仍按约定以描边色块占位。 */
.tool-popover {
  position: absolute;
  bottom: calc(100% + 18rpx);
  z-index: 18;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 42rpx rgba(77, 62, 43, 0.18);
}

.orientation-popover {
  left: 252rpx;
  width: 250rpx;
  padding: 12rpx;
}

.orientation-option {
  display: grid;
  grid-template-columns: 34rpx 1fr 26rpx;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  color: #303030;
  font-size: 28rpx;
}

.orientation-option--active {
  color: #f26724;
  background: #fff0e7;
}

.orientation-option__image {
  width: 28rpx;
  height: 28rpx;
}

.orientation-placeholder {
  justify-self: center;
  width: 27rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.orientation-placeholder--square {
  width: 22rpx;
  height: 22rpx;
}

.orientation-check {
  width: 15rpx;
  height: 8rpx;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(-45deg);
}

.style-popover {
  right: 0;
  width: 310rpx;
  padding: 22rpx 24rpx;
}

.style-popover__header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.style-popover__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #ff6d2c;
}

.style-popover__mark image {
  width: 30rpx;
  height: 30rpx;
}

.style-popover__title {
  color: #2c2c2c;
  font-size: 29rpx;
  font-weight: 600;
}

.style-popover__desc {
  margin-top: 2rpx;
  color: #9b9691;
  font-size: 20rpx;
}

.style-option {
  display: grid;
  grid-template-columns: 18rpx 1fr 18rpx;
  align-items: center;
  gap: 14rpx;
  height: 64rpx;
  color: #303030;
  font-size: 27rpx;
}

.style-option__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff7840;
}

.style-option__arrow {
  width: 13rpx;
  height: 13rpx;
  border-top: 3rpx solid #aaa6a1;
  border-right: 3rpx solid #aaa6a1;
  transform: rotate(45deg);
}

/* ==================== 录音动效 ==================== */
.voice-cover {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  padding: 20rpx 32rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.98);
  pointer-events: none;
}

.voice-cover--cancel {
  background: #fdecec;
}

.voice-wave {
  display: flex;
  align-items: center;
  gap: 9rpx;
  height: 52rpx;
}

.voice-wave__bar {
  width: 8rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ef641e;
  animation: voiceWave 0.9s ease-in-out infinite;
}

.voice-cover--cancel .voice-wave__bar {
  background: #d64541;
}

.voice-wave__bar:nth-child(2) { animation-delay: 0.12s; }
.voice-wave__bar:nth-child(3) { animation-delay: 0.24s; }
.voice-wave__bar:nth-child(4) { animation-delay: 0.36s; }
.voice-wave__bar:nth-child(5) { animation-delay: 0.48s; }
.voice-wave__bar:nth-child(6) { animation-delay: 0.6s; }
.voice-wave__bar:nth-child(7) { animation-delay: 0.72s; }

@keyframes voiceWave {
  0%,
  100% {
    height: 20rpx;
  }
  50% {
    height: 50rpx;
  }
}

.voice-tip {
  color: #8b8681;
  font-size: 24rpx;
  text-align: center;
}

.voice-cover--cancel .voice-tip {
  color: #d64541;
}

.voice-tip--warn {
  color: #eb8f1b;
  font-size: 21rpx;
}

/* ==================== 投屏设备选择 ==================== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(30, 29, 27, 0.42);
}

.device-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 32rpx 48rpx calc(26rpx + var(--safe-bottom));
  border-top-left-radius: 42rpx;
  border-top-right-radius: 42rpx;
  background: #f8f6f1;
  box-shadow: 0 -14rpx 40rpx rgba(50, 43, 34, 0.12);
  animation: device-sheet-in 0.28s ease-out;
}

@keyframes device-sheet-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.device-sheet__title {
  color: #252525;
  font-size: 38rpx;
  font-weight: 600;
  text-align: center;
}

.device-sheet__desc {
  margin-top: 10rpx;
  color: #8d8984;
  font-size: 25rpx;
  text-align: center;
}

.device-sheet__divider {
  height: 2rpx;
  margin: 25rpx 0 20rpx;
  background: #dfdbd5;
}

.sheet-loading {
  min-height: 260rpx;
  padding: 44rpx 0;
}

.device-list {
  max-height: 560rpx;
}

.device-item {
  display: grid;
  grid-template-columns: 88rpx 1fr 48rpx;
  align-items: center;
  gap: 22rpx;
  min-height: 120rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
}

.device-item--selected {
  border-color: #df7654;
  background: #fff8f4;
}

.device-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  color: #ff6e28;
  background: #fff0e9;
  font-size: 23rpx;
}

.device-placeholder--1 {
  color: #2dad6f;
  background: #eaf8f0;
}

.device-placeholder--2 {
  color: #5794ef;
  background: #eaf2ff;
}

.device-name {
  overflow: hidden;
  color: #2c2c2c;
  font-size: 30rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #c5c2be;
  border-radius: 50%;
}

.device-radio--selected {
  border-color: #e87c5a;
  background: #e87c5a;
}

.device-radio__check {
  width: 18rpx;
  height: 10rpx;
  border-bottom: 5rpx solid #ffffff;
  border-left: 5rpx solid #ffffff;
  transform: rotate(-45deg);
}

.device-sheet__cancel {
  height: 84rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  color: #272727;
  background: #eeeae5;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 84rpx;
  text-align: center;
}

/* ==================== AI 服务协议确认框 ==================== */
.consent-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(27, 31, 38, 0.5);
}

.consent-dialog {
  width: 100%;
  max-width: 654rpx;
  padding: 44rpx 40rpx 36rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(20, 28, 42, 0.2);
  animation: consent-dialog-in 0.2s ease-out;
}

.consent-dialog__title {
  color: #25282d;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.consent-dialog__content {
  margin-top: 28rpx;
  color: #636a74;
  font-size: 26rpx;
  line-height: 1.65;
  text-align: left;
}

.consent-dialog__paragraph + .consent-dialog__paragraph {
  margin-top: 20rpx;
}

.consent-dialog__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 40rpx;
}

.consent-dialog__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.consent-dialog__button--cancel {
  color: #32363c;
  background: #eeeeee;
}

.consent-dialog__button--confirm {
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140, #ff6a20);
}

@keyframes consent-dialog-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
