/* AI 对话页。UI 未出图：所有图标先用 icon-block 色块占位，换图时把 icon-block 替换为 <image> 即可 */
.ai-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f2f5fc;
  box-sizing: border-box;
}

/* ==================== 色块占位图标 ==================== */
.icon-block {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.icon-block--orange {
  background: linear-gradient(135deg, #ff8a3c, #eb5f1b);
}

.icon-block--blue {
  background: linear-gradient(135deg, #5b8cff, #3a66e0);
}

.icon-block--green {
  background: linear-gradient(135deg, #4cd07d, #2aa85c);
}

.icon-block--purple {
  background: linear-gradient(135deg, #a06bff, #7a3cf0);
}

.icon-block--grey {
  background: #e4e9f2;
  color: #55606e;
}

.icon-block--gold {
  background: linear-gradient(135deg, #ffd35c, #f0a11b);
}

.icon-block--mini {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.icon-block--xl {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 44rpx;
}

/* ==================== 工具行 ==================== */
.ai-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx;
}

.toolbar-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #3d4350;
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.token-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #55606e;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 61, 0.06);
}

/* ==================== 聊天区 ==================== */
/* 外层负责占高 + 给「加载中」当定位父级：spinner 必须盖在 scroll-view 上而不是长在里面，
   否则首屏为了能滚到底就得让内容一直渲染着，两者会上下叠着一起显示。 */
.chat-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  /* 保持和改造前一样的「flex:1 + min-height:0」撑高方式传给 scroll-view，
     别改成 height:100%——百分比高度依赖父级有确定高度，flex 项上不保险。 */
  display: flex;
  flex-direction: column;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 首屏预热：已渲染但透明，等 stickToBottom 定位到底部后再显形（需求 5.1）。
   用 opacity 而非 wx:if/display:none —— 后者没有布局，滚都滚不动。 */
.chat-scroll--warming {
  opacity: 0;
}

/* 隐藏滚动条但保留滚动（2026-07-25 用户要求；2026-07-27 改成不带类名的写法才真正生效）。
   scroll-view 的 show-scrollbar 属性只在 Skyline 渲染器生效，本项目是 WebView 渲染器
   （app.json 未开 skyline），所以只能走 ::-webkit-scrollbar。
   🔴 为什么原来的 `.chat-scroll::-webkit-scrollbar` 没用：WebView 下 scroll-view 编译成
      <wx-scroll-view class="chat-scroll"><div class="wx-scroll-view">…</div></wx-scroll-view>，
      **真正滚动、真正长滚动条的是内层那个 div**，类名挂在外层壳上，所以那条规则打了个空。
      这里写成不带选择器的形式（等价于 *::-webkit-scrollbar），内层壳一起盖住；
      wxss 是页面级的，只影响本页，不会波及别的页面。
   三个属性都写：display 管主流内核，width/height 兜底某些 Android WebView 只认尺寸。
   ⚠️ 只是隐藏滚动条外观，scroll-y / scroll-top 贴底逻辑一概不动，上下滑照常。 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
  background: transparent;
}

/* 盖在聊天区上的「加载中」（含首屏预热那一小段），底下的内容正在悄悄定位到底部。
   position/min-height 覆盖 app.wxss 的 .page-loading（同为单类选择器，页面 wxss 后加载故生效）。 */
.chat-loading {
  position: absolute;
  inset: 0;
  min-height: 0;
  background: #f2f5fc;
}

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 160rpx 40rpx 0;
  text-align: center;
}

.welcome-text {
  font-size: 32rpx;
  color: #1f2733;
  line-height: 1.6;
  font-weight: 500;
}

.welcome-tip {
  font-size: 24rpx;
  color: #8b9098;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin: 24rpx 0;
}

.msg-row--user {
  flex-direction: row-reverse;
}

/* AI 回复不再有头像（需求 6.1），所以 .msg-avatar 整块删除；.welcome 里的那个是空态插画，不受影响 */

.bubble {
  /* 用户气泡沿用原来的 520rpx 上限（需求 6.3 用户侧维持现状）；AI 气泡在下面改成铺满 */
  max-width: 520rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-all;
  box-sizing: border-box;
}

.bubble-text {
  display: block;
}

/* AI 回复气泡按宽度铺满（需求 6.2）：左右各留 32rpx 是 .chat-scroll 的页边距，
   气泡本身在这条内容栏里 100% 撑满。文字和图都在这一个气泡里（需求 3）。 */
.bubble--ai {
  width: 100%;
  max-width: 100%;
  background: #ffffff;
  color: #1f2733;
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 61, 0.05);
}

.bubble--user {
  background: linear-gradient(135deg, #ff8a3c, #eb5f1b);
  color: #ffffff;
  border-top-right-radius: 8rpx;
}

.bubble--image {
  padding: 8rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 61, 0.05);
}

/* 气泡内的图片区：AI 回复里 N 张图竖着排，与上面的文字之间留一点间距 */
.bubble-imgs {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bubble-text + .bubble-imgs {
  margin-top: 16rpx;
}

/* 图片占位盒（需求 1.2/5.2）：高度由 padding-bottom 百分比（＝高/宽×100，行内样式给）**预先占住**，
   所以图片加载完不会把上面的内容顶飞。图绝对定位铺满这个盒子。
   ⚠️ padding-bottom 的百分比是相对**宽度**算的，所以 .img-box 必须有确定宽度（下面写死 400rpx）。 */
.img-box {
  position: relative;
  width: 400rpx;
  max-width: 100%;
  height: 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: #f2f5fc;
}

/* AI 气泡已按屏宽铺满（需求 6.2），里面的图跟着铺满气泡 —— 否则 686rpx 宽的白气泡里摆一张
   400rpx 的图，右侧一大片空白。用户侧图片气泡不受影响，仍是上面的 400rpx（需求 6.3 维持现状）。 */
.bubble-imgs .img-box {
  width: 100%;
}

.img-el {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.caret {
  color: #eb5f1b;
  animation: blink 0.8s infinite;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

/* AI 回复 loading：三点闪烁 */
.dots {
  display: flex;
  gap: 10rpx;
  padding: 8rpx 4rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b4bcc9;
  animation: dot-bounce 1.2s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dot-bounce {
  0%,
  60%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-6rpx);
  }
}

.bottom-anchor {
  height: 24rpx;
}

/* 生成中：给「停止生成」浮标腾出高度。浮标是 fixed 在输入区上方的，不腾这一块，
   正在打出来的最后一两行就被它压住了（需求 2.2 的「底部打字内容会被遮住」）。
   算法：浮标底边距屏底 220rpx，输入区高约 124rpx（都含同一份 safe-bottom，抵消掉），
   即浮标底边高出聊天区底边约 96rpx，浮标自身约 62rpx 高 → 需要 ~160rpx，取 180rpx 留余量。 */
.bottom-anchor--sending {
  height: 180rpx;
}

/* ==================== 停止生成 / 封禁 ==================== */
.stop-pill {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(220rpx + var(--safe-bottom));
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: #3d4350;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 61, 0.12);
  z-index: 10;
}

.stop-square {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: #eb5f1b;
}

.banned-bar {
  background: #fdecec;
  color: #d64541;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 32rpx;
}

/* ==================== 输入区 ==================== */
/* position: relative 是给录音动效层（.voice-cover）当定位父级用的：
   它 absolute inset:0，于是输入区多高就盖多高 —— 工具栏一展开自动跟着变高（需求 4.2）。 */
.input-area {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  box-shadow: 0 -6rpx 24rpx rgba(31, 41, 61, 0.06);
}

/* 待发送图片缩略图条（v1.0.3 图文多模态）：横向可滚动，停在输入行上方 */
.pending-strip {
  white-space: nowrap;
  padding: 16rpx 24rpx 0;
}

.pending-thumb {
  position: relative;
  display: inline-block;
  width: 112rpx;
  height: 112rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f5fc;
  vertical-align: top;
}

.pending-thumb__img {
  width: 100%;
  height: 100%;
}

.pending-thumb__mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 20, 30, 0.42);
}

.pending-thumb__spin {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: pending-spin 0.8s linear infinite;
}

@keyframes pending-spin {
  to { transform: rotate(360deg); }
}

/* 删除按钮：右上角小圆角 ✕（catchtap 阻止冒泡，只删不触发预览等） */
.pending-thumb__del {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(15, 20, 30, 0.55);
  border-bottom-left-radius: 16rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.round-btn {
  flex-shrink: 0;
}

.round-btn .icon-block {
  border-radius: 50%;
}

/* 输入框外层：承接「长按唤起语音」的手势（见 chat.wxml）。
   flex 从 .chat-input 挪到这里，输入框改为撑满外层，视觉尺寸不变。 */
.input-wrap {
  flex: 1;
  min-width: 0;
}

.chat-input {
  width: 100%;
  height: 72rpx;
  background: #f2f5fc;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.voice-hold {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f2f5fc;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #3d4350;
}

.voice-hold--recording {
  background: linear-gradient(135deg, #ff8a3c, #eb5f1b);
  color: #ffffff;
}

/* ==================== 录音动效（参考 deepseek：盖住整个输入区） ==================== */

/* 2026-07-27 需求 4：动效**替换文本输入的位置**（4.1），且工具栏展开时要连工具栏一起盖住（4.2）。
   做法就是 absolute inset:0 长在 .input-area 里 —— 输入区多高它就多高，缩略图条/工具栏一出现
   自动跟着变高，不需要 JS 量任何高度。
   ⚠️ pointer-events:none 必须留着：手指还按在下面的输入框/说话条上，动效层一旦吃掉触摸，
      touchmove/touchend 就收不到 → 永远卡在录音态。
   ⚠️ 这里**不显示识别文字**（需求 4.3），只有波形 + 手势提示。 */
.voice-cover {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(12rpx + var(--safe-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  pointer-events: none;
}

/* 上滑到取消区：整块转红，与文案同步给出「这一松手就丢了」的信号 */
.voice-cover--cancel {
  background: #fdecec;
}

/* 跳动的竖条：纯 CSS 录音动画，不依赖真实音量（getRecorderManager 不给实时分贝）。
   只表示「正在听」，别理解成音量条。 */
.voice-wave {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 56rpx;
}

.voice-wave__bar {
  width: 8rpx;
  height: 20rpx;
  background: #eb5f1b;
  border-radius: 999rpx;
  animation: voiceWave 0.9s ease-in-out infinite;
}

.voice-cover--cancel .voice-wave__bar {
  background: #d64541;
}

.voice-wave__bar:nth-child(2) { animation-delay: 0.12s; }
.voice-wave__bar:nth-child(3) { animation-delay: 0.24s; }
.voice-wave__bar:nth-child(4) { animation-delay: 0.36s; }
.voice-wave__bar:nth-child(5) { animation-delay: 0.48s; }
.voice-wave__bar:nth-child(6) { animation-delay: 0.6s; }
.voice-wave__bar:nth-child(7) { animation-delay: 0.72s; }

@keyframes voiceWave {
  0%, 100% { height: 20rpx; }
  50% { height: 52rpx; }
}

.voice-tip {
  font-size: 26rpx;
  color: #8b9098;
  text-align: center;
}

.voice-cover--cancel .voice-tip {
  color: #d64541;
}

.voice-tip--warn {
  color: #eb8f1b;
  font-size: 22rpx;
}

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #e4e9f2;
  color: #9aa3b0;
  font-size: 28rpx;
}

.send-btn--active {
  background: linear-gradient(135deg, #ff8a3c, #eb5f1b);
  color: #ffffff;
}

.tools-panel {
  border-top: 1rpx solid #f0f2f7;
  padding: 24rpx 32rpx 8rpx;
}

.tools-grid {
  display: flex;
  gap: 56rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #55606e;
}

.tool-item .icon-block {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 36rpx;
}

.ratio-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 16rpx;
}

.ratio-label {
  font-size: 24rpx;
  color: #8b9098;
  margin-right: 8rpx;
}

.ratio-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f2f5fc;
  font-size: 24rpx;
  color: #55606e;
}

.ratio-chip--active {
  background: rgba(235, 95, 27, 0.1);
  color: #eb5f1b;
  font-weight: 500;
}

.input-safe {
  height: calc(12rpx + var(--safe-bottom));
}

/* ==================== 底部弹层（风格选择 / 设备选择） ==================== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 20, 30, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx 32rpx calc(24rpx + var(--safe-bottom));
  box-sizing: border-box;
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2733;
  margin-bottom: 32rpx;
}

.sheet-loading {
  padding: 40rpx 0;
}

.style-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.style-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #3d4350;
}

.device-list {
  max-height: 480rpx;
}

.device-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f0f2f7;
}

.device-copy {
  flex: 1;
  min-width: 0;
}

.device-name {
  font-size: 28rpx;
  color: #1f2733;
}

.device-desc {
  font-size: 22rpx;
  color: #8b9098;
  margin-top: 4rpx;
}

.sheet-cancel {
  margin-top: 16rpx;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: #f2f5fc;
  color: #55606e;
  font-size: 28rpx;
}

/* ==================== AI 服务协议确认框 ==================== */
.consent-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(27, 31, 38, 0.5);
}

.consent-dialog {
  width: 100%;
  max-width: 654rpx;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(20, 28, 42, 0.2);
  animation: consent-dialog-in 0.2s ease-out;
}

.consent-dialog__title {
  color: #25282d;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.consent-dialog__content {
  margin-top: 28rpx;
  color: #636a74;
  font-size: 26rpx;
  line-height: 1.65;
  text-align: left;
}

.consent-dialog__paragraph + .consent-dialog__paragraph {
  margin-top: 20rpx;
}

.consent-dialog__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 40rpx;
}

.consent-dialog__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.consent-dialog__button--cancel {
  color: #32363c;
  background: #eeeeee;
}

.consent-dialog__button--confirm {
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140, #ff6a20);
}

@keyframes consent-dialog-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
