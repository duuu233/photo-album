.ai-root {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(166rpx + var(--safe-bottom));
  overflow: hidden;
  color: #292929;
  background: #f8f5ef;
  box-sizing: border-box;
}

.ai-page-background {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* ==================== 顶部导航 ==================== */
.ai-header {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  padding-top: var(--status-bar);
}

.ai-header__row {
  position: relative;
  height: var(--navigation-height);
}

/* 历史记录入口：图标 PNG(136×136) 里「看得见的白色圆角方块」只占 48.5%，四周是透明投影留白，
   所以按 44px 画出来实际只有 ~21px，比右侧胶囊(32px)小一大截 —— 图放到 64px，
   白块才 31px 与胶囊等高；left:4px 让白块左边缘落在 20px = 聊天区左内边距上。
   投影往下糊，白块在画布里偏上 5.15%，所以图再下推 5.15% 自身高度，让白块（而不是图+投影）居中。
   点击盒保持 44px 高，溢出的图 pointer-events:none，免得吃掉聊天区顶部的触摸。
   —— 与 components/page-nav 的返回按钮同款处理，两张图几何完全一致。*/
.history-button {
  position: absolute;
  top: 50%;
  left: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 44px;
  transform: translateY(-50%);
}

.history-button__image {
  flex: 0 0 auto;
  width: 64px;
  height: 64px;
  transform: translateY(5.15%);
  pointer-events: none;
}

.header-button--pressed,
.quick-tool--pressed {
  opacity: 0.68;
}

.ai-header__title {
  position: absolute;
  top: 0;
  right: calc(var(--token-right) + 114px);
  bottom: 0;
  left: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 高度/垂直位置 1:1 取自原生胶囊 getMenuButtonBoundingClientRect()：
   top = 胶囊 top、height = 胶囊 height，两者严格同高同轴。
   之前看着比胶囊「矮一截」是因为底色只有 0.76 太透 + 投影往下糊了 14px，
   这里提高填充、收紧投影，让它读起来就是胶囊那个高度。*/
.token-pill {
  position: absolute;
  top: var(--menu-offset-top);
  right: var(--token-right);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 106px;
  height: var(--menu-height);
  min-height: var(--menu-height);
  padding: 0 9px;
  border: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 14rpx rgba(83, 73, 60, 0.1);
  box-sizing: border-box;
}

.token-pill__icon {
  width: 25rpx;
  height: 25rpx;
}

.token-pill__value {
  color: #ff6f25;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.token-pill__unit {
  color: #777777;
  font-size: 22rpx;
  line-height: 1;
}

/* ==================== 聊天区 ==================== */
.chat-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.chat-scroll--warming {
  opacity: 0;
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
  background: transparent;
}

.chat-loading {
  position: absolute;
  inset: 0;
  min-height: 0;
  background: rgba(248, 245, 239, 0.78);
}

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 84rpx 36rpx 30rpx;
  text-align: center;
}

.welcome-mark {
  width: 210rpx;
  height: 210rpx;
}

.welcome-mark image {
  width: 100%;
  height: 100%;
}

.welcome-title {
  display: flex;
  align-items: center;
  gap: 9rpx;
  margin-top: 14rpx;
  color: #5a5a5a;
  font-size: 34rpx;
  font-weight: 500;
}

.welcome-title image {
  width: 30rpx;
  height: 30rpx;
}

.welcome-text {
  margin-top: 10rpx;
  color: #5f5f5f;
  font-size: 27rpx;
  line-height: 1.5;
}

.welcome-suggestions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  margin-top: 32rpx;
}

.welcome-suggestion {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 56rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  color: #656565;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 26rpx rgba(84, 70, 51, 0.07);
  font-size: 25rpx;
}

.welcome-suggestion image {
  width: 28rpx;
  height: 28rpx;
}

.welcome-suggestion:active {
  transform: scale(0.98);
  opacity: 0.76;
}

.message-time {
  margin: 26rpx 0 18rpx;
  color: #aaa6a1;
  font-size: 25rpx;
  text-align: center;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 0;
}

.msg-row--user {
  flex-direction: row-reverse;
}

.bubble {
  max-width: 560rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  font-size: 29rpx;
  line-height: 1.55;
  word-break: break-all;
  box-sizing: border-box;
}

.bubble-text {
  display: block;
}

.bubble--ai {
  width: 100%;
  max-width: 100%;
  color: #555555;
  /* border: 2rpx solid rgba(255, 255, 255, 0.9); */
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 30rpx rgba(89, 76, 58, 0.08);
}

.bubble--ai.bubble--loading {
  width: auto;
  padding: 0;
  overflow: visible;
  background: transparent;
  box-shadow: none;
}

.loading-bubble {
  display: block;
  width: 142rpx;
}

.bubble--user {
  color: #555555;
  background: #ffe0cd;
  border-top-right-radius: 10rpx;
}

.bubble--image {
  width: 430rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 30rpx rgba(89, 76, 58, 0.07);
}

/* ⚠️ 宽度必须定在这一层，不能定在 .img-box 上。
   .img-box 靠 `padding-bottom: pad%` 占高度，而**百分比 padding 是按父元素宽度算的**，
   不是按自己的宽度。原先 .bubble-imgs 不设宽（撑满气泡内容区 622rpx）、.img-box 定宽 510rpx，
   于是竖图占位高 = 622×133.33% = 829rpx 配 510rpx 宽 → 盒子实际比例 162.6%，比图片(133.33%)高一截，
   aspectFill 为了填满就按高度放大、左右各裁掉 56rpx（图右边看着没显示全，2026-08-06 反馈）。
   父子同宽百分比才算得对：宽度放这儿，.img-box 用 100% 跟着走。
   .bubble--image（用户发的图）本来就是父子同宽，不受影响。*/
.bubble-imgs {
  display: flex;
  flex-direction: column;
  width: 510rpx;
  max-width: 100%;
  gap: 14rpx;
}

.bubble-text + .bubble-imgs {
  margin-top: 18rpx;
}

.img-box {
  position: relative;
  width: 400rpx;
  max-width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: 22rpx;
  background: #eee9e2;
}

.bubble-imgs .img-box {
  width: 100%;
}

/* 用户发的图气泡宽 430rpx、内边距 10rpx → 内容区 410rpx，而 .img-box 默认 400rpx，
   图会靠左、右边多留 10rpx 白边。这里让它铺满内容区，四周留白才对称。*/
.bubble--image .img-box {
  width: 100%;
}

.img-el {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.caret {
  color: #ef641e;
  animation: blink 0.8s infinite;
}

/* —— 流式回复（2026-08-06 SSE）：预描述 + 生成进度条 ——
   两块都长在 AI 气泡内部、正文与图片上方，所以气泡宽度/背景一律沿用 .bubble--ai，
   这里只管自己的内边距与间距，别再各自开一个卡片。*/
.pre-text {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(239, 100, 30, 0.06);
}

.pre-text__icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
}

.pre-text__body {
  flex: 1;
  color: #8a6a52;
  font-size: 26rpx;
  line-height: 1.5;
}

.gen-progress {
  padding: 4rpx 2rpx;
}

.pre-text + .gen-progress,
.pre-text + .bubble-text,
.pre-text + .bubble-imgs,
.gen-progress + .bubble-text,
.gen-progress + .bubble-imgs {
  margin-top: 18rpx;
}

.gen-progress__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.gen-progress__label {
  color: #85817d;
  font-size: 24rpx;
}

.gen-progress__value {
  color: #ef641e;
  font-size: 24rpx;
  font-weight: 600;
}

.gen-progress__track {
  width: 100%;
  height: 10rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: rgba(89, 76, 58, 0.1);
}

/* 服务端推的是 5→45→50→80→85→90→100 这样的台阶值，靠这条过渡抹平成连续增长 */
.gen-progress__bar {
  width: 0;
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #ffb27a, #ef641e);
  transition: width 0.35s ease;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

.image-actions {
  display: flex;
  align-items: center;
  align-self: flex-start;
  height: 76rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(74, 62, 46, 0.12);
}

.image-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 100%;
  padding: 0 14rpx;
  color: #2f2f2f;
  font-size: 25rpx;
}

.image-action__icon {
  width: 25rpx;
  height: 25rpx;
}

.image-action--danger {
  color: #ef4545;
}

.image-actions__divider {
  width: 2rpx;
  height: 34rpx;
  background: #dedbd7;
}

.bottom-anchor {
  height: 26rpx;
}

.bottom-anchor--sending {
  height: 150rpx;
}

/* ==================== 失败卡片 ==================== */
.bubble--ai.bubble--failed {
  position: relative;
  width: 520rpx;
  max-width: 520rpx;
  padding: 10rpx;
  overflow: visible;
}

.failure-card__delete {
  position: absolute;
  top: -54rpx;
  right: -18rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 9rpx;
  padding: 15rpx 24rpx;
  border-radius: 22rpx;
  color: #ef4545;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(74, 62, 46, 0.1);
  font-size: 24rpx;
}

.failure-card__delete image {
  width: 28rpx;
  height: 28rpx;
}

.failure-card__visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  padding: 38rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.78), transparent 230rpx),
    linear-gradient(180deg, #fff0e7 0%, #f5eee8 100%);
}

.failure-card__title {
  color: #2b2b2b;
  font-size: 34rpx;
  font-weight: 600;
}

.failure-card__desc {
  margin-top: 16rpx;
  color: #85817d;
  font-size: 25rpx;
  text-align: center;
}

.failure-card__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-width: 260rpx;
  height: 72rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ed8a69, #ed744f);
  box-shadow: 0 14rpx 26rpx rgba(226, 111, 75, 0.22);
  font-size: 27rpx;
  font-weight: 500;
}

.retry-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  font-size: 36rpx;
  line-height: 1;
}

/* ==================== 输入区 ==================== */
.stop-pill {
  position: fixed;
  left: 50%;
  bottom: calc(450rpx + var(--safe-bottom));
  z-index: 14;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 13rpx 28rpx;
  border-radius: 999rpx;
  color: #555555;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 28rpx rgba(74, 62, 46, 0.12);
  font-size: 25rpx;
  transform: translateX(-50%);
}

.stop-square {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: #ef641e;
}

.banned-bar {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  margin: 0 32rpx 12rpx;
  padding: 11rpx 20rpx;
  border-radius: 16rpx;
  color: #d64541;
  background: #fdecec;
  font-size: 23rpx;
  text-align: center;
}

.input-area {
  position: relative;
  z-index: 12;
  flex: 0 0 auto;
  margin: 8rpx 32rpx 18rpx;
  padding: 18rpx 20rpx 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 20rpx 44rpx rgba(91, 72, 45, 0.16);
}

.pending-strip {
  width: 100%;
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.pending-thumb {
  position: relative;
  display: inline-block;
  width: 100rpx;
  height: 100rpx;
  margin-right: 14rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #eee9e2;
  vertical-align: top;
}

.pending-thumb__img {
  width: 100%;
  height: 100%;
}

.pending-thumb__mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 20, 30, 0.42);
}

.pending-thumb__spin {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: pending-spin 0.8s linear infinite;
}

@keyframes pending-spin {
  to {
    transform: rotate(360deg);
  }
}

.pending-thumb__del {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  color: #ffffff;
  background: rgba(15, 20, 30, 0.55);
  border-bottom-left-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1;
}

.quick-tools {
  display: grid;
  grid-template-columns: 1fr 1fr 1.35fr 1.75fr;
  align-items: center;
  gap: 8rpx;
}

.quick-tool,
.orientation-button,
.generate-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  min-width: 0;
  height: 58rpx;
  border: 2rpx solid rgba(125, 125, 125, 0.18);
  border-radius: 999rpx;
  color: #6f6f6f;
  background: rgba(255, 255, 255, 0.42);
  font-size: 25rpx;
  white-space: nowrap;
}

.quick-tool__icon {
  width: 27rpx;
  height: 27rpx;
}

.orientation-button {
  border-color: rgba(125, 125, 125, 0.18);
}

.orientation-button--active {
  color: #f26724;
  border-color: #f5a77e;
  background: #fff4ed;
}

.orientation-button__icon {
  width: 27rpx;
  height: 27rpx;
  opacity: 0.75;
}

/* 原来是 ›/× 两个字符：字形本身在行盒里偏上、两者字宽还不一样，
   一开合就把按钮里的图标+文字整体顶偏。换成固定 34rpx 的方图，
   两态同盒同大小、图源自身居中 —— 切换时零位移。*/
.orientation-button__tail {
  flex: 0 0 auto;
  width: 22rpx;
  height: 22rpx;
}

.generate-button {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(90deg, #ff5f24, #ff884a);
  box-shadow: 0 10rpx 22rpx rgba(255, 104, 39, 0.22);
  font-weight: 500;
}

.generate-button--active {
  color: #f26724;
  border: 2rpx solid #f26724;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: none;
}

/* 外层固定 36rpx，魔杖/关闭切换不改宽度；× 的图源四周留白多(实际笔画只占 64%)，
   所以关闭态把图放大到 36rpx，才和魔杖看着一样大。*/
.generate-button__icon {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
}

.generate-button__icon-img {
  width: 29rpx;
  height: 29rpx;
}

.generate-button__icon-img--close {
  width: 36rpx;
  height: 36rpx;
}

.input-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 82rpx;
  margin-top: 16rpx;
  /* 右侧是 70rpx 的圆按钮，上下各留 6rpx，右边也给 6rpx 才是四周等距 */
  padding: 0 6rpx 0 24rpx;
  border: 2rpx solid rgba(108, 108, 108, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
}

.input-wrap,
.voice-hold {
  flex: 1;
  min-width: 0;
}

.chat-input {
  width: 100%;
  height: 78rpx;
  color: #3a3a3a;
  background: transparent;
  font-size: 30rpx;
}

.voice-hold {
  height: 68rpx;
  border-radius: 999rpx;
  color: #555555;
  background: #f2eee9;
  font-size: 28rpx;
  line-height: 68rpx;
  text-align: center;
}

.voice-hold--recording {
  color: #ffffff;
  background: linear-gradient(90deg, #ff6c2a, #ff884a);
}

.send-image-button,
.voice-switch {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
}

.send-image-button image {
  width: 70rpx;
  height: 70rpx;
}

.send-image-button--disabled {
  opacity: 0.42;
}

.voice-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 15rpx;
  color: #ffffff;
  background: #7c7c7c;
  font-size: 20rpx;
}

.voice-placeholder--keyboard {
  color: #ffffff;
}

.voice-placeholder__image {
  width: 48rpx;
  height: 48rpx;
}

.tool-popover {
  position: absolute;
  bottom: calc(100% + 18rpx);
  z-index: 18;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 18rpx 42rpx rgba(77, 62, 43, 0.18);
}

/* 居中对齐到方向按钮：quick-tools 是 1fr 1fr 1.35fr 1.75fr + 8rpx 间距，
   算下来第 3 格中心在距 .input-area padding box 左边 360rpx 处，
   弹层宽 250rpx → left = 360 - 125 = 235rpx（原来写 252rpx，整体偏右 17rpx）。*/
.orientation-popover {
  left: 235rpx;
  width: 250rpx;
  padding: 12rpx;
}

.orientation-option {
  display: grid;
  grid-template-columns: 28rpx 1fr 24rpx;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  color: #303030;
  font-size: 28rpx;
}

.orientation-option--active {
  color: #f26724;
  background: #fff0e7;
}

.orientation-option__image {
  width: 28rpx;
  height: 28rpx;
}

.orientation-check {
  width: 24rpx;
  height: 24rpx;
}

/* 右边缘对齐「一键生图」按钮：第 4 格右边缘距 padding box 右侧正好 20rpx（原写 0，多探出 20rpx）*/
.style-popover {
  right: 20rpx;
  width: 310rpx;
  padding: 22rpx 24rpx;
}

.style-popover__header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.style-popover__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
}

.style-popover__mark image {
  width: 54rpx;
  height: 54rpx;
}

.style-popover__title {
  color: #2c2c2c;
  font-size: 29rpx;
  font-weight: 600;
}

.style-popover__desc {
  margin-top: 2rpx;
  color: #9b9691;
  font-size: 20rpx;
}

.style-option {
  display: grid;
  grid-template-columns: 14rpx 1fr 28rpx;
  align-items: center;
  gap: 14rpx;
  height: 64rpx;
  color: #303030;
  font-size: 27rpx;
}

.style-option__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff7840;
}

.style-option__arrow {
  width: 28rpx;
  height: 28rpx;
}

/* ==================== 录音动效 ==================== */
.voice-cover {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  padding: 20rpx 32rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.98);
  pointer-events: none;
}

.voice-cover--cancel {
  background: #fdecec;
}

.voice-wave {
  display: flex;
  align-items: center;
  gap: 9rpx;
  height: 52rpx;
}

.voice-wave__bar {
  width: 8rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ef641e;
  animation: voiceWave 0.9s ease-in-out infinite;
}

.voice-cover--cancel .voice-wave__bar {
  background: #d64541;
}

.voice-wave__bar:nth-child(2) { animation-delay: 0.12s; }
.voice-wave__bar:nth-child(3) { animation-delay: 0.24s; }
.voice-wave__bar:nth-child(4) { animation-delay: 0.36s; }
.voice-wave__bar:nth-child(5) { animation-delay: 0.48s; }
.voice-wave__bar:nth-child(6) { animation-delay: 0.6s; }
.voice-wave__bar:nth-child(7) { animation-delay: 0.72s; }

@keyframes voiceWave {
  0%,
  100% {
    height: 20rpx;
  }
  50% {
    height: 50rpx;
  }
}

.voice-tip {
  color: #8b8681;
  font-size: 24rpx;
  text-align: center;
}

.voice-cover--cancel .voice-tip {
  color: #d64541;
}

.voice-tip--warn {
  color: #eb8f1b;
  font-size: 21rpx;
}

/* ==================== 投屏设备选择 ==================== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(30, 29, 27, 0.42);
}

.device-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 32rpx 48rpx calc(26rpx + var(--safe-bottom));
  border-top-left-radius: 42rpx;
  border-top-right-radius: 42rpx;
  background: rgba(250, 248, 244, 0.98);
  box-shadow: 0 -14rpx 40rpx rgba(50, 43, 34, 0.12);
  animation: device-sheet-in 0.28s ease-out;
}

@keyframes device-sheet-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.device-sheet__title {
  color: #252525;
  font-size: 38rpx;
  font-weight: 600;
  text-align: center;
}

.device-sheet__desc {
  margin-top: 10rpx;
  color: #8d8984;
  font-size: 25rpx;
  text-align: center;
}

.device-sheet__divider {
  height: 2rpx;
  margin: 25rpx 0 20rpx;
  background: #dfdbd5;
}

.sheet-loading {
  min-height: 260rpx;
  padding: 44rpx 0;
}

.device-list {
  max-height: 560rpx;
}

.device-item {
  display: grid;
  grid-template-columns: 88rpx 1fr 48rpx;
  align-items: center;
  gap: 22rpx;
  min-height: 120rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
}

.device-item--selected {
  border-color: #df7654;
  background: #fff8f4;
}

.device-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  color: #ff6e28;
  background: #fff0e9;
  font-size: 23rpx;
}

.device-placeholder--1 {
  color: #2dad6f;
  background: #eaf8f0;
}

.device-placeholder--2 {
  color: #5794ef;
  background: #eaf2ff;
}

.device-name {
  overflow: hidden;
  color: #2c2c2c;
  font-size: 30rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #c5c2be;
  border-radius: 50%;
}

.device-radio--selected {
  border-color: #e87c5a;
  background: #e87c5a;
}

.device-radio__check {
  width: 18rpx;
  height: 10rpx;
  border-bottom: 5rpx solid #ffffff;
  border-left: 5rpx solid #ffffff;
  transform: rotate(-45deg);
}

.device-sheet__cancel {
  height: 84rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  color: #272727;
  background: #eeeae5;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 84rpx;
  text-align: center;
}

/* ==================== AI 服务协议确认框 ==================== */
.consent-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(27, 31, 38, 0.5);
}

.consent-dialog {
  width: 100%;
  max-width: 654rpx;
  padding: 44rpx 40rpx 36rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(20, 28, 42, 0.2);
  animation: consent-dialog-in 0.2s ease-out;
}

.consent-dialog__title {
  color: #25282d;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.consent-dialog__content {
  margin-top: 28rpx;
  color: #636a74;
  font-size: 26rpx;
  line-height: 1.65;
  text-align: left;
}

.consent-dialog__paragraph + .consent-dialog__paragraph {
  margin-top: 20rpx;
}

.consent-dialog__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 40rpx;
}

.consent-dialog__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.consent-dialog__button--cancel {
  color: #32363c;
  background: #eeeeee;
}

.consent-dialog__button--confirm {
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140, #ff6a20);
}

@keyframes consent-dialog-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
