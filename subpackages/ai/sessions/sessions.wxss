/* AI 会话列表页。图标同聊天页用色块占位 */
.sessions-root {
  min-height: 100vh;
  background: #f2f5fc;
  padding-bottom: calc(180rpx + var(--safe-bottom));
  box-sizing: border-box;
}

.icon-block {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.icon-block--purple {
  background: linear-gradient(135deg, #a06bff, #7a3cf0);
}

.icon-block--xl {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 44rpx;
}

.keep-tip {
  padding: 8rpx 32rpx 16rpx;
  font-size: 22rpx;
  color: #9aa3b0;
}

.empty-card {
  margin: 120rpx 48rpx 0;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #1f2733;
  font-weight: 500;
}

.empty-desc {
  font-size: 24rpx;
  color: #8b9098;
}

.session-list {
  padding: 0 32rpx;
}

.session-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 61, 0.04);
}

.session-item--current {
  border: 2rpx solid rgba(235, 95, 27, 0.4);
}

.session-copy {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-size: 28rpx;
  color: #1f2733;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-meta {
  font-size: 22rpx;
  color: #9aa3b0;
  margin-top: 6rpx;
}

.current-tag {
  font-size: 20rpx;
  color: #eb5f1b;
  background: rgba(235, 95, 27, 0.1);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}

.list-more {
  text-align: center;
  font-size: 22rpx;
  color: #b4bcc9;
  padding: 12rpx 0 24rpx;
}

.new-btn {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(40rpx + var(--safe-bottom));
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a3c, #eb5f1b);
  color: #ffffff;
  font-size: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(235, 95, 27, 0.3);
}
