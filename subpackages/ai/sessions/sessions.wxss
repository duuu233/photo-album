.sessions-root {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
  padding-bottom: calc(48rpx + var(--safe-bottom));
  overflow-x: hidden;
  color: #2c2c2c;
  background: #f8f5ef;
  box-sizing: border-box;
}

.ai-page-background {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.keep-tip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 32rpx 40rpx 12rpx;
  color: #8b8b8b;
  font-size: 25rpx;
}

.keep-tip__icon {
  width: 26rpx;
  height: 26rpx;
}

.sessions-loading {
  position: relative;
  z-index: 1;
  min-height: 58vh;
}

.empty-state {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 300rpx 40rpx 0;
  text-align: center;
}

.empty-state__image {
  width: 220rpx;
  height: 220rpx;
}

.empty-state__title {
  margin-top: 36rpx;
  color: #2e2e2e;
  font-size: 38rpx;
  font-weight: 600;
}

.empty-state__desc {
  margin-top: 18rpx;
  color: #929292;
  font-size: 28rpx;
}

.session-list {
  position: relative;
  z-index: 1;
  padding: 0 40rpx;
}

.date-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 26rpx 0 18rpx;
  color: #292929;
  font-size: 30rpx;
  font-weight: 500;
}

.date-title__bar {
  width: 7rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #ff762e;
}

/* 裁掉轨道右侧探出去的删除按钮：没左滑就看不见它。
   代价是卡片那层很淡的投影也被裁掉，接受（0.07 透明度，肉眼几乎无差）。 */
.session-swipe {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.session-track {
  display: flex;
  align-items: stretch;
  width: 100%;
  transform: translate3d(0, 0, 0);
  transition: transform 0.26s cubic-bezier(0.22, 0.72, 0.26, 1);
  will-change: transform;
}

.session-track--open {
  transform: translate3d(-152rpx, 0, 0);
}

/* 跟手拖动期间不要过渡，否则位移会慢半拍 */
.session-track--dragging {
  transition: none;
}

.session-delete {
  position: relative;
  z-index: 0;
  display: flex;
  flex: 0 0 136rpx;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  overflow: hidden;
  color: #ffffff;
  border-radius: 28rpx;
  background: #d9755f;
  font-size: 28rpx;
  font-weight: 500;
}

.session-delete__background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.session-delete__label {
  position: relative;
  z-index: 1;
}

.session-card {
  position: relative;
  z-index: 1;
  display: grid;
  flex: 0 0 100%;
  grid-template-columns: minmax(0, 1fr) auto 24rpx;
  align-items: center;
  gap: 22rpx;
  height: 112rpx;
  padding: 0 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 10rpx 26rpx rgba(92, 79, 61, 0.07);
}

.session-card--current {
  border-color: rgba(255, 126, 57, 0.34);
  background: rgba(255, 255, 255, 0.9);
}

.session-title {
  overflow: hidden;
  color: #5c5c5c;
  font-size: 29rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  color: #9a9a9a;
  font-size: 28rpx;
  white-space: nowrap;
}

.session-chevron {
  width: 24rpx;
  height: 24rpx;
}

.list-more {
  padding: 12rpx 0 24rpx;
  color: #aaa49c;
  font-size: 23rpx;
  text-align: center;
}
