<view
  class="sessions-root"
  style="--safe-bottom: {{safeBottom}}px;"
>
  <image
    class="ai-page-background"
    src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg"
    mode="aspectFill"
  ></image>

  <page-nav title="历史会话" right-icon="/assets/images/ai-new-chat.png" bind:righttap="createNew"></page-nav>

  <!-- Token 余额占「仅保留最近 7 天」原来那一行（2026-08-10 需求 1.1），保留提示整体下移一行。
       余额本身与聊天页共用 utils/ai-token.js；聊天页顶栏那颗胶囊已撤（标题要屏幕居中，
       两者在几何上放不下），所以**这里是余额唯一的展示位**。 -->
  <view class="sessions-token">
    <!-- 整颗胶囊可点，右端带 `>`（2026-08-12 需求 3）：余额看着不够时，用户在这一页就能直接去买，
         不用退回「我的」再找入口。箭头用全站的 .ui-chevron（app.wxss），不额外引图片。 -->
    <view class="token-pill" hover-class="none" bindtap="goTokenManage">
      <image
        class="token-pill__icon"
        src="/assets/images/ai-token-spark.png"
        mode="aspectFit"
      ></image>
      <text class="token-pill__value">{{tokenBalance}}</text>
      <text class="token-pill__unit">星币</text>
      <view class="ui-chevron token-pill__arrow"></view>
    </view>
  </view>

  <view wx:if="{{!loading && sessions.length}}" class="keep-tip">
    <image
      class="keep-tip__icon"
      src="/assets/images/ai-info.png"
      mode="aspectFit"
    ></image>
    <text>仅保留最近7天会话记录</text>
  </view>

  <view wx:if="{{loading}}" class="page-loading sessions-loading">
    <view class="page-loading__spinner"></view>
    <view class="page-loading__text">加载中…</view>
  </view>

  <view wx:elif="{{!sessions.length}}" class="empty-state">
    <image
      class="empty-state__image"
      src="/assets/images/ai-empty-sessions-art.png"
      mode="aspectFit"
    ></image>
    <view class="empty-state__title">暂时没有历史会话</view>
    <view class="empty-state__desc">开始一次新的历史创作吧</view>
  </view>

  <view wx:else class="session-list">
    <block wx:for="{{sessions}}" wx:key="sessionId">
      <view wx:if="{{item.groupLabel}}" class="date-title">
        <view class="date-title__bar"></view>
        <text>{{item.groupLabel}}</text>
      </view>

      <view class="session-swipe">
        <!-- 卡片和删除按钮同在一条 flex 轨道上一起位移：删除按钮排在卡片右侧的轨道外，
             由 .session-swipe 的 overflow:hidden 裁掉，没左滑就看不见。
             ⚠️ 别改回「删除按钮绝对定位垫在卡片底下」——卡片是半透明毛玻璃(0.74)，垫在
             底下的红色会直接透出来，等于没滑就露出删除按钮。 -->
        <view
          class="session-track {{openedSessionId === item.sessionId ? 'session-track--open' : ''}} {{swipingSessionId === item.sessionId ? 'session-track--dragging' : ''}}"
          style="{{swipingSessionId === item.sessionId ? swipeTransform : ''}}"
        >
          <!-- 左滑手势挂在**卡片**上，不再挂在 .session-swipe 整条轨道上（2026-08-10 需求 6）：
               挂在轨道上时，手指落在已滑开的删除按钮上也会被当成新一轮滑动 —— 点按时那一两像素
               的抖动就足以把卡片吸附回去，表现就是「删除按钮点不动」。 -->
          <view
            class="session-card {{item.sessionId === currentId ? 'session-card--current' : ''}}"
            data-id="{{item.sessionId}}"
            bindtap="onSessionTap"
            bindlongpress="onSessionLongPress"
            bindtouchstart="onSessionTouchStart"
            bindtouchmove="onSessionTouchMove"
            bindtouchend="onSessionTouchEnd"
            bindtouchcancel="onSessionTouchEnd"
          >
            <view class="session-title">{{item.title}}</view>
            <view class="session-time">{{item.timeText}}</view>
            <image
              class="session-chevron"
              src="/assets/images/ai-chevron-right.png"
              mode="aspectFit"
            ></image>
          </view>
          <view
            class="session-delete"
            hover-class="session-delete--pressed"
            data-id="{{item.sessionId}}"
            catchtap="onSessionDeleteTap"
          >
            <image
              class="session-delete__background"
              src="/assets/images/ai-del-btn-bg.png"
              mode="scaleToFill"
            ></image>
            <text class="session-delete__label">删除</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{hasMore}}" class="list-more">上拉加载更多</view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
