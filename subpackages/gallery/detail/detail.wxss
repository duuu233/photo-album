@import "../shared.wxss";
/* 贴底的「开始投屏」用公共类 .cta-button（styles/cta-button.wxss，已由 app.wxss 全局 @import）。
   ⚠️ 不要改成 @import 另一个分包的 wxss：本页在 gallery 分包，那枚按钮的样式此前写在 token 分包里，
      分包之间不能互相引用，所以公共部分统一落在主包的 styles/。 */

/* 大图不参与滚动，垫在 z-index:0；.fold-scroll 是透明的 z-index:1 层，
   白卡随内容上滑时正好从大图上盖过去。 */
.detail-shell {
  background: #f8f5ef;
}

/* 高度不再写死（2026-08-13 需求 4：不裁图）：由 wxml 的内联 `height: {{heroPad}}vw` 给出，
   heroPad = 图片高/宽×100，于是盒子比例＝图片比例，aspectFill 裁不掉任何东西。
   白卡那一侧（.detail-spacer）用同一个 heroPad 算，比它矮 3vh —— 白卡圆角压在图上，设计稿如此。
   ⚠️ 大图是 absolute、**不跟着滚**：比例极端的长图（高 > 一屏）下半截会一直在屏幕外，
   这是这套「白卡盖大图」版式的固有取舍，不是裁剪。 */
.detail-hero {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  background: #dfe3e9;
}

/* 滚动内容块：这里**不用** .fold-scroll-body。
   那个类靠 `display: flow-root` 断开外边距合并，但本页要的是「留白 + 白卡吃掉剩余高度」，
   用 flex 列更直接；flex 容器本来就不与子元素合并外边距，flow-root 想防的问题不存在。
   min-height:100% 保证内容不足一屏时白卡仍铺到底部，不会在底部露出大图。 */
.detail-body {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100%;
}

/* 让出大图的可见高度：具体值由 wxml 内联 `calc({{heroPad}}vw - 3vh)` 给（跟着图片真实比例走）。
   这里只声明「不许被 flex 压缩」——它是 .detail-body(flex 列) 的第一个子元素，
   不写 flex-shrink:0 的话内容一多就会被压扁，白卡跟着上移把大图盖掉一块。 */
.detail-spacer {
  flex: 0 0 auto;
}

/* 白卡：去掉「适用设备尺寸」后内容只剩标题行 + 简介，上下留白一并收紧
   （padding-top 44 → 32rpx），整块比原来矮一大截，大图因此多露出约 12vh。
   ⚠️ padding-bottom 这段是从原来的 .detail-sizes 移过来的：贴底的「开始投屏」是
   absolute、留在滚动区外，不预留它的高度，简介长一点就会从按钮底下穿过去。 */
.detail-card {
  flex: 1 1 auto;
  padding: 32rpx 48rpx calc(196rpx + var(--safe-bottom, 0px));
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-title {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  color: #2a2d32;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

/* 收藏按钮：未收藏是灰描边 + 空心心；已收藏是橙描边 + 实心心。
   两态文字长度不同（收藏 / 取消收藏），宽度按内容撑开，不写死。 */
.detail-fav {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(160, 166, 174, 0.5);
  border-radius: 999rpx;
}

.detail-fav--on {
  border-color: rgba(255, 106, 30, 0.5);
}

.detail-fav-icon {
  width: 32rpx;
  height: 32rpx;
}

.detail-fav-text {
  margin-left: 12rpx;
  color: #2a2d32;
  font-size: 28rpx;
  line-height: 1;
}

.detail-fav--on .detail-fav-text {
  color: #f2621f;
}

.detail-desc {
  margin-top: 22rpx;
  color: #8b8f96;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 「适用设备尺寸」那一组样式（.detail-divider / .detail-section-title / .detail-sizes /
   .detail-size-tag）随该区块于 2026-08-12 一并删除，没有别处引用。 */

/* 设备选择弹层的整套样式（.picker-mask/.picker-sheet/.picker-item/…）已于 2026-08-13
   随该弹层迁入公共组件 components/device-picker-sheet/，本文件不再保留副本 ——
   组件样式是隔离的，留在这里既不生效也会误导下一个人。 */
