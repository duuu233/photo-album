<!-- 图片详情（设计稿：assets/ai/UI页面/图片详情-{未收藏,已收藏}.png）
     沉浸式：大图铺到状态栏，导航栏透明压在图上（page-nav 的 immersive 属性把标题改白字）。
     折叠屏：根容器锁一屏高，白卡随 .fold-scroll 上滑盖住大图，贴底按钮留在滚动区外并抬到 z-index:2。 -->
<view class="gallery-shell detail-shell fold-viewport" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <!-- 大图垫在最底层（z-index:0），滚动区透明、白卡滑上来时正好盖住它 -->
  <image class="detail-hero" src="{{photo.url}}" mode="aspectFill"></image>
  <page-nav title="图片详情" immersive="{{true}}"></page-nav>

  <scroll-view class="fold-scroll" scroll-y="{{true}}">
    <view class="detail-body">
      <!-- 留白让出大图的可见高度；用户上滑时白卡从这里往上盖 -->
      <view class="detail-spacer"></view>

      <view class="detail-card">
        <view class="detail-head">
          <view class="detail-title">{{photo.title}}</view>
          <view
            class="detail-fav {{photo.favorited ? 'detail-fav--on' : ''}}"
            hover-class="none"
            bindtap="onToggleFavorite"
          >
            <image
              class="detail-fav-icon"
              src="{{photo.favorited ? '/assets/images/heart-solid.png' : '/assets/images/heart-outline.png'}}"
              mode="aspectFit"
            ></image>
            <text class="detail-fav-text">{{photo.favorited ? '取消收藏' : '收藏'}}</text>
          </view>
        </view>

        <view wx:if="{{photo.desc}}" class="detail-desc">{{photo.desc}}</view>

        <view class="detail-divider"></view>

        <view class="detail-section-title">适用设备尺寸</view>
        <view class="detail-sizes">
          <view wx:for="{{photo.sizes}}" wx:key="*this" class="detail-size-tag">{{item}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view
    class="cta-button {{projecting ? 'cta-button--disabled' : ''}}"
    hover-class="none"
    bindtap="onProject"
  >
    <image class="cta-button-bg" src="/assets/images/primary-btn-bg.png" mode="scaleToFill"></image>
    {{projecting ? '准备中…' : '开始投屏'}}
  </view>

  <!-- 未连接时的设备选择弹层（与 AI 对话页同一套交互：选完自动连接并进投屏流程）。
       必须留在滚动区外，否则会跟着白卡一起滚。 -->
  <view wx:if="{{devicePicker.show}}" class="picker-mask" bindtap="closeDevicePicker" catchtouchmove="noop">
    <view class="picker-sheet" catchtap="noop">
      <view class="picker-title">选择投屏设备</view>
      <view class="picker-desc">选择电子纸设备后，将自动连接并开始投屏</view>
      <view class="picker-divider"></view>
      <view wx:if="{{devicePicker.loading}}" class="picker-loading">加载中…</view>
      <scroll-view wx:else class="picker-list" scroll-y="{{true}}">
        <view
          wx:for="{{devicePicker.devices}}"
          wx:key="pickerId"
          class="picker-item {{item.pickerId === devicePicker.selectedId ? 'picker-item--selected' : ''}}"
          data-index="{{index}}"
          hover-class="none"
          bindtap="onDevicePickerSelect"
        >
          <view class="picker-item-name">{{item.name || item.productName || '智能相框'}}</view>
          <view class="picker-radio {{item.pickerId === devicePicker.selectedId ? 'picker-radio--selected' : ''}}">
            <view wx:if="{{item.pickerId === devicePicker.selectedId}}" class="picker-radio-check"></view>
          </view>
        </view>
      </scroll-view>
      <view class="picker-cancel" hover-class="none" bindtap="closeDevicePicker">取消</view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
