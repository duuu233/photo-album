@import "../shared.wxss";

/* 分类条整行留在滚动区外常驻：左边是可横滑的分类，右端是固定的「收藏」。
   z-index:2 保证整行压在 z-index:1 的 .fold-scroll 之上。
   上下留白两次调整：导航栏收紧那轮跟着收到 8/18rpx，随后产品要求分类这一条**自己**再松开
   （2026-08-12 需求 3）—— 收紧的是导航栏，不是分类条，两者是各自独立的诉求。 */
.category-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin: 24rpx 0 30rpx;
  padding-right: 32rpx;
}

/* 只占左侧剩余宽度。min-width:0 不可省：flex 子项默认按内容撑开（min-width:auto），
   分类多了会把右边的「收藏」挤出屏幕，而不是自己滚起来。
   左侧 48rpx 与页面留白对齐；右侧留 12rpx，滑到底时最后一个分类不至于贴上收藏按钮。 */
.category-scroll {
  flex: 1 1 auto;
  min-width: 0;
  padding: 0 12rpx 0 48rpx;
  white-space: nowrap;
}

.category-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.category-chip {
  flex: 0 0 auto;
  height: 60rpx;
  padding: 0 30rpx;
  color: #6b7078;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 56rpx;
}

/* 固定在右端的「收藏」入口（2026-08-12 由「我的」页迁来）。
   ⚠️ **刻意不做成胶囊**：它是跳转入口，不是第 N 个分类。首版给了个底色深一点的同款胶囊，
   结果和分类挤在一行里像是「最后一个分类」（产品需求 3 要求区分）。现在改成
   「竖分隔线 + 红心 + 橙字」——形状、底色、颜色三处都与分类不同，扫一眼就分得开。
   flex: 0 0 auto：分类再多也压不扁它。 */
.category-fav {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 44rpx;
  padding-left: 24rpx;
  margin-left: 10rpx;
  border-left: 2rpx solid rgba(120, 128, 138, 0.24);
}

.category-fav-icon {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
}

.category-fav-text {
  margin-left: 8rpx;
  color: #f2621f;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.category-chip--active {
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #f2621f);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(255, 106, 30, 0.24);
}

/* 底栏是 `position: fixed`、bottom = 26rpx + 安全区、高 112rpx，
   滚动内容要把这段高度让出来，否则最后一排卡片会被底栏压住。 */
/* 去掉底栏后不再为 custom-tabbar 预留高度，收敛到与「我的收藏」同一档（.fav-scroll-body） */
.list-scroll-body {
  padding-bottom: calc(48rpx + var(--safe-bottom, 0px));
}
