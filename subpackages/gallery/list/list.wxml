<!-- 官方图库（设计稿：assets/ai/UI页面/官方图库.png）
     底栏第三格进入，是分包页面而非原生 tab（同 AI 聊天页）。
     折叠屏：根容器锁一屏高，导航栏、分类条与底栏留在滚动区外，
     瀑布流交给 .fold-scroll 滚动（方案见 styles/fold-adapt.wxss）。 -->
<view class="gallery-shell fold-viewport" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <!-- compact（2026-08-12 产品「顶部 nav 太大了」）：标题小一号、行下那段留白收掉。
       导航行本身仍与微信原生胶囊同高同轴——那是几何约束，动了就会和胶囊错位。 -->
  <page-nav title="官方图库" compact="{{true}}"></page-nav>

  <!-- 分类条常驻不滚。横向可滑，分类多了也不换行。
       右端的「收藏」**不在滑动区里**：它是这一行的固定项（2026-08-12 从「我的」页搬来），
       分类滑到哪儿它都在原地，所以 scroll-view 只占左侧剩余宽度，收藏按钮是它的兄弟节点。 -->
  <view class="category-bar">
    <scroll-view class="category-scroll" scroll-x="{{true}}" enable-flex="{{true}}">
      <view class="category-row">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-chip {{item.id === activeCategory ? 'category-chip--active' : ''}}"
          data-id="{{item.id}}"
          hover-class="none"
          bindtap="onSelectCategory"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 样式刻意与分类胶囊分家（2026-08-12 需求 3）：不画胶囊底，改成「竖分隔线 + 红心 + 橙字」，
         一眼能看出它是入口而不是第 N 个分类（此前同款胶囊，只是底色深一点，太像分类了）。 -->
    <view class="category-fav" hover-class="none" bindtap="goFavorites">
      <image class="category-fav-icon" src="/assets/images/heart-solid.png" mode="aspectFit"></image>
      <text class="category-fav-text">收藏</text>
    </view>
  </view>

  <scroll-view class="fold-scroll" scroll-y="{{true}}">
    <view class="fold-scroll-body gallery-scroll-body list-scroll-body">
      <view class="waterfall">
        <view wx:for="{{columns}}" wx:for-item="column" wx:for-index="colIndex" wx:key="colIndex" class="waterfall-column">
          <view
            wx:for="{{column}}"
            wx:for-item="photo"
            wx:key="id"
            class="photo-card"
            data-id="{{photo.id}}"
            hover-class="none"
            bindtap="goDetail"
          >
            <view class="photo-media" style="height: {{photo.imgHeight}}rpx;">
              <image class="photo-image" src="{{photo.url}}" mode="aspectFill" lazy-load="{{true}}"></image>
              <!-- 右上角红心（2026-08-12 需求 4，与「我的收藏」页同一套角标与逻辑）：
                   heart-solid = 已收藏，heart-outline = 未收藏；半透明白圆底是 CSS 画的
                   （.photo-fav，图里只有心，见 shared.wxss）。
                   catchtap：点角标只切收藏态，不冒泡进详情页。
                   data-col/data-index 是为了**原地**改这一张的状态——收藏不该让瀑布流重排，
                   重排会把用户正在看的卡片挪走（同 .photo-media 预占高度那条口径）。 -->
              <view
                class="photo-fav"
                data-id="{{photo.id}}"
                data-col="{{colIndex}}"
                data-index="{{index}}"
                catchtap="onToggleFavorite"
              >
                <image
                  class="photo-fav-icon"
                  src="{{photo.favorited ? '/assets/images/heart-solid.png' : '/assets/images/heart-outline.png'}}"
                  mode="aspectFit"
                ></image>
              </view>
            </view>
            <view class="photo-title">{{photo.title}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{!loading && !total}}" class="gallery-empty">该分类下还没有图片</view>
    </view>
  </scroll-view>

  <global-toast id="globalToast"></global-toast>
</view>
