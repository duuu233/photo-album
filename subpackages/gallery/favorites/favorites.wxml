<!-- 我的收藏（设计稿：assets/ai/UI页面/我的收藏.png）
     与官方图库同一套瀑布流，差别是每张右上角带实心心角标（点它直接取消收藏）。
     折叠屏：导航栏与计数行留在滚动区外，瀑布流交给 .fold-scroll 滚动。 -->
<view class="gallery-shell fold-viewport" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <page-nav title="我的收藏"></page-nav>

  <view class="fav-count">共收藏 <text class="fav-count-num">{{total}}</text> 张官方图片</view>

  <scroll-view class="fold-scroll" scroll-y="{{true}}">
    <view class="fold-scroll-body gallery-scroll-body fav-scroll-body">
      <view class="waterfall">
        <view wx:for="{{columns}}" wx:for-item="column" wx:for-index="colIndex" wx:key="colIndex" class="waterfall-column">
          <view
            wx:for="{{column}}"
            wx:for-item="photo"
            wx:key="id"
            class="photo-card"
            data-id="{{photo.id}}"
            hover-class="none"
            bindtap="goDetail"
          >
            <view class="photo-media" style="height: {{photo.imgHeight}}rpx;">
              <image class="photo-image" src="{{photo.url}}" mode="aspectFill" lazy-load="{{true}}"></image>
              <!-- catchtap：点角标只取消收藏，不冒泡进详情页 -->
              <view class="photo-fav" data-id="{{photo.id}}" catchtap="onToggleFavorite">
                <image class="photo-fav-icon" src="/assets/images/gallery-fav-badge.png" mode="aspectFit"></image>
              </view>
            </view>
            <view class="photo-title">{{photo.title}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{!loading && !total}}" class="gallery-empty">还没有收藏任何官方图片</view>
    </view>
  </scroll-view>

  <global-toast id="globalToast"></global-toast>
</view>
