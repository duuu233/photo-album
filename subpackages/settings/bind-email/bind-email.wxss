.email-content {
  padding-top: 78rpx;
}

.email-form {
  overflow: hidden;
  padding: 0 40rpx;
}

.email-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 120rpx;
  gap: 18rpx;
}

.email-label {
  flex: 0 0 150rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.email-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  color: #777e88;
  font-size: 28rpx;
  line-height: 92rpx;
  text-align: right;
}

.code-input {
  padding-right: 4rpx;
}

.email-placeholder {
  color: #8d939c;
}

.code-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 154rpx;
  height: 58rpx;
  padding: 0 16rpx;
  color: #ff5f1f;
  background: rgba(255, 255, 255, 0.5);
  border: 2rpx solid #ff5f1f;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.code-btn.is-counting {
  min-width: 224rpx;
  color: #ff7654;
  background: #f2f2f2;
  border-color: transparent;
}

.email-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 28rpx;
  color: #888f99;
  font-size: 24rpx;
  line-height: 1.2;
}

.tip-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  color: #8a929d;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
}

.settings-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 110rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff8b3d 0%, #ff641f 100%);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.settings-primary.is-disabled {
  color: rgba(255, 255, 255, 0.9);
  background: #e4eaf2;
  box-shadow: none;
}

.email-submit {
  position: fixed;
  right: 46rpx;
  bottom: calc(474rpx + var(--safe-bottom, 0px));
  left: 46rpx;
  z-index: 2;
}
