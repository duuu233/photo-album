.modify-password-page {
  min-height: 100vh;
  background: #f5f7fb;
}

.security-banner {
  margin: 24rpx 32rpx 0;
  padding: 30rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background:
    linear-gradient(135deg, rgba(23, 33, 51, 0.94), rgba(23, 105, 224, 0.86)),
    #172133;
  box-shadow: 0 18rpx 34rpx rgba(23, 33, 51, 0.14);
}

.banner-title {
  font-size: 36rpx;
  font-weight: 800;
}

.banner-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.52;
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  border: 1rpx solid #e6ebf2;
  border-radius: 8rpx;
  background: #ffffff;
}

.submit-wrap {
  margin: 36rpx 32rpx 0;
}
