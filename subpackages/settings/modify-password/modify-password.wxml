<view class="modify-password-page safe-bottom">
  <page-nav title="修改密码" subtitle="用于手机号和后台账号登录" />

  <view class="security-banner">
    <view class="banner-title">账户安全</view>
    <view class="banner-desc">建议使用不少于 8 位的组合密码，并避免与其他平台重复。</view>
  </view>

  <view class="form-card">
    <form-field
      name="oldPassword"
      label="当前密码"
      password="{{true}}"
      value="{{oldPassword}}"
      placeholder="请输入当前密码"
      bind:input="updateField"
    />
    <form-field
      name="newPassword"
      label="新密码"
      password="{{true}}"
      value="{{newPassword}}"
      placeholder="至少 8 位字符"
      bind:input="updateField"
    />
    <form-field
      name="confirmPassword"
      label="确认新密码"
      password="{{true}}"
      value="{{confirmPassword}}"
      placeholder="再次输入新密码"
      bind:input="updateField"
    />
  </view>

  <view class="submit-wrap">
    <brand-button text="保存新密码" loading="{{loading}}" bind:tap="savePassword" />
  </view>
</view>
