<view class="settings-shell" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <page-nav title="忘记密码"></page-nav>

  <view class="glass-card form-card">
    <view class="form-row">
      <text class="form-label">邮箱</text>
      <input class="form-input" value="{{email}}" placeholder="123456789@qq.com" placeholder-class="form-placeholder" data-field="email" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">验证码</text>
      <input class="form-input code-input" value="{{code}}" placeholder="请输入验证码" placeholder-class="form-placeholder" data-field="code" bindinput="onInput" />
      <button class="code-btn {{codeCountdown ? 'is-counting' : ''}}" disabled="{{codeCountdown > 0}}" hover-class="none" bindtap="sendCode">{{codeButtonText}}</button>
    </view>
    <view class="form-row">
      <text class="form-label">密码</text>
      <input class="form-input" password value="{{password}}" placeholder="请输入密码" placeholder-class="form-placeholder" data-field="password" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">确认密码</text>
      <input class="form-input" password value="{{confirmPassword}}" placeholder="请确认密码" placeholder-class="form-placeholder" data-field="confirmPassword" bindinput="onInput" />
    </view>
  </view>

  <button class="primary-btn form-submit" hover-class="none" bindtap="submit">确认</button>

  <global-toast id="globalToast"></global-toast>
</view>
