<!-- 用户协议。正文**不写死在这里**：法务给的是整篇文档（15 章 + 60 条列表 + 1 张表），
     写死进 wxml 下次换版还得重排一遍。现在正文来自 agreement-content.js（由那份 docx 逐块
     转换而来），这里只有一套通用渲染——和隐私政策 privacy.wxml 是同一套模板。 -->
<view class="settings-shell" style="--status-bar: {{statusBarHeight}}px;">
  <page-nav title="用户协议"></page-nav>

  <scroll-view class="article-scroll" scroll-y>
    <view class="glass-card article-card">
      <view class="article-title">《BoltStar 用户协议》</view>
      <!-- 日期与版本号照抄文档页首那一行（法务口径，端上不另拼） -->
      <view class="article-meta">{{docMeta}}</view>

      <block wx:for="{{blocks}}" wx:key="key">
        <view wx:if="{{item.type === 'h2'}}" class="article-section-title">{{item.text}}</view>
        <!-- 用户协议这份文档没有 h3 小节标题，分支保留：与隐私政策共用一套模板，
             法务下次给的版本里出现小节标题时不用再改渲染层 -->
        <view wx:elif="{{item.type === 'h3'}}" class="article-sub-title">{{item.text}}</view>
        <view wx:elif="{{item.type === 'li'}}" class="article-list">• {{item.text}}</view>

        <!-- 表格：flex 手搭，列宽均分。⚠️ 行高不能写死——违规处理那张表的措施列会折行 -->
        <view wx:elif="{{item.type === 'table'}}" class="article-table">
          <!-- 表头/单元格这两层是**静态**数据（进 data 后不再变），按官方口径可以不设 wx:key；
               强行给 key 反而不对：单元格文本会重复（多行都是「AI 功能封禁 24 小时」），*this 会撞。 -->
          <view class="article-table__row article-table__row--head">
            <view
              wx:for="{{item.head}}"
              wx:for-item="cell"
              class="article-table__cell article-table__cell--head"
            >{{cell}}</view>
          </view>
          <view
            wx:for="{{item.rows}}"
            wx:for-item="row"
            class="article-table__row"
          >
            <view
              wx:for="{{row}}"
              wx:for-item="cell"
              class="article-table__cell"
            >{{cell}}</view>
          </view>
        </view>

        <view wx:else class="article-p">{{item.text}}</view>
      </block>
    </view>
  </scroll-view>

  <global-toast id="globalToast"></global-toast>
</view>
