@import "../shared.wxss";

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 32rpx;
}

.avatar-btn,
.avatar-img {
  width: 136rpx;
  height: 136rpx;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-placeholder {
  background:
    radial-gradient(circle at 50% 38%, #ffe3cb 0 26rpx, transparent 27rpx),
    radial-gradient(circle at 50% 94%, #ff873e 0 52rpx, transparent 53rpx),
    linear-gradient(135deg, #fff6ee, #d7eaff);
}

.profile-name {
  margin-top: 24rpx;
  color: #2a2d32;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.profile-tip {
  margin-top: 16rpx;
  color: #858b96;
  font-size: 24rpx;
}

.info-card {
  margin-top: 28rpx;
}

.row-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: #2a2d32;
  font-size: 28rpx;
  text-align: right;
}

.row .row-label {
  flex: 0 0 150rpx;
}

.row .row-value {
  flex: 1;
  text-align: right;
}

.save-profile {
  position: absolute;
  right: 48rpx;
  bottom: calc(216rpx + var(--safe-bottom));
  left: 48rpx;
}
