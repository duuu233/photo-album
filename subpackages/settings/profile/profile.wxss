.profile-content {
  padding-top: 78rpx;
}

.profile-form {
  overflow: hidden;
  padding: 0 40rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 120rpx;
  gap: 28rpx;
  text-align: left;
}

.avatar-row {
  min-height: 118rpx;
}

/* button 承载 open-type="chooseAvatar"，需彻底清除默认按钮样式，外观与普通 profile-row 一致 */
.avatar-button {
  margin: 0;
  width: 100% !important;
  padding: 0;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  text-align: left;
  line-height: normal;
  background: transparent;
  border: none;
  border-radius: 0;
  box-sizing: border-box;
  overflow: visible;
}

/* 去掉 button 默认的 ::after 边框线 */
.avatar-button::after {
  display: none;
  border: none;
}

/* 去掉点击态默认背景 */
.avatar-button.button-hover {
  background: transparent;
}

.profile-label {
  flex: 0 0 auto;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.profile-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  gap: 18rpx;
}

.profile-text {
  overflow: hidden;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1.2;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-avatar {
  width: 64rpx;
  height: 64rpx;
  overflow: hidden;
  border-radius: 50%;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  color: #777e88;
  font-size: 28rpx;
  line-height: 92rpx;
  text-align: right;
}

.profile-placeholder {
  color: #8b9098;
}

.edit-name-icon {
  margin-top: 12rpx;
  width: 28rpx;
  height: 28rpx;
}

.settings-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 110rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff8b3d 0%, #ff641f 100%);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.profile-submit {
  position: fixed;
  right: 46rpx;
  bottom: calc(474rpx + var(--safe-bottom, 0px));
  left: 46rpx;
  z-index: 2;
}
