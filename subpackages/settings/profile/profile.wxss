.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
}

.avatar-btn,
.avatar {
  width: 132rpx;
  height: 132rpx;
  overflow: hidden;
  border-radius: 34rpx;
}

.profile-text {
  flex: 1;
  min-width: 0;
}

.profile-name {
  margin-bottom: 8rpx;
  color: #232323;
  font-size: 36rpx;
  font-weight: 900;
}

.form-panel {
  overflow: hidden;
}

.cell-title {
  margin-bottom: 8rpx;
  color: #232323;
  font-size: 29rpx;
  font-weight: 800;
}

.email-action {
  color: #eb5f1b;
  font-size: 26rpx;
  font-weight: 850;
}

.email-action.warn {
  color: #b5650f;
}

.phone-btn {
  min-width: 132rpx;
  min-height: 64rpx;
  font-size: 24rpx;
}

.save-btn {
  margin-top: 24rpx;
}
