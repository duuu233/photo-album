<view class="mock-root profile-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607071032177373571.png" mode="aspectFill"></image>
  </view>

  <page-nav title="个人信息"></page-nav>

  <view class="mock-content profile-content">
    <view class="profile-form glass-panel">
      <button class="profile-row avatar-row avatar-button" hover-class="none" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <text class="profile-label">头像</text>
        <view class="profile-value avatar-value">
          <image wx:if="{{userInfo.avatarUrl}}" class="profile-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <image wx:else class="profile-avatar" src="/assets/images/mine-header.jpg" mode="aspectFill"></image>
          <view class="ui-chevron"></view>
        </view>
      </button>
      <view class="thin-divider"></view>

      <view class="profile-row">
        <text class="profile-label">昵称</text>
        <view class="profile-value name-value">
          <input class="nickname-input" type="nickname" value="{{userInfo.nickName}}" placeholder="请输入昵称" placeholder-class="profile-placeholder" bindinput="onNicknameInput" />
          <image class="edit-name-icon" src="/assets/images/edit-icon01.png" mode="aspectFit"></image>
        </view>
      </view>
      <view class="thin-divider"></view>

      <view class="profile-row">
        <text class="profile-label">ID</text>
        <text class="profile-text">{{userInfo.id || '--'}}</text>
      </view>
      <view class="thin-divider"></view>

      <!-- 邮箱仅展示：小程序不操作邮箱（绑定/修改请在 App 内），入口已屏蔽（2026-07-16） -->
      <view class="profile-row">
        <text class="profile-label">邮箱</text>
        <view class="profile-value email-value">
          <text class="{{userInfo.email ? 'profile-text' : 'profile-placeholder-text'}}">{{userInfo.email || '暂未绑定'}}</text>
        </view>
      </view>
    </view>

    <view class="settings-primary profile-submit" hover-class="none" bindtap="saveProfile">保存资料</view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
