<view class="mock-root profile-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <view class="mock-bg__curve mock-bg__curve--top"></view>
    <view class="mock-bg__curve mock-bg__curve--bottom"></view>
    <view class="mock-bg__spark mock-bg__spark--one"></view>
    <view class="mock-bg__spark mock-bg__spark--two"></view>
    <view class="mock-bg__spark mock-bg__spark--three"></view>
  </view>

  <view class="mock-nav">
    <button class="mock-nav__back" hover-class="none" aria-label="返回" bindtap="goBack">
      <view class="mock-nav__back-icon"></view>
    </button>
    <view class="mock-nav__title">个人信息</view>
    <view></view>
  </view>

  <view class="mock-content profile-content">
    <view class="profile-form glass-panel">
      <button class="profile-row avatar-row" hover-class="none" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <text class="profile-label">头像</text>
        <view class="profile-value avatar-value">
          <image wx:if="{{userInfo.avatarUrl}}" class="profile-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="profile-avatar avatar-placeholder">
            <view class="avatar-sky"></view>
            <view class="avatar-face"></view>
            <view class="avatar-cap"></view>
          </view>
          <view class="ui-chevron"></view>
        </view>
      </button>
      <view class="thin-divider"></view>

      <view class="profile-row">
        <text class="profile-label">昵称</text>
        <view class="profile-value name-value">
          <input class="nickname-input" type="nickname" value="{{userInfo.nickName}}" placeholder="请输入昵称" placeholder-class="profile-placeholder" bindinput="onNicknameInput" />
          <view class="edit-name-icon"></view>
        </view>
      </view>
      <view class="thin-divider"></view>

      <view class="profile-row">
        <text class="profile-label">ID</text>
        <text class="profile-text">{{userInfo.id || '123456'}}</text>
      </view>
      <view class="thin-divider"></view>

      <button class="profile-row" hover-class="none" bindtap="goEmail">
        <text class="profile-label">邮箱</text>
        <view class="profile-value email-value">
          <text class="{{userInfo.email ? 'profile-text' : 'profile-placeholder-text'}}">{{userInfo.email || '暂未绑定'}}</text>
          <view class="ui-chevron"></view>
        </view>
      </button>
    </view>

    <button class="settings-primary profile-submit" hover-class="none" bindtap="saveProfile">保存资料</button>
  </view>
</view>
