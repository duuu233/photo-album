<view class="page profile-page safe-bottom" wx:if="{{userInfo}}">
  <view class="profile-card card">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
    </button>
    <view class="profile-text">
      <view class="profile-name">{{userInfo.nickName || '微信用户'}}</view>
      <view class="caption">点击头像可拉取微信头像</view>
    </view>
  </view>

  <view class="section card form-panel">
    <view class="form-row">
      <view class="form-label">昵称</view>
      <input class="form-input" type="nickname" value="{{userInfo.nickName}}" bindinput="onNicknameInput" />
    </view>
    <button class="list-cell email-cell" bindtap="goEmail">
      <view>
        <view class="cell-title">邮箱</view>
        <view class="caption">{{userInfo.email || '未绑定邮箱'}}</view>
      </view>
      <view class="email-action {{userInfo.email ? '' : 'warn'}}">{{userInfo.email ? '修改' : '去绑定'}}</view>
    </button>
    <view class="list-cell">
      <view>
        <view class="cell-title">手机号</view>
        <view class="caption">{{userInfo.phone || '未绑定手机号'}}</view>
      </view>
      <button class="secondary-btn phone-btn" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">{{userInfo.phone ? '更新' : '绑定'}}</button>
    </view>
  </view>

  <button class="primary-btn save-btn" bindtap="saveProfile">保存</button>
</view>
