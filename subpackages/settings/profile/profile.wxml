<view class="settings-shell" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="nav-bar">
    <button class="back-btn" hover-class="none" bindtap="goBack">←</button>
    <view class="nav-title">个人信息</view>
  </view>

  <view class="glass-card profile-card">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" hover-class="none">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-img avatar-placeholder"></view>
    </button>
    <view class="profile-name">{{userInfo.nickName || '江江江'}}</view>
    <view class="profile-tip">点击头像可更换微信头像</view>
  </view>

  <view class="glass-card info-card">
    <view class="row">
      <text class="row-label">昵称</text>
      <input class="row-input" type="nickname" value="{{userInfo.nickName}}" placeholder="请输入昵称" bindinput="onNicknameInput" />
    </view>
    <button class="row" hover-class="none" bindtap="goChangeEmail">
      <text class="row-label">邮箱</text>
      <text class="row-value">{{userInfo.email || '123456789@qq.com'}}</text>
      <view class="chevron">›</view>
    </button>
    <view class="row">
      <text class="row-label">手机号</text>
      <text class="row-value">{{userInfo.phone || '123456789'}}</text>
    </view>
  </view>

  <button class="primary-btn save-profile" hover-class="none" bindtap="saveProfile">保存</button>
</view>
