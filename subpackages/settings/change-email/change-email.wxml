<view class="mock-root email-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202606161459019677928.png" mode="aspectFill"></image>
  </view>

  <page-nav title="修改邮箱"></page-nav>

  <view class="mock-content email-content">
    <view class="email-form glass-panel">
      <view class="email-row">
        <text class="email-label">当前邮箱</text>
        <text class="current-email">{{currentEmail}}</text>
      </view>
      <view class="thin-divider"></view>

      <view class="email-row">
        <text class="email-label">新邮箱</text>
        <input class="email-input" type="text" value="{{email}}" placeholder="请输入新的邮箱地址" placeholder-class="email-placeholder" data-field="email" bindinput="onInput" />
      </view>
      <view class="thin-divider"></view>

      <view class="email-row">
        <text class="email-label">验证码</text>
        <input class="email-input code-input" type="number" value="{{code}}" placeholder="请输入验证码" placeholder-class="email-placeholder" data-field="code" bindinput="onInput" />
        <view class="code-btn {{codeCountdown ? 'is-counting' : ''}}" disabled="{{codeCountdown > 0}}" hover-class="none" bindtap="sendCode">{{codeButtonText}}</view>
      </view>
      <view class="thin-divider"></view>

      <view class="email-row">
        <text class="email-label">密码</text>
        <input class="email-input" password value="{{password}}" placeholder="请设置登录密码" placeholder-class="email-placeholder" data-field="password" bindinput="onInput" />
      </view>
      <view class="thin-divider"></view>

      <view class="email-row">
        <text class="email-label">确认密码</text>
        <input class="email-input" password value="{{confirmPassword}}" placeholder="请再次输入密码" placeholder-class="email-placeholder" data-field="confirmPassword" bindinput="onInput" />
      </view>
    </view>

    <view class="settings-primary email-submit {{canSubmit ? '' : 'is-disabled'}}" disabled="{{!canSubmit}}" hover-class="none" bindtap="submit">确认修改</view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
