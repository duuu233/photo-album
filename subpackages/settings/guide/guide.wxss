@import '../shared.wxss';

/* 本页改用 bg01 作为页面背景图（见 .mock-bg），关闭 settings-shell 自带的渐变背景与装饰圆环 */
/* 竖向 flex：导航固定高度，余下空间全给 scroll-view，
   这样常见问题超出一屏时可以在卡片区域内滚动查看
   （页面配的是 disableScroll，且 .settings-shell 有 overflow:hidden，靠页面滚动是滚不动的）*/
.guide-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: none;
}

.guide-shell::before,
.guide-shell::after {
  display: none;
}

/* 导航不参与压缩，否则内容一多会被挤扁 */
.guide-shell page-nav {
  flex: none;
}

.guide-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  /* flex 子项默认 min-height:auto，不加这条会被内容撑高、反而滚不起来 */
  min-height: 0;
}

.search-box {
  position: relative;
  z-index: 1;
  height: 96rpx;
  margin: 24rpx 48rpx 0;
  padding: 0 92rpx 0 36rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 42rpx rgba(127, 151, 184, 0.12);
}

.search-box input {
  width: 100%;
  height: 96rpx;
  color: #2a2d32;
  font-size: 28rpx;
}

.search-placeholder {
  color: #9aa1ab;
}

.search-icon {
  position: absolute;
  top: 32rpx;
  right: 38rpx;
  width: 32rpx;
  height: 32rpx;
}

.guide-card {
  margin-top: 24rpx;
  /* 底部留出安全区，最后一条不被 Home Indicator 压住 */
  margin-bottom: calc(var(--safe-bottom, 0px) + 24rpx);
  padding: 20rpx 24rpx 10rpx 24rpx;
  border-radius: 28rpx;
}

/* 加载中 / 空态提示 */
.guide-tip {
  padding: 56rpx 0;
  color: rgba(42, 43, 43, 0.5);
  font-size: 26rpx;
  text-align: center;
}

.guide-item {
  position: relative;
}

.guide-head {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 78rpx;
  text-align: left;
}

.question-icon {
  flex: 0 0 32rpx;
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
}

.guide-head text {
  flex: 1;
  color: #4a505a;
  font-size: 28rpx;
  line-height: 1.2;
}

.fold-icon {
  position: relative;
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
}

/* 折叠箭头用伪元素绘制：默认朝下，展开时朝上 */
.fold-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #2a2b2b99;
  border-right: 3rpx solid #2a2b2b99;
  transform: translate(-50%, -70%) rotate(135deg);
  transition: transform 0.2s ease;
  content: '';
}

.guide-item.open .fold-icon::after {
  transform: translate(-50%, -30%) rotate(-45deg);
}

.guide-body {
  margin: 0 0 18rpx 38rpx;
  padding: 22rpx 18rpx;
  color: rgba(42, 43, 43, 0.6);

  background: rgba(42, 43, 43, 0.03);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 40rpx;
}

.guide-body text {
  display: block;
}

.guide-rich {
  display: block;
}
