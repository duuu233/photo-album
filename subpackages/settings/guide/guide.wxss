@import "../shared.wxss";

.search-box {
  position: relative;
  z-index: 1;
  height: 96rpx;
  margin: 24rpx 48rpx 0;
  padding: 0 92rpx 0 36rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 42rpx rgba(127, 151, 184, 0.12);
}

.search-box input {
  width: 100%;
  height: 96rpx;
  color: #2a2d32;
  font-size: 28rpx;
}

.search-placeholder {
  color: #9aa1ab;
}

.search-icon {
  position: absolute;
  top: 27rpx;
  right: 38rpx;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #c0c5cc;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -11rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 4rpx;
  background: #c0c5cc;
  border-radius: 999rpx;
  transform: rotate(45deg);
  content: "";
}

.guide-card {
  margin-top: 24rpx;
  padding: 20rpx 26rpx;
}

.guide-item {
  position: relative;
}

.guide-head {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 78rpx;
  text-align: left;
}

.question-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  color: #ffffff;
  background: #ff7a2e;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.guide-head text {
  flex: 1;
  color: #4a505a;
  font-size: 28rpx;
  line-height: 1.2;
}

.fold-icon {
  color: #7c838d;
  font-size: 32rpx;
}

.guide-body {
  margin: 0 0 18rpx 48rpx;
  padding: 22rpx 18rpx;
  color: #727984;
  background: rgba(246, 247, 249, 0.88);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.guide-body text {
  display: block;
}
