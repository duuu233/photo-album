@import '../shared.wxss';

.search-box {
  position: relative;
  z-index: 1;
  height: 96rpx;
  margin: 24rpx 48rpx 0;
  padding: 0 92rpx 0 36rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 42rpx rgba(127, 151, 184, 0.12);
}

.search-box input {
  width: 100%;
  height: 96rpx;
  color: #2a2d32;
  font-size: 28rpx;
}

.search-placeholder {
  color: #9aa1ab;
}

.search-icon {
  position: absolute;
  top: 32rpx;
  right: 38rpx;
  width: 32rpx;
  height: 32rpx;
}

.guide-card {
  margin-top: 24rpx;
  padding: 20rpx 26rpx;
}

.guide-item {
  position: relative;
}

.guide-head {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 78rpx;
  text-align: left;
}

.question-icon {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.guide-head text {
  flex: 1;
  color: #4a505a;
  font-size: 28rpx;
  line-height: 1.2;
}

.fold-icon {
  position: relative;
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
}

/* 折叠箭头用伪元素绘制：默认朝下，展开时朝上 */
.fold-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #2a2b2b99;
  border-right: 3rpx solid #2a2b2b99;
  transform: translate(-50%, -70%) rotate(135deg);
  transition: transform 0.2s ease;
  content: '';
}

.guide-item.open .fold-icon::after {
  transform: translate(-50%, -30%) rotate(-45deg);
}

.guide-body {
  margin: 0 0 18rpx 48rpx;
  padding: 22rpx 18rpx;
  color: #727984;
  background: rgba(246, 247, 249, 0.88);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.guide-body text {
  display: block;
}
