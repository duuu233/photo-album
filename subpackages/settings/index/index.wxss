@import '../shared.wxss';

.first-card {
  margin-top: 68rpx;
}

/* 语种设置卡片隐藏后，此卡片成为首张卡片，顶部间距与原首卡保持一致 */
.setting-list {
  margin-top: 68rpx;
}

.setting-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 124rpx;
  padding: 0 36rpx;
  text-align: left;
}

.setting-row + .setting-row::before {
  position: absolute;
  top: 0;
  right: 36rpx;
  left: 36rpx;
  height: 1rpx;
  background: rgba(207, 214, 224, 0.72);
  content: '';
}

.setting-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  margin-right: 28rpx;
  border-radius: 50%;
}

/* 标题 flex:1（basis 0）吃掉剩余宽度，右侧取值只在放不下时收缩 */
.setting-row .row-label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.setting-row .row-value {
  flex: 0 1 auto;
  min-width: 0;
  margin-right: 18rpx;
  margin-left: 16rpx;
  overflow: hidden;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 联系我们：邮箱 boltstarservice@boltstar.net 同行放不下（标题右侧只剩约 312rpx，
   邮箱约需 390rpx），原来省略号一截就只剩 "boltstarserv…"，复制得到的却是全串，看着像 bug。
   改成上下两行：标题在上、邮箱整串在下。两行约 82rpx，仍在 124rpx 行高内，不撑高卡片。
   注意本段必须排在 .setting-row .row-value 之后——两者特指度相同，靠顺序覆盖。 */
.contact-row .contact-text {
  flex: 1;
  min-width: 0;
  margin-right: 18rpx;
}

.contact-row .row-label {
  display: block;
}

.contact-row .row-value {
  display: block;
  margin: 6rpx 0 0;
  overflow: visible;
  text-align: left;
  white-space: normal;
  word-break: break-all;
  font-size: 26rpx;
}

.orange-icon {
  color: #ff6421;
  background: rgba(255, 100, 33, 0.08);
}

.blue-icon {
  color: #287dff;
  background: rgba(40, 125, 255, 0.1);
}

.setting-icon__img {
  width: 40rpx;
  height: 40rpx;
}

.copy-icon {
  width: 32rpx;
  height: 32rpx;
  /* margin-right: 10rpx; */
}

/* z-index 必须 ≥ 2：本按钮留在 .fold-scroll(z-index:1) 之外、又与它在屏幕上重叠，
   不显式抬高就会被滚动区盖住 —— 滚动区透明，按钮**看得见却点不动**
   （2026-08-05 折叠屏改造引入，普通手机同样中招，见 styles/fold-adapt.wxss 的告警）。 */
.outline-logout {
  position: absolute;
  z-index: 2;
  right: 48rpx;
  bottom: calc(212rpx + var(--safe-bottom));
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  color: #eb5f1b;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 62px;
  border: 1px solid #eb5f1b;
  background: rgba(251, 242, 238, 0.8);
  box-shadow: 0 4px 12px 0 rgba(44, 63, 97, 0.03);
  backdrop-filter: blur(7.949999809265137px);
}

/* z-index 同 .outline-logout */
.delete-account {
  position: absolute;
  z-index: 2;
  right: 48rpx;
  bottom: calc(70rpx + var(--safe-bottom));
  left: 48rpx;
  color: #808690;
  font-size: 30rpx;
  text-align: center;
}
