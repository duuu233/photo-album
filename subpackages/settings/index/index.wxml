<view class="page safe-bottom">
  <view class="card settings-list">
    <button class="list-cell" bindtap="goProfile">
      <text>个人信息</text>
      <text class="muted">{{userInfo.nickName || '微信用户'}}</text>
    </button>
    <button class="list-cell" bindtap="goModifyPassword">
      <text>修改密码</text>
      <text class="muted">账号安全</text>
    </button>
    <button class="list-cell" bindtap="goLanguage">
      <text>语种设置</text>
      <text class="muted">{{languageInfo.label}}</text>
    </button>
    <button class="list-cell" bindtap="goAbout">
      <text>关于我们</text>
      <text class="muted">协议与隐私</text>
    </button>
    <button class="list-cell" bindtap="goAccount">
      <text>用户注销</text>
      <text class="muted">账号管理</text>
    </button>
  </view>

  <button class="danger-btn logout-btn" bindtap="logout">退出登录</button>
</view>
