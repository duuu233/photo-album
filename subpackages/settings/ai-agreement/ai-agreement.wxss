@import "../privacy/privacy.wxss";

.article-table {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(207, 214, 224, 0.92);
  border-radius: 12rpx;
}

.article-table-row {
  display: flex;
}

.article-table-row + .article-table-row {
  border-top: 1rpx solid rgba(207, 214, 224, 0.92);
}

.article-table-row.is-header {
  color: #2a2d32;
  font-weight: 700;
  background: rgba(226, 233, 243, 0.72);
}

.article-table-cell {
  flex: 1;
  padding: 14rpx 12rpx;
  color: #2f343b;
  font-size: 24rpx;
  line-height: 1.45;
}

.article-table-cell:first-child {
  flex: 0 0 35%;
  border-right: 1rpx solid rgba(207, 214, 224, 0.92);
}
