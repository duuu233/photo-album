@import "../shared.wxss";

.logo-wrap {
  position: relative;
  z-index: 1;
  margin-top: 276rpx;
  text-align: center;
}

.logo-img {
  width: 246rpx;
  height: 62rpx;
}

.version-text {
  margin-top: 42rpx;
  color: #808690;
  font-size: 26rpx;
  line-height: 1;
}

.about-text {
  position: relative;
  z-index: 1;
  width: 640rpx;
  margin: 150rpx auto 0;
  color: #2a2d32;
  font-size: 30rpx;
  line-height: 1.58;
  text-align: center;
}

/* z-index 2：与滚动区在屏幕上重叠的贴底按钮必须压过 .fold-scroll(z-index:1)，
   否则透明的滚动区会吃掉点击（见 styles/fold-adapt.wxss 的告警）。
   `.primary-btn` 自带的 z-index:1 只是靠 DOM 顺序侥幸压住，这里写死不留悬念。 */
.update-btn {
  position: absolute;
  z-index: 2;
  right: 48rpx;
  bottom: calc(216rpx + var(--safe-bottom));
  left: 48rpx;
}

.progress-ring {
  position: relative;
  z-index: 1;
  width: 360rpx;
  height: 360rpx;
  margin: 142rpx auto 0;
  background: conic-gradient(#ff762f 0 45%, #dfe5ee 45% 100%);
  border-radius: 50%;
}

.progress-inner {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #edf6ff;
  border-radius: 50%;
}

.progress-number {
  color: #ff6421;
  font-size: 74rpx;
  line-height: 1;
}

.progress-number text {
  font-size: 28rpx;
}

.progress-desc {
  margin-top: 24rpx;
  color: #808690;
  font-size: 24rpx;
}

/* z-index 同 .update-btn（本按钮 z-index 缺省时会被滚动区盖住、点不动） */
.delete-account {
  position: absolute;
  z-index: 2;
  right: 48rpx;
  bottom: calc(70rpx + var(--safe-bottom));
  left: 48rpx;
  color: #808690;
  font-size: 30rpx;
  text-align: center;
}
