<!-- 折叠屏适配（2026-08-05，方案见 styles/fold-adapt.wxss）：根容器锁一屏高，
     导航栏与 toast 留在滚动区外，中间内容交给 .fold-scroll 滚动。 -->
<view class="settings-shell fold-viewport" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <page-nav title="语种设置"></page-nav>
   <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>
  <scroll-view class="fold-scroll" scroll-y="{{true}}">
   <view class="fold-scroll-body settings-scroll-body">
  <view class="glass-card language-card">
    <view wx:for="{{languages}}" wx:key="value" class="language-row" hover-class="none" data-value="{{item.value}}" bindtap="selectLanguage">
      <text>{{item.label}}</text>
      <image wx:if="{{item.value === selected}}" class="radio-icon" src="/assets/images/selected-icon.png" mode="aspectFit"></image>
      <view wx:else class="radio"></view>
    </view>
  </view> 

   </view>
  </scroll-view>

  <!-- 贴底按钮留在滚动区外：定位父级仍是根容器（一屏高），位置与改动前逐像素一致 -->
  <view class="primary-btn save-language" hover-class="none" bindtap="saveLanguage"><image class="cta-button-bg" src="/assets/images/primary-btn-bg.png" mode="scaleToFill"></image>保存设置</view>

  <global-toast id="globalToast"></global-toast>
</view>
