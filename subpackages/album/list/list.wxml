<view class="page album-page safe-bottom">
  <view class="page-title">
    <view>
      <view class="page-title__main">我的相册</view>
      <view class="page-title__sub">查看已投屏照片，或继续选择新照片投到相框。</view>
    </view>
  </view>

  <view class="toolbar">
    <button class="primary-btn" bindtap="chooseForProjection">选择照片投屏</button>
    <button class="ghost-btn" bindtap="toggleManage">{{manageMode ? '取消' : '管理'}}</button>
  </view>

  <view class="photo-grid" wx:if="{{photos.length}}">
    <view class="photo-card tone-{{item.tone}} {{selectedMap[item.id] ? 'selected' : ''}}" wx:for="{{photos}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleSelect">
      <image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill"></image>
      <view wx:else class="photo-placeholder image-placeholder">图片占位</view>
      <view class="select-dot" wx:if="{{manageMode}}">{{selectedMap[item.id] ? '✓' : ''}}</view>
      <view class="photo-info">
        <view class="photo-title">{{item.title}}</view>
        <view class="photo-caption">{{item.deviceName}} · {{item.createdAt}}</view>
        <view class="photo-caption">{{item.onDevice ? '设备照片' : '仅相册保留'}} · {{item.size}}MB</view>
      </view>
    </view>
  </view>

  <view class="empty card" wx:else>
    <view class="empty-title">暂无照片</view>
    <view class="caption">从手机相册选择照片，投屏后会在这里留下记录。</view>
  </view>

  <view class="bottom-bar" wx:if="{{manageMode}}">
    <text>已选 {{selectedCount}} 张</text>
    <button class="danger-btn" bindtap="deleteSelected">删除</button>
  </view>
</view>
