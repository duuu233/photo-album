<view class="mock-root album-root" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607310920402821453.png" mode="aspectFill"></image>
  </view>

  <!-- 「我的相册」（2026-08-04 由「设备照片」+「投屏管理」合并）：列表 = 投屏成功记录，
       导航栏的设备下拉即「按电子纸设备分类」的分类器，同时承担标题作用（2026-08-01 去标题）。
       样式走 app.wxss 的 .nav-device-filter，与投屏管理页同一份，保证两页宽度一致。 -->
  <page-nav>
    <view wx:if="{{filters.length}}" class="nav-device-filter">
      <view class="nav-device-filter__btn" hover-class="none" bindtap="toggleFilterMenu">
        <!-- 设备名可能很长（还会被重名消歧追加序列号尾号），必须单行省略号，绝不换行 -->
        <text class="nav-device-filter__name">{{currentFilterLabel}}</text>
        <view class="nav-device-filter__arrow {{showFilterMenu ? 'is-open' : ''}}"></view>
      </view>
      <!-- 下拉筛选菜单：value=后端设备ID(同名设备也能分开筛)，label 仅展示设备名(重名时带序列号尾号) -->
      <view class="nav-device-filter__menu" wx:if="{{showFilterMenu}}">
        <view wx:if="{{filterLoading}}" class="nav-device-filter__option nav-device-filter__option--loading">加载中…</view>
        <block wx:else>
          <view wx:for="{{filters}}" wx:key="value" class="nav-device-filter__option {{currentFilter === item.value ? 'is-active' : ''}}" hover-class="none" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</view>
        </block>
      </view>
    </view>
  </page-nav>

  <!-- 加载中：等接口返回再决定展示照片网格还是空态，避免空态先闪一下 -->
  <view wx:if="{{loading}}" class="page-loading">
    <view class="page-loading__spinner"></view>
    <view class="page-loading__text">加载中…</view>
  </view>

  <!-- 加载失败：与「暂无照片」空态严格区分（弱网时伪装成空态会让用户以为照片被清空），并给一键重试 -->
  <view wx:elif="{{loadError}}" class="album-empty">
    <image class="empty-art" src="/subpackages/album/images/album-bg01.png" mode="aspectFit"></image>
    <view class="empty-title">加载失败</view>
    <view class="empty-desc">网络异常或服务出错，请稍后重试</view>
    <view class="empty-retry" hover-class="none" bindtap="retryLoad">重新加载</view>
  </view>

  <!-- 非加载态：设备筛选载体(有设备/照片就显示) + (有照片→网格 / 无照片→空态) -->
  <block wx:else>
    <!-- 工具栏：设备下拉已上移进导航栏（见页首 page-nav），这里只留「全选 / 共 n 张」照片操作，
         仅在有照片时出现。整条工具栏在无照片时不渲染，避免留一条空白横条。 -->
    <view wx:if="{{filters.length && filteredPhotos.length}}" class="album-toolbar">
      <view class="toolbar-left">
        <view class="select-all-btn" hover-class="none" bindtap="toggleSelectAll">全选</view>
        <text class="photo-count">共 {{totalCount}} 张</text>
      </view>
    </view>
    <view wx:if="{{filters.length}}" class="album-hint">
      <view class="album-hint__dot"></view>
      <text>选中照片可再次投屏或删除，支持多选/全选</text>
    </view>

    <!-- 有照片：照片网格（选中时加 has-bottom-bar 留出底部栏空间）+ 底部操作栏 -->
    <block wx:if="{{filteredPhotos.length}}">
      <view class="photo-grid {{selectedCount ? 'has-bottom-bar' : ''}}">
        <view wx:for="{{filteredPhotos}}" wx:key="id" class="photo-tile thumb-{{item.thumbType}}" data-id="{{item.id}}" bindtap="toggleSelect">
          <!-- 有缩略图(imgThumb)则显示图片，否则渲染 CSS 绘制的占位插画。
               aspectFit：完整显示原图、保持比例不裁切不拉伸，留白落在格子底色上 -->
          <image wx:if="{{item.imgThumb}}" class="photo-img" src="{{item.imgThumb}}" mode="aspectFit" lazy-load></image>
          <view wx:else class="photo-art">
            <view class="art-sun"></view>
            <view class="art-cloud"></view>
            <view class="art-face"></view>
            <view class="art-body"></view>
            <view class="art-ground"></view>
          </view>
          <view class="select-circle {{selectedMap[item.id] ? 'is-selected' : ''}}">
            <image wx:if="{{selectedMap[item.id]}}" class="select-icon" src="/assets/images/selected-icon.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <!-- 底部操作栏：再次投屏（橙）/ 删除（红）/ 取消（深色）。
           2026-08-04：第一枚由「刷新屏幕」改为投屏记录页的「再次投屏」，单选投一张、多选/全选按批量传输走。 -->
      <view class="album-bottom-bar" wx:if="{{selectedCount}}">
        <view class="bottom-action action-retry" hover-class="none" aria-label="再次投屏" bindtap="retryProjection">
          <image class="action-icon" src="/assets/images/album-icon01.png" mode="aspectFit"></image>
        </view>
        <view class="bottom-action action-delete" hover-class="none" aria-label="删除照片" bindtap="showDeleteDialog">
          <image class="action-icon" src="/assets/images/album-icon02.png" mode="aspectFit"></image>
        </view>
        <view class="bottom-action action-cancel" hover-class="none" aria-label="取消" bindtap="cancelSelect">
          <image class="action-icon action-icon--cancel" src="/assets/images/album-icon03.png" mode="aspectFit"></image>
        </view>
      </view>
    </block>

    <!-- 无照片空态：引导用户先投屏（此时若有设备，导航栏设备下拉仍展示设备并默认选中） -->
    <view wx:else class="album-empty">
      <image class="empty-art" src="/subpackages/album/images/album-bg01.png" mode="aspectFit"></image>
      <view class="empty-title">当前电子纸设备还没有投屏成功的照片</view>
      <view class="empty-desc">投屏成功的照片会自动出现在这里</view>
    </view>
  </block>

  <!-- 删除确认弹窗：点遮罩关闭，点弹窗内部 catchtap="noop" 阻止冒泡避免误关 -->
  <view class="confirm-mask" wx:if="{{showDeleteConfirm}}" catchtouchmove="noop" bindtap="hideDeleteDialog">
    <view class="confirm-dialog {{deleteClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
      <view class="confirm-icon">
        <view class="picture-icon"></view>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">删除照片</view>
        <view class="confirm-desc">确认删除已选的{{selectedCount}}张照片吗？删除后将同时从电子纸设备与我的相册中移除，且无法恢复</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="hideDeleteDialog">取消</view>
        <view class="confirm-primary" hover-class="none" bindtap="confirmDeleteSelected">确认</view>
      </view>
    </view>
  </view>

  <!-- 全局 Toast 实例：utils/toast.js 通过 #globalToast 找到它来显示长文案提示 -->
  <global-toast id="globalToast"></global-toast>
</view>
