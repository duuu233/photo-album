.toolbar {
  display: grid;
  grid-template-columns: 1fr 160rpx;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.photo-card {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: #dbeafe;
}

.photo-card.selected {
  border-color: #1769e0;
}

.tone-blue {
  background: linear-gradient(135deg, #b7d7ff, #d8efe1);
}

.tone-amber {
  background: linear-gradient(135deg, #ffd7bd, #fff2b8);
}

.tone-rose {
  background: linear-gradient(135deg, #dad0ff, #ffd4ea);
}

.tone-green {
  background: linear-gradient(135deg, #b7f0d2, #d5f3ff);
}

.photo-img {
  width: 100%;
  height: 300rpx;
}

.select-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  color: #ffffff;
  background: rgba(23, 105, 224, 0.9);
  font-size: 24rpx;
}

.photo-info {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 42rpx 16rpx 16rpx;
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(180deg, rgba(24, 34, 48, 0), rgba(24, 34, 48, 0.78));
}

.photo-caption {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #edf1f6;
}

.bottom-bar .danger-btn {
  min-width: 180rpx;
}
