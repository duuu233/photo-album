.toolbar {
  display: grid;
  grid-template-columns: 1fr 160rpx;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.photo-card {
  position: relative;
  min-height: 310rpx;
  overflow: hidden;
  background: #f0f0f0;
  border: 3rpx solid transparent;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 32rpx rgba(64, 77, 97, 0.08);
}

.photo-card.selected {
  border-color: #eb5f1b;
}

.tone-blue {
  background: linear-gradient(135deg, #cfe4ff, #d9efe8);
}

.tone-amber {
  background: linear-gradient(135deg, #ffd8bd, #fff0c1);
}

.tone-rose {
  background: linear-gradient(135deg, #ded6ff, #ffd7e9);
}

.tone-green {
  background: linear-gradient(135deg, #bff0d7, #d7f3ff);
}

.photo-img,
.photo-placeholder {
  width: 100%;
  height: 310rpx;
}

.select-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  color: #ffffff;
  background: rgba(235, 95, 27, 0.92);
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  font-size: 25rpx;
  font-weight: 900;
}

.photo-info {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 56rpx 18rpx 18rpx;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(35, 35, 35, 0), rgba(35, 35, 35, 0.78));
}

.photo-title {
  font-size: 27rpx;
  font-weight: 850;
}

.photo-caption {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.empty-title {
  color: #232323;
  font-size: 34rpx;
  font-weight: 800;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  color: #232323;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #edf0f5;
  box-shadow: 0 -10rpx 28rpx rgba(64, 77, 97, 0.08);
}

.bottom-bar .danger-btn {
  min-width: 180rpx;
}
