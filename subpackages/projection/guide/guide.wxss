.guide-card {
  padding: 30rpx;
}

.guide-title {
  margin-bottom: 26rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.step {
  display: flex;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  color: #ffffff;
  background: #1769e0;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
}

.step-text {
  flex: 1;
  color: #344054;
  line-height: 1.7;
}
