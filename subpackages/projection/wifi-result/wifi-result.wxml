<!-- WiFi 版投屏结果（流程见 wifi-result.js 文件头与 utils/wifi-projection.js） -->
<view class="mock-root wifi-result-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="投屏"></page-nav>

  <view class="mock-content wifi-result-content">
    <view class="wifi-result-card glass-panel">
      <!-- 2026-10-29：中间不再放投屏图片，改为状态图标（与蓝牙版结果页同一组：进行中 / 成功 / 失败） -->
      <image class="wifi-result-art" src="{{phase !== 'done' ? '/assets/images/upload-icon01.png' : (total > 0 && successCount === total ? '/assets/images/upload-icon03.png' : '/assets/images/upload-icon02.png')}}" mode="aspectFit"></image>
      <view class="wifi-result-device">{{deviceName}}<text wx:if="{{total > 1}}">　第 {{current + 1}} / {{total}} 张</text></view>
      <view class="wifi-result-stage {{phase === 'done' && successCount === total ? 'is-success' : ''}} {{phase === 'done' && successCount < total ? 'is-failed' : ''}}">{{stageText}}</view>
      <view wx:if="{{phase === 'done' && carouselTip}}" class="wifi-result-carousel">{{carouselTip}}</view>
      <view wx:if="{{phase === 'running'}}" class="wifi-result-progress">
        <view class="wifi-result-progress__bar"><view class="wifi-result-progress__fill" style="width: {{progress}}%;"></view></view>
        <text class="wifi-result-progress__num">{{progress}}%</text>
      </view>
      <view class="wifi-result-note">进度含图片上传与处理；发送后设备会自行下载并刷新屏幕，多张时只在最后一张刷屏</view>
    </view>

    <!-- 投屏步骤（2026-11-12）：准备投屏 → 图片上传中 → 图片处理中 → 已发送，屏幕即将刷新，对应上方进度文案；
         样式与交互同配网状态页：未开始白圈序号、进行中转圈、通过打勾、失败在当前步打叉。
         只有单张投屏显示（2026-11-13）；批量投屏照原样只显示进度卡与逐张列表 -->
    <view wx:if="{{total <= 1}}" class="cast-steps glass-panel">
      <view wx:for="{{steps}}" wx:key="key" class="cast-step is-{{item.status}}">
        <view class="step-icon">
          <view wx:if="{{item.status === 'loading'}}" class="step-icon__spinner"></view>
          <text wx:elif="{{item.status === 'done'}}" class="step-icon__mark">✓</text>
          <text wx:elif="{{item.status === 'fail'}}" class="step-icon__mark">×</text>
          <text wx:else class="step-icon__no">{{index + 1}}</text>
        </view>
        <text class="step-text">{{item.text}}</text>
      </view>
    </view>

    <!-- 逐张列表最多露 4 行，多出的上下滑动查看；投到第几张就滚到那一行（listAnchor） -->
    <view wx:if="{{total > 1}}" class="wifi-result-list glass-panel">
      <scroll-view scroll-y scroll-with-animation class="wifi-result-list__scroll" scroll-into-view="{{listAnchor}}">
        <view wx:for="{{items}}" wx:key="key" id="wifi-row-{{index}}" class="wifi-result-row is-{{item.status}}">
          <image class="wifi-result-row__thumb" src="{{item.src}}" mode="aspectFill"></image>
          <text class="wifi-result-row__no">第 {{index + 1}} 张</text>
          <text class="wifi-result-row__text">{{item.text}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 两个按钮，与蓝牙版结果页一致：成功「继续投屏」/ 有失败「重试未成功的」+「返回首页」 -->
  <view wx:if="{{phase === 'done'}}" class="wifi-result-actions">
    <view wx:if="{{retryable && total}}" class="wifi-result-primary" hover-class="none" bindtap="retryFailed">重试未成功的</view>
    <view wx:elif="{{canContinue}}" class="wifi-result-primary" hover-class="none" bindtap="continueProjection">继续投屏</view>
    <view class="wifi-result-secondary" hover-class="none" bindtap="backHome">返回首页</view>
  </view>

  <!-- 「拍照 / 相册」选择弹层（与蓝牙版结果页同款）。点遮罩关闭；弹层内部 catchtap="noop" 阻止冒泡 -->
  <view class="media-mask" wx:if="{{showMediaSheet}}" catchtouchmove="noop" bindtap="hideMediaSheet">
    <view class="bottom-sheet media-sheet {{mediaSheetClosing ? 'pop-closing-sheet' : ''}}" catchtap="noop">
      <view class="media-sheet-title">选择投屏方式</view>
      <view class="media-option" hover-class="none" bindtap="chooseCamera">
        <view class="media-option-left">
          <image class="media-art mini camera-art" src="/assets/images/home-media-mini01.png" mode="aspectFit" />
          <view class="media-option-copy">
            <view>拍照</view>
            <text>调用手机相机拍照</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-camera-card-right-icon.png" mode="aspectFit" />
      </view>
      <view class="media-option" hover-class="none" bindtap="chooseAlbum">
        <view class="media-option-left">
          <image class="media-art mini album-art" src="/assets/images/home-media-mini02.png" mode="aspectFit" />
          <view class="media-option-copy">
            <view>相册</view>
            <text>从手机相册选择照片</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-album-card-right-icon.png" mode="aspectFit" />
      </view>
      <view class="cancel-action" hover-class="none" bindtap="hideMediaSheet">取消</view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
  <debug-log></debug-log>
</view>
