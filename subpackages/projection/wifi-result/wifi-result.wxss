/* WiFi 版投屏结果：主按钮橙色渐变（与配网状态页一致），次按钮白底（2026-11-05 起与蓝牙版结果页同为两个按钮） */
.wifi-result-content {
  padding-bottom: calc(320rpx + var(--safe-bottom));
}

.wifi-result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 32rpx;
  padding: 40rpx 36rpx 36rpx;
}

/* 状态图标（2026-10-29，原为投屏图片）：尺寸同蓝牙版结果页 .result-art */
.wifi-result-art {
  display: block;
  width: 260rpx;
  height: 220rpx;
  margin: 16rpx auto 8rpx;
}

.wifi-result-device {
  margin-top: 24rpx;
  color: #8b9098;
  font-size: 24rpx;
}

.wifi-result-stage {
  margin-top: 20rpx;
  color: #2a2d32;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.wifi-result-stage.is-success {
  color: #ff5a1e;
}

.wifi-result-stage.is-failed {
  color: #e5533d;
}

/* 勾了「同时加入轮播」但没加进去：结果下方追加一行 */
.wifi-result-carousel {
  margin-top: 12rpx;
  color: #e5533d;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.wifi-result-progress {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 28rpx;
}

.wifi-result-progress__bar {
  flex: 1;
  height: 16rpx;
  overflow: hidden;
  background: rgba(255, 98, 31, 0.12);
  border-radius: 999rpx;
}

.wifi-result-progress__fill {
  height: 100%;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  transition: width 0.2s linear;
}

.wifi-result-progress__num {
  width: 88rpx;
  color: #ff621f;
  font-size: 24rpx;
  text-align: right;
}

.wifi-result-note {
  margin-top: 20rpx;
  color: #9ba2ad;
  font-size: 22rpx;
  text-align: center;
}

/* 投屏步骤（2026-11-12）：与配网状态页 .provision-steps 同一套尺寸、颜色与转圈（不同分包不能互相 @import，照搬一份） */
.cast-steps {
  margin-top: 24rpx;
  padding: 16rpx 36rpx;
}

.cast-step {
  display: flex;
  align-items: center;
  height: 96rpx;
}

.cast-step + .cast-step {
  border-top: 1rpx solid rgba(42, 43, 43, 0.06);
}

.step-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  box-sizing: border-box;
  border-radius: 50%;
}

/* 未开始：白底灰边圆圈，圈里是序号 1~4 */
.cast-step.is-pending .step-icon {
  background: #ffffff;
  border: 3rpx solid #c8cdd5;
}

.step-icon__no {
  color: #8b9098;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

/* 执行中：橙色转圈 */
.step-icon__spinner {
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 98, 31, 0.18);
  border-top-color: #ff621f;
  border-radius: 50%;
  animation: castStepSpin 0.8s linear infinite;
}

/* 通过：橙色实心勾；失败：红色实心叉 */
.cast-step.is-done .step-icon {
  background: linear-gradient(135deg, #ff8338, #ff621f);
}

.cast-step.is-fail .step-icon {
  background: #e5533d;
}

.step-icon__mark {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.step-text {
  color: #8b9098;
  font-size: 28rpx;
}

.cast-step.is-loading .step-text,
.cast-step.is-done .step-text {
  color: #2a2d32;
}

.cast-step.is-loading .step-text {
  font-weight: 700;
}

.cast-step.is-fail .step-text {
  color: #e5533d;
}

@keyframes castStepSpin {
  to {
    transform: rotate(360deg);
  }
}

.wifi-result-list {
  margin-top: 24rpx;
  padding: 8rpx 32rpx;
}

/* 最多露 4 行（行高 96rpx，border-box 含分隔线），多出的在框内上下滑动 */
.wifi-result-list__scroll {
  max-height: 384rpx;
}

.wifi-result-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  color: #8b9098;
  font-size: 26rpx;
}

.wifi-result-row + .wifi-result-row {
  border-top: 1rpx solid rgba(42, 43, 43, 0.06);
}

.wifi-result-row__thumb {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
}

.wifi-result-row__no {
  margin-right: 20rpx;
  color: #4a5059;
}

.wifi-result-row__text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* V1.4 起不等 ack：SENT（已发送刷屏）/ UPLOADED（只上传）都算这一张成功 */
.wifi-result-row.is-SENT .wifi-result-row__text,
.wifi-result-row.is-UPLOADED .wifi-result-row__text {
  color: #0e9f87;
}

.wifi-result-row.is-FAILED .wifi-result-row__text {
  color: #e5533d;
}

.wifi-result-row.is-running .wifi-result-row__text {
  color: #ff621f;
}

.wifi-result-actions {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + var(--safe-bottom));
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.wifi-result-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 36rpx;
  font-weight: 700;
}

.wifi-result-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin-top: 24rpx;
  color: #2a2d32;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 700;
}

/* ── 「拍照 / 相册」选择弹层（与蓝牙版结果页同款，点「再投一张」后弹出）。滑入 / 滑出动画在 app.wxss ── */
.media-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 46rpx;
  color: #2a2b2b;
  font-size: 40rpx;
  font-weight: 500;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 128rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  background: #f8f9fb;
  border-radius: 28rpx;
}

.media-option-left {
  display: flex;
  align-items: center;
}

.media-art.mini {
  position: relative;
  width: 98rpx;
  height: 96rpx;
}

.media-option-copy {
  height: 100%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  padding-left: 28rpx;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  width: 118rpx;
  height: 118rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 500;
}
