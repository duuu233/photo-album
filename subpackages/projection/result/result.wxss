.result-page {
  display: flex;
  flex-direction: column;
}

.result-body {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 48rpx 56rpx 0;
  text-align: center;
}

.result-art {
  display: block;
  width: 260rpx;
  height: 220rpx;
  margin: 40rpx auto 48rpx;
}

.result-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.result-desc {
  margin-top: 22rpx;
  color: #828a95;
  font-size: 26rpx;
  line-height: 1.5;
}

.progress-percent {
  margin-top: 56rpx;
  color: #ff6421;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.progress-percent__sign {
  margin-left: 4rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.progress-bar {
  flex: 1;
  height: 18rpx;
  overflow: hidden;
  background: #e6ebf2;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff8a45, #ff6421);
  border-radius: 999rpx;
  transition: width 0.25s ease;
}

.progress-count {
  flex: 0 0 auto;
  color: #828a95;
  font-size: 26rpx;
}

/* 进度条下方的投屏注意事项提示（多条，序号列表样式） */
.progress-tips {
  margin-top: 44rpx;
  padding: 30rpx 32rpx;
  text-align: left;
}

.progress-tip-item {
  display: flex;
  align-items: flex-start;
}

.progress-tip-item + .progress-tip-item {
  margin-top: 20rpx;
}

.progress-tip-index {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin: 3rpx 16rpx 0 0;
  color: #ff6421;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  background: rgba(255, 100, 33, 0.12);
  border-radius: 50%;
}

.progress-tip-text {
  flex: 1;
  color: #828a95;
  font-size: 24rpx;
  line-height: 1.5;
}

.info-card {
  margin-top: 60rpx;
  overflow: hidden;
  padding: 0 40rpx;
}

.info-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 120rpx;

  text-align: left;
}
.info-icon__img {
  width: 100%;
  height: 100%;
  display: inline-block;
}
.info-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 48rpx;
  height: 48rpx;
  margin-right: 38rpx;
}

.info-label {
  flex: 1;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 600;
}

.info-arrow {
  margin-left: 16rpx;
  color: #c2c8d0;
}

.info-value {
  color: #808690;
  font-size: 28rpx;
}

/* 投屏明细计数：绿色=成功(successCount/所选)、红色=失败(failCount/所选)，部分成功两者并排 */
.info-detail {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
}

.detail-count--ok {
  color: #12b76a;
}

.detail-count--fail {
  color: #f0483e;
}

.detail-sep {
  margin: 0 8rpx;
  color: #c2c8d0;
}

/* 失败页固定排查提示（复用 progress-tip 列表样式） */
.fail-tips {
  margin-top: 32rpx;
  padding: 30rpx 32rpx;
  text-align: left;
}

.result-actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 56rpx calc(60rpx + var(--safe-bottom));
}

.result-primary,
.result-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.result-primary {
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
}

.result-secondary {
  color: #2a2d32;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

/* ── 「拍照 / 相册」选择弹层（与首页/设备详情页同款，点「继续投屏」后弹出）。滑入/滑出动画在 app.wxss ── */
.media-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 46rpx;
  color: #2a2b2b;
  font-size: 40rpx;
  font-weight: 500;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 128rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  background: #f8f9fb;
  border-radius: 28rpx;
}

.media-option-left {
  display: flex;
  align-items: center;
}

.media-art.mini {
  position: relative;
  width: 98rpx;
  height: 96rpx;
}

.media-option-copy {
  height: 100%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  padding-left: 28rpx;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  width: 118rpx;
  height: 118rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 500;
}
