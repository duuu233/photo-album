.result-page {
  display: flex;
  flex-direction: column;
}

.result-body {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 48rpx 56rpx 0;
  text-align: center;
}

.result-art {
  display: block;
  width: 260rpx;
  height: 220rpx;
  margin: 40rpx auto 48rpx;
}

.result-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.result-desc {
  margin-top: 22rpx;
  color: #828a95;
  font-size: 26rpx;
  line-height: 1.5;
}

.progress-percent {
  margin-top: 56rpx;
  color: #ff6421;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.progress-percent__sign {
  margin-left: 4rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.progress-bar {
  flex: 1;
  height: 18rpx;
  overflow: hidden;
  background: #e6ebf2;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff8a45, #ff6421);
  border-radius: 999rpx;
  transition: width 0.25s ease;
}

.progress-count {
  flex: 0 0 auto;
  color: #828a95;
  font-size: 26rpx;
}

/* 进度条下方的投屏注意事项提示 */
.progress-tip {
  margin-top: 24rpx;
  color: #828a95;
  font-size: 24rpx;
  text-align: center;
}

.info-card {
  margin-top: 60rpx;
  overflow: hidden;
  padding: 0 40rpx;
}

.info-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 120rpx;

  text-align: left;
}
.info-icon__img {
  width: 100%;
  height: 100%;
  display: inline-block;
}
.info-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 48rpx;
  height: 48rpx;
  margin-right: 38rpx;
}

.info-label {
  flex: 1;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 600;
}

.info-arrow {
  margin-left: 16rpx;
  color: #c2c8d0;
}

.info-value {
  color: #808690;
  font-size: 28rpx;
}

.result-actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 56rpx calc(60rpx + var(--safe-bottom));
}

.result-primary,
.result-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.result-primary {
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
}

.result-secondary {
  color: #2a2d32;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}
