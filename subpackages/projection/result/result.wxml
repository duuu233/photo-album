<view class="mock-root result-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607071032177373571.png" mode="aspectFill"></image>
  </view>

  <page-nav title="{{title}}"></page-nav> 

  <view class="result-body">
    <image class="result-art {{status}}" src="{{artImage}}" mode="aspectFit"></image>

    <view class="result-title">{{title}}</view>
    <view class="result-desc">{{desc}}</view>

    <block wx:if="{{status === 'progress'}}">
      <view class="progress-percent">{{progressPercent}}<text class="progress-percent__sign">%</text></view>
      <view class="progress-wrap">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
        </view>
        <text class="progress-count">{{progressCurrent}}/{{progressTotal}}</text>
      </view>
      <view class="progress-tips glass-panel">
        <view class="progress-tip-item">
          <text class="progress-tip-index">1</text>
          <text class="progress-tip-text">投屏过程请保持手机亮屏，不要远离设备</text>
        </view>
        <view class="progress-tip-item">
          <text class="progress-tip-index">2</text>
          <text class="progress-tip-text">批量投屏如果意外中断，请前往图库主动刷新屏幕</text>
        </view>
        <view class="progress-tip-item">
          <text class="progress-tip-index">3</text>
          <text class="progress-tip-text">投屏失败的图片可以前往投屏记录重新上传</text>
        </view>
      </view>
    </block>

    <view wx:else class="info-card glass-panel">
      <view class="info-row">
        <view class="info-icon"><image class="info-icon__img" src="/assets/images/projection-result-icon01.png" mode="aspectFit"></image></view>
        <text class="info-label">投屏设备</text>
        <text class="info-value">{{deviceName}}</text>
      </view>
      <view class="thin-divider"></view>
      <view class="info-row" hover-class="none" bindtap="goRecords">
        <view class="info-icon"><image class="info-icon__img" src="/assets/images/projection-result-icon02.png" mode="aspectFit"></image></view>
        <text class="info-label">投屏管理</text>
        <text class="info-value">{{recordCount}}张</text>
        <view class="ui-chevron info-arrow"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{status !== 'progress'}}" class="result-actions">
    <view wx:if="{{status === 'success'}}" class="result-primary" hover-class="none" bindtap="continueProjection">继续投屏</view>
    <view wx:else class="result-primary" hover-class="none" bindtap="retry">重新投屏</view>
    <view class="result-secondary" hover-class="none" bindtap="backHome">返回首页</view>
  </view>

  <!-- 「拍照 / 相册」选择弹层：点「继续投屏」后在当前页弹出（与首页一致，不跳首页）。点遮罩关闭；点弹层内部 catchtap="noop" 阻止冒泡避免误关 -->
  <view
    class="media-mask"
    wx:if="{{showMediaSheet}}"
    catchtouchmove="noop"
    bindtap="hideMediaSheet"
  >
    <view class="bottom-sheet media-sheet {{mediaSheetClosing ? 'pop-closing-sheet' : ''}}" catchtap="noop">
      <view class="media-sheet-title">选择投屏方式</view>
      <view class="media-option" hover-class="none" bindtap="chooseCamera">
        <view class="media-option-left">
          <image class="media-art mini camera-art" src="/assets/images/home-media-mini01.png" mode="aspectFit" />
          <view class="media-option-copy">
            <view>拍照</view>
            <text>调用手机相机拍照</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-camera-card-right-icon.png" mode="aspectFit" />
      </view>
      <view class="media-option" hover-class="none" bindtap="chooseAlbum">
        <view class="media-option-left">
          <image class="media-art mini album-art" src="/assets/images/home-media-mini02.png" mode="aspectFit" />
          <view class="media-option-copy">
            <view>相册</view>
            <text>从手机相册选择照片</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-album-card-right-icon.png" mode="aspectFit" />
      </view>
      <view class="cancel-action" hover-class="none" bindtap="hideMediaSheet">取消</view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
