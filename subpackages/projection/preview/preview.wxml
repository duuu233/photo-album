<view class="mock-root preview-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607071032177373571.png" mode="aspectFill"></image>
  </view>

  <page-nav title="照片预览"></page-nav>

  <view class="preview-counter" wx:if="{{imageCount}}">
    <view class="preview-imageCount">   {{activeIndex + 1}}/{{imageCount}}  </view>
  </view>

  <view class="preview-stage">
    <!-- 多图轮播（2026-07-24 恢复 swiper）：左右滑动切换图片，下方小圆点指示当前索引。
         触摸交由上层 .edit-layer 的手势分流驱动（swiper 只负责切图时的滑动过场）。
         2026-07-25 三处修正：
         ① 编辑层起来时整条 swiper 隐藏（is-hidden，visibility 而非 wx:if，避免销毁重建导致
            current 复位/闪烁）——否则横向取景时取景框上下会露出底层那张竖向图（用户反馈①）；
         ② 图片源优先取 previewSrc（切图前烘焙的「所见即所得」缓存），过场里不再闪回未裁剪原图；
         ③ 隐藏时机改为「编辑层图片已解码(editReady)」而不是「编辑层已挂载(editing)」——原先两者
            同一次 setData 完成，swiper 已经藏了、编辑层的 <image> 还没画出来，中间就露出 .edit-clip
            的灰底，看着就是「闪一下像重新加载」。现在交接期间底层 swiper 一直顶着。 -->
    <swiper wx:if="{{imageCount}}" class="preview-swiper {{editing && !sliding && editReady ? 'is-hidden' : ''}}" current="{{activeIndex}}" duration="300" bindchange="onSwiperChange">
      <swiper-item wx:for="{{images}}" wx:key="index">
        <view class="photo-wrap" style="{{item.wrapStyle || deviceWrapStyle}}">
          <image wx:if="{{item.previewSrc || item.tempFilePath || item.url}}" class="photo-img"
                 style="{{item.imgStyle || ''}}" src="{{item.previewSrc || item.tempFilePath || item.url}}" mode="aspectFill"></image>
          <view wx:else class="photo-img photo-placeholder">图片占位</view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="photo-wrap empty-photo">暂无待投屏照片</view>

    <!-- 常驻编辑层（catch 全部触摸，在 JS 里分流）：
         · 单指快速左右滑 → 切图（swiper 过场）；
         · 单指长按 1s（伴放大回弹 + 震动，仿苹果相册）→ 进入拖拽，之后单指平移图片；
         · 双指 → 缩放 + 旋转（随时可用，不需长按）。
         2026-07-25 修「来回切图闪一下」：本层**不再用 wx:if 销毁重建**——一销毁，里面的 <image>
         节点跟着没了，切回来必须重新下载解码，就是用户看到的「像重新加载」。改为整层常驻，
         切图过场(sliding)/新图还没解码完(!editReady) 时只加 is-hidden（透明 + 不吃触摸），
         让底层 swiper 顶着画面；等 bindload 到了再显形。 -->
    <view wx:if="{{imageCount && editSrc}}"
          class="edit-layer {{editing && !sliding && editReady ? '' : 'is-hidden'}}"
          catchtouchstart="onEditTouchStart"
          catchtouchmove="onEditTouchMove"
          catchtouchend="onEditTouchEnd"
          catchtouchcancel="onEditTouchEnd">
      <view class="edit-clip {{editPickup ? 'is-pickup' : ''}} {{dragging ? 'is-dragging' : ''}}"
            style="left:{{frame.left}}px; top:{{frame.top}}px; width:{{frame.width}}px; height:{{frame.height}}px;">
        <image class="edit-image" src="{{editSrc}}" mode="scaleToFill"
               bindload="onEditImageLoad" binderror="onEditImageError"
               style="left:{{editImgLeft}}px; top:{{editImgTop}}px; width:{{editBaseW}}px; height:{{editBaseH}}px; transform:{{editTransform}};"></image>
      </view>
    </view>

    <!-- 图右上角悬浮：顺时针转90°（跟随取景框右上角定位，样式里再往左平移自身宽度） -->
    <view wx:if="{{editing && !sliding && editReady && frame}}" class="rotate-fab"
          style="left:{{frame.left + frame.width - 12}}px; top:{{frame.top + 12}}px;"
          catchtap="rotate90">↻ 90°</view>
  </view>

  <!-- 轮播小圆点（多图才显示，样式仿首页设备列表、尺寸略小） -->
  <view class="carousel-dots" wx:if="{{imageCount > 1}}">
    <view class="dot {{index === activeIndex ? 'active' : ''}}" wx:for="{{images}}" wx:key="index"></view>
  </view>

  <!-- 分段控制器（2026-07-25 改，仿 element-plus el-segmented）：竖向/横向/原图 三档等宽同框，
       位置沿用原工具栏。选中档由一块白色滑块 .segmented-thumb 标示，切换时**滑过去**而不是直接跳。
       ⚠️ 「原图」是**动作**不是状态（点了弹二次确认、还原成最初的图），所以它没有滑块位：
          滑块只在 竖向(0) / 横向(1) 两档间移动，点原图滑块原地不动 —— 有意为之，别当 bug 改。
          还原后取景方向会重置回竖向，滑块自然回到第 0 档。 -->
  <view class="segmented" wx:if="{{imageCount}}">
    <view class="segmented-thumb" style="transform: translateX({{orientation === 'landscape' ? 100 : 0}}%);"></view>
    <view class="segmented-item {{orientation === 'portrait' ? 'is-active' : ''}}" hover-class="segmented-item--hover" hover-stay-time="80" data-orient="portrait" bindtap="setOrientation">
      <image class="segmented-icon" src="{{orientation === 'portrait' ? '/assets/images/preview-icon01-selected.png' : '/assets/images/preview-icon01.png'}}" mode="aspectFit"></image>
      <text>竖向</text>
    </view>
    <view class="segmented-item {{orientation === 'landscape' ? 'is-active' : ''}}" hover-class="segmented-item--hover" hover-stay-time="80" data-orient="landscape" bindtap="setOrientation">
      <image class="segmented-icon" src="{{orientation === 'landscape' ? '/assets/images/preview-icon02-selected.png' : '/assets/images/preview-icon02.png'}}" mode="aspectFit"></image>
      <text>横向</text>
    </view>
    <view class="segmented-item" hover-class="segmented-item--hover" hover-stay-time="80" bindtap="restoreOrigin">
      <image class="segmented-icon" src="/assets/images/preview-icon03.png" mode="aspectFit"></image>
      <text>原图</text>
    </view>
  </view>

  <!-- 手势说明（2026-07-24 新增，放竖/横/原下方；2026-07-25 长按阈值 2s→1s，文案同步） -->
  <view class="gesture-tip" wx:if="{{imageCount}}">长按1秒后可拖拽图片、双指可缩放与旋转图片</view>

  <view class="preview-submit {{projecting ? 'is-disabled' : ''}}" hover-class="none" bindtap="confirmProjection">{{projecting ? '投屏中' : '开始投屏'}}</view>

  <!-- 离屏导出用画布（定位到屏幕外不可见）：投屏前把「取景框内所见」绘制到这里再导出临时文件 -->
  <canvas type="2d" id="cropCanvas" class="crop-canvas"></canvas>

  <global-toast id="globalToast"></global-toast>
</view>
