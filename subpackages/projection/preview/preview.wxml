<view class="mock-root preview-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="/assets/images/bg02.png" mode="aspectFill"></image>
  </view>

  <page-nav title="照片预览" right-text="保存" bind:righttap="savePhoto"></page-nav>

  <view class="preview-counter" wx:if="{{imageCount}}">
    <text class="counter-current">{{activeIndex + 1}}</text>/{{imageCount}}
  </view>

  <view class="preview-stage">
    <swiper wx:if="{{images.length}}" class="preview-swiper" current="{{activeIndex}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{images}}" wx:key="index">
        <view class="photo-wrap">
          <image wx:if="{{item.tempFilePath || item.url}}" class="photo-img" src="{{item.tempFilePath || item.url}}" mode="aspectFill" style="transform: rotate({{index === activeIndex ? rotation : 0}}deg);"></image>
          <view wx:else class="photo-img photo-placeholder">图片占位</view>
          <view wx:if="{{index === activeIndex && activeTool === 'crop'}}" class="crop-corners">
            <view class="crop-corner corner-tl"></view>
            <view class="crop-corner corner-tr"></view>
            <view class="crop-corner corner-bl"></view>
            <view class="crop-corner corner-br"></view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="photo-wrap empty-photo">暂无待投屏照片</view>
  </view>

  <view class="tool-bar">
    <button class="tool {{activeTool === 'crop' ? 'is-active' : ''}}" hover-class="none" data-tool="crop" bindtap="selectTool">
      <view class="tool-icon tool-crop"></view>
      <text>裁剪</text>
    </button>
    <button class="tool {{activeTool === 'rotate' ? 'is-active' : ''}}" hover-class="none" data-tool="rotate" bindtap="selectTool">
      <view class="tool-icon tool-rotate"></view>
      <text>旋转</text>
    </button>
    <button class="tool {{activeTool === 'origin' ? 'is-active' : ''}}" hover-class="none" data-tool="origin" bindtap="selectTool">
      <view class="tool-icon tool-origin"></view>
      <text>原图</text>
    </button>
  </view>

  <button class="preview-submit" loading="{{projecting}}" hover-class="none" bindtap="confirmProjection">{{projecting ? '投屏中' : '开始投屏'}}</button>
</view>
