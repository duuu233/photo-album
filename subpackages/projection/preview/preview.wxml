<view class="mock-root preview-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607071032177373571.png" mode="aspectFill"></image>
  </view>

  <page-nav title="照片预览"></page-nav>

  <view class="preview-counter" wx:if="{{imageCount}}">
    <view class="preview-imageCount">   {{activeIndex + 1}}/{{imageCount}}  </view>
  </view>

  <view class="preview-stage">
    <!-- 常驻编辑层（2026-07-22）：可视区域固定（按 竖向/横向 锁比例），图片在其下自由
         单指平移 / 双指缩放+旋转，区内即最终成像；没有保存按钮，点「开始投屏」自动按区内所见烘焙上传。
         2026-07-22 优化：不再画裁剪框/九宫格/框外遮罩，可视区外的内容由 .edit-clip 的 overflow:hidden 直接裁掉。 -->
    <view wx:if="{{editing}}" class="edit-layer"
          catchtouchstart="onEditTouchStart"
          catchtouchmove="onEditTouchMove"
          catchtouchend="onEditTouchEnd"
          catchtouchcancel="onEditTouchEnd">
      <view class="edit-clip" style="left:{{frame.left}}px; top:{{frame.top}}px; width:{{frame.width}}px; height:{{frame.height}}px;">
        <image class="edit-image" src="{{editSrc}}" mode="scaleToFill"
               style="left:{{editImgLeft}}px; top:{{editImgTop}}px; width:{{editBaseW}}px; height:{{editBaseH}}px; transform:{{editTransform}};"></image>
      </view>
      <view wx:if="{{editHint}}" class="edit-hint">单指拖动 · 双指缩放/旋转 · 右上角转90°</view>
    </view>

    <!-- 编辑层没起来（无图/读图失败等）的 fallback 普通预览。烘焙成图即所见（无旋转），直接铺 -->
    <view wx:else class="photo-wrap" style="{{activeImage.wrapStyle || deviceWrapStyle}}">
      <image wx:if="{{activeImage && (activeImage.tempFilePath || activeImage.url)}}" class="photo-img"
             src="{{activeImage.tempFilePath || activeImage.url}}" mode="aspectFill"></image>
      <view wx:elif="{{imageCount}}" class="photo-img photo-placeholder">图片占位</view>
      <view wx:else class="photo-img photo-placeholder">暂无待投屏照片</view>
    </view>

    <!-- 图右上角悬浮：顺时针转90°（跟随取景框右上角定位，样式里再往左平移自身宽度） -->
    <view wx:if="{{editing && frame}}" class="rotate-fab"
          style="left:{{frame.left + frame.width - 12}}px; top:{{frame.top + 12}}px;"
          catchtap="rotate90">↻ 90°</view>
  </view>

  <!-- 竖向/横向 分段控制器（交互仿 element-plus 的 el-segmented：白色滑块滑到选中项）。
       只改可视区域（取景框比例），图片本身不动；横向超出可视区的部分单指拖动调整。 -->
  <view class="orient-seg" wx:if="{{imageCount}}">
    <view class="orient-seg__thumb {{orientation === 'landscape' ? 'to-right' : ''}}"></view>
    <view class="orient-seg__item {{orientation === 'portrait' ? 'is-on' : ''}}" hover-class="none" data-orient="portrait" bindtap="setOrientation">竖向</view>
    <view class="orient-seg__item {{orientation === 'landscape' ? 'is-on' : ''}}" hover-class="none" data-orient="landscape" bindtap="setOrientation">横向</view>
  </view>

  <view class="tool-bar" wx:if="{{imageCount}}">
    <view class="tool" hover-class="none" bindtap="restoreOrigin">
      <image class="tool-icon" src="/assets/images/preview-icon03.png" mode="aspectFit"></image>
      <text>原图</text>
    </view>
    <!-- 临时联调（2026-07-22）：把当前图传给 seekink 抖动 bin 接口并打印返回，后续处理待定 -->
    <view class="tool tool--text" hover-class="none" bindtap="fetchDitheringBin">
      <text>抖动Bin</text>
    </view>
  </view>

  <!-- 上一张/下一张（2026-07-22：替代左右滑动切图），多图才显示；切图保留各自的编辑状态 -->
  <view class="nav-row" wx:if="{{imageCount > 1}}">
    <view class="nav-btn {{activeIndex <= 0 ? 'is-disabled' : ''}}" hover-class="none" bindtap="prevImage">上一张</view>
    <view class="nav-btn {{activeIndex >= imageCount - 1 ? 'is-disabled' : ''}}" hover-class="none" bindtap="nextImage">下一张</view>
  </view>

  <view class="preview-submit {{projecting ? 'is-disabled' : ''}}" hover-class="none" bindtap="confirmProjection">{{projecting ? '投屏中' : '开始投屏'}}</view>

  <!-- 离屏导出用画布（定位到屏幕外不可见）：投屏前把「取景框内所见」绘制到这里再导出临时文件 -->
  <canvas type="2d" id="cropCanvas" class="crop-canvas"></canvas>

  <global-toast id="globalToast"></global-toast>
</view>
