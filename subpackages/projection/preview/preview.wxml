<view
  class="mock-root preview-page"
  style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;"
>
  <view class="mock-bg">
    <image
      class="mock-bg__image"
      src="https://oss.boltfox.cn/prodFile/202607310920402821453.png"
      mode="aspectFill" />
  </view>
  <page-nav title="照片预览">
  </page-nav>
  <view class="preview-counter" wx:if="{{imageCount}}">
    <view class="preview-imageCount">{{activeIndex + 1}}/{{imageCount}}</view>
  </view>
  <view class="preview-stage">
    <!-- Banner 轨道（2026-08-01 自绘，替掉原来的 swiper）
         为什么不用 swiper：swiper 的触摸被上层 .edit-layer 的 catch 手势独占，它只能在松手后
         被动播一段 360ms 过场——手指划的时候画面纹丝不动，松手才「啪」地跳一下，既不像 banner，
         交接瞬间还会闪。这里改成自己画轨道：
           · 轨道里横排「上一张 / 当前 / 下一张」三格，slideDx 跟手实时平移，边界给三分之一阻尼；
           · 当前格上叠着常驻编辑层，滑走的就是用户此刻看到的构图本身，起手不闪；
           · 松手补完 300ms 过场后原地把 activeIndex 换掉、轨道无动画归零，
             此时进场那张已经解码好（过场中一直在屏上），换过去看不出接缝。 -->
    <view
      wx:if="{{imageCount}}"
      class="slide-track {{slideAnimating ? 'is-animating' : ''}}"
      style="transform: translateX({{slideDx}}px);"
    >
      <!-- 上一张：位于当前格左侧一屏，手指右滑时从左边露出来 -->
      <view wx:if="{{prevImage}}" class="slide-cell slide-cell--prev">
        <view class="photo-wrap" style="{{prevImage.wrapStyle || deviceWrapStyle}}">
          <image
            wx:if="{{prevImage.previewSrc || prevImage.tempFilePath || prevImage.url}}"
            class="photo-img"
            style="{{prevImage.imgStyle || ''}}"
            src="{{prevImage.previewSrc || prevImage.tempFilePath || prevImage.url}}"
            mode="aspectFill" />
        </view>
      </view>

      <!-- 当前格底图：编辑层没就绪（换图/解码中）时由它顶着画面，绝不会露出白底或占位灰。
           编辑层一就绪就藏起来——否则横向取景时取景框上下会露出这张竖向比例的底图。
           图源优先 previewSrc（构图烘焙缓存），滑回来看到的就是上次构好的画面，不会闪回原图。 -->
      <view class="slide-cell slide-cell--current {{editing && editReady ? 'is-hidden' : ''}}">
        <view class="photo-wrap" style="{{activeImage.wrapStyle || deviceWrapStyle}}">
          <image
            wx:if="{{activeImage.previewSrc || activeImage.tempFilePath || activeImage.url}}"
            class="photo-img"
            style="{{activeImage.imgStyle || ''}}"
            src="{{activeImage.previewSrc || activeImage.tempFilePath || activeImage.url}}"
            mode="aspectFill" />
          <view wx:else class="photo-img photo-placeholder">图片占位</view>
        </view>
      </view>

      <!-- 下一张：位于当前格右侧一屏，手指左滑时从右边露出来 -->
      <view wx:if="{{nextImage}}" class="slide-cell slide-cell--next">
        <view class="photo-wrap" style="{{nextImage.wrapStyle || deviceWrapStyle}}">
          <image
            wx:if="{{nextImage.previewSrc || nextImage.tempFilePath || nextImage.url}}"
            class="photo-img"
            style="{{nextImage.imgStyle || ''}}"
            src="{{nextImage.previewSrc || nextImage.tempFilePath || nextImage.url}}"
            mode="aspectFill" />
        </view>
      </view>

      <!-- 常驻编辑层：单指左右滑走 Banner 过场；单指长按 0.5s 后才可平移；双指自由缩放与旋转。
           放在轨道内 → 过场时跟着一起滑出去，滑的就是用户此刻所见（不再先切成静态图再动）。
           用 opacity 而不是 wx:if 切换，避免 <image> 被拆掉后切回来重新下载解码。 -->
      <view
        wx:if="{{imageCount && editSrc}}"
        class="edit-layer {{editing && editReady ? '' : 'is-hidden'}}"
        catchtouchstart="onEditTouchStart"
        catchtouchmove="onEditTouchMove"
        catchtouchend="onEditTouchEnd"
        catchtouchcancel="onEditTouchEnd"
      >
        <view class="edit-clip {{editPickup ? 'is-pickup' : ''}} {{dragging ? 'is-dragging' : ''}}" style="left:{{frame.left}}px; top:{{frame.top}}px; width:{{frame.width}}px; height:{{frame.height}}px;">
          <image
            class="edit-image"
            src="{{editSrc}}"
            mode="scaleToFill"
            bindload="onEditImageLoad"
            binderror="onEditImageError"
            style="left:{{editImgLeft}}px; top:{{editImgTop}}px; width:{{editBaseW}}px; height:{{editBaseH}}px; transform:{{editTransform}};" />
        </view>
      </view>

      <!-- 图右上角悬浮：顺时针转90°（跟随取景框右上角定位，样式里再往左平移自身宽度）。
           同样放在轨道内，过场时与图一起滑走，不会孤零零停在原地。 -->
      <view
        wx:if="{{editing && editReady && frame}}"
        class="rotate-fab"
        style="left:{{frame.left + frame.width - 12}}px; top:{{frame.top + 12}}px;"
        catchtap="rotate90"
      >
        ↻ 90°
      </view>
    </view>
    <view wx:else class="photo-wrap empty-photo">暂无待投屏照片</view>
  </view>
  <!-- 轮播小圆点（多图才显示，样式仿首页设备列表、尺寸略小） -->
  <view class="carousel-dots" wx:if="{{imageCount > 1}}">
    <view
      class="dot {{index === activeIndex ? 'active' : ''}}"
      wx:for="{{images}}"
      wx:key="index"
    >
    </view>
  </view>
  <!-- 操作栏（2026-07-27 恢复仿 el-segmented 交互）：灰色轨道内放一块白色选中滑块， orientation 改变时滑块在竖向/横向之间平滑移动，选中项同步切换橙色图标和文字。 ⚠️ 「原图」是动作而非第三个状态：点击后弹二次确认，滑块保持当前方向； 确认还原后 orientation 重置为竖向，滑块随状态回到第一档。 -->
  <!-- -->
  <view class="segmented" wx:if="{{imageCount}}">
    <view class="segmented-thumb" style="transform: translateX({{orientation === 'landscape' ? 100 : 0}}%);">
    </view>
    <view
      class="segmented-item {{orientation === 'portrait' ? 'is-active' : ''}}"
      hover-class="segmented-item--hover"
      hover-stay-time="80"
      data-orient="portrait"
      bindtap="setOrientation"
    >
      <image
        class="segmented-icon"
        src="{{orientation === 'portrait' ? '/assets/images/preview-icon01-selected.png' : '/assets/images/preview-icon01.png'}}"
        mode="aspectFit" />
      <text>竖向</text>
    </view>
    <view
      class="segmented-item {{orientation === 'landscape' ? 'is-active' : ''}}"
      hover-class="segmented-item--hover"
      hover-stay-time="80"
      data-orient="landscape"
      bindtap="setOrientation"
    >
      <image
        class="segmented-icon"
        src="{{orientation === 'landscape' ? '/assets/images/preview-icon02-selected.png' : '/assets/images/preview-icon02.png'}}"
        mode="aspectFit" />
      <text>横向</text>
    </view>
    <view
      class="segmented-item"
      hover-class="segmented-item--hover"
      hover-stay-time="80"
      bindtap="restoreOrigin"
    >
      <image
        class="segmented-icon"
        src="/assets/images/preview-icon03.png"
        mode="aspectFit" />
      <text>原图</text>
    </view>
  </view>
  <view class="gesture-tip" wx:if="{{imageCount}}">长按0.5秒后可拖拽图片，双指可自由缩放与旋转</view>
  <view
    class="preview-submit {{projecting ? 'is-disabled' : ''}}"
    hover-class="none"
    bindtap="confirmProjection"
  >
    {{projecting ? '投屏中' : '开始投屏'}}
  </view>
  <!-- 离屏导出用画布（定位到屏幕外不可见）：投屏前把「取景框内所见」绘制到这里再导出临时文件 -->
  <canvas
    type="2d"
    id="cropCanvas"
    class="crop-canvas" />
  <global-toast id="globalToast">
  </global-toast>
</view>
