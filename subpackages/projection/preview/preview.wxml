<view
  class="mock-root preview-page"
  style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;"
>
  <view class="mock-bg">
    <image
      class="mock-bg__image"
      src="https://oss.boltfox.cn/prodFile/202607310920402821453.png"
      mode="aspectFill" />
  </view>
  <page-nav title="照片预览">
  </page-nav>
  <view class="preview-counter" wx:if="{{imageCount}}">
    <view class="preview-imageCount">{{activeIndex + 1}}/{{imageCount}}</view>
  </view>
  <view class="preview-stage">
    <!-- 多图轮播（2026-07-24 恢复 swiper）：左右滑动切换图片，下方小圆点指示当前索引。 触摸交由上层 .edit-layer 的手势分流驱动（swiper 只负责切图时的滑动过场）。 2026-07-25 三处修正： ① 编辑层起来时整条 swiper 隐藏（is-hidden，visibility 而非 wx:if，避免销毁重建导致 current 复位/闪烁）——否则横向取景时取景框上下会露出底层那张竖向图（用户反馈①）； ② 图片源优先取 previewSrc（切图前烘焙的「所见即所得」缓存），过场里不再闪回未裁剪原图； ③ 隐藏时机改为「编辑层图片已解码(editReady)」而不是「编辑层已挂载(editing)」——原先两者 同一次 setData 完成，swiper 已经藏了、编辑层的 <image> 还没画出来，中间就露出 .edit-clip 的灰底，看着就是「闪一下像重新加载」。现在交接期间底层 swiper 一直顶着。 -->
    <swiper
      wx:if="{{imageCount}}"
      class="preview-swiper {{editing && !sliding && editReady ? 'is-hidden' : ''}}"
      current="{{activeIndex}}"
      duration="360"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{images}}" wx:key="index">
        <view class="photo-wrap" style="{{item.wrapStyle || deviceWrapStyle}}">
          <image
            wx:if="{{item.previewSrc || item.tempFilePath || item.url}}"
            class="photo-img"
            style="{{item.imgStyle || ''}}"
            src="{{item.previewSrc || item.tempFilePath || item.url}}"
            mode="aspectFill" />
          <view wx:else class="photo-img photo-placeholder">图片占位</view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="photo-wrap empty-photo">暂无待投屏照片</view>
    <!-- 常驻编辑层：单指左右滑走 Banner 过场；单指长按 0.5s 后才可平移；双指自由缩放与旋转。 -->
    <view
      wx:if="{{imageCount && editSrc}}"
      class="edit-layer {{editing && !sliding && editReady ? '' : 'is-hidden'}}"
      catchtouchstart="onEditTouchStart"
      catchtouchmove="onEditTouchMove"
      catchtouchend="onEditTouchEnd"
      catchtouchcancel="onEditTouchEnd"
    >
      <view class="edit-clip {{editPickup ? 'is-pickup' : ''}} {{dragging ? 'is-dragging' : ''}}" style="left:{{frame.left}}px; top:{{frame.top}}px; width:{{frame.width}}px; height:{{frame.height}}px;">
        <image
          class="edit-image"
          src="{{editSrc}}"
          mode="scaleToFill"
          bindload="onEditImageLoad"
          binderror="onEditImageError"
          style="left:{{editImgLeft}}px; top:{{editImgTop}}px; width:{{editBaseW}}px; height:{{editBaseH}}px; transform:{{editTransform}};" />
      </view>
    </view>
    <!-- 图右上角悬浮：顺时针转90°（跟随取景框右上角定位，样式里再往左平移自身宽度） -->
    <view
      wx:if="{{editing && !sliding && editReady && frame}}"
      class="rotate-fab"
      style="left:{{frame.left + frame.width - 12}}px; top:{{frame.top + 12}}px;"
      catchtap="rotate90"
    >
      ↻ 90°
    </view>
  </view>
  <!-- 轮播小圆点（多图才显示，样式仿首页设备列表、尺寸略小） -->
  <view class="carousel-dots" wx:if="{{imageCount > 1}}">
    <view
      class="dot {{index === activeIndex ? 'active' : ''}}"
      wx:for="{{images}}"
      wx:key="index"
    >
    </view>
  </view>
  <!-- 操作栏（2026-07-27 恢复仿 el-segmented 交互）：灰色轨道内放一块白色选中滑块， orientation 改变时滑块在竖向/横向之间平滑移动，选中项同步切换橙色图标和文字。 ⚠️ 「原图」是动作而非第三个状态：点击后弹二次确认，滑块保持当前方向； 确认还原后 orientation 重置为竖向，滑块随状态回到第一档。 -->
  <!-- -->
  <view class="segmented" wx:if="{{imageCount}}">
    <view class="segmented-thumb" style="transform: translateX({{orientation === 'landscape' ? 100 : 0}}%);">
    </view>
    <view
      class="segmented-item {{orientation === 'portrait' ? 'is-active' : ''}}"
      hover-class="segmented-item--hover"
      hover-stay-time="80"
      data-orient="portrait"
      bindtap="setOrientation"
    >
      <image
        class="segmented-icon"
        src="{{orientation === 'portrait' ? '/assets/images/preview-icon01-selected.png' : '/assets/images/preview-icon01.png'}}"
        mode="aspectFit" />
      <text>竖向</text>
    </view>
    <view
      class="segmented-item {{orientation === 'landscape' ? 'is-active' : ''}}"
      hover-class="segmented-item--hover"
      hover-stay-time="80"
      data-orient="landscape"
      bindtap="setOrientation"
    >
      <image
        class="segmented-icon"
        src="{{orientation === 'landscape' ? '/assets/images/preview-icon02-selected.png' : '/assets/images/preview-icon02.png'}}"
        mode="aspectFit" />
      <text>横向</text>
    </view>
    <view
      class="segmented-item"
      hover-class="segmented-item--hover"
      hover-stay-time="80"
      bindtap="restoreOrigin"
    >
      <image
        class="segmented-icon"
        src="/assets/images/preview-icon03.png"
        mode="aspectFit" />
      <text>原图</text>
    </view>
  </view>
  <view class="gesture-tip" wx:if="{{imageCount}}">长按0.5秒后可拖拽图片，双指可自由缩放与旋转</view>
  <view
    class="preview-submit {{projecting ? 'is-disabled' : ''}}"
    hover-class="none"
    bindtap="confirmProjection"
  >
    {{projecting ? '投屏中' : '开始投屏'}}
  </view>
  <!-- 离屏导出用画布（定位到屏幕外不可见）：投屏前把「取景框内所见」绘制到这里再导出临时文件 -->
  <canvas
    type="2d"
    id="cropCanvas"
    class="crop-canvas" />
  <global-toast id="globalToast">
  </global-toast>
</view>
