<view class="mock-root preview-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607071032177373571.png" mode="aspectFill"></image>
  </view>

  <page-nav title="照片预览"></page-nav>

  <view class="preview-counter" wx:if="{{imageCount}}">
  <view class="preview-imageCount">   {{activeIndex + 1}}/{{imageCount}}  </view>
  
    <view class="preview-save" wx:if="{{editing}}" hover-class="none" bindtap="savePhoto">保存</view>
  </view>

  <view class="preview-stage">
    <swiper wx:if="{{images.length}}" class="preview-swiper" current="{{activeIndex}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{images}}" wx:key="index">
        <view class="photo-wrap" style="{{item.wrapStyle || deviceWrapStyle}}">
          <image wx:if="{{item.tempFilePath || item.url}}" class="photo-img" src="{{item.tempFilePath || item.url}}" mode="aspectFill"></image>
          <view wx:else class="photo-img photo-placeholder">图片占位</view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="photo-wrap empty-photo">暂无待投屏照片</view>

    <!-- 统一编辑层：盖在 swiper 之上。裁剪框固定（锁设备比例），图片在框下自由 平移/缩放/旋转，框内即最终成像。 -->
    <view wx:if="{{editing}}" class="edit-layer"
          catchtouchstart="onEditTouchStart"
          catchtouchmove="onEditTouchMove"
          catchtouchend="onEditTouchEnd"
          catchtouchcancel="onEditTouchEnd">
      <image class="edit-image" src="{{editSrc}}" mode="scaleToFill"
             style="left:{{editImgLeft}}px; top:{{editImgTop}}px; width:{{editBaseW}}px; height:{{editBaseH}}px; transform:{{editTransform}};"></image>
      <view class="edit-shade" style="left:{{frame.left}}px; top:{{frame.top}}px; width:{{frame.width}}px; height:{{frame.height}}px;"></view>
      <view class="edit-frame" style="left:{{frame.left}}px; top:{{frame.top}}px; width:{{frame.width}}px; height:{{frame.height}}px;">
        <view class="crop-third crop-third--v1"></view>
        <view class="crop-third crop-third--v2"></view>
        <view class="crop-third crop-third--h1"></view>
        <view class="crop-third crop-third--h2"></view>
        <view class="edit-corner corner-tl"></view>
        <view class="edit-corner corner-tr"></view>
        <view class="edit-corner corner-bl"></view>
        <view class="edit-corner corner-br"></view>
      </view>
      <view wx:if="{{editHint}}" class="edit-hint">{{editHintText}}</view>
    </view>

    <!-- 旋转交互切换（对比用）：放在编辑层之上、作为其兄弟节点，独立接管点击，不触发图片手势 -->
    <view wx:if="{{editing}}" class="rotate-mode-switch">
      <view class="rms-item {{rotateMode === 'pinch' ? 'is-on' : ''}}" data-mode="pinch" catchtap="setRotateMode">双指旋转</view>
      <view class="rms-item {{rotateMode === 'drag' ? 'is-on' : ''}}" data-mode="drag" catchtap="setRotateMode">长按旋转</view>
    </view>
  </view>

  <view class="tool-bar">
    <view class="tool {{activeTool === 'crop' ? 'is-active' : ''}}" hover-class="none" data-tool="crop" bindtap="selectTool">
      <image class="tool-icon" src="{{activeTool === 'crop' ? '/assets/images/preview-icon01-selected.png' : '/assets/images/preview-icon01.png'}}" mode="aspectFit"></image>
      <text>裁剪</text>
    </view>
    <view class="tool {{activeTool === 'rotate' ? 'is-active' : ''}}" hover-class="none" data-tool="rotate" bindtap="selectTool">
      <image class="tool-icon" src="{{activeTool === 'rotate' ? '/assets/images/preview-icon02-selected.png' : '/assets/images/preview-icon02.png'}}" mode="aspectFit"></image>
      <text>旋转</text>
    </view>
    <view class="tool {{activeTool === 'origin' ? 'is-active' : ''}}" hover-class="none" data-tool="origin" bindtap="selectTool">
      <image class="tool-icon" src="{{activeTool === 'origin' ? '/assets/images/preview-icon03-selected.png' : '/assets/images/preview-icon03.png'}}" mode="aspectFit"></image>
      <text>原图</text>
    </view>
  </view>

  <view class="preview-submit {{editing || projecting ? 'is-disabled' : ''}}" hover-class="none" bindtap="confirmProjection">{{projecting ? '投屏中' : '开始投屏'}}</view>

  <!-- 离屏导出用画布（定位到屏幕外不可见）：裁剪时把选区绘制到这里再导出临时文件 -->
  <canvas type="2d" id="cropCanvas" class="crop-canvas"></canvas>

  <global-toast id="globalToast"></global-toast>
</view>
