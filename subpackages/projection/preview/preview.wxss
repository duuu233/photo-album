.device-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx;
}

.device-name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.link-btn {
  color: #1769e0;
  font-size: 26rpx;
}

.notice {
  margin: 24rpx 0;
  padding: 18rpx 22rpx;
  color: #1769e0;
  background: #eaf2ff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.notice.danger {
  color: #c72e2e;
  background: #fff1f1;
}

.preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.preview-item {
  position: relative;
  height: 210rpx;
  overflow: hidden;
  background: #e4eaf2;
  border-radius: 8rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  color: #ffffff;
  background: rgba(24, 34, 48, 0.72);
  border-radius: 50%;
  font-size: 30rpx;
}

.submit-btn {
  margin-top: 32rpx;
}
