.preview-page {
  display: flex;
  flex-direction: column;
}

.preview-counter {
  position: relative;
  z-index: 1;
  min-height: 48rpx;
  margin: 4rpx 46rpx 0;
  color: #8b9098;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
}

/* 保存按钮：放在计数行内，靠右并与图片右边缘对齐 */
.preview-save {
  position: absolute;
  top: 0;
  right: 0;
  height: 48rpx;
  padding-left: 24rpx;
  color: #ff5f1f;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.counter-current {
  color: #ff5f1f;
}

.preview-stage {
  position: relative;
  z-index: 1;
  margin: 28rpx 46rpx 0;
}

.preview-swiper {
  width: 100%;
  height: 760rpx;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 760rpx;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 40rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  transition: transform 0.25s ease;
}

.photo-placeholder,
.empty-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1ab;
  font-size: 28rpx;
}

.crop-corners {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  pointer-events: none;
}

.crop-corner {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.95);
}

.corner-tl {
  top: 0;
  left: 0;
  border-right: 0;
  border-bottom: 0;
}

.corner-tr {
  top: 0;
  right: 0;
  border-left: 0;
  border-bottom: 0;
}

.corner-bl {
  bottom: 0;
  left: 0;
  border-right: 0;
  border-top: 0;
}

.corner-br {
  bottom: 0;
  right: 0;
  border-left: 0;
  border-top: 0;
}

.tool-bar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  margin: 28rpx 46rpx 0;
  padding: 28rpx 0;

  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 40rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.tool.is-active {
  color: #ff5f1f;
}

.tool-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.preview-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin: auto 46rpx calc(48rpx + var(--safe-bottom));
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
  font-size: 34rpx;
  font-weight: 700;
}

/* 编辑态：投屏按钮置灰不可点 */
.preview-submit.is-disabled {
  background: #c8ccd2;
  box-shadow: none;
}
