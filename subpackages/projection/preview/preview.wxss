.preview-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.preview-counter {
  position: relative;
  z-index: 1;
  min-height: 48rpx;
  margin: 4rpx 46rpx 0;
  color: #8b9098;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
}

.preview-imageCount {
  color: rgba(42, 43, 43, 0.8);
  border-radius: 62px;
  background: rgba(42, 43, 43, 0.08);
  display: inline-block;
  padding: 4rpx 30rpx;
}

/* 编辑舞台：对齐 Flutter 的 Expanded 布局，在 680rpx 短屏下限之上占满页面剩余空间。
   JS 会实测最终高度供 fallback 与编辑层共用；上下留白仍保持 48rpx/24rpx。 */
.preview-stage {
  position: relative;
  z-index: 1;
  flex: 1 0 680rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 680rpx;
  margin: 48rpx 46rpx 24rpx;
  /* Banner 轨道的左右邻格就停在舞台外各一屏处，必须由舞台裁掉（2026-08-01）——
     否则静止时页面左右 46rpx 的留白里会露出邻图的一条边。裁剪只能加在舞台上，
     不能加在轨道上：轨道要靠自身平移把邻格送进可视区，自己裁自己就永远露不出来。 */
  overflow: hidden;
}

/* Banner 轨道（2026-08-01 自绘，替掉 swiper）：铺满舞台，横向平移带动三格一起走。
   平移量由 JS 的 slideDx 下发；跟手期间不加过渡（逐帧跟指头），松手补完过场时才挂上 is-animating。
   ⚠️ 轨道不能 overflow:hidden——邻格就在轨道左右各一屏外，裁掉就永远露不出来；
      邻格超出的部分被舞台外的页面内容遮挡即可，视觉上就是从屏幕边缘滑进来。 */
.slide-track {
  position: absolute;
  inset: 0;
  will-change: transform;
}

/* 松手后的补完过场：300ms 与 JS 的 SLIDE_MS 同值，改要一起改（JS 靠定时器等它走完再换索引）。
   ease-out：起手快、落位缓，和微信原生 swiper 的手感一致。 */
.slide-track.is-animating {
  transition: transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* 三格：每格一屏宽，内部把 photo-wrap 居中 */
.slide-cell {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.slide-cell--prev {
  right: 100%;
}

.slide-cell--next {
  left: 100%;
}

/* 编辑层就绪后把当前格底图藏掉：横向取景的取景框比竖向矮，不藏的话框上下会露出这张竖向比例的底图
   （2026-07-25 的老问题，换轨道后规则不变）。用 visibility 而不是 wx:if/display——
   保留布局与已解码的位图，换图那一刻直接显形，不必重新下载解码（那正是「闪一下」的来源）。 */
.slide-cell--current.is-hidden {
  visibility: hidden;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 40rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder,
.empty-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1ab;
  font-size: 28rpx;
}

/* 常驻编辑层：铺满舞台的透明触摸面，catch 全部手势（滑动切图 / 长按拖拽 / 双指缩放旋转都在 JS 分流） */
.edit-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
}

/* 切图过场中 / 新图还没解码完：整层透明并让出触摸，当前格底图顶着画面（2026-07-25）。
   用 opacity 而不是 visibility/display——后两者在部分机型上会让 <image> 推迟甚至不发起加载，
   那样 bindload 永远不来，编辑层就再也显不出来了。opacity:0 仍然参与绘制，加载照常。
   pointer-events:none 保证透明期间手势不被本层 catch 吞掉。 */
.edit-layer.is-hidden {
  opacity: 0;
  pointer-events: none;
}

/* 可视区域容器：位置/尺寸由 JS 按 frame 下发，区外内容 overflow:hidden 裁掉，圆角与卡片一致（框内即最终成像） */
.edit-clip {
  position: absolute;
  overflow: hidden;
  background: #ffffff;
  border-radius: 40rpx;
}

/* 长按 0.5s 触发拖拽时的「拿起」反馈 */
.edit-clip.is-pickup {
  animation: clipPickup 0.34s ease;
}

@keyframes clipPickup {
  0% { transform: scale(1); }
  45% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

/* 拖拽进行中：加一点浮起阴影，强调「已拿起、可拖动」 */
.edit-clip.is-dragging {
  box-shadow: 0 18rpx 48rpx rgba(17, 21, 28, 0.28);
}

/* 被变换的图片：transform 由手势实时下发，绕中心 平移/旋转/缩放 */
.edit-image {
  position: absolute;
  transform-origin: center center;
  will-change: transform;
}

/* 图右上角悬浮的顺时针转90°按钮：left/top 由 JS 按取景框右上角下发（px），再往左平移自身宽度 */
.rotate-fab {
  position: absolute;
  z-index: 7;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  white-space: nowrap;
  background: rgba(17, 21, 28, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  transform: translateX(-100%);
}

/* 轮播小圆点（仿首页设备列表 .carousel-dots，尺寸略小） */
.carousel-dots {
  position: relative;
  z-index: 1;
  display: flex;
  align-self: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.dot {
  width: 24rpx;
  height: 6rpx;
  background: #d7dce3;
  border-radius: 999rpx;
}

.dot.active {
  background: #ff5f1f;
}

/* 分段控制器（2026-07-27 恢复仿 element-plus el-segmented 交互）：竖向/横向/原图三档等宽同框。
   结构为「一条轨道 + 一块会滑动的选中滑块」，竖/横切换时滑块跟随 orientation 移动；
   「原图」仍是还原动作，不占用滑块状态。轨道底色比页面稍深，白色滑块才浮得出来。 */
.segmented {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 28rpx 46rpx 0;
  /* 滑块靠 6rpx 内边距嵌在轨道里；.segmented-thumb 的宽度算式与这个值强耦合，改一处要同步另一处 */
  padding: 6rpx;
  /* background: rgba(226, 233, 243, 0.62); */
  background: rgba(226, 233, 243, 0);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 40rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

/* 选中滑块：绝对定位盖在轨道上，宽度 = 轨道内宽的 1/3（全局 box-sizing:border-box，
   绝对定位的百分比按 padding box 算，故内宽 = 100% - 左右各 6rpx）。
   位置由 wxml 内联 transform: translateX(0 / 100%) 下发——按自身宽度整数倍平移，
   所以档位数变了也不用改这里。transition 就是 el-segmented「滑过去」的观感来源。 */
.segmented-thumb {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: calc((100% - 12rpx) / 3);
  background: #ffffff;
  border-radius: 34rpx;
  box-shadow: 0 6rpx 16rpx rgba(121, 145, 178, 0.22);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 每档：flex:1 等宽平分轨道（可点范围即元素盒子，等宽后每档约 1/3 栏宽，
   比 2026-07-25 那版靠 padding 撑出来的点击区还大一点，图标/文字位置视觉不变）。
   z-index 让内容压在滑块之上，否则白滑块会盖住图标。 */
.segmented-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
  color: #777e88;
  font-size: 24rpx;
  transition: color 0.28s ease;
}

.segmented-item.is-active {
  color: #ff5f1f;
}

/* 按下反馈：滑块是跟着选中态走的（原图这档永远没有滑块），所以按压态单独给一层淡底，
   保证三档手感一致——尤其是「原图」，它点了只弹确认框、滑块不动，没有这层就像没响应。 */
.segmented-item--hover {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 34rpx;
}

.segmented-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 手势说明（2026-07-24 新增，放竖/横/原下方） */
.gesture-tip {
  position: relative;
  z-index: 1;
  margin: 20rpx 46rpx 0;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.preview-submit {
  position: relative;
  z-index: 9;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin: auto 46rpx calc(48rpx + var(--safe-bottom));
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
  font-size: 34rpx;
  font-weight: 700;
}

/* 投屏中：按钮置灰防连点 */
.preview-submit.is-disabled {
  background: #c8ccd2;
  box-shadow: none;
}

/* 离屏导出画布：移到屏幕外，仅用于投屏前出图 */
.crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 10rpx;
  height: 10rpx;
}
