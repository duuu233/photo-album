.preview-page {
  display: flex;
  flex-direction: column;
}

.preview-counter {
  position: relative;
  z-index: 1;
  min-height: 48rpx;
  margin: 4rpx 46rpx 0;
  color: #8b9098;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
}

/* 保存按钮：放在计数行内，靠右并与图片右边缘对齐 */
.preview-save {
  position: absolute;
  top: 0;
  right: 0;
  height: 48rpx;
  padding-left: 24rpx;
  color: #ff5f1f;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.counter-current {
  color: #ff5f1f;
}

.preview-stage {
  position: relative;
  z-index: 1;
  margin: 28rpx 46rpx 0;
}

.preview-swiper {
  width: 100%;
  height: 760rpx;
}

/* 裁剪后 photo-wrap 会按裁剪比例缩小，这里让它在 swiper-item 内居中 */
.preview-swiper swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 760rpx;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 40rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  transition: transform 0.25s ease;
}

.photo-placeholder,
.empty-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1ab;
  font-size: 28rpx;
}

/* 裁剪交互层：盖在 swiper 之上，单独显示当前图片 */
.crop-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
  overflow: hidden;
  background: #11151c;
  border-radius: 40rpx;
}

.crop-image {
  position: absolute;
}

/* 选区外的遮罩：用超大 box-shadow 把裁剪框以外区域压暗 */
.crop-shade {
  position: absolute;
  box-shadow: 0 0 0 2000px rgba(17, 21, 28, 0.58);
  pointer-events: none;
}

.crop-frame {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
}

/* 框内可拖动区域：整体平移裁剪框 */
.crop-move {
  position: absolute;
  inset: 0;
}

/* 三等分参考线 */
.crop-third {
  position: absolute;
  background: rgba(255, 255, 255, 0.35);
  pointer-events: none;
}

.crop-third--v1 {
  top: 0;
  bottom: 0;
  left: 33.33%;
  width: 1px;
}

.crop-third--v2 {
  top: 0;
  bottom: 0;
  left: 66.66%;
  width: 1px;
}

.crop-third--h1 {
  left: 0;
  right: 0;
  top: 33.33%;
  height: 1px;
}

.crop-third--h2 {
  left: 0;
  right: 0;
  top: 66.66%;
  height: 1px;
}

/* 四角拖拽手柄 */
.crop-corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #ffffff;
  z-index: 2;
}

.corner-tl {
  top: -3rpx;
  left: -3rpx;
  border-right: 0;
  border-bottom: 0;
}

.corner-tr {
  top: -3rpx;
  right: -3rpx;
  border-left: 0;
  border-bottom: 0;
}

.corner-bl {
  bottom: -3rpx;
  left: -3rpx;
  border-right: 0;
  border-top: 0;
}

.corner-br {
  bottom: -3rpx;
  right: -3rpx;
  border-left: 0;
  border-top: 0;
}

/* 离屏导出画布：移到屏幕外，仅用于裁剪导出 */
.crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 10rpx;
  height: 10rpx;
}

.tool-bar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  margin: 28rpx 46rpx 0;
  padding: 28rpx 0;

  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 40rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.tool.is-active {
  color: #ff5f1f;
}

.tool-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}
.preview-imageCount {
  color: rgba(42, 43, 43, 0.8);
  border-radius: 62px;
  background: rgba(42, 43, 43, 0.08);
  display: inline-block;
  padding: 4rpx 30rpx;
}
/* 压缩图片开关行：与工具栏同样式的玻璃卡片，放在投屏按钮上方 */
.compress-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 46rpx 0;
  padding: 22rpx 30rpx;

  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 40rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

.compress-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-right: 20rpx;
}

.compress-label {
  color: #2a2b2b;
  font-size: 28rpx;
  font-weight: 600;
}

.compress-tip {
  color: #777e88;
  font-size: 22rpx;
}

.compress-switch {
  transform: scale(0.8);
  transform-origin: right center;
}

.preview-submit {
  position: relative;
  z-index: 9;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin: auto 46rpx calc(48rpx + var(--safe-bottom));
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
  font-size: 34rpx;
  font-weight: 700;
}

/* 编辑态：投屏按钮置灰不可点 */
.preview-submit.is-disabled {
  background: #c8ccd2;
  box-shadow: none;
}
