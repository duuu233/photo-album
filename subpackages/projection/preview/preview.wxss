.device-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.device-name {
  margin-bottom: 8rpx;
  color: #232323;
  font-size: 32rpx;
  font-weight: 850;
}

.notice {
  margin: 22rpx 0;
  padding: 18rpx 22rpx;
  color: #1d8a5f;
  background: #e9f8f1;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.notice.danger {
  color: #c7372f;
  background: #fff0ef;
}

.preview-stage {
  position: relative;
  height: 660rpx;
  padding: 18rpx;
  overflow: hidden;
  background: #2b3038;
}

.main-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.crop-frame {
  position: absolute;
  top: 64rpx;
  right: 54rpx;
  bottom: 64rpx;
  left: 54rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 12rpx;
  pointer-events: none;
}

.tool-panel {
  margin-top: 20rpx;
  padding: 22rpx;
}

.tool-title {
  margin-bottom: 18rpx;
  color: #232323;
  font-size: 28rpx;
  font-weight: 800;
}

.tool-row {
  display: grid;
  grid-template-columns: 96rpx 96rpx 1fr 1fr;
  gap: 14rpx;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  color: #3b4048;
  background: #edf1f7;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.tool-btn.active {
  color: #ffffff;
  background: #eb5f1b;
}

.thumb-strip {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.thumb-track {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.thumb {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  border-radius: 18rpx;
}

.thumb.active {
  border-color: #eb5f1b;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  color: #ffffff;
  background: rgba(35, 35, 35, 0.72);
  border-radius: 50%;
  font-size: 30rpx;
}

.submit-btn {
  margin-top: 28rpx;
}
