.preview-page {
  display: flex;
  flex-direction: column;
}

.preview-counter {
  position: relative;
  z-index: 1;
  min-height: 48rpx;
  margin: 4rpx 46rpx 0;
  color: #8b9098;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
}

.counter-current {
  color: #ff5f1f;
}

/* 编辑舞台：高度改这里务必同步 preview.js 的 STAGE_H_RPX；fallback 的 photo-wrap 靠 flex 居中 */
.preview-stage {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 680rpx;
  margin: 28rpx 46rpx 0;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 40rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1ab;
  font-size: 28rpx;
}

/* 常驻编辑层：铺满舞台的透明触摸面（手势在整个舞台内都可操作），图片在固定可视区域下自由 平移/缩放/旋转 */
.edit-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
}

/* 可视区域容器（2026-07-22 优化，取代 裁剪框+九宫格+框外遮罩）：位置/尺寸由 JS 按 frame 下发，
   区外内容直接 overflow:hidden 裁掉，观感与 photo-wrap 圆角卡片一致（框内即最终成像） */
.edit-clip {
  position: absolute;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 40rpx;
}

/* 被变换的图片：transform 由手势实时下发，绕中心 平移/旋转/缩放 */
.edit-image {
  position: absolute;
  transform-origin: center center;
  will-change: transform;
}

/* 图右上角悬浮的顺时针转90°按钮：left/top 由 JS 按取景框右上角下发（px），再往左平移自身宽度 */
.rotate-fab {
  position: absolute;
  z-index: 7;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  background: rgba(17, 21, 28, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  transform: translateX(-100%);
}

/* 编辑手势提示：整个页面实例只出一次，触摸后隐藏 */
.edit-hint {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  transform: translateX(-50%);
  padding: 10rpx 24rpx;
  color: #ffffff;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
  white-space: nowrap;
  pointer-events: none;
}

/* 离屏导出画布：移到屏幕外，仅用于投屏前出图 */
.crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 10rpx;
  height: 10rpx;
}

/* 竖向/横向 分段控制器：仿 el-segmented——灰底容器 + 白色滑块滑到选中项 */
.orient-seg {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 24rpx 46rpx 0;
  padding: 6rpx;
  background: rgba(42, 43, 43, 0.08);
  border-radius: 999rpx;
}

/* 滑块：宽 = (容器宽 - 两侧 padding)/2，正好盖住一个选项；切换时水平滑过去 */
.orient-seg__thumb {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(121, 145, 178, 0.25);
  transition: transform 0.25s ease;
}

.orient-seg__thumb.to-right {
  transform: translateX(100%);
}

.orient-seg__item {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 18rpx 0;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1;
  text-align: center;
  transition: color 0.25s ease;
}

.orient-seg__item.is-on {
  color: #ff5f1f;
  font-weight: 600;
}

.tool-bar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  margin: 24rpx 46rpx 0;
  padding: 20rpx 0;

  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 40rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.tool-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

/* 上一张/下一张（替代左右滑动切图） */
.nav-row {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 24rpx;
  margin: 24rpx 46rpx 0;
}

.nav-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #2a2b2b;
  font-size: 28rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 999rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

/* 已到第一张/最后一张：置灰（JS 侧同样短路，不响应点击） */
.nav-btn.is-disabled {
  color: #b7bdc6;
  opacity: 0.6;
}

.preview-imageCount {
  color: rgba(42, 43, 43, 0.8);
  border-radius: 62px;
  background: rgba(42, 43, 43, 0.08);
  display: inline-block;
  padding: 4rpx 30rpx;
}

.preview-submit {
  position: relative;
  z-index: 9;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin: auto 46rpx calc(48rpx + var(--safe-bottom));
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
  font-size: 34rpx;
  font-weight: 700;
}

/* 投屏中：按钮置灰防连点 */
.preview-submit.is-disabled {
  background: #c8ccd2;
  box-shadow: none;
}
