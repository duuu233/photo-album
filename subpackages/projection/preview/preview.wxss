.preview-page {
  display: flex;
  flex-direction: column;
}

.preview-actions {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: flex-end;
  min-height: 84rpx;
  padding: 20rpx 46rpx 0;
}

.preview-save {
  min-width: 72rpx;
  height: 64rpx;
  color: #ff5f1f;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: right;
}

.preview-counter {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  color: #8b9098;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.counter-current {
  color: #ff5f1f;
}

.preview-stage {
  position: relative;
  z-index: 1;
  margin: 28rpx 46rpx 0;
}

.preview-swiper {
  width: 100%;
  height: 760rpx;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 760rpx;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 32rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  transition: transform 0.25s ease;
}

.photo-placeholder,
.empty-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1ab;
  font-size: 28rpx;
}

.crop-corners {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  pointer-events: none;
}

.crop-corner {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.95);
}

.corner-tl {
  top: 0;
  left: 0;
  border-right: 0;
  border-bottom: 0;
}

.corner-tr {
  top: 0;
  right: 0;
  border-left: 0;
  border-bottom: 0;
}

.corner-bl {
  bottom: 0;
  left: 0;
  border-right: 0;
  border-top: 0;
}

.corner-br {
  bottom: 0;
  right: 0;
  border-left: 0;
  border-top: 0;
}

.tool-bar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  margin: 28rpx 46rpx 0;
  padding: 28rpx 0;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(127, 151, 184, 0.12);
}

.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.tool.is-active {
  color: #ff5f1f;
}

.tool-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.tool-crop::before,
.tool-crop::after {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  content: "";
}

.tool-crop::before {
  top: 2rpx;
  left: 2rpx;
  border-right: 0;
  border-bottom: 0;
}

.tool-crop::after {
  right: 2rpx;
  bottom: 2rpx;
  border-left: 0;
  border-top: 0;
}

.tool-rotate {
  border: 4rpx solid currentColor;
  border-radius: 50%;
  border-top-color: transparent;
}

.tool-rotate::after {
  position: absolute;
  top: -3rpx;
  right: -2rpx;
  width: 0;
  height: 0;
  border: 8rpx solid transparent;
  border-left-color: currentColor;
  content: "";
}

.tool-origin {
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.tool-origin::before {
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  left: 5rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: skewX(-22deg);
  content: "";
}

.tool-origin::after {
  position: absolute;
  top: 8rpx;
  left: 9rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
  content: "";
}

.preview-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin: auto 46rpx calc(48rpx + var(--safe-bottom));
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
  font-size: 34rpx;
  font-weight: 700;
}
