.preview-page {
  display: flex;
  flex-direction: column;
}

.preview-counter {
  position: relative;
  z-index: 1;
  min-height: 48rpx;
  margin: 4rpx 46rpx 0;
  color: #8b9098;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
}

.preview-imageCount {
  color: rgba(42, 43, 43, 0.8);
  border-radius: 62px;
  background: rgba(42, 43, 43, 0.08);
  display: inline-block;
  padding: 4rpx 30rpx;
}

/* 编辑舞台：高度改这里务必同步 preview.js 的 STAGE_H_RPX。
   2026-07-24：上下留白加大（margin 48rpx/24rpx），并恢复 swiper 轮播承载多图。 */
.preview-stage {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 680rpx;
  margin: 48rpx 46rpx 24rpx;
}

/* 多图轮播 swiper：铺满舞台；每个 item 内居中放 photo-wrap */
.preview-swiper {
  width: 100%;
  height: 100%;
}

.preview-swiper swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 40rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder,
.empty-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1ab;
  font-size: 28rpx;
}

/* 常驻编辑层：铺满舞台的透明触摸面，catch 全部手势（滑动切图 / 长按拖拽 / 双指缩放旋转都在 JS 分流） */
.edit-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
}

/* 可视区域容器：位置/尺寸由 JS 按 frame 下发，区外内容 overflow:hidden 裁掉，圆角与卡片一致（框内即最终成像） */
.edit-clip {
  position: absolute;
  overflow: hidden;
  background: #e6ecf4;
  border-radius: 40rpx;
}

/* 长按 2s 触发拖拽时的「拿起」反馈：轻微放大再回弹（配合 wx.vibrateShort 震动），仿苹果相册长按取图 */
.edit-clip.is-pickup {
  animation: clipPickup 0.34s ease;
}

@keyframes clipPickup {
  0% { transform: scale(1); }
  45% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

/* 拖拽进行中：加一点浮起阴影，强调「已拿起、可拖动」 */
.edit-clip.is-dragging {
  box-shadow: 0 18rpx 48rpx rgba(17, 21, 28, 0.28);
}

/* 被变换的图片：transform 由手势实时下发，绕中心 平移/旋转/缩放 */
.edit-image {
  position: absolute;
  transform-origin: center center;
  will-change: transform;
}

/* 图右上角悬浮的顺时针转90°按钮：left/top 由 JS 按取景框右上角下发（px），再往左平移自身宽度 */
.rotate-fab {
  position: absolute;
  z-index: 7;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  white-space: nowrap;
  background: rgba(17, 21, 28, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  transform: translateX(-100%);
}

/* 轮播小圆点（仿首页设备列表 .carousel-dots，尺寸略小） */
.carousel-dots {
  position: relative;
  z-index: 1;
  display: flex;
  align-self: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.dot {
  width: 24rpx;
  height: 6rpx;
  background: #d7dce3;
  border-radius: 999rpx;
}

.dot.active {
  background: #ff5f1f;
}

/* 工具栏（2026-07-24 还原原样式）：竖向/横向/原图 三图标并列，选中态橙色 */
.tool-bar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  margin: 28rpx 46rpx 0;
  padding: 28rpx 0;
  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 40rpx;
  box-shadow: 0 24rpx 54rpx rgba(121, 145, 178, 0.13);
}

.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: #777e88;
  font-size: 24rpx;
}

.tool.is-active {
  color: #ff5f1f;
}

.tool-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

/* 手势说明（2026-07-24 新增，放竖/横/原下方） */
.gesture-tip {
  position: relative;
  z-index: 1;
  margin: 20rpx 46rpx 0;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.preview-submit {
  position: relative;
  z-index: 9;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin: auto 46rpx calc(48rpx + var(--safe-bottom));
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
  font-size: 34rpx;
  font-weight: 700;
}

/* 投屏中：按钮置灰防连点 */
.preview-submit.is-disabled {
  background: #c8ccd2;
  box-shadow: none;
}

/* 离屏导出画布：移到屏幕外，仅用于投屏前出图 */
.crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 10rpx;
  height: 10rpx;
}
