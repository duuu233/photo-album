<view class="mock-root records-page filter-{{filter}}" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="/assets/images/bg01.png" mode="aspectFill"></image>
    <view class="records-tint"></view>
  </view>

  <page-nav title="投屏管理"></page-nav>

  <view class="mock-content records-content">
    <view class="record-tabs">
      <view class="record-tabs__indicator"></view>
      <view class="record-tab {{filter === 'success' ? 'is-active' : ''}}" hover-class="none" data-filter="success" bindtap="switchFilter">投屏成功</view>
      <view class="record-tab {{filter === 'fail' ? 'is-active' : ''}}" hover-class="none" data-filter="fail" bindtap="switchFilter">投屏失败</view>
    <view>

    <view class="record-count">共 {{filteredRecords.length}} 条记录</view>

    <view wx:if="{{filteredRecords.length}}" class="record-list">
      <view class="record-card glass-panel" wx:for="{{filteredRecords}}" wx:key="id">
        <view class="thumb thumb-{{item.thumbType}}">
          <image wx:if="{{item.thumbUrl}}" class="thumb-img" src="{{item.thumbUrl}}" mode="aspectFill"></image>
          <view wx:else class="thumb-art">
            <view class="thumb-sky"></view>
            <view class="thumb-sun"></view>
            <view class="thumb-ground"></view>
            <view class="thumb-face"></view>
          </view>
        </view>

        <view class="record-body">
          <view class="record-head">
            <view class="record-title">{{item.deviceName}}</view>
            <view class="record-status {{item.status === 'success' ? 'success' : 'fail'}}">{{item.statusText}}</view>
          </view>
          <view class="record-time">
            <image class="record-icon date-icon" src="/assets/images/date-icon01.png" mode="aspectFit"></image>
            <text>{{item.createdAt}}</text>
          </view>
          <view wx:if="{{item.status === 'fail'}}" class="record-reason">
            <image class="record-icon warning-icon" src="/assets/images/warning-icon01.png" mode="aspectFit"></image>
            <text>{{item.message}}</text>
          </view>
          <view class="thin-divider"></view>
          <view class="record-actions">
            <view class="record-action retry-action" hover-class="none" data-id="{{item.id}}" bindtap="retryProjection">{{item.status === 'success' ? '再次投屏' : '重新投屏'}}</view>
            <view class="record-action delete-action" hover-class="none" data-id="{{item.id}}" bindtap="deleteRecord">删除</view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-record glass-panel" wx:else>
      <view class="empty-record__title">{{filter === 'success' ? '暂无成功记录' : '暂无失败记录'}}</view>
      <view class="empty-record__desc">{{filter === 'success' ? '完成一次照片投屏后会显示在这里。' : '投屏失败时会保留原因，方便排查。'}}</view>
    </view>
  </view>
</view>
