.records-content {
  padding-top: 78rpx;
}

.filter-success .records-tint {
  opacity: 1;
  background-color: rgba(53, 184, 86, 0.05);
}

.filter-fail .records-tint {
  opacity: 1;
  background-color: rgba(255, 72, 72, 0.06);
}

.record-tabs {
  position: relative;
  display: flex;
  height: 82rpx;
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.84);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 38rpx rgba(126, 150, 184, 0.08);
}

/* 滑动指示器：切换时平移并过渡背景色（白 -> 橙） */
.record-tabs__indicator {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  z-index: 0;
  width: calc(50% - 8rpx);
  border-radius: 999rpx;
  background-color: #ff6a20;
  box-shadow: 0 10rpx 24rpx rgba(255, 106, 32, 0.32);
  transition:
    transform 0.36s cubic-bezier(0.22, 0.61, 0.36, 1),
    background-color 0.36s ease,
    box-shadow 0.36s ease;
}

.filter-fail .record-tabs__indicator {
  transform: translateX(100%);
  background-color: #ff4350;
  box-shadow: 0 10rpx 24rpx rgba(255, 67, 80, 0.32);
}

.record-tab {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  color: #858b94;
  background: transparent;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: color 0.32s ease;
}

.record-tab.is-active {
  color: #ffffff;
}

.record-count {
  margin: 36rpx 0 18rpx;
  color: #777e88;
  font-size: 24rpx;
  line-height: 1;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-card {
  display: flex;
  min-height: 206rpx;
  padding: 26rpx 28rpx;
  animation: record-card-in 0.38s ease both;
}

/* 切换标签后列表重新渲染，卡片淡入上移，配合标签切换动画 */
@keyframes record-card-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.thumb {
  position: relative;
  flex: 0 0 auto;
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #d9e8f7;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.record-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 42rpx;
}

.record-title {
  overflow: hidden;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 500;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-status {
  flex: 0 0 auto;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.record-status.success {
  color: #35b856;
  background: #e9f8ef;
}

.record-status.fail {
  color: #ff3045;
  background: #fff0f1;
}

.record-time,
.record-reason {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.2;
}

.record-reason {
  margin-top: 10rpx;
  color: #ef5b50;
}

.record-icon {
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
}

.record-card .thin-divider {
  margin-top: 16rpx;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 54rpx;
  min-height: 42rpx;
  margin-top: 14rpx;
  align-items: center;
}

.record-action {
  min-width: 88rpx;
  min-height: 42rpx;
  font-size: 24rpx;
  line-height: 42rpx;
  text-align: center;
}

.retry-action {
  color: #ff6a20;
}
.line-action {
  background: rgba(42, 43, 43, 0.1);
  width: 1rpx;
  height: 30rpx;
}
.delete-action {
  color: #8b9098;
}

.empty-record {
  padding: 78rpx 32rpx;
  text-align: center;
}

.empty-record__title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.empty-record__desc {
  margin-top: 14rpx;
  color: #777e88;
  font-size: 26rpx;
  line-height: 1.45;
}

/* 加载失败态的「重新加载」按钮（与设备详情页 status-retry 同款视觉） */
.empty-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  min-height: 80rpx;
  margin: 44rpx auto 0;
  padding: 0 56rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 32rpx rgba(255, 102, 31, 0.22);
  font-size: 28rpx;
}
