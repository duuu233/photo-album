<!-- 星币管理（原「Token 管理」，2026-08-12 全站文案 Token→星币；设计稿：assets/ai/UI页面/Token管理.png）
     折叠屏适配同设置类页面：根容器锁一屏高，导航栏与贴底按钮留在滚动区外，
     中间内容交给 .fold-scroll 滚动（方案见 styles/fold-adapt.wxss）。 -->
<view class="token-shell fold-viewport" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <page-nav title="星币管理"></page-nav>
  <scroll-view class="fold-scroll" scroll-y="{{true}}">
    <view class="fold-scroll-body token-scroll-body cta-button-gap">

      <!-- 概览卡：外层橙色渐变底 + 内层白卡，与设计稿 Group 195244 一致 -->
      <view class="account-card">
        <view class="account-card-title">我的星币</view>
        <view class="account-inner">
          <view class="account-balance">
            <view class="account-balance-copy">
              <view class="account-label">当前可用余额</view>
              <view class="account-balance-value">
                <text class="account-balance-num">{{account.balance}}</text>
                <text class="account-balance-unit">星币</text>
              </view>
            </view>
            <image class="account-coin" src="/assets/images/token-coin.png" mode="aspectFit"></image>
          </view>
          <view class="account-divider"></view>
          <view class="account-stats">
            <view class="account-stat">
              <view class="account-label">总额（累计购买）</view>
              <view class="account-stat-value">
                <text class="account-stat-num account-stat-num--orange">{{account.totalPurchased}}</text>
                <text class="account-stat-unit">星币</text>
              </view>
            </view>
            <view class="account-stat-split"></view>
            <view class="account-stat">
              <view class="account-label">已消耗</view>
              <view class="account-stat-value">
                <text class="account-stat-num">{{account.totalSpent}}</text>
                <text class="account-stat-unit">星币</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="token-section-title">套餐购买</view>
      <!-- 横向滑动套餐列表。enable-flex 让内部 .package-row 的 flex 布局生效
           （scroll-view 默认不是 flex 容器，不开这个属性卡片会各自换行）。
           左右留白由 .package-row 负责，scroll-view 本身通栏（见 wxss）。 -->
      <scroll-view class="package-scroll" scroll-x="{{true}}" enable-flex="{{true}}">
        <view class="package-row">
          <view
            wx:for="{{packages}}"
            wx:key="id"
            class="package-card {{item.id === selectedId ? 'package-card--active' : ''}}"
            data-id="{{item.id}}"
            hover-class="none"
            bindtap="onSelectPackage"
          >
            <!-- 赠送角标：无赠送的档位（设计稿里的 200 星币）不渲染文字。
                 选中态是实心橙色标签、贴住卡片右上角；未选中是卡片内的橙色文字。
                 ⚠️ 外层 .package-gift-slot 必须常在：选中态的角标是绝对定位、脱离文档流，
                    没有这个等高占位，选中那张卡的「500 星币」及以下内容会整体上移，
                    与相邻档位错开一行高度。 -->
            <view class="package-gift-slot">
              <view wx:if="{{item.gift > 0}}" class="package-gift">赠送 {{item.gift}} 星币</view>
            </view>
            <view class="package-tokens">
              <text class="package-tokens-num">{{item.tokens}}</text>
              <text class="package-tokens-unit">星币</text>
            </view>
            <view class="package-price">
              <text class="package-price-symbol">¥</text>
              <text class="package-price-num">{{item.price}}</text>
            </view>
            <view class="package-unit">≈ ¥{{item.unitPrice}}/星币</view>
          </view>
        </view>
      </scroll-view>

      <view class="record-entry" hover-class="none" bindtap="goRecords">
        <view class="record-entry-copy">
          <!-- ⚠️ 这里的 & 必须写字面量：WXML 只有 <text decode="{{true}}"> 会解 HTML 转义符，
               普通 view 里的转义写法不会被还原，会把转义串本身原样显示出来（本页原来的表现）。
               记录页 records.wxml 的导航标题同理，也是直接写字面量。 -->
          <view class="record-entry-title">购买 & 消费记录</view>
          <view class="record-entry-desc">查看所有购买和消费明细</view>
        </view>
        <image class="record-entry-chevron" src="/assets/images/mine-icon-right.png" mode="aspectFit"></image>
      </view>

      <!-- 星币消耗规则（2026-08-12 需求 4）：数据来自 GET /Client/Order/getAiConfigList，
           顺序原样按后端给的来（后台按权重排好，端上重排只会和配置对不上）。
           拉不到就整块不出现 —— 说明性内容，挂了不该在页面上留一块空白。
           ⚠️ 表格是 flex 手搭的：三列宽度写死百分比，「说明」列允许折行，
           所以行高不定、不能给固定 height。 -->
      <block wx:if="{{aiConfigs.length}}">
        <view class="token-section-title">星币消耗规则</view>
        <view class="rule-card">
          <view class="rule-row rule-row--head">
            <text class="rule-col rule-col--name">服务类型</text>
            <text class="rule-col rule-col--cost">星币消耗（星币/次）</text>
            <text class="rule-col rule-col--remark">说明</text>
          </view>
          <view
            wx:for="{{aiConfigs}}"
            wx:key="id"
            class="rule-row"
          >
            <text class="rule-col rule-col--name">{{item.name}}</text>
            <text class="rule-col rule-col--cost rule-cost">{{item.cost}}</text>
            <text class="rule-col rule-col--remark">{{item.remark}}</text>
          </view>
        </view>
      </block>

    </view>
  </scroll-view>

  <!-- 贴底按钮留在滚动区外；.cta-button-gap 已把它占的高度让出来 -->
  <view
    class="cta-button {{selectedId ? '' : 'cta-button--disabled'}}"
    hover-class="none"
    bindtap="goConfirm"
  >
    <image class="cta-button-bg" src="/assets/images/primary-btn-bg.png" mode="scaleToFill"></image>
    立即购买
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
