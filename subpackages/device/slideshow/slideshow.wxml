<!-- 页面框架（背景 + 导航）始终渲染，内容区在「设置 / 加载中 / 加载失败 / 不存在」之间切换，
     避免接口报错时 device 为空导致布局错乱 -->
<view class="mock-root slideshow-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="轮播设置"></page-nav>

  <view wx:if="{{device}}" class="mock-content slideshow-content">
    <view class="slideshow-card glass-panel">
      <view class="switch-row">
        <view class="setting-title">开启轮播</view>
        <switch checked="{{carouselOn}}" color="#ff6a20" bindchange="toggleCarousel" />
      </view>

      <view class="setting-tip">
        <view class="tip-icon">i</view>
        <text>轮播以开启时间起算24小时后轮播下一张</text>
      </view>

      <view class="thin-divider"></view>

      <view class="mode-title {{carouselOn ? '' : 'is-disabled'}}">轮播方式</view>
      <!-- 未开启轮播时，轮播方式不可选择（changePlayback 内已做拦截，这里同步置灰） -->
      <view class="mode-option {{carouselOn && device.playbackMode === 'order' ? 'is-active' : ''}} {{carouselOn ? '' : 'is-disabled'}}" hover-class="none" data-mode="order" bindtap="changePlayback">
        <view class="radio-dot"><view></view></view>
        <text>顺序轮播</text>
      </view>
      <view class="mode-option {{carouselOn && device.playbackMode === 'random' ? 'is-active' : ''}} {{carouselOn ? '' : 'is-disabled'}}" hover-class="none" data-mode="random" bindtap="changePlayback">
        <view class="radio-dot"><view></view></view>
        <text>随机轮播</text>
      </view>
    </view>
  </view>

  <!-- 加载中：全局统一 loading（同我的图库等页面），样式在 app.wxss 的 page-loading -->
  <view wx:elif="{{loading}}" class="page-loading">
    <view class="page-loading__spinner"></view>
    <view class="page-loading__text">加载中…</view>
  </view>

  <!-- 设备不存在 / 加载失败：居中空态卡片，导航与背景仍在，不会错乱 -->
  <view wx:else class="slideshow-status">
    <view class="status-card glass-panel">
      <image class="status-art" src="/assets/images/empty_device_art.png" mode="aspectFit"></image>
      <view class="status-title">{{loadError ? '加载失败' : '电子纸设备不存在'}}</view>
      <view class="status-desc">{{loadError ? '网络异常或服务出错，请稍后重试' : '该电子纸设备可能已被删除或解绑'}}</view>
      <view wx:if="{{loadError}}" class="status-retry" hover-class="none" bindtap="loadDevice">重新加载</view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
