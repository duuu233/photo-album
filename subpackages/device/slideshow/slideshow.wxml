<view class="mock-root slideshow-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;" wx:if="{{device}}">
  <view class="mock-bg">
    <view class="mock-bg__curve mock-bg__curve--top"></view>
    <view class="mock-bg__curve mock-bg__curve--bottom"></view>
    <view class="mock-bg__spark mock-bg__spark--one"></view>
    <view class="mock-bg__spark mock-bg__spark--two"></view>
    <view class="mock-bg__spark mock-bg__spark--three"></view>
  </view>

  <view class="mock-nav">
    <button class="mock-nav__back" hover-class="none" aria-label="返回" bindtap="goBack">
      <view class="mock-nav__back-icon"></view>
    </button>
    <view class="mock-nav__title">轮播设置</view>
    <view></view>
  </view>

  <view class="mock-content slideshow-content">
    <view class="slideshow-card glass-panel">
      <view class="switch-row">
        <view class="setting-title">开启轮播</view>
        <switch checked="{{device.carouselEnabled}}" color="#ff6a20" bindchange="toggleCarousel" />
      </view>

      <view class="setting-tip">
        <view class="tip-icon">i</view>
        <text>轮播以开启时间起算24小时后轮播下一张</text>
      </view>

      <view class="thin-divider"></view>

      <view class="mode-title">轮播方式</view>
      <button class="mode-option {{device.playbackMode === 'order' ? 'is-active' : ''}}" hover-class="none" data-mode="order" bindtap="changePlayback">
        <view class="radio-dot"><view></view></view>
        <text>顺序轮播</text>
      </button>
      <button class="mode-option {{device.playbackMode === 'random' ? 'is-active' : ''}}" hover-class="none" data-mode="random" bindtap="changePlayback">
        <view class="radio-dot"><view></view></view>
        <text>随机轮播</text>
      </button>
    </view>
  </view>
</view>

<view class="mock-root empty-slideshow" wx:else>
  <view class="empty-state glass-panel">设备不存在</view>
</view>
