/* 占满导航栏以下的剩余高度：100vh - 状态栏高度(--status-bar) - 顶部导航栏高度(88rpx)。
   有了确定高度，底部绝对定位的「重新扫描」按钮与「扫描不到怎么办」才会贴屏幕底部。 */
.bind-content {
  position: relative;
  z-index: 1;
  height: calc(100vh - var(--status-bar) - 88rpx);
  box-sizing: border-box;
}

/* 硬件联调调试台入口横幅 */
.debug-entry {
  display: flex;
  align-items: center;
  margin: 0 48rpx 8rpx;
  padding: 22rpx 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 100, 33, 0.22);
  border-radius: 22rpx;
  box-shadow: 0 12rpx 30rpx rgba(126, 150, 184, 0.08);
}

.debug-entry__icon {
  flex: 0 0 auto;
  margin-right: 20rpx;
  font-size: 40rpx;
}

.debug-entry__copy {
  flex: 1;
  min-width: 0;
}

.debug-entry__title {
  display: block;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 700;
}

.debug-entry__sub {
  display: block;
  margin-top: 6rpx;
  color: #8b9098;
  font-size: 22rpx;
}

.debug-entry__arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #ff621f;
  font-size: 40rpx;
  font-weight: 700;
}

.content-dimmed {
  opacity: 0.42;
}

.radar-wrap {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  margin: 40rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-art {
  width: 100%;
  height: 100%;
}
.radar-art-gif {
  width: 80%;
  height: 80%;
}
.scan-copy {
  margin-top: 12rpx;
  text-align: center;
}

.scan-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.scan-desc {
  margin-top: 22rpx;
  color: #737a84;
  font-size: 24rpx;
  line-height: 1;
}

.scan-help-link {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(174rpx + var(--safe-bottom));
  color: #ff6421;
  font-size: 26rpx;
  text-align: center;
}

.nearby-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 48rpx 24rpx;
}

.nearby-head text {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.refresh-btn {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

/* 预留底部「立即绑定」按钮的空间，列表过长时内部滚动 */
.device-list {
  max-height: calc(100vh - var(--status-bar) - 940rpx);
  padding: 0 48rpx 8rpx;
}

.nearby-device {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 22rpx;
  padding: 24rpx 34rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 38rpx rgba(126, 150, 184, 0.08);
}

/* 选中态：橙色描边 + 浅橙底 + 橙色设备名，对应设计稿首项高亮 */
.nearby-device.selected {
  background: rgba(255, 247, 242, 0.92);
  border-color: #ff6421;
  box-shadow: 0 16rpx 38rpx rgba(255, 105, 30, 0.12);
}

.nearby-device.selected .nearby-name {
  color: #ff5a1e;
}

/* 换成首页的 home-icon02 后，橙色底色块要去掉（含选中态的加深底色）：
   这张图四角透明、自带圆角底衬，外面再套一层色块会在四角露出色晕。
   与 list.wxss / detail.wxss 换图时的处理一致。选中态仍有橙色描边+橙色设备名+右侧对勾，识别度足够。 */
.nearby-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin-right: 26rpx;
}

/* 与容器同尺寸：home-icon02 是带细节的插画，塞在 56rpx 的内框里会糊 */
.nearby-icon__img {
  width: 88rpx;
  height: 88rpx;
}

.nearby-copy {
  flex: 1;
  min-width: 0;
}

.nearby-name {
  display: block;
  overflow: hidden;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nearby-sub {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #8b9098;
  font-size: 22rpx;
  /* 截断兜底：设备ID 那行在广播解析失败时会退化成 iOS 的 36 位 UUID，不截断会把整行撑破 */
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧单选指示：选中显示对勾图标，未选显示空心圆 */
.select-circle {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-left: 16rpx;
}

.select-circle--empty {
  box-sizing: border-box;
  border: 3rpx solid #c8cdd5;
  border-radius: 50%;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  width: 654rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 36rpx;
  font-weight: 700;
}

.bind-bottom {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + var(--safe-bottom));
}

.bind-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(42, 43, 43, 0.5);
}

.scan-help-sheet {
  position: relative;
  width: 100%;
  padding: 48rpx 48rpx calc(48rpx + var(--safe-bottom));
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.sheet-close {
  position: absolute;
  top: 32rpx;
  right: 36rpx;
  width: 44rpx;
  height: 44rpx;
  color: #8b9098;
  font-size: 42rpx;
  line-height: 1;
}

.scan-help-title {
  color: #2a2d32;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.scan-help-icon {
  display: block;
  width: 190rpx;
  height: 190rpx;
  margin: 48rpx auto 44rpx;
}

.check-title {
  margin-bottom: 22rpx;
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 700;
}

.check-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 44rpx;
  color: #555c66;
  font-size: 24rpx;
  line-height: 1.24;
}
