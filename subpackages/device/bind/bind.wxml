<!-- 折叠屏适配（2026-08-05）：--nav-h 是 page-nav 回抛的实测导航高度（含状态栏），
     .bind-content 用它算「导航以下的剩余高度」，比写死 88rpx 准（rpx 会随屏宽放大）。
     bind:measure 由 utils/fold-adapt 注入的 onNavMeasure 接住，页面 JS 不必再写。 -->
<view class="mock-root bind-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px; --nav-h: {{navHeight}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="绑定设备" bind:measure="onNavMeasure"></page-nav>

  <view class="bind-content {{showHelp ? 'content-dimmed' : ''}}">
    <!-- 调试台入口：开发对接/硬件联调用，需要屏蔽时注释掉本段即可（不要删除） -->
    <view class="debug-entry" hover-class="none" bindtap="openDebug">
      <view class="debug-entry__icon">🔧</view>
      <view class="debug-entry__copy">
        <text class="debug-entry__title">硬件联调调试台</text>
        <text class="debug-entry__sub">开发对接用 · 一键测试上传/删除/电量等全部指令</text>
      </view>
      <view class="debug-entry__arrow">›</view>
    </view>


    <view class="radar-wrap">
      <!-- 搜索期间雷达一直转（哪怕已经搜到设备）：下面的列表同步追加，两者并存才是「边搜边显示」 -->
      <image wx:if="{{scanning}}" class="radar-art radar-art-gif" src="https://oss.boltfox.cn/prodFile/202606161504054302273.gif" mode="aspectFit"></image>
      <image wx:elif="{{devices.length}}" class="radar-art" src="/assets/images/device_found_art.png" mode="aspectFit"></image>
      <image wx:else class="radar-art" src="/assets/images/device_not_found_art.png" mode="aspectFit"></image>
    </view>

    <!-- 搜到一个显示一个：只要已经搜到设备就渲染列表，不再等扫描结束。
         此前这一段挂在 wx:if="{{!scanning && devices.length}}" 上，即使 onUpdate 已经把设备
         增量塞进 devices，用户也要干等满整个搜索窗口才看得到任何一台——窗口一拉长体验就更差。
         搜索中也能直接点「立即绑定」，confirmBind 会先停扫再连接。 -->
    <block wx:if="{{devices.length}}">
      <view class="nearby-head">
        <view class="nearby-head__summary">
          <text class="nearby-count">已找到 {{devices.length}} 台</text>
          <text wx:if="{{scanning}}" class="nearby-end-search" hover-class="none" aria-role="button" bindtap="stopScanForBind">，结束搜索</text>
        </view>
        <image wx:if="{{!scanning}}" class="refresh-btn" src="/assets/images/refresh-icon.png" mode="aspectFit" aria-label="重新搜索" bindtap="scan"></image>
      </view>
      <!-- 单选列表：点选某台设备高亮，底部「立即绑定」绑定选中项；长按某行可进入该设备的硬件联调 -->
      <scroll-view scroll-y class="device-list">
        <view class="nearby-device {{selectedId === (item.id || item.deviceId) ? 'selected' : ''}}" wx:for="{{devices}}" wx:key="deviceId" hover-class="none" data-id="{{item.id || item.deviceId}}" bindtap="selectDevice" bindlongpress="openDebug">
          <!-- 设备图统一用首页设备卡那张 home-device-thumb（首页/列表/详情/搜索四处同图，2026-07-20 补齐本页）。
               ⚠️ 2026-08-21 前它叫 home-icon02.png，首页改版的新素材占了这个名字，故文件更名、图没换。 -->
          <view class="nearby-icon"><image class="nearby-icon__img" src="/assets/images/home-device-thumb.png" mode="aspectFit"></image></view>
          <view class="nearby-copy">
            <text class="nearby-name">{{item.name}}</text>
            <text class="nearby-sub">{{item.screen ? item.screen + ' · ' : ''}}{{item.battery !== undefined ? '电量' + item.battery + '% · ' : ''}}信号 {{item.signalText || '--'}}</text>
            <!-- 设备ID：广播里的 Device_ID，扫描阶段就能显示，用来区分同型号同名设备
                 （见 bind.js displayDeviceCode）。新固件播完整 6 字节、与设备详情页一致；
                 老固件只有 4 字节，包里就这么多，不做截断也不补齐。
                 判重/身份匹配仍只认连上后 0x01 读到的完整 6 字节 ID，与这里的展示无关。 -->
            <text wx:if="{{item.deviceCode}}" class="nearby-sub">设备ID {{item.deviceCode}}</text>
          </view>
          <image wx:if="{{selectedId === (item.id || item.deviceId)}}" class="select-circle" src="/assets/images/selected-icon.png" mode="aspectFit"></image>
          <view wx:else class="select-circle select-circle--empty"></view>
        </view>
      </scroll-view>
      <view class="primary-action bind-bottom" hover-class="none" bindtap="confirmBind">立即绑定</view>
    </block>

    <block wx:elif="{{scanning}}">
      <view class="scan-copy">
        <view class="scan-title">正在搜索附近电子纸设备</view>
        <view class="scan-desc">请尽量将手机靠近需要添加的电子纸设备...</view>
      </view>
      <view class="scan-help-link" hover-class="none" bindtap="openHelp">扫描不到怎么办?</view>
      <view class="primary-action bind-bottom" hover-class="none" bindtap="cancelScan">取消搜索</view>
    </block>

    <block wx:else>
      <view class="scan-copy">
        <view class="scan-title">未发现电子纸设备</view>
        <view class="scan-desc">未搜索到附近电子纸设备，请确认电子纸设备已开机并靠近手机</view>
      </view>
      <view class="scan-help-link" hover-class="none" bindtap="openHelp">扫描不到怎么办?</view>
      <view class="primary-action bind-bottom" hover-class="none" bindtap="scan">重新扫描</view>
    </block>
  </view>

  <view wx:if="{{showHelp}}" class="bind-mask" catchtouchmove="noop" bindtap="closeHelp">
    <view class="scan-help-sheet {{helpClosing ? 'pop-closing-sheet' : ''}}" catchtap="noop">
      <view class="sheet-close" hover-class="none" bindtap="closeHelp">×</view>
      <view class="scan-help-title">扫描不到怎么办?</view>
      <image class="scan-help-icon" src="/assets/images/scan_help_art.png" mode="aspectFit"></image>
      <view class="check-title">请检查:</view>
      <view class="check-list">
        <text>1.电子纸设备是否有电?</text>
        <text>2.当前电子纸设备是否被占用?</text>
        <text>3.电子纸设备蓝牙是否工作正常，手机或小程序蓝牙开关是否打开</text>
        <text>4.电子纸设备是否与手机距离过远，隔离或有其他遮挡物</text>
      </view>
    </view>
  </view>

  <device-name-dialog
    visible="{{renameVisible}}"
    value="{{renameValue}}"
    saving="{{renameSaving}}"
    title="给设备取个名字"
    cancel-text="稍后"
    confirm-text="确定"
    bindcancel="cancelRename"
    bindconfirm="confirmRename"
  ></device-name-dialog>

  <global-toast id="globalToast"></global-toast>
</view>
