<view class="mock-root bind-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202606161459019677928.png" mode="aspectFill"></image>
  </view>

  <page-nav title="绑定设备"></page-nav>

  <view class="bind-content {{showHelp ? 'content-dimmed' : ''}}">
    <view class="debug-entry" hover-class="none" bindtap="openDebug">
      <view class="debug-entry__icon">🔧</view>
      <view class="debug-entry__copy">
        <text class="debug-entry__title">硬件联调调试台</text>
        <text class="debug-entry__sub">开发对接用 · 一键测试上传/删除/电量等全部指令</text>
      </view>
      <view class="debug-entry__arrow">›</view>
    </view>

    <view class="radar-wrap {{scanning ? 'radar-scanning' : ''}}">
      <image wx:if="{{!scanning && devices.length}}" class="radar-art" src="/assets/images/device_found_art.png" mode="aspectFit"></image>
      <image wx:elif="{{!scanning && !devices.length}}" class="radar-art" src="/assets/images/device_not_found_art.png" mode="aspectFit"></image>
      <image wx:else class="radar-art" src="/assets/images/device_scanning_art.png" mode="aspectFit"></image>
    </view>

    <block wx:if="{{!scanning && devices.length}}">
      <view class="nearby-head">
        <text>附近设备</text>
        <view class="refresh-btn" hover-class="none" aria-label="重新搜索" bindtap="scan"></view>
      </view>
      <scroll-view scroll-y class="device-list">
        <view class="nearby-device" wx:for="{{devices}}" wx:key="deviceNo" hover-class="none" data-id="{{item.id || item.deviceId}}" bindtap="bindDevice">
          <view class="nearby-icon"><view class="small-frame-icon"></view></view>
          <view class="nearby-copy">
            <text class="nearby-name">{{item.name}}</text>
            <text class="nearby-sub">{{item.screen ? item.screen + ' · ' : ''}}{{item.battery !== undefined ? '电量' + item.battery + '% · ' : ''}}信号 {{item.RSSI || '--'}}</text>
          </view>
          <view class="debug-tag" catchtap="openDebug" data-id="{{item.id || item.deviceId}}">联调</view>
          <view class="bind-tag">绑定</view>
        </view>
      </scroll-view>
    </block>

    <block wx:elif="{{scanning}}">
      <view class="scan-copy">
        <view class="scan-title">正在搜索附近设备</view>
        <view class="scan-desc">请尽量将手机靠近需要添加的设备...</view>
      </view>
      <view class="scan-help-link" hover-class="none" bindtap="openHelp">扫描不到怎么办?</view>
    </block>

    <block wx:else>
      <view class="scan-copy">
        <view class="scan-title">未发现设备</view>
        <view class="scan-desc">设备连接中断，请检查设备状态后重试</view>
      </view>
      <view class="scan-help-link" hover-class="none" bindtap="openHelp">扫描不到怎么办?</view>
      <view class="primary-action bind-bottom" hover-class="none" bindtap="scan">重新扫描</view>
    </block>
  </view>

  <view wx:if="{{showHelp}}" class="bind-mask" catchtouchmove="noop" bindtap="closeHelp">
    <view class="scan-help-sheet" catchtap="noop">
      <view class="sheet-close" hover-class="none" bindtap="closeHelp">×</view>
      <view class="scan-help-title">扫描不到怎么办?</view>
      <image class="scan-help-icon" src="/assets/images/scan_help_art.png" mode="aspectFit"></image>
      <view class="check-title">请检查:</view>
      <view class="check-list">
        <text>1.设备是否有电?</text>
        <text>2.当前设备是否被占用?</text>
        <text>3.设备蓝牙是否工作正常，手机蓝牙是否打开</text>
        <text>4.设备是否与手机距离过远，隔离或有其他遮挡物</text>
      </view>
      <view class="primary-action" hover-class="none" bindtap="scan">重新扫描</view>
    </view>
  </view>
</view>
