.accept-content {
  padding-top: 48rpx;
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.accept-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx 40rpx;
}

.accept-thumb {
  width: 220rpx;
  height: 220rpx;
}

.accept-title {
  margin-top: 24rpx;
  color: #2a2d32;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  word-break: break-all;
}

.accept-desc {
  margin-top: 16rpx;
  color: #6f7782;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.accept-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  margin-top: 48rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.accept-btn.is-busy {
  opacity: 0.6;
}

.accept-sub {
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  color: #8b9098;
  font-size: 26rpx;
}
