<!-- WiFi 版设备详情（说明见 wifi-detail.js 文件头） -->
<view class="mock-root wifi-detail-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="设备详情"></page-nav>

  <view class="mock-content wifi-detail-content">
    <view wx:if="{{loading}}" class="page-loading">
      <view class="page-loading__spinner"></view>
      <view class="page-loading__text">加载中…</view>
    </view>

    <view wx:elif="{{loadError}}" class="wifi-detail-error glass-panel">
      <view class="wifi-detail-error__title">加载失败</view>
      <view class="wifi-detail-error__desc">网络异常或服务出错，请稍后重试。</view>
      <view class="wifi-detail-error__btn" hover-class="none" bindtap="retryLoad">重新加载</view>
    </view>

    <block wx:else>
      <view class="wifi-detail-head glass-panel">
        <image class="wifi-detail-head__thumb" src="{{device.thumb || '/assets/images/home-device-thumb.png'}}" mode="aspectFit"></image>
        <view class="wifi-detail-head__copy">
          <view class="wifi-detail-head__name-row">
            <text class="wifi-detail-head__name">{{device.name}}</text>
            <view class="comm-badge">
              <image class="comm-badge__icon" src="/assets/images/badge-wifi.svg" mode="aspectFit"></image>
              <text class="comm-badge__text">WiFi版</text>
            </view>
          </view>
          <view class="wifi-detail-meta">
            <view class="wifi-detail-state is-{{status}}">
              <view wx:if="{{status === 'loading'}}" class="wifi-detail-state__spinner"></view>
              <view wx:else class="wifi-detail-state__dot"></view>
              <text>{{statusText}}</text>
            </view>
            <!-- 2026-10-29：电量挪到在线状态这一栏（与蓝牙版一致），仅在线时有值 -->
            <view wx:if="{{batteryText}}" class="wifi-detail-battery">
              <image class="battery-level-icon" src="{{batteryIcon}}" mode="aspectFit"></image>
              <text>{{batteryText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 投屏 / 轮播设置放在设备卡与功能栏之间（2026-10-29，与蓝牙版位置一致） -->
      <view class="wifi-detail-actions glass-panel">
        <view class="wifi-detail-action projection-action" hover-class="none" bindtap="startProjection">
          <image class="wifi-detail-action__icon" src="/assets/images/screen-casting-icon01.png" mode="aspectFit"></image>
          <text>投屏</text>
        </view>
        <view class="wifi-detail-action-divider"></view>
        <!-- V1.4 更新说明 1.5：原「刷新状态」改为「轮播设置」；状态随进页与 WS device.status 自动重查 -->
        <!-- 轮播开启中（2026-11-02；2026-11-05 起只在 running 且设备在线时显示，去掉「轮播中」文字）：图标变绿 + 右上角绿点动效 -->
        <view class="wifi-detail-action slideshow-action" hover-class="none" bindtap="openSlideshow">
          <view class="slideshow-icon-wrap">
            <image class="wifi-detail-action__icon" src="{{slideshowOn && status === 'online' ? '/assets/images/device-detail-icon01-on.png' : '/assets/images/device-detail-icon01.png'}}" mode="aspectFit"></image>
            <view wx:if="{{slideshowOn && status === 'online'}}" class="slideshow-on-dot"></view>
          </view>
          <text>轮播设置</text>
        </view>
      </view>

      <!-- 功能栏（2026-10-29）：设备信息、设备ID、屏幕尺寸（2026-11-02）、消息中心（休眠设置 2026-11-09 隐藏）、固件升级（2026-11-02）、TF卡、共享设备（2026-11-05 起所有者与接收者都显示，接收者进去只看不改）、解除绑定 -->
      <view class="wifi-detail-entries glass-panel">
        <view class="wifi-detail-entry" hover-class="none" bindtap="openInfo">
          <text class="wifi-detail-entry__label">设备信息</text>
          <view class="wifi-detail-entry__right">
            <!-- 有没看过的优雅刷新版本（2026-11-13）：亮红点，进优雅刷新升级看过即消失 -->
            <view wx:if="{{infoHasNew}}" class="wifi-detail-dot"></view>
            <view class="ui-chevron"></view>
          </view>
        </view>
        <!-- 设备ID / 屏幕尺寸（2026-11-02，同蓝牙版详情）：只展示、不可点；屏幕尺寸取后台产品配置 sizeModel，没配整行不展示。
             顶部卡片原来的「屏幕尺寸」「设备ID」两行已去掉（与这里重复），改在这里显示 -->
        <view class="wifi-detail-entry device-id-entry">
          <text class="wifi-detail-entry__label">设备ID</text>
          <text class="wifi-detail-entry__value wifi-detail-entry__value--plain">{{device.productDeviceId || '--'}}</text>
        </view>
        <view wx:if="{{device.sizeModel}}" class="wifi-detail-entry size-model-entry">
          <text class="wifi-detail-entry__label">屏幕尺寸</text>
          <text class="wifi-detail-entry__value wifi-detail-entry__value--plain">{{device.sizeModel}}</text>
        </view>
        <!-- 休眠设置入口 2026-11-09 按产品要求隐藏（wifi-sleep 页与 openSleep 保留，恢复时把入口加回这里即可） -->
        <view class="wifi-detail-entry" hover-class="none" bindtap="openMessages">
          <text class="wifi-detail-entry__label">消息中心</text>
          <view class="wifi-detail-entry__right">
            <!-- 有未读只亮红点、不显示具体数字（2026-11-06），样式同固件升级行；消息列表页不变 -->
            <view wx:if="{{unreadCount}}" class="wifi-detail-dot"></view>
            <view class="ui-chevron"></view>
          </view>
        </view>
        <!-- 固件升级（2026-11-02）：右侧当前固件版本；有新版本亮红点，进行中显示「升级中」 -->
        <view class="wifi-detail-entry ota-entry" hover-class="none" bindtap="openOta">
          <text class="wifi-detail-entry__label">固件升级</text>
          <view class="wifi-detail-entry__right">
            <text class="wifi-detail-entry__value">{{otaText}}</text>
            <view wx:if="{{otaHasUpdate}}" class="wifi-detail-dot"></view>
            <view class="ui-chevron"></view>
          </view>
        </view>
        <!-- TF卡：未插卡不可点；有卡显示已用 / 总量 + 箭头，进 TF 卡设置 -->
        <view class="wifi-detail-entry tf-entry" hover-class="none" bindtap="openTf">
          <text class="wifi-detail-entry__label">TF卡</text>
          <view class="wifi-detail-entry__right">
            <text class="wifi-detail-entry__value">{{tfText}}</text>
            <view wx:if="{{tfState === 'present'}}" class="ui-chevron"></view>
          </view>
        </view>
        <view class="wifi-detail-entry" hover-class="none" bindtap="openShare">
          <text class="wifi-detail-entry__label">共享设备</text>
          <view class="ui-chevron"></view>
        </view>
      </view>

      <!-- 一键清空 + 解除绑定（2026-11-09）：布局样式同蓝牙版详情 .action-list（图标 + 橙 / 红字，中间细分隔线）。
           一键清空仅所有者（会删掉这台设备全部云端照片），接收者这张卡片只有解除绑定 -->
      <view class="detail-list action-list glass-panel">
        <block wx:if="{{isOwner}}">
          <view class="detail-row action-row clear-row" hover-class="none" bindtap="clearCopies">
            <view class="row-left">
              <image class="row-icon" src="/assets/images/device-detail-icon05.png" mode="aspectFit"></image>
              <text>一键清空</text>
            </view>
            <view class="row-right">
              <text>清空电子纸设备及小程序/APP内的照片</text>
              <view class="ui-chevron"></view>
            </view>
          </view>
          <view class="thin-divider"></view>
        </block>
        <view class="detail-row action-row delete-row" hover-class="none" bindtap="showUnbindConfirm">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit"></image>
            <text>解除绑定</text>
          </view>
          <view class="row-right">
            <text>解除绑定电子纸设备，保留照片</text>
            <view class="ui-chevron"></view>
          </view>
        </view>
      </view>

      <!-- 删除设备（仅所有者）：样式同蓝牙版页底入口；先删云端图片再删设备 -->
      <view wx:if="{{isOwner}}" class="outline-delete-device" hover-class="none" bindtap="showDeleteConfirm">删除设备</view>
    </block>
  </view>

  <!-- 解除绑定确认：只删设备记录，照片保留 -->
  <view class="confirm-mask" wx:if="{{showUnbindConfirm}}" catchtouchmove="noop" bindtap="hideUnbindConfirm">
    <view class="confirm-dialog {{unbindClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
      <view class="confirm-icon danger-icon">
        <image class="trash-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit"></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">解除绑定</view>
        <view class="confirm-desc">解除绑定后，照片将保留，您可以稍后重新绑定电子纸设备。</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="hideUnbindConfirm">取消</view>
        <view class="confirm-primary" hover-class="none" bindtap="confirmUnbind">确认</view>
      </view>
    </view>
  </view>

  <!-- 删除设备一级确认 -->
  <view class="confirm-mask" wx:if="{{showDeleteConfirm}}" catchtouchmove="noop" bindtap="hideDeleteConfirm">
    <view class="confirm-dialog {{deleteClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
      <view class="confirm-icon danger-icon">
        <image class="trash-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit"></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">删除设备</view>
        <view class="confirm-desc">删除设备将清空该设备的云端照片及小程序/APP内的照片，防止隐私泄露；已分享的成员也将同时失去这台设备及其照片。是否确认删除设备？</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="hideDeleteConfirm">取消</view>
        <view class="confirm-primary" hover-class="none" bindtap="openDeleteStep2">继续</view>
      </view>
    </view>
  </view>

  <!-- 删除设备二级确认：清照片记录 → 删云端图片 → 删设备 -->
  <view class="confirm-mask" wx:if="{{showDeleteConfirm2}}" catchtouchmove="noop" bindtap="hideDeleteConfirm2">
    <view class="confirm-dialog {{deleteClosing2 ? 'pop-closing-dialog' : ''}}" catchtap="noop">
      <view class="confirm-icon danger-icon">
        <image class="trash-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit"></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">确认删除设备</view>
        <view class="confirm-desc">我已知晓删除电子纸设备相关内容，确认删除</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="hideDeleteConfirm2">取消</view>
        <view class="confirm-primary" hover-class="none" bindtap="confirmDeleteDevice">确认</view>
      </view>
    </view>
  </view>

  <!-- 一键清空 · 一级确认（2026-11-09，交互同蓝牙版）：点「继续」进二级确认 -->
  <view class="confirm-mask" wx:if="{{showClearConfirm}}" catchtouchmove="noop" bindtap="hideClearConfirm">
    <view class="confirm-dialog {{clearClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
      <view class="confirm-icon clear-icon">
        <image class="broom-icon" src="/assets/images/device-detail-icon05.png" mode="aspectFit"></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">一键清空</view>
        <view class="confirm-desc">将清空该设备的云端照片并恢复设备内置图片，同时清空小程序/APP的图库，请谨慎选择是否继续。</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="hideClearConfirm">再想想</view>
        <view class="confirm-primary" hover-class="none" bindtap="openClearStep2">继续</view>
      </view>
    </view>
  </view>

  <!-- 一键清空 · 二级确认：清相册记录 → 删云端图片 → 恢复内置图片（设备记录保留） -->
  <view class="confirm-mask" wx:if="{{showClearConfirm2}}" catchtouchmove="noop" bindtap="hideClearConfirm2">
    <view class="confirm-dialog {{clearClosing2 ? 'pop-closing-dialog' : ''}}" catchtap="noop">
      <view class="confirm-icon clear-icon">
        <image class="broom-icon" src="/assets/images/device-detail-icon05.png" mode="aspectFit"></image>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">一键清空</view>
        <view class="confirm-desc">我已阅读并了解此操作的结果，确认继续。</view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-cancel" hover-class="none" bindtap="hideClearConfirm2">取消</view>
        <view class="confirm-primary" hover-class="none" bindtap="confirmClearCopies">确认</view>
      </view>
    </view>
  </view>

  <view class="media-mask" wx:if="{{showMediaSheet}}" catchtouchmove="noop" bindtap="hideMediaSheet">
    <view class="bottom-sheet media-sheet {{mediaSheetClosing ? 'pop-closing-sheet' : ''}}" catchtap="noop">
      <view class="media-sheet-title">选择投屏方式</view>
      <view class="media-option" hover-class="none" bindtap="chooseCamera">
        <view class="media-option-left">
          <image class="media-art mini camera-art" src="/assets/images/home-media-mini01.png" mode="aspectFit"></image>
          <view class="media-option-copy">
            <view>拍照</view>
            <text>调用手机相机拍照</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-camera-card-right-icon.png" mode="aspectFit"></image>
      </view>
      <view class="media-option" hover-class="none" bindtap="chooseAlbum">
        <view class="media-option-left">
          <image class="media-art mini album-art" src="/assets/images/home-media-mini02.png" mode="aspectFit"></image>
          <view class="media-option-copy">
            <view>相册</view>
            <text>从手机相册选择照片</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-album-card-right-icon.png" mode="aspectFit"></image>
      </view>
      <view class="cancel-action" hover-class="none" bindtap="hideMediaSheet">取消</view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
  <debug-log></debug-log>
</view>
