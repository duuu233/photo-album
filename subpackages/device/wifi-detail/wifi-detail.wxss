.wifi-detail-content {
  padding-top: 32rpx;
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.wifi-detail-head {
  display: flex;
  align-items: center;
  padding: 36rpx 36rpx;
}

.wifi-detail-head__thumb {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 140rpx;
  margin-right: 28rpx;
}

.wifi-detail-head__copy {
  flex: 1;
  min-width: 0;
}

.wifi-detail-head__name-row {
  display: flex;
  align-items: center;
}

.wifi-detail-head__name {
  overflow: hidden;
  color: #2a2d32;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-detail-head__id {
  display: block;
  margin-top: 10rpx;
  color: #8b9098;
  font-size: 22rpx;
}

/* 通信类型角标：与搜索设备列表的 WiFi版 角标同款（青绿） */
.comm-badge {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 32rpx;
  margin-left: 12rpx;
  padding: 0 12rpx 0 8rpx;
  background: linear-gradient(135deg, rgba(18, 184, 150, 0.16), rgba(56, 189, 248, 0.12));
  border: 1rpx solid rgba(14, 159, 135, 0.32);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.comm-badge__icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
}

.comm-badge__text {
  color: #0e9f87;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.wifi-detail-state {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #9ba2ad;
  font-size: 26rpx;
}

.wifi-detail-state.is-online {
  color: #0e9f87;
}

.wifi-detail-state__dot {
  width: 14rpx;
  height: 14rpx;
  background: currentColor;
  border-radius: 50%;
}

.wifi-detail-state__spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(14, 159, 135, 0.25);
  border-top-color: #0e9f87;
  border-radius: 50%;
  box-sizing: border-box;
  animation: wifiDetailSpin 0.8s linear infinite;
}

@keyframes wifiDetailSpin {
  to {
    transform: rotate(360deg);
  }
}

.wifi-detail-rows {
  margin-top: 24rpx;
  padding: 8rpx 36rpx;
}

.wifi-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
}

.wifi-detail-row + .wifi-detail-row {
  border-top: 1rpx solid rgba(42, 43, 43, 0.06);
}

.wifi-detail-row__label {
  color: #8b9098;
  font-size: 28rpx;
}

.wifi-detail-row__value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 62%;
  color: #2a2d32;
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.wifi-detail-actions {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  height: 96rpx;
  margin-top: 24rpx;
  border-radius: 40rpx;
}

.wifi-detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 96rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.wifi-detail-action.projection-action {
  color: #eb5f1b;
}

.wifi-detail-action.refresh-action {
  color: #0e9f87;
}

.wifi-detail-action.is-busy {
  opacity: 0.5;
}

.wifi-detail-action-divider {
  height: 38rpx;
  background: #dadddf;
}

.wifi-detail-action__icon {
  width: 40rpx;
  height: 40rpx;
}

.wifi-detail-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 36rpx;
}

.wifi-detail-error__title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.wifi-detail-error__desc {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 24rpx;
}

.wifi-detail-error__btn {
  margin-top: 36rpx;
  padding: 20rpx 64rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* ── 「拍照 / 相册」选择弹层（与设备列表 / 蓝牙详情页同款，点「投屏」后弹出）────── */
.media-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 46rpx;
  color: #2a2b2b;
  font-size: 40rpx;
  font-weight: 500;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 128rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  background: #f8f9fb;
  border-radius: 28rpx;
}

.media-option-left {
  display: flex;
  align-items: center;
}

.media-art.mini {
  position: relative;
  width: 98rpx;
  height: 96rpx;
}

.media-option-copy {
  height: 100%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  padding-left: 28rpx;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  width: 118rpx;
  height: 118rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 500;
}
