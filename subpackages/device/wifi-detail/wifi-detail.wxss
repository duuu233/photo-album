.wifi-detail-content {
  padding-top: 32rpx;
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.wifi-detail-head {
  display: flex;
  align-items: center;
  padding: 36rpx 36rpx;
}

.wifi-detail-head__thumb {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 140rpx;
  margin-right: 28rpx;
}

.wifi-detail-head__copy {
  flex: 1;
  min-width: 0;
}

.wifi-detail-head__name-row {
  display: flex;
  align-items: center;
}

.wifi-detail-head__name {
  overflow: hidden;
  color: #2a2d32;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-detail-head__id {
  display: block;
  margin-top: 10rpx;
  color: #8b9098;
  font-size: 22rpx;
}

/* 通信类型角标：与搜索设备列表的 WiFi版 角标同款（青绿） */
.comm-badge {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 32rpx;
  margin-left: 12rpx;
  padding: 0 12rpx 0 8rpx;
  background: linear-gradient(135deg, rgba(18, 184, 150, 0.16), rgba(56, 189, 248, 0.12));
  border: 1rpx solid rgba(14, 159, 135, 0.32);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.comm-badge__icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
}

.comm-badge__text {
  color: #0e9f87;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.wifi-detail-state {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #9ba2ad;
  font-size: 26rpx;
}

.wifi-detail-state.is-online {
  color: #0e9f87;
}

/* 休眠中（2026-10-27）：蓝色，与离线的灰区分 */
.wifi-detail-state.is-sleeping {
  color: #2f80ed;
}

/* 本地模式（2026-10-29，TF 卡本地播放）：紫色，与离线 / 休眠区分 */
.wifi-detail-state.is-local {
  color: #8e5bd9;
}

/* 状态与电量一栏（2026-10-29，与蓝牙版 .summary-meta 同排法） */
.wifi-detail-meta {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 14rpx;
}

.wifi-detail-meta .wifi-detail-state {
  margin-top: 0;
}

.wifi-detail-battery {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #2a2d32;
  font-size: 26rpx;
}

.wifi-detail-state__dot {
  width: 14rpx;
  height: 14rpx;
  background: currentColor;
  border-radius: 50%;
}

.wifi-detail-state__spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(14, 159, 135, 0.25);
  border-top-color: #0e9f87;
  border-radius: 50%;
  box-sizing: border-box;
  animation: wifiDetailSpin 0.8s linear infinite;
}

@keyframes wifiDetailSpin {
  to {
    transform: rotate(360deg);
  }
}

.wifi-detail-actions {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  height: 96rpx;
  margin-top: 24rpx;
  border-radius: 40rpx;
}

.wifi-detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 96rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.wifi-detail-action.projection-action {
  color: #eb5f1b;
}

.wifi-detail-action.slideshow-action {
  color: #0e9f87;
}

.wifi-detail-action-divider {
  height: 38rpx;
  background: #dadddf;
}

.wifi-detail-action__icon {
  width: 40rpx;
  height: 40rpx;
}

.wifi-detail-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 36rpx;
}

.wifi-detail-error__title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.wifi-detail-error__desc {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 24rpx;
}

.wifi-detail-error__btn {
  margin-top: 36rpx;
  padding: 20rpx 64rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* ── 「拍照 / 相册」选择弹层（与设备列表 / 蓝牙详情页同款，点「投屏」后弹出）────── */
.media-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 46rpx;
  color: #2a2b2b;
  font-size: 40rpx;
  font-weight: 500;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 128rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  background: #f8f9fb;
  border-radius: 28rpx;
}

.media-option-left {
  display: flex;
  align-items: center;
}

.media-art.mini {
  position: relative;
  width: 98rpx;
  height: 96rpx;
}

.media-option-copy {
  height: 100%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  padding-left: 28rpx;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  width: 118rpx;
  height: 118rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 500;
}

/* 休眠设置 / 消息中心入口（2026-10-27，V1.4 实现报告反馈） */
.wifi-detail-entries {
  margin-top: 24rpx;
  padding: 0 36rpx;
}

.wifi-detail-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
}

.wifi-detail-entry + .wifi-detail-entry {
  border-top: 1rpx solid rgba(42, 43, 43, 0.06);
}

.wifi-detail-entry__label {
  color: #33373d;
  font-size: 28rpx;
  font-weight: 600;
}

.wifi-detail-entry__right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wifi-detail-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #e5533d;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
}

.wifi-detail-entry__value {
  max-width: 400rpx;
  overflow: hidden;
  color: #777e88;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 解除绑定（2026-10-29）：红字，同蓝牙版 .delete-row */
.unbind-entry .wifi-detail-entry__label {
  color: #ff3045;
  font-weight: 500;
}

/* 「删除设备」页底入口：与蓝牙版 detail.wxss .outline-delete-device 同款（无描边、不引导点击） */
.outline-delete-device {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  margin: 64rpx 0 0;
  color: #ff3045;
  background: transparent;
  font-size: 28rpx;
  font-weight: 500;
}

/* 解除绑定 / 删除设备确认弹窗：与蓝牙版详情同款 */
.confirm-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.4);
}

.confirm-dialog {
  display: grid;
  grid-template-columns: 80rpx 1fr;
  column-gap: 28rpx;
  width: 100%;
  padding: 60rpx 48rpx 40rpx 48rpx;
  background: #ffffff;
  border-radius: 28rpx;
  animation: popDialogIn 0.24s ease-out;
}

.confirm-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
}

.danger-icon {
  color: #ff3045;
  background: rgba(255, 48, 69, 0.08);
}

.trash-icon {
  width: 48rpx;
  height: 48rpx;
}

.confirm-copy {
  min-width: 0;
  margin-left: 12rpx;
}

.confirm-title {
  color: #25282d;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.15;
}

.confirm-desc {
  margin-top: 12rpx;
  color: #6f7782;
  font-size: 24rpx;
  line-height: 1.45;
}

.confirm-actions {
  grid-column: 1 / 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 42rpx;
  padding-left: 118rpx;
}

.confirm-cancel,
.confirm-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.confirm-cancel {
  color: #32363c;
  background: #eeeeee;
}

.confirm-primary {
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
}
