/* 选择 WiFi 页（2026-10-26 整体优化）：提示语 + 灰字入口一组，下面是列表卡片，卡片末尾居中的「手动输入WiFi名称」橙字。
   提示条、列表项沿用 WiFi 账号密码页 / 原 WiFi 列表弹层的样式。
   10-27 曾去掉「设备仅支持 2.4G WiFi 配网」提示条，2026-10-29 按产品口径恢复。 */
.wifi-list-content {
  padding-top: 24rpx;
}

.wifi-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6421;
  font-size: 26rpx;
}

.wifi-tip__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  color: #ffffff;
  background: #ff6421;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

/* 提示语下的手动输入入口：灰色小字，居中 */
.wifi-manual-hint {
  margin: 10rpx 0 32rpx;
  padding: 6rpx 0;
  color: #8b9098;
  font-size: 24rpx;
  text-align: center;
}

.wifi-list-panel {
  padding: 28rpx 0 8rpx;
  overflow: hidden;
}

.wifi-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(42, 43, 43, 0.06);
}

.wifi-list-head__title {
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 700;
}

.wifi-list-head__rescan {
  display: flex;
  align-items: center;
  color: #ff6421;
  font-size: 24rpx;
}

.wifi-list-head__rescan-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 6rpx;
}

.wifi-list-scanning {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #8b9098;
  font-size: 26rpx;
}

.wifi-list-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 98, 31, 0.18);
  border-top-color: #ff621f;
  border-radius: 50%;
  animation: wifiListSpin 0.8s linear infinite;
}

@keyframes wifiListSpin {
  to {
    transform: rotate(360deg);
  }
}

/* 提示（没搜到 / 失败原因）：居中灰字 */
.wifi-list-sub {
  padding: 40rpx 48rpx;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.wifi-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 32rpx;
}

/* 行间细分隔线，从图标右侧起画（与图标对齐的内缩线） */
.wifi-item + .wifi-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 92rpx;
  right: 32rpx;
  height: 1rpx;
  background: rgba(42, 43, 43, 0.06);
}

.wifi-item--pressed {
  background: rgba(255, 247, 242, 0.92);
}

.wifi-item__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.wifi-item__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #2a2d32;
  font-size: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-item__signal {
  margin-left: 16rpx;
}

.wifi-item__arrow {
  margin-left: 16rpx;
  color: #c8cdd5;
  font-size: 36rpx;
}

/* 列表下方的手动输入：原文字版样式（橙字），居中 */
.wifi-manual-text {
  padding: 28rpx 32rpx 24rpx;
  color: #ff6421;
  font-size: 30rpx;
  text-align: center;
}
