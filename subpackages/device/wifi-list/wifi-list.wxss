/* 提示条、列表项与 WiFi 账号密码页 / 原 WiFi 列表弹层同一套样式 */
.wifi-list-content {
  padding-top: 24rpx;
}

.wifi-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  color: #ff6421;
  font-size: 26rpx;
}

.wifi-tip__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  color: #ffffff;
  background: #ff6421;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

.wifi-list-panel {
  padding: 28rpx 24rpx 16rpx;
}

.wifi-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 12rpx;
}

.wifi-list-head__title {
  color: #2a2d32;
  font-size: 28rpx;
  font-weight: 700;
}

.wifi-list-head__rescan {
  color: #ff6421;
  font-size: 26rpx;
}

.wifi-list-scanning {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  color: #8b9098;
  font-size: 26rpx;
}

.wifi-list-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 98, 31, 0.18);
  border-top-color: #ff621f;
  border-radius: 50%;
  animation: wifiListSpin 0.8s linear infinite;
}

@keyframes wifiListSpin {
  to {
    transform: rotate(360deg);
  }
}

.wifi-list-sub {
  padding: 8rpx 24rpx 16rpx;
  color: #b3b8c0;
  font-size: 22rpx;
}

.wifi-item {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
}

.wifi-item + .wifi-item {
  margin-top: 8rpx;
}

.wifi-item__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.wifi-item__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #2a2d32;
  font-size: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-item__signal {
  margin-left: 16rpx;
}

.wifi-item__arrow {
  margin-left: 16rpx;
  color: #c8cdd5;
  font-size: 36rpx;
}

.wifi-item--manual .wifi-item__name {
  color: #ff6421;
}

/* 联调查看（非正式版）：设备回包字段 */
.wifi-raw-summary {
  margin: 0 24rpx 12rpx;
  padding: 16rpx 20rpx;
  color: #555c66;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx dashed #c8cdd5;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.wifi-raw-summary__hex {
  display: block;
  margin-top: 8rpx;
  color: #8b9098;
  font-family: Menlo, monospace;
}

.wifi-item--raw {
  height: auto;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  align-items: flex-start;
}

.wifi-item__body {
  flex: 1;
  min-width: 0;
}

.wifi-item__body .wifi-item__name {
  display: block;
}

.wifi-item__raw {
  display: block;
  margin-top: 4rpx;
  color: #8b9098;
  font-size: 22rpx;
  line-height: 1.4;
  word-break: break-all;
}

/* 联调日志（非正式版） */
.wifi-debug-log {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(30, 33, 38, 0.86);
  border-radius: 16rpx;
}

.wifi-debug-log__title {
  margin-bottom: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.wifi-debug-log__line {
  display: block;
  color: #c9f7d8;
  font-family: Menlo, monospace;
  font-size: 20rpx;
  line-height: 1.5;
  word-break: break-all;
}
