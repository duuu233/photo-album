<!-- WiFi 版设备配网 · 选择 WiFi（设备经蓝牙扫描附近 WiFi，流程见 wifi-list.js 文件头）。列表项样式沿用原 WiFi 列表弹层 -->
<view class="mock-root wifi-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px; --nav-h: {{navHeight}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="选择WiFi" bind:measure="onNavMeasure"></page-nav>

  <view class="mock-content wifi-list-content">
    <view class="wifi-tip">
      <view class="wifi-tip__icon">i</view>
      <text>设备仅支持 2.4G WiFi 配网</text>
    </view>

    <view class="wifi-list-panel glass-panel">
      <view class="wifi-list-head">
        <text class="wifi-list-head__title">设备附近的 WiFi</text>
        <text wx:if="{{!scanning}}" class="wifi-list-head__rescan" hover-class="none" bindtap="rescan">重新搜索</text>
      </view>
      <!-- 设备扫描中（3~5 秒） -->
      <view wx:if="{{scanning}}" class="wifi-list-scanning">
        <view class="wifi-list-spinner"></view>
        <text>正在搜索网络...</text>
      </view>
      <view wx:elif="{{tip}}" class="wifi-list-sub">{{tip}}</view>
      <!-- 联调查看（非正式版）：整包原始数据 -->
      <view wx:if="{{showRaw && !scanning && rawSummary}}" class="wifi-raw-summary">
        <text user-select>{{rawSummary}}</text>
        <text wx:if="{{rawHex}}" class="wifi-raw-summary__hex" user-select>{{rawHex}}</text>
      </view>
      <view wx:for="{{wifiList}}" wx:key="key" class="wifi-item {{showRaw ? 'wifi-item--raw' : ''}}" hover-class="none" data-ssid="{{item.ssid}}" bindtap="pickWifi">
        <image class="wifi-item__icon" src="/assets/images/badge-wifi.svg" mode="aspectFit"></image>
        <view wx:if="{{showRaw}}" class="wifi-item__body">
          <text class="wifi-item__name">{{item.ssid || '(隐藏网络)'}}</text>
          <!-- 设备回包里这条的全部字段：SSID / RSSI / 信道 / 频率 / 长度 / 原始字节 -->
          <text class="wifi-item__raw" user-select>SSID：{{item.ssid || '(空)'}}</text>
          <text class="wifi-item__raw" user-select>RSSI：{{item.rssi}} dBm（{{item.level}} 格）</text>
          <text class="wifi-item__raw" user-select>信道：{{item.channel !== '' ? item.channel : '未返回'}} · 频率：{{item.frequency !== '' ? item.frequency + ' MHz' : '未返回'}}</text>
          <text class="wifi-item__raw" user-select>长度字节：{{item.len}} · 原始：{{item.raw}}</text>
        </view>
        <text wx:else class="wifi-item__name">{{item.ssid}}</text>
        <!-- 信号强度：4 格，按设备扫到的 RSSI 点亮 -->
        <view class="wifi-signal" aria-label="信号 {{item.level}} 格">
          <view class="wifi-signal__bar {{item.level >= 1 ? 'is-on' : ''}}"></view>
          <view class="wifi-signal__bar {{item.level >= 2 ? 'is-on' : ''}}"></view>
          <view class="wifi-signal__bar {{item.level >= 3 ? 'is-on' : ''}}"></view>
          <view class="wifi-signal__bar {{item.level >= 4 ? 'is-on' : ''}}"></view>
        </view>
        <text class="wifi-item__arrow">›</text>
      </view>
      <view wx:if="{{!scanning}}" class="wifi-item wifi-item--manual" hover-class="none" bindtap="manualInput">
        <text class="wifi-item__name">手动输入WiFi名称</text>
        <text class="wifi-item__arrow">›</text>
      </view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
