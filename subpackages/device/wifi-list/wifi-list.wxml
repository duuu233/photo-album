<!-- WiFi 版设备配网 · 选择 WiFi（设备经蓝牙扫描附近 WiFi，流程见 wifi-list.js 文件头）。列表项样式沿用原 WiFi 列表弹层 -->
<view class="mock-root wifi-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px; --nav-h: {{navHeight}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="选择WiFi" bind:measure="onNavMeasure"></page-nav>

  <view class="mock-content wifi-list-content">
    <view class="wifi-tip">
      <view class="wifi-tip__icon">i</view>
      <text>设备仅支持 2.4G WiFi 配网</text>
    </view>
    <!-- 搜不到时的手动入口：灰字，点击进账号密码页手动填名称 -->
    <view class="wifi-manual-hint" hover-class="none" aria-role="button" bindtap="manualInput">若列表搜索不到您的wifi，请手动输入</view>

    <view class="wifi-list-panel glass-panel">
      <view class="wifi-list-head">
        <text class="wifi-list-head__title">设备附近的2.4G WiFi</text>
        <view wx:if="{{!scanning}}" class="wifi-list-head__rescan" hover-class="none" aria-role="button" bindtap="rescan">
          <image class="wifi-list-head__rescan-icon" src="/assets/images/refresh-icon.png" mode="aspectFit"></image>
          <text>重新搜索</text>
        </view>
      </view>
      <!-- ① 蓝牙连接设备 → ② 设备扫描（3~5 秒）；扫描中已收到的网络照常列在下面 -->
      <view wx:if="{{scanning}}" class="wifi-list-scanning">
        <view class="wifi-list-spinner"></view>
        <text>{{phase === 'connecting' ? '正在连接设备...' : '正在搜索网络...'}}</text>
      </view>
      <view wx:elif="{{tip}}" class="wifi-list-sub">{{tip}}</view>
      <!-- 两步：点一行只选中（高亮 + 行尾「连接」），再点「连接」才进账号密码页 -->
      <view wx:for="{{wifiList}}" wx:key="ssid" class="wifi-item {{item.ssid === selectedSsid ? 'is-selected' : ''}}" hover-class="wifi-item--pressed" data-ssid="{{item.ssid}}" bindtap="pickWifi">
        <image class="wifi-item__icon" src="/assets/images/badge-wifi.svg" mode="aspectFit"></image>
        <text class="wifi-item__name">{{item.ssid}}</text>
        <!-- 信号强度：信号格（与搜索设备列表同一组件，仿 iPhone 满格 4 格、最弱 1 格） -->
        <signal-bars class="wifi-item__signal" level="{{item.level}}"></signal-bars>
        <view wx:if="{{item.ssid === selectedSsid}}" class="wifi-item__connect" hover-class="none" catchtap="connectSelected">连接</view>
        <text wx:else class="wifi-item__arrow">›</text>
      </view>
      <!-- 手动输入：文字样式（橙字）居中，列表下方 -->
      <view wx:if="{{!scanning}}" class="wifi-manual-text" hover-class="none" bindtap="manualInput">手动输入WiFi名称</view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
