<!-- 页面框架（背景 + 导航）始终渲染，内容区在「详情 / 加载中 / 加载失败 / 不存在」之间切换， 避免接口报错时 device 为空导致布局错乱 -->
<view class="mock-root detail-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image
      class="mock-bg__image"
      src="https://oss.boltfox.cn/prodFile/202607310920402821453.png"
      mode="aspectFill" />
  </view>
  <page-nav title="设备详情">
  </page-nav>
  <!-- 设备存在：渲染详情内容与相关弹窗 -->
  <block wx:if="{{device}}">
    <view class="mock-content detail-content">
      <view class="device-summary glass-panel">
        <!-- 2026-07-19 产品要求：设备图统一用首页那张 home-icon02（原来是 mine-icon03）；
             不分连接状态。该图四角透明自带圆角，故 .summary-icon 不再加底色。 -->
        <view class="summary-icon">
          <image
            class="summary-icon__img"
            src="/assets/images/home-icon02.png"
            mode="aspectFit" />
        </view>
        <view class="summary-copy">
          <view class="summary-name-row">
            <view class="summary-title">{{device.name}}</view>
            <view
              class="edit-name-btn"
              hover-class="none"
              catchtap="renameDevice"
              aria-label="编辑设备名称"
            >
              <image
                class="edit-name-icon"
                src="/assets/images/edit-icon01.png"
                mode="aspectFit" />
            </view>
          </view>
          <view class="summary-meta">
            <view class="connection {{device.connected ? 'is-connected' : ''}}">
              <image
                class="meta-bt-icon"
                src="{{device.connected ? '/assets/images/bluetooth-icon.png' : '/assets/images/bluetooth-icon-not.png'}}"
                mode="aspectFit" />
              <text>{{device.connected ? '已连接' : '未连接'}}</text>
            </view>
            <!-- 仅在已连接设备后才展示电量图标与数值 -->
            <view wx:if="{{device.connected}}" class="battery-meta">
              <image
                class="battery-level-icon"
                src="{{batteryIcon}}"
                mode="aspectFit" />
              <text>{{batteryText}}</text>
            </view>
          </view>
        </view>
      </view>
      <!-- 顶部「投屏 / 连接」操作，样式同「我的设备」的轮播设置和连接模块 -->
      <view class="device-actions glass-panel">
        <view
          class="device-action projection-action"
          hover-class="none"
          catchtap="startProjection"
        >
          <image
            class="action-frame-icon"
            src="/assets/images/screen-casting-icon01.png"
            mode="aspectFit" />
          <text>投屏</text>
        </view>
        <view class="device-action-divider">
        </view>
        <view
          class="device-action connection-action {{device.connected ? 'disconnect' : 'connect'}}"
          hover-class="none"
          catchtap="toggleConnection"
        >
          <image
            class="action-bt-icon"
            src="{{device.connected ? '/assets/images/disconnect-icon01.png' : '/assets/images/bluetooth-connection.png'}}"
            mode="aspectFit" />
          <text>{{device.connected ? '断开' : '连接'}}</text>
        </view>
      </view>
      <view class="detail-list glass-panel">
        <view
          class="detail-row"
          hover-class="none"
          bindtap="goSlideshow"
        >
          <view class="row-left">
            <image
              class="row-icon"
              src="/assets/images/device-detail-icon01.png"
              mode="aspectFit" />
            <text>轮播设置</text>
          </view>
          <view class="row-right">
            <text>{{playbackLabel}}</text>
            <view class="ui-chevron">
            </view>
          </view>
        </view>
        <view class="thin-divider">
        </view>
        <view class="detail-row">
          <view class="row-left">
            <image
              class="row-icon"
              src="/assets/images/device-detail-icon02.png"
              mode="aspectFit" />
            <text>设备ID</text>
          </view>
          <view class="row-value">{{deviceCode}}</view>
        </view>
        <view class="thin-divider">
        </view>
        <!-- 屏幕物理尺寸（像素，如 680*960）：产品静态属性，不随连接状态置 -- -->
        <view class="detail-row">
          <view class="row-left">
            <image
              class="row-icon"
              src="/assets/images/device-detail-screen-size.svg"
              mode="aspectFit" />
            <text>屏幕尺寸</text>
          </view>
          <view class="row-value">{{resolutionText}}</view>
        </view>
        <view class="thin-divider">
        </view>
        <view class="detail-row">
          <view class="row-left">
            <image
              class="row-icon"
              src="/assets/images/device-detail-icon03.png"
              mode="aspectFit" />
            <!-- 2026-08-02：行名回到「最大照片数量」，已用/上限全部挪进右侧值里，
                 形如 8/51（见 detail.js memoryText） -->
            <text>最大照片数量</text>
          </view>
          <view class="row-value">{{memoryText}}</view>
        </view>
        <view class="thin-divider">
        </view>
        <!-- 固件升级入口（规格书 v1.5 §6.3.2~§6.3.4 OTA/DFU）：点击走「检测版本 → 二次确认 → 进升级页」。
             2026-08-11 删除「长按进本地固件测试」与下方的「OTA测试升级」行，只留真实升级这一条路。 -->
        <view
          class="detail-row"
          hover-class="none"
          bindtap="goOtaUpgrade"
        >
          <view class="row-left">
            <image
              class="row-icon"
              src="/assets/images/device-detail-icon04.png"
              mode="aspectFit" />
            <text>固件升级</text>
          </view>
          <view class="row-right">
            <!-- 2026-08-20：右侧回到「只显示设备当前在跑的固件版本号」（调试台 0x03 那个值），
                 未连接/读不到时按本页约定回落 '--'；有没有新版本不再用文案说，改成箭头旁的红点。
                 红点与点击结论同源（detail.js hasFirmwareUpdate），不会出现「红点亮着、点进去弹已是最新」 -->
            <text>{{firmwareVersionText}}</text>
            <view wx:if="{{firmwareHasUpdate}}" class="firmware-dot">
            </view>
            <view class="ui-chevron">
            </view>
          </view>
        </view>
      </view>
      <view class="detail-list action-list glass-panel">
        <view
          class="detail-row action-row clear-row"
          hover-class="none"
          bindtap="clearCopies"
        >
          <view class="row-left">
            <image
              class="row-icon"
              src="/assets/images/device-detail-icon05.png"
              mode="aspectFit" />
            <text>一键清空</text>
          </view>
          <view class="row-right">
            <text>空电子纸设备及小程序/APP内的照片</text>
            <view class="ui-chevron">
            </view>
          </view>
        </view>
        <view class="thin-divider">
        </view>
        <view
          class="detail-row action-row delete-row"
          hover-class="none"
          bindtap="showDeleteConfirm"
        >
          <view class="row-left">
            <image
              class="row-icon"
              src="/assets/images/device-detail-icon06.png"
              mode="aspectFit" />
            <text>解除绑定</text>
          </view>
          <view class="row-right">
            <text>解除绑定电子纸设备，保留照片</text>
            <view class="ui-chevron">
            </view>
          </view>
        </view>
      </view>
      <!-- 「删除设备」是最重的破坏性操作（一键清空 + 断开连接 + 解除绑定）。
           2026-08-01 产品要求：从卡片行改成页面最底部的独立入口；同日二次调整——去掉描边、
           字号字重与上面各行 label 拉平、再往下移，避免像主按钮一样引导用户去删除
           （见 detail.wxss .outline-delete-device）。 -->
      <view
        class="outline-delete-device"
        hover-class="none"
        bindtap="showPermanentDeleteConfirm"
      >删除设备</view>
    </view>
    <!-- 解除绑定确认：照片保留，只解除账号关系 -->
    <view
      class="confirm-mask"
      wx:if="{{showDeleteConfirm}}"
      catchtouchmove="noop"
      bindtap="hideDeleteConfirm"
    >
      <view class="confirm-dialog {{deleteClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon danger-icon">
          <image
            class="trash-icon"
            src="/assets/images/device-detail-icon06.png"
            mode="aspectFit" />
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">解除绑定</view>
          <view class="confirm-desc">解除绑定后，电子纸设备上的照片将保留，您可以稍后重新绑定电子纸设备。</view>
        </view>
        <view class="confirm-actions">
          <view
            class="confirm-cancel"
            hover-class="none"
            bindtap="hideDeleteConfirm"
          >
            取消
          </view>
          <view
            class="confirm-primary"
            hover-class="none"
            bindtap="confirmDeleteDevice"
          >
            确认
          </view>
        </view>
      </view>
    </view>
    <!-- 删除设备一级确认：建议先清空照片防止隐私泄露 -->
    <view
      class="confirm-mask"
      wx:if="{{showPermanentDeleteConfirm}}"
      catchtouchmove="noop"
      bindtap="hidePermanentDeleteConfirm"
    >
      <view class="confirm-dialog {{permanentDeleteClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon danger-icon">
          <image class="trash-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit" />
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">删除设备</view>
          <view class="confirm-desc">删除设备将执行一键清空电子纸设备及小程序/APP内的照片，防止隐私泄露。是否确认删除设备？</view>
        </view>
        <view class="confirm-actions">
          <view class="confirm-cancel" hover-class="none" bindtap="hidePermanentDeleteConfirm">取消</view>
          <view class="confirm-primary" hover-class="none" bindtap="openPermanentDeleteStep2">继续</view>
        </view>
      </view>
    </view>
    <!-- 删除设备二级确认：执行清空、断开、解除绑定 -->
    <view
      class="confirm-mask"
      wx:if="{{showPermanentDeleteConfirm2}}"
      catchtouchmove="noop"
      bindtap="hidePermanentDeleteConfirm2"
    >
      <view class="confirm-dialog {{permanentDeleteClosing2 ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon danger-icon">
          <image class="trash-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit" />
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">确认删除设备</view>
          <view class="confirm-desc">我已知晓删除电子纸设备相关内容，确认删除</view>
        </view>
        <view class="confirm-actions">
          <view class="confirm-cancel" hover-class="none" bindtap="hidePermanentDeleteConfirm2">取消</view>
          <view class="confirm-primary" hover-class="none" bindtap="confirmPermanentDeleteDevice">确认</view>
        </view>
      </view>
    </view>
    <!-- 一键清空 · 一级确认弹窗：交互同上（点遮罩关闭，点弹窗内部不关闭）。 点「继续」进入二级确认，避免一次点击就清空设备+图库 -->
    <view
      class="confirm-mask"
      wx:if="{{showClearConfirm}}"
      catchtouchmove="noop"
      bindtap="hideClearConfirm"
    >
      <view class="confirm-dialog {{clearClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon clear-icon">
          <image
            class="broom-icon"
            src="/assets/images/device-detail-icon05.png"
            mode="aspectFit" />
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">一键清空</view>
          <view class="confirm-desc">将清空电子纸设备内所有照片，同时清空小程序/APP的图库，请谨慎选择是否继续。</view>
        </view>
        <view class="confirm-actions">
          <view
            class="confirm-cancel"
            hover-class="none"
            bindtap="hideClearConfirm"
          >
            再想想
          </view>
          <view
            class="confirm-primary"
            hover-class="none"
            bindtap="openClearStep2"
          >
            继续
          </view>
        </view>
      </view>
    </view>
    <!-- 一键清空 · 二级确认弹窗：确认「已阅读并了解结果」后才真正执行清空 -->
    <view
      class="confirm-mask"
      wx:if="{{showClearConfirm2}}"
      catchtouchmove="noop"
      bindtap="hideClearConfirm2"
    >
      <view class="confirm-dialog {{clearClosing2 ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon clear-icon">
          <image
            class="broom-icon"
            src="/assets/images/device-detail-icon05.png"
            mode="aspectFit" />
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">一键清空</view>
          <view class="confirm-desc">我已阅读并了解此操作的结果，确认继续。</view>
        </view>
        <view class="confirm-actions">
          <view
            class="confirm-cancel"
            hover-class="none"
            bindtap="hideClearConfirm2"
          >
            取消
          </view>
          <view
            class="confirm-primary"
            hover-class="none"
            bindtap="confirmClearCopies"
          >
            确认
          </view>
        </view>
      </view>
    </view>
    <!-- 「拍照 / 相册」选择弹层：点「投屏」后弹出，由用户选择投屏方式（与首页一致）。 点遮罩关闭；点弹层内部用 catchtap="noop" 阻止冒泡，避免误关 -->
    <view
      class="media-mask"
      wx:if="{{showMediaSheet}}"
      catchtouchmove="noop"
      bindtap="hideMediaSheet"
    >
      <view class="bottom-sheet media-sheet {{mediaSheetClosing ? 'pop-closing-sheet' : ''}}" catchtap="noop">
        <view class="media-sheet-title">选择投屏方式</view>
        <view
          class="media-option"
          hover-class="none"
          bindtap="chooseCamera"
        >
          <view class="media-option-left">
            <image
              class="media-art mini camera-art"
              src="/assets/images/home-media-mini01.png"
              mode="aspectFit" />
            <view class="media-option-copy">
              <view>拍照</view>
              <text>调用手机相机拍照</text>
            </view>
          </view>
          <image
            class="round-arrow"
            src="/assets/images/home-camera-card-right-icon.png"
            mode="aspectFit" />
        </view>
        <view
          class="media-option"
          hover-class="none"
          bindtap="chooseAlbum"
        >
          <view class="media-option-left">
            <image
              class="media-art mini album-art"
              src="/assets/images/home-media-mini02.png"
              mode="aspectFit" />
            <view class="media-option-copy">
              <view>相册</view>
              <text>从手机相册选择照片</text>
            </view>
          </view>
          <image
            class="round-arrow"
            src="/assets/images/home-album-card-right-icon.png"
            mode="aspectFit" />
        </view>
        <view
          class="cancel-action"
          hover-class="none"
          bindtap="hideMediaSheet"
        >
          取消
        </view>
      </view>
    </view>
  </block>
  <!-- 加载中：全局统一 loading（同我的图库等页面），样式在 app.wxss 的 page-loading -->
  <view wx:elif="{{loading}}" class="page-loading">
    <view class="page-loading__spinner">
    </view>
    <view class="page-loading__text">加载中…</view>
  </view>
  <!-- 设备不存在 / 加载失败：居中空态卡片，导航与背景仍在，不会错乱 -->
  <view wx:else class="detail-status">
    <view class="status-card glass-panel">
      <image
        class="status-art"
        src="/assets/images/empty_device_art.png"
        mode="aspectFit" />
      <view class="status-title">{{loadError ? '加载失败' : '电子纸设备不存在'}}</view>
      <view class="status-desc">{{loadError ? '网络异常或服务出错，请稍后重试' : '该电子纸设备可能已被删除或解绑'}}</view>
      <view
        wx:if="{{loadError}}"
        class="status-retry"
        hover-class="none"
        bindtap="loadDetail"
      >
        重新加载
      </view>
    </view>
  </view>
  <device-name-dialog
    visible="{{renameVisible}}"
    value="{{renameValue}}"
    saving="{{renameSaving}}"
    bindcancel="cancelRename"
    bindconfirm="confirmRename"
  ></device-name-dialog>
  <global-toast id="globalToast">
  </global-toast>
</view>
