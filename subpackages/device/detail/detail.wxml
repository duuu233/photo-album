<!-- 页面框架（背景 + 导航）始终渲染，内容区在「详情 / 加载中 / 加载失败 / 不存在」之间切换，
     避免接口报错时 device 为空导致布局错乱 -->
<view class="mock-root detail-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607070935141637931.png" mode="aspectFill"></image>
  </view>

  <page-nav title="设备详情"></page-nav>

  <!-- 设备存在：渲染详情内容与相关弹窗 -->
  <block wx:if="{{device}}">
    <view class="mock-content detail-content">
      <view class="device-summary glass-panel">
        <view class="summary-icon">
          <image class="summary-icon__img" src="/assets/images/mine-icon03.png" mode="aspectFit"></image>
        </view>
        <view class="summary-copy">
          <view class="summary-name-row">
            <view class="summary-title">{{device.name}}</view>
            <view class="edit-name-btn" hover-class="none" catchtap="renameDevice" aria-label="编辑设备名称">
              <image class="edit-name-icon" src="/assets/images/edit-icon01.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="summary-meta">
            <view class="connection {{device.connected ? 'is-connected' : ''}}">
              <image class="meta-bt-icon" src="{{device.connected ? '/assets/images/bluetooth-icon.png' : '/assets/images/bluetooth-icon-not.png'}}" mode="aspectFit"></image>
              <text>{{device.connected ? '已连接' : '未连接'}}</text>
            </view>
            <!-- 仅在已连接设备后才展示电量图标与数值 -->
            <view wx:if="{{device.connected}}" class="battery-meta">
              <image class="battery-level-icon" src="{{batteryIcon}}" mode="aspectFit"></image>
              <text>{{batteryText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 顶部「投屏 / 连接」操作，样式同「我的设备」的轮播设置和连接模块 -->
      <view class="device-actions glass-panel">
        <view class="device-action projection-action" hover-class="none" catchtap="startProjection">
          <image class="action-frame-icon" src="/assets/images/screen-casting-icon01.png" mode="aspectFit"></image>
          <text>投屏</text>
        </view>
        <view class="device-action-divider"></view>
        <view class="device-action connection-action {{device.connected ? 'disconnect' : 'connect'}}" hover-class="none" catchtap="toggleConnection">
          <image class="action-bt-icon" src="{{device.connected ? '/assets/images/disconnect-icon01.png' : '/assets/images/bluetooth-connection.png'}}" mode="aspectFit"></image>
          <text>{{device.connected ? '断开' : '连接'}}</text>
        </view>
      </view>

      <view class="detail-list glass-panel">
        <view class="detail-row" hover-class="none" bindtap="goSlideshow">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon01.png" mode="aspectFit"></image>
            <text>轮播设置</text>
          </view>
          <view class="row-right">
            <text>{{playbackLabel}}</text>
            <view class="ui-chevron"></view>
          </view>
        </view>
        <view class="thin-divider"></view>

        <view class="detail-row">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon02.png" mode="aspectFit"></image>
            <text>设备ID</text>
          </view>
          <view class="row-value">{{deviceCode}}</view>
        </view>
        <view class="thin-divider"></view>

        <view class="detail-row">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon03.png" mode="aspectFit"></image>
            <text>设备内存</text>
          </view>
          <view class="row-value">{{memoryText}}</view>
        </view>
        <view class="thin-divider"></view>

        <view class="detail-row" hover-class="none" bindtap="goOtaUpgrade" bindlongpress="goOtaTest">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon04.png" mode="aspectFit"></image>
            <text>固件升级</text>
          </view>
          <view class="row-right">
            <!-- 未连接/无版本号时 newVersionNo 为 -- 占位，此时不带「版本」前缀 -->
            <text>{{newVersionNo === '--' ? '--' : '版本' + newVersionNo}}</text>
            <view class="ui-chevron"></view>
          </view>
        </view>
        <view class="thin-divider"></view>

        <!-- OTA 测试按钮：一点即用代码包内本地固件走真实 DFU（未连接则干跑），交互与设备应答全程打印到 console -->
        <view class="detail-row ota-test-row {{otaTesting ? 'is-testing' : ''}}" hover-class="none" bindtap="startOtaTest">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon04.png" mode="aspectFit"></image>
            <text>OTA测试升级</text>
          </view>
          <view class="row-right">
            <text class="ota-test-status">{{otaTestStatus}}</text>
            <view class="ui-chevron"></view>
          </view>
        </view>
      </view>

      <view class="detail-list action-list glass-panel">
        <view class="detail-row action-row clear-row" hover-class="none" bindtap="clearCopies">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon05.png" mode="aspectFit"></image>
            <text>一键清空</text>
          </view>
          <view class="row-right">
            <text>清空设备本地所有照片</text>
            <view class="ui-chevron"></view>
          </view>
        </view>
        <view class="thin-divider"></view>

        <view class="detail-row action-row delete-row" hover-class="none" bindtap="showDeleteConfirm">
          <view class="row-left">
            <image class="row-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit"></image>
            <text>删除设备</text>
          </view>
          <view class="row-right">
            <text>删除后将无法恢复</text>
            <view class="ui-chevron"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 删除前置确认弹窗：设备连接中时先弹此框，点「断开」执行断开交互后接着弹删除确认框 -->
    <view class="confirm-mask" wx:if="{{showDisconnectConfirm}}" catchtouchmove="noop" bindtap="hideDisconnectConfirm">
      <view class="confirm-dialog {{disconnectClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon danger-icon">
          <image class="trash-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit"></image>
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">删除设备</view>
          <view class="confirm-desc">删除设备需要先断开此设备</view>
        </view>
        <view class="confirm-actions">
          <view class="confirm-cancel" hover-class="none" bindtap="hideDisconnectConfirm">取消</view>
          <view class="confirm-primary" hover-class="none" bindtap="confirmDisconnectForDelete">断开</view>
        </view>
      </view>
    </view>

    <!-- 删除确认弹窗：点遮罩关闭，点弹窗内部用 catchtap="noop" 阻止冒泡，避免误关 -->
    <view class="confirm-mask" wx:if="{{showDeleteConfirm}}" catchtouchmove="noop" bindtap="hideDeleteConfirm">
      <view class="confirm-dialog {{deleteClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon danger-icon">
          <image class="trash-icon" src="/assets/images/device-detail-icon06.png" mode="aspectFit"></image>
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">删除设备</view>
          <view class="confirm-desc">删除设备后，设备上的照片将保留，如不再使用此设备，建议先清空所有照片</view>
        </view>
        <view class="confirm-actions">
          <view class="confirm-cancel" hover-class="none" bindtap="hideDeleteConfirm">再想想</view>
          <view class="confirm-primary" hover-class="none" bindtap="confirmDeleteDevice">确认</view>
        </view>
      </view>
    </view>

    <!-- 一键清空 · 一级确认弹窗：交互同上（点遮罩关闭，点弹窗内部不关闭）。
         点「继续」进入二级确认，避免一次点击就清空设备+图库 -->
    <view class="confirm-mask" wx:if="{{showClearConfirm}}" catchtouchmove="noop" bindtap="hideClearConfirm">
      <view class="confirm-dialog {{clearClosing ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon clear-icon">
          <image class="broom-icon" src="/assets/images/device-detail-icon05.png" mode="aspectFit"></image>
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">一键清空</view>
          <view class="confirm-desc">将清空设备内所有照片，同时清空图库，请谨慎选择是否继续。</view>
        </view>
        <view class="confirm-actions">
          <view class="confirm-cancel" hover-class="none" bindtap="hideClearConfirm">再想想</view>
          <view class="confirm-primary" hover-class="none" bindtap="openClearStep2">继续</view>
        </view>
      </view>
    </view>

    <!-- 一键清空 · 二级确认弹窗：确认「已阅读并了解结果」后才真正执行清空 -->
    <view class="confirm-mask" wx:if="{{showClearConfirm2}}" catchtouchmove="noop" bindtap="hideClearConfirm2">
      <view class="confirm-dialog {{clearClosing2 ? 'pop-closing-dialog' : ''}}" catchtap="noop">
        <view class="confirm-icon clear-icon">
          <image class="broom-icon" src="/assets/images/device-detail-icon05.png" mode="aspectFit"></image>
        </view>
        <view class="confirm-copy">
          <view class="confirm-title">一键清空</view>
          <view class="confirm-desc">我已阅读并了解此操作的结果，确认继续。</view>
        </view>
        <view class="confirm-actions">
          <view class="confirm-cancel" hover-class="none" bindtap="hideClearConfirm2">取消</view>
          <view class="confirm-primary" hover-class="none" bindtap="confirmClearCopies">继续</view>
        </view>
      </view>
    </view>

    <!-- 「拍照 / 相册」选择弹层：点「投屏」后弹出，由用户选择投屏方式（与首页一致）。
         点遮罩关闭；点弹层内部用 catchtap="noop" 阻止冒泡，避免误关 -->
    <view class="media-mask" wx:if="{{showMediaSheet}}" catchtouchmove="noop" bindtap="hideMediaSheet">
      <view class="bottom-sheet media-sheet {{mediaSheetClosing ? 'pop-closing-sheet' : ''}}" catchtap="noop">
        <view class="media-sheet-title">选择投屏方式</view>
        <view class="media-option" hover-class="none" bindtap="chooseCamera">
          <view class="media-option-left">
            <image class="media-art mini camera-art" src="/assets/images/home-media-mini01.png" mode="aspectFit"></image>
            <view class="media-option-copy">
              <view>拍照</view>
              <text>调用手机相机拍照</text>
            </view>
          </view>
          <image class="round-arrow" src="/assets/images/home-camera-card-right-icon.png" mode="aspectFit"></image>
        </view>
        <view class="media-option" hover-class="none" bindtap="chooseAlbum">
          <view class="media-option-left">
            <image class="media-art mini album-art" src="/assets/images/home-media-mini02.png" mode="aspectFit"></image>
            <view class="media-option-copy">
              <view>相册</view>
              <text>从手机相册选择照片</text>
            </view>
          </view>
          <image class="round-arrow" src="/assets/images/home-album-card-right-icon.png" mode="aspectFit"></image>
        </view>
        <view class="cancel-action" hover-class="none" bindtap="hideMediaSheet">取消</view>
      </view>
    </view>
  </block>

  <!-- 加载中：全局统一 loading（同我的图库等页面），样式在 app.wxss 的 page-loading -->
  <view wx:elif="{{loading}}" class="page-loading">
    <view class="page-loading__spinner"></view>
    <view class="page-loading__text">加载中…</view>
  </view>

  <!-- 设备不存在 / 加载失败：居中空态卡片，导航与背景仍在，不会错乱 -->
  <view wx:else class="detail-status">
    <view class="status-card glass-panel">
      <image class="status-art" src="/assets/images/empty_device_art.png" mode="aspectFit"></image>
      <view class="status-title">{{loadError ? '加载失败' : '设备不存在'}}</view>
      <view class="status-desc">{{loadError ? '网络异常或服务出错，请稍后重试' : '该设备可能已被删除或解绑'}}</view>
      <view wx:if="{{loadError}}" class="status-retry" hover-class="none" bindtap="loadDetail">重新加载</view>
    </view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
