<!-- 设备存在才渲染详情，否则走文件底部的“设备不存在”空态 -->
<view class="mock-root detail-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;" wx:if="{{device}}">
  <view class="mock-bg">
    <view class="mock-bg__curve mock-bg__curve--top"></view>
    <view class="mock-bg__curve mock-bg__curve--bottom"></view>
    <view class="mock-bg__spark mock-bg__spark--one"></view>
    <view class="mock-bg__spark mock-bg__spark--two"></view>
    <view class="mock-bg__spark mock-bg__spark--three"></view>
  </view>

  <view class="mock-nav">
    <button class="mock-nav__back" hover-class="none" aria-label="返回" bindtap="goBack">
      <view class="mock-nav__back-icon"></view>
    </button>
    <view class="mock-nav__title">设备详情</view>
    <view></view>
  </view>

  <view class="mock-content detail-content">
    <view class="device-summary glass-panel">
      <view class="summary-icon">
        <view class="frame-logo"></view>
      </view>
      <view class="summary-copy">
        <view class="summary-title">{{device.name}}</view>
        <view class="summary-meta">
          <view class="connection {{device.connected ? 'is-connected' : ''}}">
            <view class="ui-bluetooth"></view>
            <text>{{device.connected ? '已连接' : '未连接'}}</text>
          </view>
          <view class="battery-meta">
            <view class="ui-battery"><view class="ui-battery__fill" style="width: {{device.battery}}%;"></view></view>
            <text>{{device.battery}}%</text>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-list glass-panel">
      <button class="detail-row" hover-class="none" bindtap="goSlideshow">
        <view class="row-left">
          <view class="row-icon row-icon-photo"></view>
          <text>轮播设置</text>
        </view>
        <view class="row-right">
          <text>{{playbackLabel}}</text>
          <view class="ui-chevron"></view>
        </view>
      </button>
      <view class="thin-divider"></view>

      <view class="detail-row">
        <view class="row-left">
          <view class="row-icon row-icon-id">ID</view>
          <text>设备ID</text>
        </view>
        <view class="row-value">{{deviceCode}}</view>
      </view>
      <view class="thin-divider"></view>

      <view class="detail-row">
        <view class="row-left">
          <view class="row-icon row-icon-memory"></view>
          <text>设备内存</text>
        </view>
        <view class="row-value">{{memoryText}}</view>
      </view>
      <view class="thin-divider"></view>

      <view class="detail-row">
        <view class="row-left">
          <view class="row-icon row-icon-mac"></view>
          <text>MAC地址</text>
        </view>
        <view class="row-value">{{macAddress}}</view>
      </view>
      <view class="thin-divider"></view>

      <view class="detail-row">
        <view class="row-left">
          <view class="row-icon row-icon-ota"></view>
          <text>OTA升级</text>
        </view>
        <view class="row-value">版本{{firmwareVersion}}</view>
      </view>
    </view>

    <view class="detail-list action-list glass-panel">
      <button class="detail-row action-row clear-row" hover-class="none" bindtap="clearCopies">
        <view class="row-left">
          <view class="row-icon row-icon-clear"></view>
          <text>一键清空</text>
        </view>
        <view class="row-right">
          <text>清空设备本地所有照片</text>
          <view class="ui-chevron"></view>
        </view>
      </button>
      <view class="thin-divider"></view>

      <button class="detail-row action-row delete-row" hover-class="none" bindtap="showDeleteConfirm">
        <view class="row-left">
          <view class="row-icon row-icon-delete"></view>
          <text>删除设备</text>
        </view>
        <view class="row-right">
          <text>删除后将无法恢复</text>
          <view class="ui-chevron"></view>
        </view>
      </button>
    </view>
  </view>

  <!-- 删除确认弹窗：点遮罩关闭，点弹窗内部用 catchtap="noop" 阻止冒泡，避免误关 -->
  <view class="confirm-mask" wx:if="{{showDeleteConfirm}}" catchtouchmove="noop" bindtap="hideDeleteConfirm">
    <view class="confirm-dialog" catchtap="noop">
      <view class="confirm-icon danger-icon">
        <view class="trash-icon"></view>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">删除设备</view>
        <view class="confirm-desc">删除后将解除与该相框设备的绑定，后续使用需重新添加设备。</view>
      </view>
      <view class="confirm-actions">
        <button class="confirm-cancel" hover-class="none" bindtap="hideDeleteConfirm">取消</button>
        <button class="confirm-primary" hover-class="none" bindtap="confirmDeleteDevice">确认</button>
      </view>
    </view>
  </view>

  <!-- 一键清空确认弹窗：交互同上（点遮罩关闭，点弹窗内部不关闭） -->
  <view class="confirm-mask" wx:if="{{showClearConfirm}}" catchtouchmove="noop" bindtap="hideClearConfirm">
    <view class="confirm-dialog" catchtap="noop">
      <view class="confirm-icon clear-icon">
        <view class="broom-icon"></view>
      </view>
      <view class="confirm-copy">
        <view class="confirm-title">一键清空</view>
        <view class="confirm-desc">将清空设备内所有照片，请谨慎选择是否继续？</view>
      </view>
      <view class="confirm-actions">
        <button class="confirm-cancel" hover-class="none" bindtap="hideClearConfirm">取消</button>
        <button class="confirm-primary" hover-class="none" bindtap="confirmClearCopies">确认</button>
      </view>
    </view>
  </view>
</view>

<view class="mock-root empty-detail" wx:else>
  <view class="empty-state glass-panel">设备不存在</view>
</view>
