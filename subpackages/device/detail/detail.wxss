.detail-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 58rpx;
}

.device-summary {
  display: flex;
  align-items: center;
  min-height: 148rpx;
  padding: 26rpx 40rpx;
}

/* 顶部「投屏 / 连接」操作模块，样式对齐「我的设备」列表卡片的轮播设置和连接 */
.device-actions {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  height: 84rpx;
  /* border: 1px solid rgba(255, 255, 255, 0.31); */
  border-radius: 28rpx;
  /* background: linear-gradient(
    88deg,
    rgba(255, 255, 255, 0.38) 2.41%,
    rgba(255, 255, 255, 0.55) 96.27%
  );
  box-shadow: 0 4px 12.1px 0 rgba(44, 63, 97, 0.03); */
  backdrop-filter: blur(7.95px);
}

.device-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 84rpx;
  color: #777e88;
  font-size: 28rpx;
  font-weight: 500;
}

.device-action-divider {
  height: 38rpx;
  background: #dadddf;
}

.projection-action {
  color: #eb5f1b;
}

.connection-action.disconnect {
  color: #eb5f1b;
}

.connection-action.connect {
  color: #2079fc;
}

.action-frame-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.action-bt-icon {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
}

.summary-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  /* 2026-07-19：设备图改用首页那张 home-icon02，它四角透明、自带圆角底色，
     再叠一层底色会在四角露出色晕（首页并没有底色容器），故不设 background。 */
}

.summary-icon__img {
  width: 92rpx;
  height: 92rpx;
}

.summary-copy {
  flex: 1;
  min-width: 0;
  margin-left: 34rpx;
}

.summary-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.summary-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-name-btn {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 6rpx;
}

.edit-name-icon {
  width: 36rpx;
  height: 36rpx;
}

.summary-meta {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 18rpx;
  color: #777e88;
  font-size: 24rpx;
  line-height: 1;
}

.connection,
.battery-meta {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.connection {
  color: #9ba2ad;
}

.connection.is-connected {
  color: #287dff;
}

.meta-bt-icon {
  flex: 0 0 auto;
  width: 22rpx;
  height: 28rpx;
}

.detail-list {
  overflow: hidden;
  padding: 0 38rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 120rpx;
  gap: 22rpx;
  text-align: left;
}

.row-left,
.row-right {
  display: flex;
  align-items: center;
  min-width: 0;
}

.row-left {
  flex: 1;
  gap: 30rpx;
}

.row-left text {
  overflow: hidden;
  color: #33373d;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-right {
  flex-shrink: 0;
  gap: 16rpx;
  max-width: 386rpx;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1.2;
}

.row-right text,
.row-value {
  overflow: hidden;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-icon {
  position: relative;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  color: #7d858f;
}

.action-list {
  margin-top: 2rpx;
}

/* 「删除设备」单独成卡：在 .detail-content 的 24rpx 间距上再加一段，和上面的操作卡拉开距离 */
.danger-list {
  margin-top: 24rpx;
}

.action-row .row-left text {
  font-weight: 500;
}

.clear-row .row-left,
.clear-row .row-icon {
  color: #ff6a20;
}

.delete-row .row-left,
.delete-row .row-icon {
  color: #ff3045;
}

.confirm-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.4);
}

.confirm-dialog {
  display: grid;
  grid-template-columns: 80rpx 1fr;
  column-gap: 28rpx;
  width: 100%;
  padding: 60rpx 48rpx 40rpx 48rpx;
  background: #ffffff;
  border-radius: 28rpx;
  animation: popDialogIn 0.24s ease-out;
}

.confirm-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
}

.danger-icon {
  color: #ff3045;
  background: rgba(255, 48, 69, 0.08);
}

.clear-icon {
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.08);
}

.confirm-copy {
  min-width: 0;
  margin-left: 12rpx;
}

.confirm-title {
  color: #25282d;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.15;
}

.confirm-desc {
  margin-top: 12rpx;
  color: #6f7782;
  font-size: 24rpx;
  line-height: 1.45;
}

.confirm-actions {
  grid-column: 1 / 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 42rpx;
  padding-left: 118rpx;
}

.confirm-cancel,
.confirm-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.confirm-cancel {
  color: #32363c;
  background: #eeeeee;
}

.confirm-primary {
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
}

.trash-icon,
.broom-icon {
  width: 48rpx;
  width: 48rpx;
}

/* 加载中 / 加载失败 / 设备不存在 的统一空态：占满导航以下区域并整体居中 */
.detail-status {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: calc(100vh - var(--status-bar) - 88rpx);
  padding: 0 46rpx calc(120rpx + var(--safe-bottom));
}

.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 72rpx 48rpx 64rpx;
  text-align: center;
}

.status-art {
  width: 300rpx;
  height: 240rpx;
  margin-bottom: 12rpx;
}

.status-title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.status-desc {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 26rpx;
  line-height: 1.5;
}

.status-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  min-height: 80rpx;
  margin-top: 44rpx;
  padding: 0 56rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 32rpx rgba(255, 102, 31, 0.22);
  font-size: 28rpx;
  font-weight: 600;
}

/* ── 「拍照 / 相册」选择弹层（与首页 media-sheet 同款样式，点投屏后弹出）────── */
.media-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 46rpx;
  color: #2a2b2b;
  font-size: 40rpx;
  font-weight: 500;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 128rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  background: #f8f9fb;
  border-radius: 28rpx;
}

.media-option-left {
  display: flex;
  align-items: center;
}

.media-art.mini {
  position: relative;
  width: 98rpx;
  height: 96rpx;
}

.media-option-copy {
  height: 100%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  padding-left: 28rpx;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  width: 118rpx;
  height: 118rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 500;
}

/* OTA 测试按钮：橙色状态文案，凸显是测试/联调入口；跑测试时整行降透明度表示进行中 */
.ota-test-row .row-left text {
  color: #ff6a20;
}

.ota-test-status {
  color: #ff6a20;
}

.ota-test-row.is-testing {
  opacity: 0.6;
}
