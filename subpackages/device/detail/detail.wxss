.detail-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 58rpx;
}

.device-summary {
  display: flex;
  align-items: center;
  min-height: 148rpx;
  padding: 26rpx 40rpx;
}

.summary-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  background: rgba(255, 106, 32, 0.1);
  border-radius: 24rpx;
}

.summary-icon__img {
  width: 92rpx;
  height: 92rpx;
}

.summary-copy {
  flex: 1;
  min-width: 0;
  margin-left: 34rpx;
}

.summary-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.summary-title {
  min-width: 0;
  overflow: hidden;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-name-btn {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 6rpx;
}

.edit-name-icon {
  width: 36rpx;
  height: 36rpx;
}

.summary-meta {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 18rpx;
  color: #777e88;
  font-size: 24rpx;
  line-height: 1;
}

.connection,
.battery-meta {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.connection {
  color: #9ba2ad;
}

.connection.is-connected {
  color: #287dff;
}

.meta-bt-icon {
  flex: 0 0 auto;
  width: 22rpx;
  height: 28rpx;
}

.detail-list {
  overflow: hidden;
  padding: 0 38rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 120rpx;
  gap: 22rpx;
  text-align: left;
}

.row-left,
.row-right {
  display: flex;
  align-items: center;
  min-width: 0;
}

.row-left {
  flex: 1;
  gap: 30rpx;
}

.row-left text {
  overflow: hidden;
  color: #33373d;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-right {
  flex-shrink: 0;
  gap: 16rpx;
  max-width: 330rpx;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1.2;
}

.row-right text,
.row-value {
  overflow: hidden;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-icon {
  position: relative;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  color: #7d858f;
}

.action-list {
  margin-top: 2rpx;
}

.action-row .row-left text {
  font-weight: 500;
}

.clear-row .row-left,
.clear-row .row-icon {
  color: #ff6a20;
}

.delete-row .row-left,
.delete-row .row-icon {
  color: #ff3045;
}

.confirm-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.4);
}

.confirm-dialog {
  display: grid;
  grid-template-columns: 80rpx 1fr;
  column-gap: 28rpx;
  width: 100%;
  padding: 60rpx 48rpx 40rpx 48rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.confirm-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
}

.danger-icon {
  color: #ff3045;
  background: rgba(255, 48, 69, 0.08);
}

.clear-icon {
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.08);
}

.confirm-copy {
  min-width: 0;
  margin-left: 12rpx;
}

.confirm-title {
  color: #25282d;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.15;
}

.confirm-desc {
  margin-top: 12rpx;
  color: #6f7782;
  font-size: 24rpx;
  line-height: 1.45;
}

.confirm-actions {
  grid-column: 1 / 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 42rpx;
  padding-left: 118rpx;
}

.confirm-cancel,
.confirm-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.confirm-cancel {
  color: #32363c;
  background: #eeeeee;
}

.confirm-primary {
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
}

.trash-icon,
.broom-icon {
  width: 48rpx;
  width: 48rpx;
}

.empty-detail {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 46rpx;
}

.empty-state {
  width: 100%;
  padding: 80rpx 24rpx;
  color: #777e88;
  text-align: center;
}
