.detail-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.device-summary {
  display: flex;
  align-items: center;
  min-height: 148rpx;
  padding: 26rpx 40rpx;
}

.summary-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.1);
  border-radius: 24rpx;
}

.summary-copy {
  flex: 1;
  min-width: 0;
  margin-left: 34rpx;
}

.summary-title {
  overflow: hidden;
  color: #2a2d32;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-meta {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 18rpx;
  color: #777e88;
  font-size: 24rpx;
  line-height: 1;
}

.connection,
.battery-meta {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.connection {
  color: #9ba2ad;
}

.connection.is-connected {
  color: #287dff;
}

.detail-list {
  overflow: hidden;
  padding: 0 38rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 120rpx;
  gap: 22rpx;
  text-align: left;
}

.row-left,
.row-right {
  display: flex;
  align-items: center;
  min-width: 0;
}

.row-left {
  flex: 1;
  gap: 30rpx;
}

.row-left text {
  overflow: hidden;
  color: #33373d;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-right {
  flex-shrink: 0;
  gap: 16rpx;
  max-width: 330rpx;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1.2;
}

.row-right text,
.row-value {
  overflow: hidden;
  color: #777e88;
  font-size: 28rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-icon {
  position: relative;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  color: #7d858f;
}

.row-icon-photo {
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.row-icon-photo::before {
  position: absolute;
  top: 8rpx;
  left: 7rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
  content: "";
}

.row-icon-photo::after {
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: skewX(-24deg);
  content: "";
}

.row-icon-id {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.row-icon-memory {
  border: 4rpx solid currentColor;
  border-radius: 2rpx;
}

.row-icon-memory::after {
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  width: 14rpx;
  height: 12rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  content: "";
}

.row-icon-mac::before,
.row-icon-mac::after {
  position: absolute;
  left: 6rpx;
  width: 28rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 999rpx;
  content: "";
}

.row-icon-mac::before {
  top: 4rpx;
}

.row-icon-mac::after {
  bottom: 4rpx;
}

.row-icon-ota {
  border: 4rpx solid currentColor;
  border-top-color: transparent;
  border-radius: 50%;
}

.row-icon-ota::after {
  position: absolute;
  right: -4rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(24deg);
  content: "";
}

.action-list {
  margin-top: 2rpx;
}

.action-row .row-left text {
  font-weight: 500;
}

.clear-row .row-left,
.clear-row .row-icon {
  color: #ff6a20;
}

.delete-row .row-left,
.delete-row .row-icon {
  color: #ff3045;
}

.row-icon-clear::before {
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 18rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  content: "";
}

.row-icon-clear::after {
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 32rpx;
  height: 4rpx;
  background: currentColor;
  box-shadow: 8rpx -9rpx 0 -1rpx currentColor, 16rpx -18rpx 0 -1rpx currentColor;
  transform: skewX(-18deg);
  content: "";
}

.row-icon-delete::before {
  position: absolute;
  left: 9rpx;
  top: 13rpx;
  width: 22rpx;
  height: 23rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  content: "";
}

.row-icon-delete::after {
  position: absolute;
  left: 7rpx;
  top: 5rpx;
  width: 26rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 999rpx;
  box-shadow: 7rpx -5rpx 0 -1rpx currentColor;
  content: "";
}

.confirm-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.4);
}

.confirm-dialog {
  display: grid;
  grid-template-columns: 80rpx 1fr;
  column-gap: 28rpx;
  width: 100%;
  padding: 60rpx 48rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.confirm-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
}

.danger-icon {
  color: #ff3045;
  background: rgba(255, 48, 69, 0.08);
}

.clear-icon {
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.08);
}

.confirm-copy {
  min-width: 0;
}

.confirm-title {
  color: #25282d;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.15;
}

.confirm-desc {
  margin-top: 12rpx;
  color: #6f7782;
  font-size: 24rpx;
  line-height: 1.45;
}

.confirm-actions {
  grid-column: 1 / 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 42rpx;
  padding-left: 118rpx;
}

.confirm-cancel,
.confirm-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.confirm-cancel {
  color: #32363c;
  background: #eeeeee;
}

.confirm-primary {
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
}

.trash-icon,
.broom-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.trash-icon::before {
  position: absolute;
  left: 9rpx;
  top: 12rpx;
  width: 20rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  content: "";
}

.trash-icon::after {
  position: absolute;
  left: 7rpx;
  top: 5rpx;
  width: 24rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 999rpx;
  box-shadow: 7rpx -5rpx 0 -1rpx currentColor;
  content: "";
}

.broom-icon::before {
  position: absolute;
  left: 13rpx;
  top: 3rpx;
  width: 12rpx;
  height: 25rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  content: "";
}

.broom-icon::after {
  position: absolute;
  left: 4rpx;
  bottom: 4rpx;
  width: 30rpx;
  height: 4rpx;
  background: currentColor;
  box-shadow: 8rpx -8rpx 0 -1rpx currentColor, 16rpx -16rpx 0 -1rpx currentColor;
  transform: skewX(-18deg);
  content: "";
}

.empty-detail {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 46rpx;
}

.empty-state {
  width: 100%;
  padding: 80rpx 24rpx;
  color: #777e88;
  text-align: center;
}
