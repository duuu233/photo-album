<!-- WiFi 版设备固件升级（逻辑见 wifi-ota.js 文件头；版式与配网状态页同一套，样式引用 wifi-provision.wxss） -->
<view class="mock-root provision-page wifi-ota-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="{{navTitle}}"></page-nav>

  <!-- 优雅刷新「暂无可用版本」（2026-11-14）：标题与提示在页面里上下居中（is-empty） -->
  <view class="mock-content provision-content {{!showArt && phase === 'latest' && !showVersions ? 'is-empty' : ''}}">
    <!-- 顶部图标：优雅刷新升级（mode=fpga）不显示（2026-11-14 产品要求），固件升级照旧 -->
    <image wx:if="{{showArt}}" class="ota-art" src="{{art}}" mode="aspectFit"></image>

    <view class="provision-title {{phase === 'failed' || phase === 'error' ? 'is-failed' : ''}} {{phase === 'verifying' ? 'is-success' : ''}}">
      <view wx:if="{{phase === 'checking'}}" class="ota-title-spinner"></view>
      <text>{{title}}</text>
    </view>
    <view class="provision-hint">{{hint}}</view>

    <!-- 版本比对结果：当前版本 / 最新版本 -->
    <view wx:if="{{showVersions}}" class="ota-versions glass-panel">
      <view wx:if="{{showCurrent}}" class="ota-version-row">
        <text class="ota-version-row__label">当前版本</text>
        <text class="ota-version-row__value">{{currentVersion}}</text>
      </view>
      <view class="ota-version-row">
        <text class="ota-version-row__label">{{targetLabel}}</text>
        <text class="ota-version-row__value">{{latestVersion}}</text>
      </view>
    </view>

    <!-- 优雅刷新版本简介（2026-11-13，mode=fpga）：安装确认与进度页都带出 -->
    <view wx:if="{{intro}}" class="ota-intro glass-panel">
      <text class="ota-intro__label">版本简介</text>
      <text class="ota-intro__text">{{intro}}</text>
    </view>

    <!-- 升级进度条（2026-11-12）：左边当前那一步的文案、右边百分比；匀速前进、分档停住，规则见 utils/wifi-ota.js「升级进度条」 -->
    <view wx:if="{{showSteps}}" class="ota-progress glass-panel {{phase === 'failed' ? 'is-failed' : ''}}">
      <view class="ota-progress__head">
        <text class="ota-progress__text">{{progressText}}</text>
        <text class="ota-progress__num">{{progress}}%</text>
      </view>
      <view class="ota-progress__bar"><view class="ota-progress__fill" style="width: {{progress}}%;"></view></view>
    </view>

    <!-- 升级步骤：SENT / DOWNLOADING / FLASHING / VERIFYING 四步；FAILED / TIMEOUT 在当前那一步打叉 -->
    <view wx:if="{{showSteps}}" class="provision-steps glass-panel">
      <view wx:for="{{steps}}" wx:key="key" class="provision-step is-{{item.status}}">
        <view class="step-icon">
          <view wx:if="{{item.status === 'loading'}}" class="step-icon__spinner"></view>
          <text wx:elif="{{item.status === 'done'}}" class="step-icon__mark">✓</text>
          <text wx:elif="{{item.status === 'fail'}}" class="step-icon__mark">×</text>
          <text wx:else class="step-icon__no">{{index + 1}}</text>
        </view>
        <text class="step-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{phase === 'available'}}" class="provision-actions">
    <view class="provision-primary ota-start" hover-class="none" bindtap="startUpgrade">{{confirmText}}</view>
  </view>
  <view wx:elif="{{phase === 'verifying' || phase === 'busy'}}" class="provision-actions">
    <view class="provision-primary" hover-class="none" bindtap="finish">完成</view>
  </view>
  <view wx:elif="{{phase === 'failed'}}" class="provision-actions provision-actions--stack">
    <view class="provision-primary ota-retry" hover-class="none" bindtap="retryUpgrade">{{retryText}}</view>
    <view class="provision-cancel" hover-class="none" bindtap="finish">取消</view>
  </view>
  <view wx:elif="{{phase === 'unknown' || phase === 'error'}}" class="provision-actions">
    <view class="provision-primary" hover-class="none" bindtap="retryCheck">重新检查</view>
  </view>

  <global-toast id="globalToast"></global-toast>
  <debug-log></debug-log>
</view>
