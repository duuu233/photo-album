/* 固件升级页（参照投屏结果页）：图标 + 进度条 + 文案，整体居中的简洁进度界面 */
.ota-page {
  display: flex;
  flex-direction: column;
}

/* 底部 40rpx 与投屏结果页同款：内容变长（失败说明多行）时不会顶到下方「升级/重试 + 返回」按钮 */
.ota-body {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 48rpx 56rpx 40rpx;
  text-align: center;
}

.ota-art {
  display: block;
  width: 260rpx;
  height: 220rpx;
  margin: 40rpx auto 48rpx;
}

.ota-title {
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.ota-desc {
  margin-top: 22rpx;
  color: #828a95;
  font-size: 26rpx;
  line-height: 1.5;
}

.progress-percent {
  margin-top: 56rpx;
  color: #ff6421;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.progress-percent__sign {
  margin-left: 4rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.progress-bar {
  flex: 1;
  height: 18rpx;
  overflow: hidden;
  background: #e6ebf2;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff8a45, #ff6421);
  border-radius: 999rpx;
  transition: width 0.25s ease;
}

.progress-note {
  margin-top: 24rpx;
  color: #828a95;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 升级规则（2026-08-13 需求 2）：进度条下方的两条固定告知。
   ⚠️ 整块**左对齐**：.ota-body 是整页居中的，两条长句居中后每行断点不齐、像散文；
   这是要一条条读进去的告知，序号「1）2）」也必须对齐同一条左边界。
   这一屏没有底部按钮区（ota-actions 在 progress 时整块不渲染），所以自己让开安全区，
   否则全面屏上末行会压在手势条上。 */
.progress-rules {
  margin: 40rpx auto 0;
  padding: 24rpx 28rpx calc(24rpx + var(--safe-bottom));
  text-align: left;
}

.progress-rule {
  color: #8b929d;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 两条之间留一点气口，比行距大、比段距小：读起来是「两条规则」而不是一段话 */
.progress-rule + .progress-rule {
  margin-top: 12rpx;
}

.ota-actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 56rpx calc(60rpx + var(--safe-bottom));
}

.ota-primary,
.ota-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.ota-primary {
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.22);
}

.ota-secondary {
  color: #2a2d32;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}
