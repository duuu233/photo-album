/* WiFi 版轮播设置（2026-10-27）：卡片 / 主按钮配色沿用蓝牙版轮播页与 WiFi 详情页 */
.ws-content {
  padding-top: 32rpx;
  padding-bottom: calc(180rpx + var(--safe-bottom));
}

.ws-card {
  margin-bottom: 28rpx;
  padding: 36rpx 36rpx 32rpx;
}

.ws-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.ws-title {
  color: #33373d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ws-title--gap {
  display: block;
  margin-top: 36rpx;
  margin-bottom: 18rpx;
}

.ws-state {
  color: #9ba2ad;
  font-size: 26rpx;
}

.ws-state.is-on {
  color: #0e9f87;
}

.ws-sub {
  margin-top: 12rpx;
  color: #8a9099;
  font-size: 24rpx;
  line-height: 1.5;
}

.ws-hint {
  margin-top: 12rpx;
  color: #e5533d;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 已选 X/100：选满变橙色 */
.ws-count {
  margin-top: 8rpx;
  color: #25282d;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.ws-count.is-full {
  color: #ff6a20;
}

.ws-segment {
  display: flex;
  gap: 20rpx;
}

.ws-segment__item {
  flex: 1;
  height: 76rpx;
  color: #2a2d32;
  background: rgba(238, 238, 238, 0.84);
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.ws-segment__item.is-active {
  color: #ff6a20;
  background: rgba(255, 255, 255, 0.6);
  border-color: #ff6a20;
}

.ws-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  color: #33373d;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
}

.ws-row--top {
  align-items: flex-start;
  padding: 22rpx 0;
}

.ws-row--switch {
  margin-top: 16rpx;
  border-bottom: none;
}

.ws-row__value {
  color: #ff6a20;
  font-weight: 600;
}

.ws-times {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
}

.ws-time {
  padding: 8rpx 20rpx;
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.1);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.ws-time--add {
  color: #0e9f87;
  background: rgba(14, 159, 135, 0.1);
}

.ws-select-all {
  color: #ff6a20;
  font-size: 26rpx;
  font-weight: 600;
}

.ws-empty {
  margin-top: 28rpx;
  color: #8a9099;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.ws-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.ws-tile {
  position: relative;
  box-sizing: border-box;
  width: calc((100% - 42rpx) / 4);
  height: 0;
  padding-bottom: calc((100% - 42rpx) / 4);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.6);
  border: 4rpx solid transparent;
  border-radius: 16rpx;
}

.ws-tile.is-selected {
  border-color: #ff6a20;
}

/* 选满 100 张后未选的置灰（点了提示先取消部分照片） */
.ws-tile.is-disabled {
  opacity: 0.4;
}

.ws-tile__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 右上角圆圈：选中后显示选择顺序（= 轮播顺序） */
.ws-tile__badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  box-sizing: border-box;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.25);
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.ws-tile.is-selected .ws-tile__badge {
  background: #ff6a20;
}

.ws-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 46rpx calc(28rpx + var(--safe-bottom));
}

.ws-primary {
  flex: 1;
  height: 92rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 32rpx rgba(255, 102, 31, 0.22);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}

.ws-text-btn {
  padding: 0 28rpx;
  height: 92rpx;
  color: #5d636b;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 92rpx;
}

.ws-primary.is-busy,
.ws-text-btn.is-busy {
  opacity: 0.6;
}

.ws-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx;
  text-align: center;
}

.ws-error__title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.ws-error__desc {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 26rpx;
}

.ws-error__btn {
  margin-top: 40rpx;
  padding: 0 56rpx;
  height: 80rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}
