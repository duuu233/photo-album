/* WiFi 版轮播设置（2026-10-27）：卡片 / 主按钮配色沿用蓝牙版轮播页与 WiFi 详情页 */
.ws-content {
  padding-top: 32rpx;
  padding-bottom: calc(180rpx + var(--safe-bottom));
}

.ws-card {
  margin-bottom: 28rpx;
  padding: 36rpx 36rpx 32rpx;
}

.ws-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.ws-title {
  color: #33373d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ws-title--gap {
  display: block;
  margin-top: 36rpx;
  margin-bottom: 18rpx;
}

.ws-state {
  color: #9ba2ad;
  font-size: 26rpx;
}

.ws-state.is-on {
  color: #0e9f87;
}

.ws-sub {
  margin-top: 12rpx;
  color: #8a9099;
  font-size: 24rpx;
  line-height: 1.5;
}

.ws-hint {
  margin-top: 12rpx;
  color: #e5533d;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 已选 X/100：选满变橙色 */
.ws-count {
  margin-top: 8rpx;
  color: #25282d;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.ws-count.is-full {
  color: #ff6a20;
}

.ws-segment {
  display: flex;
  gap: 20rpx;
}

.ws-segment__item {
  flex: 1;
  height: 76rpx;
  color: #2a2d32;
  background: rgba(238, 238, 238, 0.84);
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.ws-segment__item.is-active {
  color: #ff6a20;
  background: rgba(255, 255, 255, 0.6);
  border-color: #ff6a20;
}

.ws-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  color: #33373d;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
}

.ws-row--last {
  border-bottom: none;
}

.ws-row--top {
  align-items: flex-start;
  padding: 22rpx 0;
}

.ws-row__value {
  color: #ff6a20;
  font-weight: 600;
}

.ws-times {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
}

.ws-time {
  padding: 8rpx 20rpx;
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.1);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.ws-time--add {
  color: #0e9f87;
  background: rgba(14, 159, 135, 0.1);
}

.ws-select-all {
  color: #ff6a20;
  font-size: 26rpx;
  font-weight: 600;
}

.ws-empty {
  margin-top: 28rpx;
  color: #8a9099;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

/* 选图网格（2026-11-05 20261105-1 第 1 条）：每行 3 张，格子同「我的上传」（album/list .photo-grid / .photo-tile：
   间距 14rpx、高 210rpx、圆角 22rpx、浅蓝底，图片 aspectFit 完整显示） */
.ws-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.ws-tile {
  position: relative;
  height: 210rpx;
  overflow: hidden;
  background: #d7e7f8;
  border-radius: 22rpx;
}

/* 分页尾：横跨三列 */
.ws-grid__more {
  grid-column: 1 / -1;
  padding: 18rpx 0 6rpx;
  color: #8a9bb0;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

/* 选满 100 张后未选的置灰（点了提示先取消部分照片） */
.ws-tile.is-disabled {
  opacity: 0.4;
}

.ws-tile__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 右上角圆圈（位置大小同「我的上传」的选择圈）：选中后橙底显示选择顺序（= 轮播顺序） */
.ws-tile__badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  box-sizing: border-box;
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 8rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
  border: 3rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
}

.ws-tile.is-selected .ws-tile__badge {
  background: #ff6a20;
}

.ws-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 46rpx calc(28rpx + var(--safe-bottom));
}

.ws-primary {
  flex: 1;
  height: 92rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 32rpx rgba(255, 102, 31, 0.22);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}

.ws-text-btn {
  padding: 0 28rpx;
  height: 92rpx;
  color: #5d636b;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 92rpx;
}

.ws-primary.is-busy,
.ws-text-btn.is-busy {
  opacity: 0.6;
}

/* 简单模式与高级卡片都没启用：保存置灰（点了只提示「至少配置一项」） */
.ws-primary.is-disabled {
  background: #c9cdd3;
  box-shadow: none;
}

.ws-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx;
  text-align: center;
}

.ws-error__title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.ws-error__desc {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 26rpx;
}

.ws-error__btn {
  margin-top: 40rpx;
  padding: 0 56rpx;
  height: 80rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

/* ── 2026-11-05 轮播服务端化：下次刷新、时区、基础配置提示、高级设置 ── */
.ws-next {
  margin-top: 6rpx;
  color: #0e9f87;
}

/* 工作日 / 周末启用独立配置时，基础配置旁的灰字提示（不阻断保存） */
.ws-base-hint {
  margin-top: 14rpx;
  color: #8a9099;
  font-size: 24rpx;
  line-height: 1.5;
}

.ws-advanced-toggle {
  margin: 4rpx 0 28rpx;
  padding: 20rpx 0;
  color: #ff6a20;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.ws-tag {
  padding: 4rpx 16rpx;
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.1);
  border-radius: 999rpx;
  font-size: 22rpx;
}

/* 纪念日：每条一块，日期可改、可删除 */
.ws-anniv {
  margin-top: 24rpx;
  padding: 8rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
}

.ws-anniv__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
}

.ws-anniv__date {
  color: #33373d;
  font-size: 30rpx;
  font-weight: 700;
}

.ws-anniv__remove {
  color: #e5533d;
  font-size: 26rpx;
}

.ws-anniv-add {
  margin-top: 24rpx;
  height: 80rpx;
  color: #0e9f87;
  background: rgba(14, 159, 135, 0.1);
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  text-align: center;
}

/* 底部弹层：时区选择、卡片选图 */
.ws-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.ws-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  max-height: 80vh;
  padding: 36rpx 36rpx calc(28rpx + var(--safe-bottom));
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  /* 从下往上滑入（20261105-1 第 1 条，全局 popSheetSlideUp）；退场挂 .pop-closing-sheet */
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.ws-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ws-sheet__title {
  color: #2a2b2b;
  font-size: 34rpx;
  font-weight: 600;
}

.ws-sheet__close {
  color: #8a9099;
  font-size: 28rpx;
}

.ws-sheet__body {
  height: 56vh;
}

.ws-sheet__actions {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.ws-search {
  height: 72rpx;
  margin-bottom: 16rpx;
  padding: 0 28rpx;
  color: #25282d;
  background: #f3f4f6;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.ws-zone-group {
  padding: 20rpx 0 8rpx;
  color: #8a9099;
  font-size: 24rpx;
}

.ws-zone {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 84rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ws-zone__label {
  color: #33373d;
  font-size: 28rpx;
}

.ws-zone.is-active .ws-zone__label {
  color: #ff6a20;
  font-weight: 600;
}
