.info-content {
  padding-top: 32rpx;
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.info-rows {
  padding: 8rpx 36rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid rgba(42, 43, 43, 0.06);
}

.info-row__label {
  color: #8b9098;
  font-size: 28rpx;
}

.info-row__value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 62%;
  color: #2a2d32;
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.info-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 36rpx;
}

.info-error__title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.info-error__desc {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 24rpx;
}

.info-error__btn {
  margin-top: 36rpx;
  padding: 20rpx 64rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  font-size: 28rpx;
}
