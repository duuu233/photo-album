.info-content {
  padding-top: 32rpx;
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.info-rows {
  padding: 8rpx 36rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid rgba(42, 43, 43, 0.06);
}

.info-row__label {
  color: #8b9098;
  font-size: 28rpx;
}

.info-row__value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 62%;
  color: #2a2d32;
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.info-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 36rpx;
}

.info-error__title {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.info-error__desc {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 24rpx;
}

.info-error__btn {
  margin-top: 36rpx;
  padding: 20rpx 64rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* 优雅刷新升级入口（2026-11-13） */
.info-links {
  margin-top: 24rpx;
}

/* 优雅刷新升级入口文字：与上面信息行标签同样式（2026-11-14 产品要求改灰色、常规字重） */
.info-row__name {
  color: #8b9098;
  font-size: 28rpx;
}

.info-row__arrow {
  color: #8b9098;
  font-size: 40rpx;
  line-height: 1;
}

.info-row--hover {
  opacity: 0.7;
}

.info-row__right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 有新的优雅刷新版本（2026-11-13），样式同详情页红点 */
.info-row__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff3b30;
}
