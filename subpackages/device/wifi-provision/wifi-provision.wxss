/* 底部留出按钮区：失败态为主按钮 112 + 取消 88 + 底距 48 */
.provision-content {
  padding-bottom: calc(280rpx + var(--safe-bottom));
}

.provision-art {
  display: block;
  width: 600rpx;
  height: 240rpx;
  margin: 40rpx auto 0;
}

.provision-title {
  margin-top: 36rpx;
  color: #2a2d32;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.provision-title.is-success {
  color: #ff5a1e;
}

.provision-title.is-failed {
  color: #e5533d;
  font-size: 32rpx;
}

.provision-hint {
  margin-top: 16rpx;
  color: #8b9098;
  font-size: 24rpx;
  text-align: center;
}

.provision-steps {
  margin-top: 48rpx;
  padding: 16rpx 36rpx;
}

.provision-step {
  display: flex;
  align-items: center;
  height: 96rpx;
}

.provision-step + .provision-step {
  border-top: 1rpx solid rgba(42, 43, 43, 0.06);
}

.step-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  box-sizing: border-box;
  border-radius: 50%;
}

/* 未开始：白底灰边圆圈，圈里是序号 1~4 */
.is-pending .step-icon {
  background: #ffffff;
  border: 3rpx solid #c8cdd5;
}

.step-icon__no {
  color: #8b9098;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

/* 执行中：橙色转圈 */
.step-icon__spinner {
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 98, 31, 0.18);
  border-top-color: #ff621f;
  border-radius: 50%;
  animation: provisionSpin 0.8s linear infinite;
}

/* 通过：橙色实心勾；失败：红色实心叉 */
.is-done .step-icon {
  background: linear-gradient(135deg, #ff8338, #ff621f);
}

.is-fail .step-icon {
  background: #e5533d;
}

.step-icon__mark {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.step-text {
  color: #8b9098;
  font-size: 28rpx;
}

.is-loading .step-text,
.is-done .step-text {
  color: #2a2d32;
}

.is-loading .step-text {
  font-weight: 700;
}

.is-fail .step-text {
  color: #e5533d;
}

.provision-actions {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + var(--safe-bottom));
  z-index: 2;
  display: flex;
}

.provision-actions--stack {
  flex-direction: column;
}

/* 主按钮：与全站主按钮同一套橙色渐变 + 外发光 */
.provision-primary {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8338, #ff621f);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 36rpx rgba(255, 98, 31, 0.2);
  font-size: 36rpx;
  font-weight: 700;
}

/* 取消：无按钮底框，只留橙色文字（点击区仍有 88rpx 高） */
.provision-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 8rpx;
  color: #ff621f;
  font-size: 32rpx;
}


@keyframes provisionSpin {
  to {
    transform: rotate(360deg);
  }
}
