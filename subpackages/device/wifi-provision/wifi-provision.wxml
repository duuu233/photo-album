<!-- WiFi 版设备配网 · 配网状态（流程见 utils/wifi-provision.js，页面交互见 wifi-provision.js 文件头） -->
<view class="mock-root provision-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px; --nav-h: {{navHeight}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="设备配网" bind:measure="onNavMeasure"></page-nav>

  <view class="mock-content provision-content">
    <image class="provision-art" src="/assets/images/wifi-provision-art.svg" mode="aspectFit"></image>

    <view class="provision-title {{phase === 'failed' ? 'is-failed' : ''}} {{phase === 'success' ? 'is-success' : ''}}">{{title}}</view>
    <view class="provision-hint">请将手机靠近设备，保持网络连接稳定</view>

    <view class="provision-steps glass-panel">
      <view wx:for="{{steps}}" wx:key="key" class="provision-step is-{{item.status}}">
        <!-- 状态圈：未开始的白圈里默认显示序号 1~4；执行中转圈，通过打勾，失败打叉 -->
        <view class="step-icon">
          <view wx:if="{{item.status === 'loading'}}" class="step-icon__spinner"></view>
          <text wx:elif="{{item.status === 'done'}}" class="step-icon__mark">✓</text>
          <text wx:elif="{{item.status === 'fail'}}" class="step-icon__mark">×</text>
          <text wx:else class="step-icon__no">{{index + 1}}</text>
        </view>
        <text class="step-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{phase === 'success'}}" class="provision-actions">
    <view class="provision-primary" hover-class="none" bindtap="goExperience">立即体验</view>
  </view>
  <!-- 失败：上下排，「重新配网」主按钮占满整行在上，「取消」在下只是橙色文字 -->
  <view wx:elif="{{phase === 'failed'}}" class="provision-actions provision-actions--stack">
    <view class="provision-primary" hover-class="none" bindtap="retry">重新配网</view>
    <view class="provision-cancel" hover-class="none" bindtap="cancel">取消</view>
  </view>

  <global-toast id="globalToast"></global-toast>
</view>
