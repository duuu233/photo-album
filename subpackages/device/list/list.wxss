/* 顶部添加按钮：单独一行，右对齐到与下方卡片相同的内容边缘（2026-11-06 起常驻，Tab 在它下一行） */
.device-toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

/* ── WiFi版 / 蓝牙版 Tab（2026-11-06）：样式与交互照投屏记录页 .record-tabs，
   白色胶囊底 + 橙色滑动指示器，切到蓝牙版时指示器平移一格；单独一行占满宽度 ── */
.device-tabs {
  position: relative;
  display: flex;
  height: 82rpx;
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.84);
  border-radius: 999rpx;
  box-shadow: 0 16rpx 38rpx rgba(126, 150, 184, 0.08);
}

.device-tabs__indicator {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  z-index: 0;
  width: calc(50% - 8rpx);
  border-radius: 999rpx;
  background-color: #ff6a20;
  box-shadow: 0 10rpx 24rpx rgba(255, 106, 32, 0.32);
  transition: transform 0.36s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.device-tabs--ble .device-tabs__indicator {
  transform: translateX(100%);
}

.device-tab {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  color: #858b94;
  background: transparent;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: color 0.32s ease;
}

.device-tab.is-active {
  color: #ffffff;
}

/* 与投屏记录页 .record-count 同款：Tab 下方「共 N 台设备」 */
.device-count {
  margin: 36rpx 0 18rpx;
  color: #777e88;
  font-size: 24rpx;
  line-height: 1;
}

/* ── 当前 Tab 没有设备：默认设备图 + 右下角加号，整块点击进搜索设备页 ── */
.empty-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36rpx;
  padding: 56rpx 36rpx 64rpx;
  text-align: center;
}

.empty-tab--hover {
  opacity: 0.82;
}

.empty-tab__art {
  position: relative;
  width: 360rpx;
  height: 284rpx;
}

.empty-tab__img {
  width: 100%;
  height: 100%;
}

.empty-tab__plus {
  position: absolute;
  right: 36rpx;
  bottom: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.24);
}

.empty-tab__title {
  margin-top: 20rpx;
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-tab__desc {
  margin-top: 12rpx;
  color: #ff6a20;
  font-size: 26rpx;
}

.device-add-btn {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.18);
}

.device-add-btn__icon {
  width: 100%;
  height: 100%;
}

.device-add-btn--hover {
  opacity: 0.82;
}

.device-content {
  padding-top: 40rpx;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.device-card {
  position: relative;
  overflow: hidden;
  padding-top: 48rpx;
  fill: rgba(255, 255, 255, 0.4);
  stroke-width: 1px;
  stroke: #fff;
  backdrop-filter: blur(5px);
  border-radius: 40rpx 40rpx 40rpx 40rpx;
}

.device-card--promoted {
  animation: devicePromoted 0.52s cubic-bezier(0.2, 0.82, 0.28, 1);
}

@keyframes devicePromoted {
  0% {
    opacity: 0.45;
    transform: translateY(32rpx) scale(0.985);
  }
  58% {
    transform: translateY(-7rpx) scale(1.008);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.device-card:not(.is-offline) {
  /* background: linear-gradient(
    180deg,
    rgba(255, 245, 237, 0.94) 0%,
    rgba(255, 255, 255, 0.82) 60%
  );
  border-color: rgba(255, 214, 188, 0.8); */
}

.device-card__main {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 0 34rpx 0 40rpx;
}

.device-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  /* width: 92rpx;
  height: 92rpx;
  padding: 20rpx;
  border-radius: 16px;
  border-radius: 16px;
  background: rgba(42, 43, 43, 0.04); */

  /* 2026-07-19：设备图改用首页设备卡那张 home-device-thumb（旧名 home-icon02），它四角透明、自带圆角底色，
     再叠一层底色会在四角露出色晕（首页并没有底色容器），故这里不设 background。 */
}
.device-logo__icon {
  width: 120rpx;
  height: 120rpx;
}

.device-copy {
  flex: 1;
  min-width: 0;
  margin-left: 44rpx;
}

.device-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.device-name {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-name-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 6rpx;
}

.edit-name-icon {
  width: 36rpx;
  height: 36rpx;
}

.device-id {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: #8b9098;
  font-size: 22rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-meta {
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-height: 34rpx;
  margin-top: 10rpx;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1;
}

.connection,
.battery-meta {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.connection {
  color: #9ba2ad;
}

.connection.is-connected {
  color: #287dff;
}

.battery-meta {
  color: #737b86;
}

.meta-bt-icon {
  flex: 0 0 auto;
  width: 22rpx;
  height: 28rpx;
}

.device-chevron {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 44rpx;
  color: #777e88;
}

.device-chevron__icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.device-delete-hint {
  position: absolute;
  right: 34rpx;
  top: 148rpx;
  min-width: 64rpx;
  min-height: 44rpx;
  color: #9ba2ad;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
}

.device-actions {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  height: 84rpx;
  margin-top: 34rpx;
  /* 背景色与设备详情页 .device-actions.glass-panel 一致（取全局 .glass-panel） */
  /* background: rgba(255, 255, 255, 0.4); */
  border-radius: 40rpx;
  border: 1px solid rgba(255, 255, 255, 0.31);
  box-shadow: 0 4px 12.1px 0 rgba(44, 63, 97, 0.03);
  backdrop-filter: blur(7.949999809265137px);
}

.device-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 84rpx;
  color: #777e88;
  font-size: 28rpx;
  font-weight: 500;
}

.projection-action {
  color: #eb5f1b;
}

.device-action-divider {
  height: 38rpx;
  background: #dadddf;
}

.connection-action.disconnect {
  color: #eb5f1b;
}

.connection-action.connect {
  color: #2079fc;
}

.action-frame-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.action-bt-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

/* 分组标题 .device-group-title（2026-10-27）已于 2026-11-06 删除：WiFi 版 / 蓝牙版改由顶部 Tab 区分 */

/* ── WiFi 版卡片：在线青绿（与 WiFi版 角标同色）、休眠中蓝、离线 / 未知灰 ── */
.wifi-state {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #9ba2ad;
}

.wifi-state.is-online {
  color: #0e9f87;
}

.wifi-state.is-sleeping {
  color: #2f80ed;
}

/* 本地模式（2026-10-29，TF 卡本地播放）：紫色 */
.wifi-state.is-local {
  color: #8e5bd9;
}

.meta-wifi-icon {
  flex: 0 0 auto;
  width: 26rpx;
  height: 26rpx;
}

.is-offline .meta-wifi-icon,
.is-sleeping .meta-wifi-icon,
.is-shutdown .meta-wifi-icon,
.is-local .meta-wifi-icon,
.is-unknown .meta-wifi-icon {
  opacity: 0.45;
  filter: grayscale(1);
}

.wifi-state__spinner {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid rgba(14, 159, 135, 0.25);
  border-top-color: #0e9f87;
  border-radius: 50%;
  box-sizing: border-box;
  animation: wifiStateSpin 0.8s linear infinite;
}

@keyframes wifiStateSpin {
  to {
    transform: rotate(360deg);
  }
}

.wifi-slideshow-action {
  color: #0e9f87;
}

.action-slideshow-icon {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
}

/* 轮播开启中标记（2026-11-02）：图标右上角绿点（带呼吸光圈），颜色同「轮播设置」。
   2026-11-05：去掉「轮播中」文字标签，开启中图标换绿色版（device-detail-icon01-on.png），只在 running 且设备在线时显示 */
.slideshow-icon-wrap {
  position: relative;
  display: flex;
  flex: 0 0 auto;
}

.slideshow-on-dot {
  position: absolute;
  top: -4rpx;
  right: -6rpx;
  width: 14rpx;
  height: 14rpx;
  box-sizing: border-box;
  background: #0e9f87;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  animation: slideshowOnPulse 1.6s ease-out infinite;
}

@keyframes slideshowOnPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(14, 159, 135, 0.45);
  }
  70% {
    box-shadow: 0 0 0 10rpx rgba(14, 159, 135, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(14, 159, 135, 0);
  }
}

.empty-device {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 36rpx;
  text-align: center;
}

.empty-device__art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.1);
  border-radius: 30rpx;
}

.empty-device__title {
  margin-top: 26rpx;
  color: #2a2d32;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-device__desc {
  margin-top: 14rpx;
  color: #7e858f;
  font-size: 26rpx;
}

.empty-device__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 72rpx;
  margin-top: 34rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

/* ── 「拍照 / 相册」选择弹层（与设备详情页 media-sheet 同款，点某台设备的「投屏」后弹出）────── */
.media-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(42, 43, 43, 0.5);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: popSheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.media-sheet {
  height: 706rpx;
  padding: 42rpx 48rpx 0;
}

.media-sheet-title {
  margin-bottom: 46rpx;
  color: #2a2b2b;
  font-size: 40rpx;
  font-weight: 500;
}

.media-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 128rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  background: #f8f9fb;
  border-radius: 28rpx;
}

.media-option-left {
  display: flex;
  align-items: center;
}

.media-art.mini {
  position: relative;
  width: 98rpx;
  height: 96rpx;
}

.media-option-copy {
  height: 100%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  padding-left: 28rpx;
}

.media-option-copy view {
  color: #2a2d32;
  font-size: 32rpx;
  font-weight: 500;
}

.media-option-copy text {
  display: block;
  margin-top: 12rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1;
}

.round-arrow {
  width: 118rpx;
  height: 118rpx;
}

.cancel-action {
  position: absolute;
  right: 48rpx;
  bottom: 108rpx;
  left: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 112rpx;
  color: #2a2d32;
  background: #ededed;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 500;
}
