/* 顶部添加按钮：右对齐到与下方卡片相同的内容边缘 */
.device-toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.device-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(255, 102, 31, 0.18);
}

.device-add-btn__icon {
  width: 100%;
  height: 100%;
}

.device-add-btn--hover {
  opacity: 0.82;
}

.device-content {
  padding-top: 40rpx;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.device-card {
  position: relative;
  overflow: hidden;
  padding-top: 48rpx;
  fill: rgba(255, 255, 255, 0.4);
  stroke-width: 1px;
  stroke: #fff;
  backdrop-filter: blur(5px);
  border-radius: 40rpx 40rpx 40rpx 40rpx;
}

.device-card:not(.is-offline) {
  /* background: linear-gradient(
    180deg,
    rgba(255, 245, 237, 0.94) 0%,
    rgba(255, 255, 255, 0.82) 60%
  );
  border-color: rgba(255, 214, 188, 0.8); */
}

.device-card__main {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 0 34rpx 0 40rpx;
}

.device-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  /* width: 92rpx;
  height: 92rpx; */
  padding: 20rpx;
  border-radius: 16px;
  border-radius: 16px;
  background: rgba(42, 43, 43, 0.04);
}
.device-logo-is-connected {
  background: rgba(255, 175, 139, 0.1);
}
.device-logo__icon {
  width: 92rpx;
  height: 92rpx;
}

.device-copy {
  flex: 1;
  min-width: 0;
  margin-left: 44rpx;
}

.device-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.device-name {
  overflow: hidden;
  color: #2a2d32;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-name-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 6rpx;
}

.edit-name-icon {
  width: 36rpx;
  height: 36rpx;
}

.device-meta {
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-height: 34rpx;
  margin-top: 14rpx;
  color: #8b9098;
  font-size: 24rpx;
  line-height: 1;
}

.connection,
.battery-meta {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.connection {
  color: #9ba2ad;
}

.connection.is-connected {
  color: #287dff;
}

.battery-meta {
  color: #737b86;
}

.meta-bt-icon {
  flex: 0 0 auto;
  width: 22rpx;
  height: 28rpx;
}

.device-chevron {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 44rpx;
  color: #777e88;
}

.device-delete-hint {
  position: absolute;
  right: 34rpx;
  top: 148rpx;
  min-width: 64rpx;
  min-height: 44rpx;
  color: #9ba2ad;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
}

.device-actions {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  height: 84rpx;
  margin-top: 34rpx;
  background: rgba(255, 255, 255, 0.54);
  border-radius: 40rpx;
  border: 1px solid rgba(255, 255, 255, 0.31);
  background: linear-gradient(
    88deg,
    rgba(255, 255, 255, 0.38) 2.41%,
    rgba(255, 255, 255, 0.55) 96.27%
  );
  box-shadow: 0 4px 12.1px 0 rgba(44, 63, 97, 0.03);
  backdrop-filter: blur(7.949999809265137px);
}

.device-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 84rpx;
  color: #777e88;
  font-size: 24rpx;
  font-weight: 500;
}

.device-action-divider {
  height: 38rpx;
  background: #dadddf;
}

.connection-action.disconnect {
  color: #eb5f1b;
}

.connection-action.connect {
  color: #2079fc;
}

.action-frame-icon {
  flex: 0 0 auto;
  width: 32rpx;
  height: 30rpx;
}

.action-bt-icon {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
}

.empty-device {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 36rpx;
  text-align: center;
}

.empty-device__art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  color: #ff6a20;
  background: rgba(255, 106, 32, 0.1);
  border-radius: 30rpx;
}

.empty-device__title {
  margin-top: 26rpx;
  color: #2a2d32;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-device__desc {
  margin-top: 14rpx;
  color: #7e858f;
  font-size: 26rpx;
}

.empty-device__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 72rpx;
  margin-top: 34rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9140 0%, #ff6a20 100%);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}
