<view class="mock-root device-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202606161438400869930.png" mode="aspectFill"></image>
  </view>

  <page-nav title="{{selectMode ? '选择相框' : '我的设备'}}"></page-nav>

  <view class="mock-content device-content">
    <view class="device-toolbar">
      <view class="device-add-btn" hover-class="device-add-btn--hover" aria-label="添加设备" bindtap="goBind">
        <image class="device-add-btn__icon" src="/assets/images/home-add-icon.png" mode="aspectFit"></image>
      </view>
    </view>

    <view wx:if="{{devices.length}}" class="device-list">
      <view class="device-card glass-panel {{item.connected ? '' : 'is-offline'}}" wx:for="{{devices}}" wx:key="id" wx:for-index="index" data-id="{{item.id}}" bindtap="selectDevice">
        <view class="device-card__main">
          <view class="device-logo {{item.connected ? 'device-logo-is-connected' : ''}}">
            <image class="device-logo__icon" src="{{item.connected ? '/assets/images/device-list-icon04.png' : '/assets/images/device-list-icon05.png'}}" mode="aspectFit"></image>
          </view>

          <view class="device-copy">
            <view class="device-name-row">
              <text class="device-name">{{item.name}}</text>
              <view class="edit-name-btn" hover-class="none" catchtap="renameDevice" data-id="{{item.id}}" aria-label="编辑设备名称">
                <image class="edit-name-icon" src="/assets/images/edit-icon01.png" mode="aspectFit"></image>
              </view>
            </view>
            <view class="device-meta">
              <view class="connection {{item.connected ? 'is-connected' : ''}}">
                <image class="meta-bt-icon" src="{{item.connected ? '/assets/images/bluetooth-icon.png' : '/assets/images/bluetooth-icon-not.png'}}" mode="aspectFit"></image>
                <text>{{item.connected ? '已连接' : '未连接'}}</text>
              </view>
              <view wx:if="{{item.connected && item.batteryText}}" class="battery-meta">
                <image class="battery-level-icon" src="{{item.batteryIcon}}" mode="aspectFit"></image>
                <text>{{item.batteryText}}</text>
              </view>
            </view>
          </view>

          <view class="device-chevron">
            <image class="device-chevron__icon" src="/assets/images/mine-icon-right.png" mode="aspectFit"></image>
          </view>
        </view>

        <!-- <view wx:if="{{item.canDeleteHint}}" class="device-delete-hint" hover-class="none" data-id="{{item.id}}" catchtap="deleteDevice">删除</view> -->

        <view class="device-actions">
          <view class="device-action" hover-class="none" data-id="{{item.id}}" catchtap="goSlideshow">
            <image class="action-frame-icon" src="/assets/images/carousel-settings-icon01.png" mode="aspectFit"></image>
            <text>轮播设置</text>
          </view>
          <view class="device-action-divider"></view>
          <view class="device-action connection-action {{item.connected ? 'disconnect' : 'connect'}}" hover-class="none" data-id="{{item.id}}" catchtap="toggleConnection">
            <image class="action-bt-icon" src="{{item.connected ? '/assets/images/disconnect-icon01.png' : '/assets/images/bluetooth-connection.png'}}" mode="aspectFit"></image>
            <text>{{item.connected ? '断开' : '连接'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-device glass-panel" wx:else>
      <view class="empty-device__art">
        <view class="frame-logo"></view>
      </view>
      <view class="empty-device__title">暂无设备</view>
      <view class="empty-device__desc">请先搜索并绑定附近的智能相框。</view>
      <view class="empty-device__btn" hover-class="none" bindtap="goBind">添加设备</view>
    </view>
  </view>
</view>
