<view class="mock-root device-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="/assets/images/bg02.png" mode="aspectFill"></image>
  </view>

  <page-nav title="{{selectMode ? '选择相框' : '我的设备'}}" right-text="+" bind:righttap="goBind"></page-nav>

  <view class="mock-content device-content">
    <view wx:if="{{devices.length}}" class="device-list">
      <view class="device-card glass-panel {{item.connected ? '' : 'is-offline'}}" wx:for="{{devices}}" wx:key="id" wx:for-index="index" data-id="{{item.id}}" bindtap="selectDevice">
        <view class="device-card__main">
          <view class="device-logo">
            <view class="frame-logo"></view>
          </view>

          <view class="device-copy">
            <view class="device-name-row">
              <text class="device-name">{{item.name}}</text>
              <button class="edit-name-btn" hover-class="none" catchtap="renameDevice" data-id="{{item.id}}" aria-label="编辑设备名称">
                <view class="edit-name-icon"></view>
              </button>
            </view>
            <view class="device-meta">
              <view class="connection {{item.connected ? 'is-connected' : ''}}">
                <view class="ui-bluetooth"></view>
                <text>{{item.connected ? '已连接' : '未连接'}}</text>
              </view>
              <view wx:if="{{item.connected}}" class="battery-meta">
                <view class="ui-battery"><view class="ui-battery__fill" style="width: {{item.battery}}%;"></view></view>
                <text>{{item.battery}}%</text>
              </view>
            </view>
          </view>

          <view class="device-chevron">
            <view class="ui-chevron"></view>
          </view>
        </view>

        <button wx:if="{{item.canDeleteHint}}" class="device-delete-hint" hover-class="none" data-id="{{item.id}}" catchtap="deleteDevice">删除</button>

        <view class="device-actions">
          <button class="device-action" hover-class="none" data-id="{{item.id}}" catchtap="goSlideshow">
            <view class="action-frame-icon"></view>
            <text>轮播设置</text>
          </button>
          <view class="device-action-divider"></view>
          <button class="device-action connection-action {{item.connected ? 'disconnect' : 'connect'}}" hover-class="none" data-id="{{item.id}}" catchtap="toggleConnection">
            <view class="ui-bluetooth"></view>
            <text>{{item.connected ? '断开' : '连接'}}</text>
          </button>
        </view>
      </view>
    </view>

    <view class="empty-device glass-panel" wx:else>
      <view class="empty-device__art">
        <view class="frame-logo"></view>
      </view>
      <view class="empty-device__title">暂无设备</view>
      <view class="empty-device__desc">请先搜索并绑定附近的智能相框。</view>
      <button class="empty-device__btn" hover-class="none" bindtap="goBind">添加设备</button>
    </view>
  </view>
</view>
