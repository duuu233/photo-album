<view class="mock-root device-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202607310920402821453.png" mode="aspectFill"></image>
  </view>

  <page-nav title="{{selectMode ? '选择相框' : '我的设备'}}"></page-nav>

  <view class="mock-content device-content">
    <view class="device-toolbar" wx:if="{{!loading && devices.length}}">
      <view class="device-add-btn" hover-class="device-add-btn--hover" aria-label="添加设备" bindtap="goBind">
        <image class="device-add-btn__icon" src="/assets/images/home-add-icon.png" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 加载中：等接口返回再决定展示设备列表还是空态，避免空态先闪一下 -->
    <view wx:if="{{loading}}" class="page-loading">
      <view class="page-loading__spinner"></view>
      <view class="page-loading__text">加载中…</view>
    </view>

    <!-- 加载失败：与「暂无设备」空态严格区分（弱网时伪装成空态会让用户以为设备被解绑），并给一键重试 -->
    <view wx:elif="{{loadError}}" class="empty-device glass-panel">
      <view class="empty-device__art">
        <view class="frame-logo"></view>
      </view>
      <view class="empty-device__title">加载失败</view>
      <view class="empty-device__desc">网络异常或服务出错，请稍后重试。</view>
      <view class="empty-device__btn" hover-class="none" bindtap="retryLoad">重新加载</view>
    </view>

    <view wx:elif="{{devices.length}}" class="device-list">
      <view class="device-card glass-panel {{item.connected ? '' : 'is-offline'}} {{reorderingDeviceId === '' + item.id ? 'device-card--promoted' : ''}}" wx:for="{{devices}}" wx:key="id" wx:for-index="index" data-id="{{item.id}}" bindtap="selectDevice">
        <view class="device-card__main">
          <!-- 2026-07-19 产品要求：设备图统一用首页那张 home-icon02（首页/列表/详情三处同图），
               且不区分连接状态；连接状态由蓝牙角标和状态文案表达。
               该图四角透明自带圆角，故 .device-logo 不再加底色（首页也没有底色）。 -->
          <view class="device-logo">
            <image class="device-logo__icon" src="/assets/images/home-icon02.png" mode="aspectFit"></image>
          </view>

          <view class="device-copy">
            <view class="device-name-row">
              <text class="device-name">{{item.name}}</text>
              <view class="edit-name-btn" hover-class="none" catchtap="renameDevice" data-id="{{item.id}}" aria-label="编辑设备名称">
                <image class="edit-name-icon" src="/assets/images/edit-icon01.png" mode="aspectFit"></image>
              </view>
            </view>
            <!-- productDeviceId 来自 getUserProductList.deviceId，经 API 层校验为完整 6 字节后展示；空值不占位 -->
            <text wx:if="{{item.productDeviceId}}" class="device-id">设备ID {{item.productDeviceId}}</text>
            <view class="device-meta">
              <view class="connection {{item.connected ? 'is-connected' : ''}}">
                <image class="meta-bt-icon" src="{{item.connected ? '/assets/images/bluetooth-icon.png' : '/assets/images/bluetooth-icon-not.png'}}" mode="aspectFit"></image>
                <text>{{item.connected ? '已连接' : '未连接'}}</text>
              </view>
              <view wx:if="{{item.connected && item.batteryText}}" class="battery-meta">
                <image class="battery-level-icon" src="{{item.batteryIcon}}" mode="aspectFit"></image>
                <text>{{item.batteryText}}</text>
              </view>
            </view>
          </view>

          <view class="device-chevron">
            <image class="device-chevron__icon" src="/assets/images/mine-icon-right.png" mode="aspectFit"></image>
          </view>
        </view>

        <!-- <view wx:if="{{item.canDeleteHint}}" class="device-delete-hint" hover-class="none" data-id="{{item.id}}" catchtap="deleteDevice">删除</view> -->

        <view class="device-actions">
          <view class="device-action projection-action" hover-class="none" data-id="{{item.id}}" catchtap="startProjection">
            <image class="action-frame-icon" src="/assets/images/screen-casting-icon01.png" mode="aspectFit"></image>
            <text>投屏</text>
          </view>
          <view class="device-action-divider"></view>
          <view class="device-action connection-action {{item.connected ? 'disconnect' : 'connect'}}" hover-class="none" data-id="{{item.id}}" catchtap="toggleConnection">
            <image class="action-bt-icon" src="{{item.connected ? '/assets/images/disconnect-icon01.png' : '/assets/images/bluetooth-connection.png'}}" mode="aspectFit"></image>
            <text>{{item.connected ? '断开' : '连接'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-device glass-panel" wx:else>
      <view class="empty-device__art">
        <view class="frame-logo"></view>
      </view>
      <view class="empty-device__title">暂无设备</view>
      <view class="empty-device__desc">请先搜索并绑定附近的智能相框。</view>
      <view class="empty-device__btn" hover-class="none" bindtap="goBind">添加设备</view>
    </view>
  </view>

  <!-- 「拍照 / 相册」选择弹层：点某台设备的「投屏」后弹出，交互与设备详情页一致。
       点遮罩关闭；点弹层内部用 catchtap="noop" 阻止冒泡，避免误关 -->
  <view class="media-mask" wx:if="{{showMediaSheet}}" catchtouchmove="noop" bindtap="hideMediaSheet">
    <view class="bottom-sheet media-sheet {{mediaSheetClosing ? 'pop-closing-sheet' : ''}}" catchtap="noop">
      <view class="media-sheet-title">选择投屏方式</view>
      <view class="media-option" hover-class="none" bindtap="chooseCamera">
        <view class="media-option-left">
          <image class="media-art mini camera-art" src="/assets/images/home-media-mini01.png" mode="aspectFit"></image>
          <view class="media-option-copy">
            <view>拍照</view>
            <text>调用手机相机拍照</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-camera-card-right-icon.png" mode="aspectFit"></image>
      </view>
      <view class="media-option" hover-class="none" bindtap="chooseAlbum">
        <view class="media-option-left">
          <image class="media-art mini album-art" src="/assets/images/home-media-mini02.png" mode="aspectFit"></image>
          <view class="media-option-copy">
            <view>相册</view>
            <text>从手机相册选择照片</text>
          </view>
        </view>
        <image class="round-arrow" src="/assets/images/home-album-card-right-icon.png" mode="aspectFit"></image>
      </view>
      <view class="cancel-action" hover-class="none" bindtap="hideMediaSheet">取消</view>
    </view>
  </view>

  <device-name-dialog
    visible="{{renameVisible}}"
    value="{{renameValue}}"
    saving="{{renameSaving}}"
    bindcancel="cancelRename"
    bindconfirm="confirmRename"
  ></device-name-dialog>

  <global-toast id="globalToast"></global-toast>
</view>
