<!-- WiFi 版设备配网 · WiFi 账号密码（交互说明见 wifi-config.js 文件头）。切换图标回到 WiFi 列表页 -->
<view class="mock-root wifi-page" style="--status-bar: {{statusBarHeight}}px; --safe-bottom: {{safeBottom}}px; --nav-h: {{navHeight}}px;">
  <view class="mock-bg">
    <image class="mock-bg__image" src="https://oss.boltfox.cn/prodFile/202608211340094498724.jpg" mode="aspectFill"></image>
  </view>

  <page-nav title="WiFi 配网" bind:measure="onNavMeasure"></page-nav>

  <view class="mock-content wifi-content">
    <!-- 头图：手机 → 设备 → 云 -->
    <image class="wifi-art" src="/assets/images/wifi-provision-art.svg" mode="aspectFit"></image>

    <view wx:if="{{deviceName || deviceNo}}" class="wifi-device">
      <text class="wifi-device__name">{{deviceName || deviceNo}}</text>
      <text wx:if="{{spec}}" class="wifi-device__spec">{{spec}}</text>
    </view>

    <view class="wifi-tip">
      <view class="wifi-tip__icon">i</view>
      <text>设备仅支持 2.4G WiFi 配网</text>
    </view>

    <view class="wifi-form glass-panel">
      <view class="wifi-field">
        <text class="wifi-field__label">WiFi名称</text>
        <view class="wifi-field__box">
          <input class="wifi-field__input" value="{{ssid}}" placeholder="请输入或选择WiFi名称" placeholder-class="wifi-field__placeholder" bindinput="onSsidInput" />
          <view class="wifi-field__switch" hover-class="none" aria-role="button" aria-label="选择WiFi" bindtap="openWifiList">
            <image class="wifi-field__switch-icon" src="/assets/images/wifi-switch.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
      <view class="wifi-field">
        <text class="wifi-field__label">WiFi密码</text>
        <view class="wifi-field__box">
          <!-- 默认加密显示 ****，右侧小眼睛切换明文 / ****（2026-10-26 产品要求） -->
          <input class="wifi-field__input" value="{{password}}" password="{{!showPassword}}" placeholder="请输入WiFi密码" placeholder-class="wifi-field__placeholder" bindinput="onPasswordInput" />
          <view class="wifi-field__switch" hover-class="none" aria-role="button" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}" bindtap="togglePassword">
            <image class="wifi-field__eye-icon" src="{{showPassword ? '/assets/images/eye-open.svg' : '/assets/images/eye-closed.svg'}}" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="wifi-primary wifi-bottom" hover-class="none" bindtap="goNext">下一步</view>

  <global-toast id="globalToast"></global-toast>
  <debug-log></debug-log>
</view>
